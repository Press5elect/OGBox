From cfa74448635434275de449e192dd573fa1fd3def Mon Sep 17 00:00:00 2001
From: Press5elect <noreply@anthropic.com>
Date: Sun, 1 Nov 2026 04:31:56 +0000
Subject: [PATCH 1/7] native: the host PC of a signal's context on x86-64
 (NC_UC_PC)

---
 native/core/core.c |  2 +-
 native/core/nc.h   | 10 ++++++++++
 native/hle/glue.c  |  2 +-
 3 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/native/core/core.c b/native/core/core.c
index ae7dc59..1da7bf8 100644
--- a/native/core/core.c
+++ b/native/core/core.c
@@ -368,7 +368,7 @@ bool nc_core_fault(NcCore *c, int sig, siginfo_t *info, void *ucontext)
     if (sig == SIGILL) {
         return false;
     }
-    const uintptr_t pc = ((ucontext_t *)ucontext)->uc_mcontext.pc;
+    const uintptr_t pc = (uintptr_t)NC_UC_PC(ucontext);
     if (sig == SIGBUS && nc_cpu_unaligned_fault(c->cpu, info->si_code, ucontext)) {
         /* Doom 3 keeps a critical section at 0x00BFD88E: RtlEnterCriticalSection's
          * lock inc of its LockCount (0x00BFD89E) took the core down */
diff --git a/native/core/nc.h b/native/core/nc.h
index 66a36b1..0733209 100644
--- a/native/core/nc.h
+++ b/native/core/nc.h
@@ -60,4 +60,14 @@ static inline uint32_t nc_align_up(uint32_t v, uint32_t a)
 }
 #endif
 
+/* The host program counter of a signal's context (a ucontext_t *): aarch64
+ * Linux names it pc; x86-64 FreeBSD (the PS5) mc_rip; x86-64 Linux RIP. */
+#if defined(__aarch64__)
+#define NC_UC_PC(uc) (((ucontext_t *)(uc))->uc_mcontext.pc)
+#elif defined(__x86_64__) && defined(__FreeBSD__)
+#define NC_UC_PC(uc) (((ucontext_t *)(uc))->uc_mcontext.mc_rip)
+#elif defined(__x86_64__)
+#define NC_UC_PC(uc) (((ucontext_t *)(uc))->uc_mcontext.gregs[REG_RIP])
+#endif
+
 #endif
diff --git a/native/hle/glue.c b/native/hle/glue.c
index f9211dd..5b35935 100644
--- a/native/hle/glue.c
+++ b/native/hle/glue.c
@@ -160,7 +160,7 @@ static pthread_mutex_t g_smp_mu = PTHREAD_MUTEX_INITIALIZER;
 
 static void smp_signal(int sig, siginfo_t *si, void *uc)
 {
-    const uintptr_t pc = (uintptr_t)((ucontext_t *)uc)->uc_mcontext.pc;
+    const uintptr_t pc = (uintptr_t)NC_UC_PC(uc);
     uint32_t eip;
     uint32_t v;
     if (g_nc_idle_waiting) {
