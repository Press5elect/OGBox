From fc9f7c76c0fdeffb620b395f0c7551387bab62f4 Mon Sep 17 00:00:00 2001
From: Press5elect <noreply@anthropic.com>
Date: Sun, 1 Nov 2026 04:32:18 +0000
Subject: [PATCH 3/6] native: the aarch64 MMIO and RAM-fault decoder only on
 aarch64; weak defaults for the CPU backend elsewhere

---
 native/core/mmio.c | 39 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 39 insertions(+)

diff --git a/native/core/mmio.c b/native/core/mmio.c
index c2cdfb9..f7073f5 100644
--- a/native/core/mmio.c
+++ b/native/core/mmio.c
@@ -81,6 +81,9 @@ typedef struct Access {
     bool pair_offset; /* pair: the first element is at Rn + imm (signed-offset form) */
 } Access;
 
+#if defined(__aarch64__)
+/* The faulting access decoded from the aarch64 instruction FEX generated
+ * (loads, stores, pairs; their registers in the signal's context). */
 static int64_t sext(uint64_t v, unsigned bits)
 {
     return (int64_t)(v << (64 - bits)) >> (64 - bits);
@@ -442,6 +445,42 @@ bool nc_ram_emulate(NcVm *vm, const siginfo_t *info, void *ucontext,
     return true;
 }
 
+#else
+/* Another host: the guest's accesses are its CPU backend's to decode (x86-64,
+ * the native backend: the guest's own instruction). These are weak, so the
+ * backend gives the real ones; without them a fault on a device's registers
+ * or on tracked RAM is not handled here (the caller passes it on). */
+__attribute__((weak)) bool nc_mmio_fault(const NcVm *vm, const siginfo_t *info, void *ucontext)
+{
+    (void)vm;
+    (void)info;
+    (void)ucontext;
+    return false;
+}
+
+__attribute__((weak)) bool nc_ram_access_span(const NcVm *vm, const siginfo_t *info, void *ucontext, uint32_t *lo,
+                                              uint32_t *hi, bool *store)
+{
+    (void)vm;
+    (void)info;
+    (void)ucontext;
+    (void)lo;
+    (void)hi;
+    (void)store;
+    return false;
+}
+
+__attribute__((weak)) bool nc_ram_emulate(NcVm *vm, const siginfo_t *info, void *ucontext,
+                                          void (*stored)(uint32_t pa, uint32_t n))
+{
+    (void)vm;
+    (void)info;
+    (void)ucontext;
+    (void)stored;
+    return false;
+}
+#endif
+
 /* nc_mmio_access's store may run again (nc_mmio_retry); one was asked for */
 static __thread bool t_retry_ok, t_retry;
 
