+                 (unsigned long long)g_reader.cur_off, g_reader.cur_n, (double)(now - g_reader.cur_since_ns) / 1e6,
+                 stage[g_reader.cur_stage & 3]);
+    }
+    uint64_t oldest = 0;
+    for (unsigned i = 0; i < g_reader.n; i++) {
+        const DiscJob *j = &g_reader.q[(g_reader.head + i) % DISC_JOBS];
+        oldest = !oldest || j->queued_ns < oldest ? j->queued_ns : oldest;
+    }
+    nc_log("hakuX-native-io", "reader: %s; queued %u (oldest %.1f ms), read and not completed %u, busy %u | totals: "
