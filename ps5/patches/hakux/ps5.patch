+/* OGBox 1.0.2: HAKUX_HLE_VSHLOG=1: each vertex program, once, as its tokens and the GLSL it
+ * runs as (the first 256 programs; the draw log names a draw's program by the same hash) */
+static void vshlog(uint64_t hash, const uint32_t *tok, uint32_t nslots, const char *glsl)
+{
+    static int on = -1;
+    static uint64_t seen[256];
+    static unsigned nseen;
+    static pthread_mutex_t mu = PTHREAD_MUTEX_INITIALIZER;
+    if (on < 0) {
+        on = getenv("HAKUX_HLE_VSHLOG") != NULL;
+    }
+    if (!on || !hash || !tok) {
+        return;
+    }
+    pthread_mutex_lock(&mu);
+    bool fresh = nseen < 256;
+    for (unsigned i = 0; i < nseen && fresh; i++) {
+        fresh = seen[i] != hash;
+    }
+    if (fresh) {
+        seen[nseen++] = hash;
+    }
+    pthread_mutex_unlock(&mu);
+    if (!fresh) {
+        return;
+    }
+    hle_log("hakuX-hle-vsh", "program %016llx: %u slots", (unsigned long long)hash, nslots);
+    for (uint32_t i = 0; i < nslots; i++) {
+        hle_log("hakuX-hle-vsh", "  %016llx tok %3u: %08x %08x %08x %08x", (unsigned long long)hash, i,
+                tok[4 * i], tok[4 * i + 1], tok[4 * i + 2], tok[4 * i + 3]);
+    }
+    for (const char *l = glsl; l && *l;) {
+        const char *e = strchr(l, '\n');
+        const int n = e ? (int)(e - l) : (int)strlen(l);
+        if (n) {
+            hle_log("hakuX-hle-vsh", "  %016llx | %.*s", (unsigned long long)hash, n, l);
+        }
+        l = e ? e + 1 : NULL;
+    }
+}
