+ * held over them. false on a read error. A file with nothing held reads as pread does: false
+ * unless all len bytes are there. */
+bool nc_wb_read(int fd, uint64_t ino, uint64_t off, uint8_t *buf, uint32_t len);
+
+/* The file is cut to size (io.c truncates the host file after): held bytes past it go. */
+void nc_wb_truncate(uint64_t ino, uint64_t size);
+/* Times set on the file (io.c sets them on the host file too): set again once its held bytes are
+ * written, which change its write time. tv: access, then modification. */
+void nc_wb_times(uint64_t ino, const struct timeval tv[2]);
+/* The file was deleted from the host: its held bytes are dropped. */
+void nc_wb_deleted(uint64_t ino);
+/* Every file under the folder dir is going or being replaced (a cache drive formatted, a state's
+ * drive put back): their held bytes are dropped, after a write of theirs under way. */
+void nc_wb_deleted_under(const char *dir);
+/* A file or folder was renamed on the host (old to new, host paths): the journal follows. */
+void nc_wb_renamed(const char *old_path, const char *new_path);
+
+/* Waits until the file's held bytes are on the host (its own written first). */
+void nc_wb_drain(uint64_t ino);
+/* Waits until every held byte is. */
+void nc_wb_drain_all(void);
+
+typedef struct NcWbStats {
+    uint64_t held, held_max, written, writes, files, waits_cap, drains;
+    double write_s, drain_s, slowest_ms;
+} NcWbStats;
+void nc_wb_stats(NcWbStats *s);
+/* OGBox 0.0.9: the host file the held bytes now go to ("" when none are held). */
+void nc_wb_current(char *path, size_t n);
