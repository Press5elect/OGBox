+/* An IRP for one of the kernel's own devices (no driver: the disc, a hard disk
+ * partition), done as the same request through a file is: its status, *info the
+ * bytes moved. */
+static uint32_t device_irp(NcKernel *k, uint32_t dev, uint32_t irp, uint32_t sp, uint32_t *info)
+{
+    *info = 0;
+    const char *path = NULL, *rel = "";
+    for (int i = 0; i < 32 && !path; i++) {
+        if (g_devices[i].object == dev) {
+            path = g_devices[i].name;
+        }
+    }
+    const int part = path ? device_of(path, &rel) : -2;
+    if (part == -2 || *rel) {
+        return STATUS_INVALID_DEVICE_REQUEST;
+    }
+    const uint8_t major = *(const uint8_t *)nc_vm_host(k->vm, sp + NC_SL_MAJOR);
+    const uint32_t buf = nc_vm_rd32(k->vm, irp + NC_IRP_USER_BUFFER);
+    switch (major) {
+    case IRP_MJ_READ:
+    case IRP_MJ_WRITE: {
+        const bool write = major == IRP_MJ_WRITE;
+        const uint32_t len = nc_vm_rd32(k->vm, sp + NC_SL_LENGTH);
+        const uint64_t off =
+            (uint64_t)nc_vm_rd32(k->vm, sp + NC_SL_OFFSET) | (uint64_t)nc_vm_rd32(k->vm, sp + NC_SL_OFFSET + 4) << 32;
+        if (len && !buf) {
+            return NC_STATUS_INVALID_PARAMETER;
+        }
+        for (uint32_t pg = buf & ~(NC_PAGE - 1); len && pg < buf + len; pg += NC_PAGE) {
+            if (nc_vm_phys(k->vm, pg) == UINT32_MAX) {
+                return 0xC0000005u; /* STATUS_ACCESS_VIOLATION: no page there (in the middle of an IRP: not paged in) */
+            }
+        }
+        if (part == -1) {
+            if (write) {
+                return STATUS_MEDIA_WRITE_PROTECTED;
+            }
+            if (!k->disc || k->disc->fd < 0) {
+                return STATUS_NO_MEDIA_IN_DEVICE;
+            }
+            uint8_t *bytes = malloc(len ? len : 1);
+            if (!bytes) {
+                return NC_STATUS_INSUFFICIENT_RESOURCES;
+            }
+            const NcDiscFile raw = {.sector = (uint32_t)(off / DISC_SECTOR), .size = UINT32_MAX};
+            const bool ok = !len || nc_disc_read(k->disc, &raw, off % DISC_SECTOR, bytes, len);
+            if (ok && len) {
+                nc_vm_will_write(buf, len);
+                nc_vm_copy_out(k->vm, buf, bytes, len);
+            }
+            free(bytes);
+            if (!ok) {
+                return 0xC000009Cu; /* STATUS_DEVICE_DATA_ERROR */
+            }
+        } else if (part == 0 || part >= 3) {
+            /* the config sectors, a cache partition's head (raw_io) */
+            if (write) {
+                nc_vm_will_read(buf, len);
+            } else {
+                nc_vm_will_write(buf, len);
+            }
+            raw_io_guest(k, part, off, buf, len, write);
+        } else {
+            return STATUS_INVALID_DEVICE_REQUEST; /* the data and system drives are host folders */
+        }
+        *info = len;
+        return NC_STATUS_SUCCESS;
+    }
+    case IRP_MJ_DEVICE_CONTROL:
+    case IRP_MJ_INTERNAL_DEVICE_CONTROL: {
+        /* the codes NtDeviceIoControlFile answers (NtControlFile), the output in UserBuffer */
+        const uint32_t code = nc_vm_rd32(k->vm, sp + NC_SL_CODE), out_len = nc_vm_rd32(k->vm, sp + NC_SL_OUT_LENGTH);
+        uint32_t status = NC_STATUS_SUCCESS;
+        if (part >= 0 && (code >> 16) == 7) { /* FILE_DEVICE_DISK */
+            NcFile volume;
+            memset(&volume, 0, sizeof(volume));
+            volume.kind = F_VOLUME;
+            volume.partition = part;
+            *info = disk_ioctl(&volume, code, buf ? nc_vm_host(k->vm, buf) : NULL, buf ? out_len : 0, &status);
+        } else if (code == IOCTL_SCSI_PASS_THROUGH_DIRECT) {
+            scsi_pass_through(k, nc_vm_rd32(k->vm, sp + NC_SL_IN_BUFFER), nc_vm_rd32(k->vm, sp + NC_SL_IN_LENGTH));
+        } else if (code != FSCTL_LOCK_VOLUME && code != FSCTL_UNLOCK_VOLUME && code != FSCTL_DISMOUNT_VOLUME) {
+            static uint32_t told[16];
+            unsigned i = 0;
+            while (i < 16 && told[i] && told[i] != code) {
+                i++;
+            }
+            if (i < 16 && !told[i]) {
+                told[i] = code;
+                nc_log("hakuX-native-io", "irp control %08x on %s: not known here (invalid device request)", code,
+                       path);
+            }
+            status = STATUS_INVALID_DEVICE_REQUEST;
+        }
+        return status;
+    }
+    case IRP_MJ_FLUSH_BUFFERS: /* nothing held back */
+        return NC_STATUS_SUCCESS;
+    default:
+        return STATUS_INVALID_DEVICE_REQUEST;
+    }
+}
