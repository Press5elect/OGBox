+    HT_CHECK(strstr(buf, "pf = clamp((nh + sp.x) / den, 0.0, 10000.0);") != NULL);
+    HT_CHECK(strstr(buf, "vec3 fo = c[102].xyz;") != NULL);
+    HT_CHECK(!strstr(buf, "pow(nh"));
+}
+
+static void test_texgen_infinite_viewer(void)
+{
+    HleFfhwKey k = { .magic = HLE_FFHW_MAGIC, .texgen_infinite = 1 };
+    k.texgen[0][0] = HLE_FFHW_TG_SPHERE;
+    k.texgen[0][2] = HLE_FFHW_TG_REFLECTION;
+    HT_CHECK(gen(&k, 0x1E1F) > 0);
+    HT_CHECK(strstr(buf, "vec3 r = reflect(vec3(0.0, 0.0, 1.0), tN);") != NULL);
+    HT_CHECK(strstr(buf, "oT0.z = reflect(vec3(0.0, 0.0, 1.0), tN).z;") != NULL);
+    HT_CHECK(!strstr(buf, "normalize(tPos.xyz)"));
+}
+
+/* two-sided lighting, as the NV2A tests (Lighting Two Sided, Specular back)
+ * show it: lit, the back colours from the back registers along -N by the
+ * back's own colour sources, and without SEPARATE_SPECULAR the front vertex
+ * specular passed through; unlit, (0, 0, 0, 1) whatever the back colour
+ * registers hold */
+static void test_two_side(void)
+{
+    HleFfhwKey k = { .magic = HLE_FFHW_MAGIC, .lighting = 1, .two_side = 1, .specular = 1,
+                     .src = { 0, 0, 1, 0 }, .bsrc = { 0, 0, 0, 2 }, .light = { 1, 2 } };
+    size_t n = gen(&k, 0x1E1F | 3u << 7);               /* back colour arrays too */
+    HT_CHECK(n > 0 && n == strlen(buf));
+    dump("ffhw_two_side");
+    /* the front's diffuse from the vertex, the back's from the material;
+     * emission and ambient from the material: the scene ambient as it is,
+     * not scaled by the emission register again */
+    HT_CHECK(strstr(buf, "oD0 = vec4(c[71].rgb, v3.a);") != NULL);
+    HT_CHECK(strstr(buf, "oB0 = vec4(c[156].rgb, c[156].w);") != NULL);
+    HT_CHECK(strstr(buf, "oD0.rgb += v3.rgb * c[77].rgb * (att * nl);") != NULL);
+    HT_CHECK(strstr(buf, "oB0.rgb += vec3(1.0) * c[162].rgb * (att * bl);") != NULL);
+    HT_CHECK(strstr(buf, "oB1.rgb += v4.rgb * c[163].rgb * (att * bf);") != NULL);
+    HT_CHECK(strstr(buf, "float bl = max(dot(-tN, Ld), 0.0), "
+                         "bh = max(dot(-tN, c[80].xyz), 0.0);") != NULL);
+    HT_CHECK(strstr(buf, "float bl = max(dot(-tN, VP), 0.0), "
+                         "bh = max(dot(-tN, normalize(VP + eyeV)), 0.0);") != NULL);
+    HT_CHECK(strstr(buf, "vec3 bsp = c[183].xyz;") != NULL);           /* the back power */
+    /* no SEPARATE_SPECULAR: the front vertex specular, back arrays or not */
+    HT_CHECK(strstr(buf, "oB0.rgb += oB1.rgb;\n    oB1 = v4;") != NULL);
+    HT_CHECK(strstr(buf, "oB1 = v8") == NULL && strstr(buf, "oB0 = v7") == NULL);
+    /* the other compositions: ambient from the material, emission from a
+     * vertex colour; both from vertex colours */
+    k.bsrc[0] = 2;
+    HT_CHECK(gen(&k, 0x1E1F) > 0);
+    HT_CHECK(strstr(buf, "oB0 = vec4(c[156].rgb + v4.rgb * c[157].rgb, c[156].w);") != NULL);
+    k.bsrc[1] = 1;
+    HT_CHECK(gen(&k, 0x1E1F) > 0);
+    HT_CHECK(strstr(buf, "oB0 = vec4(v4.rgb + v3.rgb * c[157].rgb, c[156].w);") != NULL);
+    /* unlit: black, alpha 1, whatever the back colour registers hold */
+    k.lighting = 0;
+    HT_CHECK(gen(&k, 0x1E1F | 3u << 7) > 0);
+    HT_CHECK(strstr(buf, "oB0 = vec4(0.0, 0.0, 0.0, 1.0);\n"
+                         "    oB1 = vec4(0.0, 0.0, 0.0, 1.0);") != NULL);
+    HT_CHECK(strstr(buf, "oB1 = v4") == NULL);
+    /* off: as before (the pixel stage doesn't read them) */
+    k.two_side = 0;
+    HT_CHECK(gen(&k, 0x1E1F) > 0);
+    HT_CHECK(strstr(buf, "oB0 = v7;\n    oB1 = v8;") != NULL);
+}
+
+static void test_lit_specular_disabled(void)
+{
+    /* ControlFlags_FF on Xbox: highlights remain in diffuse, and a combiner
+     * reading specular alone gets opaque black regardless of LIGHT_CONTROL. */
+    HleFfhwKey k = { .magic = HLE_FFHW_MAGIC, .lighting = 1, .separate_spec = 1,
+                     .alpha_mat_spec = 1, .light = { 1 } };
+    HleVshKey vk = { .in_mask = 0x1F, .spec_off = 1 };
+    uint32_t tok[HLE_FFHW_SLOTS * 4];
+    for (unsigned two_side = 0; two_side < 2; two_side++) {
+        k.two_side = two_side;
+        memcpy(tok, &k, sizeof(k));
+        HT_CHECK(hle_ffhw_glsl(tok, HLE_FFHW_SLOTS, &vk, buf, sizeof(buf)) > 0);
+        HT_CHECK(strstr(buf, "oD0.rgb += oD1.rgb;") != NULL);
+        HT_CHECK((strstr(buf, "oB0.rgb += oB1.rgb;") != NULL) == (two_side != 0));
+        HT_CHECK(strstr(buf, "vSpecular = vec4(0.0, 0.0, 0.0, 1.0);") != NULL);
+        HT_CHECK(strstr(buf, "vBack1 = vec4(0.0, 0.0, 0.0, 1.0);") != NULL);
+        dump(two_side ? "ffhw_specular_disabled_two_side" : "ffhw_specular_disabled");
+    }
 }
 
 static void test_not_a_key(void)
@@ -106,7 +192,10 @@ int main(void)
 {
     HT_RUN(test_unlit);
     HT_RUN(test_lit_skinned);
+    HT_RUN(test_two_side);
+    HT_RUN(test_lit_specular_disabled);
     HT_RUN(test_not_a_key);
     HT_RUN(test_specular_power);
+    HT_RUN(test_texgen_infinite_viewer);
     HT_DONE();
 }
diff --git a/tests/hle/test_fill.c b/tests/hle/test_fill.c
new file mode 100644
index 0000000000000000000000000000000000000000..337659f80dad273a2827ce330ee7d1aa932cb47f
--- /dev/null
+++ b/tests/hle/test_fill.c
@@ -0,0 +1,97 @@
+/* Copyright (C) 2026-present PortareOS */
+/* Xbox fill and smoothing rules, based on nxdk_pgraph_tests captures. */
+#include "hw/xbox/hle/vk/fill.h"
+#include "hle_test.h"
+
+#define PT 0x1B00u
+#define LN 0x1B01u
+#define FL 0x1B02u
+#define MS_ON  0xFFFF0001u              /* D3D's antialiasing control: multisampling on */
+#define MS_OFF 0xFFFF0000u
+
+static void test_modes(void)
+{
+    HT_EQ_INT(hle_fill_mode(PT), HLE_FILL_POINT);
+    HT_EQ_INT(hle_fill_mode(LN), HLE_FILL_LINE);
+    HT_EQ_INT(hle_fill_mode(FL), HLE_FILL_FILL);
+    HT_EQ_INT(hle_fill_mode(0), HLE_FILL_FILL);         /* never written */
+    HT_EQ_INT(hle_fill_mode(0x1B03), HLE_FILL_FILL);
+}
+
+/* Triangle wireframe uses line rasterization and its offset mode. */
+static void test_tris(void)
+{
+    HleFill f = hle_fill(HLE_TOPO_TRIS, LN, LN, HLE_CULL_BACK, HLE_FACES_BOTH, 0, MS_ON, true);
+    HT_EQ_INT(f.mode, HLE_FILL_LINE);
+    HT_CHECK(f.lines && !f.points);
+    HT_EQ_INT(f.offset, 1);
+    f = hle_fill(HLE_TOPO_TRIS, PT, PT, HLE_CULL_NONE, HLE_FACES_BOTH, 0, MS_ON, true);
+    HT_EQ_INT(f.mode, HLE_FILL_POINT);
+    HT_CHECK(f.points && !f.lines);
+    HT_EQ_INT(f.offset, 2);
+    f = hle_fill(HLE_TOPO_TRIS, FL, FL, HLE_CULL_NONE, HLE_FACES_BOTH, 0, MS_ON, true);
+    HT_CHECK(f.mode == HLE_FILL_FILL && !f.lines && !f.points && f.offset == 0);
+    /* Fall back to solid fill when non-solid modes are unavailable. */
+    f = hle_fill(HLE_TOPO_TRIS, LN, LN, HLE_CULL_NONE, HLE_FACES_BOTH, 0, MS_ON, false);
+    HT_CHECK(f.mode == HLE_FILL_FILL && !f.lines && f.offset == 0);
+}
+
+/* Polygon fill mode does not change line and point primitives. */
+static void test_prims(void)
+{
+    HleFill f = hle_fill(HLE_TOPO_LINES, PT, PT, HLE_CULL_NONE, HLE_FACES_BOTH, 0, MS_ON, true);
+    HT_CHECK(f.mode == HLE_FILL_FILL && f.lines && !f.points);
+    f = hle_fill(HLE_TOPO_POINTS, LN, LN, HLE_CULL_NONE, HLE_FACES_BOTH, 0, MS_ON, true);
+    HT_CHECK(f.mode == HLE_FILL_FILL && f.points && !f.lines);
+    HT_CHECK(!hle_fill_split(HLE_TOPO_LINES, FL, LN, HLE_CULL_NONE));
+}
+
+/* Different front/back modes may require separate passes. */
+static void test_faces(void)
+{
+    HT_CHECK(hle_fill_split(HLE_TOPO_TRIS, FL, LN, HLE_CULL_NONE));
+    HT_CHECK(!hle_fill_split(HLE_TOPO_TRIS, FL, LN, HLE_CULL_BACK));
+    HT_CHECK(!hle_fill_split(HLE_TOPO_TRIS, LN, LN, HLE_CULL_NONE));
+    HT_CHECK(!hle_fill_split(HLE_TOPO_TRIS, FL, 0, HLE_CULL_NONE));     /* both filled */
+    HleFill f = hle_fill(HLE_TOPO_TRIS, FL, LN, HLE_CULL_NONE, HLE_FACES_FRONT, 0, MS_ON, true);
+    HT_EQ_INT(f.mode, HLE_FILL_FILL);
+    f = hle_fill(HLE_TOPO_TRIS, FL, LN, HLE_CULL_NONE, HLE_FACES_BACK, 0, MS_ON, true);
+    HT_EQ_INT(f.mode, HLE_FILL_LINE);
+    /* With front faces culled, use the back-face mode. */
+    f = hle_fill(HLE_TOPO_TRIS, FL, PT, HLE_CULL_FRONT, HLE_FACES_BOTH, 0, MS_ON, true);
+    HT_EQ_INT(f.mode, HLE_FILL_POINT);
+    f = hle_fill(HLE_TOPO_TRIS, FL, PT, HLE_CULL_BACK, HLE_FACES_BOTH, 0, MS_ON, true);
+    HT_EQ_INT(f.mode, HLE_FILL_FILL);
+}
+
+/* Smoothing applies only without multisampling: bit 0 for lines,
+ * bit 1 for filled triangles. */
+static void test_smooth(void)
+{
+    HleFill f = hle_fill(HLE_TOPO_LINES, FL, FL, HLE_CULL_NONE, HLE_FACES_BOTH, 3, MS_ON, true);
+    HT_CHECK(!f.lsmooth && !f.psmooth);
+    f = hle_fill(HLE_TOPO_LINES, FL, FL, HLE_CULL_NONE, HLE_FACES_BOTH, 1, MS_OFF, true);
+    HT_CHECK(f.lsmooth && !f.psmooth);
+    f = hle_fill(HLE_TOPO_LINES, FL, FL, HLE_CULL_NONE, HLE_FACES_BOTH, 2, MS_OFF, true);
+    HT_CHECK(!f.lsmooth && !f.psmooth);
+    f = hle_fill(HLE_TOPO_TRIS, FL, FL, HLE_CULL_NONE, HLE_FACES_BOTH, 2, MS_OFF, true);
+    HT_CHECK(!f.lsmooth && f.psmooth);
+    f = hle_fill(HLE_TOPO_TRIS, FL, FL, HLE_CULL_NONE, HLE_FACES_BOTH, 1, MS_OFF, true);
+    HT_CHECK(!f.lsmooth && !f.psmooth);
+    f = hle_fill(HLE_TOPO_TRIS, LN, LN, HLE_CULL_NONE, HLE_FACES_BOTH, 3, MS_OFF, true);
+    HT_CHECK(f.lsmooth && !f.psmooth);
+    f = hle_fill(HLE_TOPO_TRIS, PT, PT, HLE_CULL_NONE, HLE_FACES_BOTH, 3, MS_OFF, true);
+    HT_CHECK(!f.lsmooth && !f.psmooth);
+    f = hle_fill(HLE_TOPO_POINTS, FL, FL, HLE_CULL_NONE, HLE_FACES_BOTH, 3, MS_OFF, true);
+    HT_CHECK(!f.lsmooth && !f.psmooth);
+}
+
+int main(void)
+{
+    HT_RUN(test_modes);
+    HT_RUN(test_tris);
+    HT_RUN(test_prims);
+    HT_RUN(test_faces);
+    HT_RUN(test_smooth);
+    HT_DONE();
+}
diff --git a/tests/hle/test_iorp.c b/tests/hle/test_iorp.c
new file mode 100644
index 0000000000000000000000000000000000000000..4aabc61a3963938d09f2e24093aad2e184074d02
--- /dev/null
+++ b/tests/hle/test_iorp.c
@@ -0,0 +1,306 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Host test of native/kernel/iorp.h, the I/O manager's IRP stack walks, device
+ * queues and StartIo bookkeeping (io.c's IofCallDriver, IofCompleteRequest,
+ * IoStartPacket, IoStartNextPacket), on a buffer standing in for guest memory.
+ */
+#include "hle_test.h"
+
+#include "native/kernel/iorp.h"
+
+#define BASE 0x10000u
+static uint8_t g_mem[0x10000];
+
+static uint8_t m_rd8(void *c, uint32_t va)
+{
+    (void)c;
+    return g_mem[va - BASE];
+}
+
+static void m_wr8(void *c, uint32_t va, uint8_t v)
+{
+    (void)c;
+    g_mem[va - BASE] = v;
+}
+
+static uint32_t m_rd32(void *c, uint32_t va)
+{
+    uint32_t v;
+    (void)c;
+    memcpy(&v, &g_mem[va - BASE], 4);
+    return v;
+}
+
+static void m_wr32(void *c, uint32_t va, uint32_t v)
+{
+    (void)c;
+    memcpy(&g_mem[va - BASE], &v, 4);
+}
+
+static const NcIoMem M = {NULL, m_rd8, m_wr8, m_rd32, m_wr32};
+
+/* the layout: two drivers and their devices, IRPs past them */
+#define DRV_UP   (BASE + 0x100u)
+#define DRV_LOW  (BASE + 0x200u)
+#define DEV_UP   (BASE + 0x300u)
+#define DEV_LOW  (BASE + 0x400u)
+#define IRP_A    (BASE + 0x1000u)
+#define IRP_B    (BASE + 0x2000u)
+#define IRP_C    (BASE + 0x3000u)
+
+static void setup(void)
+{
+    memset(g_mem, 0, sizeof(g_mem));
+    for (unsigned mj = 0; mj < NC_IRP_MJ_COUNT; mj++) {
+        m_wr32(NULL, DRV_UP + NC_DRV_MAJOR + 4 * mj, 0x00100000u + mj);
+        m_wr32(NULL, DRV_LOW + NC_DRV_MAJOR + 4 * mj, 0x00200000u + mj);
+    }
+    m_wr32(NULL, DRV_LOW + NC_DRV_STARTIO, 0x00300000u);
+    m_wr32(NULL, DEV_UP + NC_DEV_DRIVER, DRV_UP);
+    m_wr32(NULL, DEV_LOW + NC_DEV_DRIVER, DRV_LOW);
+    g_mem[DEV_UP + NC_DEV_STACK_SIZE - BASE] = 2;
+    g_mem[DEV_LOW + NC_DEV_STACK_SIZE - BASE] = 1;
+    nc_devq_init(&M, DEV_LOW + NC_DEV_QUEUE);
+}
+
+static uint32_t sl(uint32_t irp, unsigned i)
+{
+    return irp + NC_IRP_BASE + i * NC_SL_SIZE;
+}
+
+static void set_routine(uint32_t sp, uint32_t routine, uint32_t context, uint8_t control)
+{
+    m_wr32(NULL, sp + NC_SL_ROUTINE, routine);
+    m_wr32(NULL, sp + NC_SL_CONTEXT, context);
+    g_mem[sp + NC_SL_CONTROL - BASE] = control;
+}
+
+static void test_init(void)
+{
+    setup();
+    nc_irp_init(&M, IRP_A, NC_IRP_BASE + 2 * NC_SL_SIZE, 2);
+    HT_EQ_U32(m_rd8(NULL, IRP_A + NC_IRP_TYPE), 6);
+    HT_EQ_U32(m_rd8(NULL, IRP_A + NC_IRP_SIZE), NC_IRP_BASE + 2 * NC_SL_SIZE);
+    HT_EQ_U32(m_rd8(NULL, IRP_A + NC_IRP_STACK_COUNT), 2);
+    HT_EQ_U32(m_rd8(NULL, IRP_A + NC_IRP_LOCATION), 3);   /* none in use */
+    HT_EQ_U32(m_rd32(NULL, IRP_A + NC_IRP_STACK), sl(IRP_A, 2));
+    HT_EQ_U32(m_rd32(NULL, IRP_A + NC_IRP_THREAD_LIST), IRP_A + NC_IRP_THREAD_LIST);
+}
+
+/* Two drivers, the upper one's completion routine in the lower's location, the
+ * originator's in the top one: the lower completes, the upper's routine runs
+ * with its own device, then the originator's with none, then the IRP finishes. */
+static void test_stack_walk(void)
+{
+    setup();
+    nc_irp_init(&M, IRP_A, NC_IRP_BASE + 2 * NC_SL_SIZE, 2);
+    uint32_t routine = 0, sp = 0;
+    g_mem[sl(IRP_A, 1) + NC_SL_MAJOR - BASE] = 0x02;      /* IRP_MJ_READ for the upper */
+    set_routine(sl(IRP_A, 1), 0xAAAA0000u, 0x11, NC_SL_ON_SUCCESS | NC_SL_ON_ERROR);
+    HT_CHECK(nc_irp_down(&M, IRP_A, DEV_UP, &routine, &sp));
+    HT_EQ_U32(sp, sl(IRP_A, 1));
+    HT_EQ_U32(routine, 0x00100002u);
+    HT_EQ_U32(m_rd8(NULL, IRP_A + NC_IRP_LOCATION), 2);
+    HT_EQ_U32(m_rd32(NULL, sp + NC_SL_DEVICE), DEV_UP);
+    /* the upper driver passes it down, its routine in the next location */
+    g_mem[sl(IRP_A, 0) + NC_SL_MAJOR - BASE] = 0x02;
+    set_routine(sl(IRP_A, 0), 0xBBBB0000u, 0x22, NC_SL_ON_SUCCESS);
+    HT_CHECK(nc_irp_down(&M, IRP_A, DEV_LOW, &routine, &sp));
+    HT_EQ_U32(sp, sl(IRP_A, 0));
+    HT_EQ_U32(routine, 0x00200002u);
+    HT_EQ_U32(m_rd8(NULL, IRP_A + NC_IRP_LOCATION), 1);
+    /* the lower one completes it */
+    m_wr32(NULL, IRP_A + NC_IRP_STATUS, 0);
+    HT_CHECK(nc_irp_complete_begin(&M, IRP_A));
+    NcIrpCall c;
+    HT_CHECK(nc_irp_walk(&M, IRP_A, &c));
+    HT_EQ_U32(c.routine, 0xBBBB0000u);
+    HT_EQ_U32(c.args[0], DEV_UP);
+    HT_EQ_U32(c.args[1], IRP_A);
+    HT_EQ_U32(c.args[2], 0x22);
+    HT_EQ_U32(m_rd32(NULL, sl(IRP_A, 0) + NC_SL_ROUTINE), 0);  /* cleared as it runs */
+    HT_CHECK(nc_irp_routine_returned(&M, IRP_A, 0));
+    HT_CHECK(nc_irp_walk(&M, IRP_A, &c));
+    HT_EQ_U32(c.routine, 0xAAAA0000u);
+    HT_EQ_U32(c.args[0], 0);                                   /* the top's: no device */
+    HT_EQ_U32(c.args[2], 0x11);
+    HT_CHECK(nc_irp_routine_returned(&M, IRP_A, 0));
+    HT_CHECK(!nc_irp_walk(&M, IRP_A, &c));                     /* done: finish */
+    HT_EQ_U32(m_rd8(NULL, IRP_A + NC_IRP_LOCATION), 4);
+    HT_CHECK(!nc_irp_complete_begin(&M, IRP_A));               /* a second completion: a bug check */
+}
+
+/* STATUS_MORE_PROCESSING_REQUIRED stops the walk where it is: the IRP is the
+ * routine's driver's again, and it completes it once more later. */
+static void test_more_processing(void)
+{
+    setup();
+    nc_irp_init(&M, IRP_B, NC_IRP_BASE + 2 * NC_SL_SIZE, 2);
+    uint32_t routine, sp;
+    set_routine(sl(IRP_B, 1), 0xAAAA0000u, 0, NC_SL_ON_SUCCESS);
+    HT_CHECK(nc_irp_down(&M, IRP_B, DEV_UP, &routine, &sp));
+    set_routine(sl(IRP_B, 0), 0xBBBB0000u, 0, NC_SL_ON_SUCCESS);
+    HT_CHECK(nc_irp_down(&M, IRP_B, DEV_LOW, &routine, &sp));
+    HT_CHECK(nc_irp_complete_begin(&M, IRP_B));
+    NcIrpCall c;
+    HT_CHECK(nc_irp_walk(&M, IRP_B, &c));
+    HT_EQ_U32(c.routine, 0xBBBB0000u);
+    HT_CHECK(!nc_irp_routine_returned(&M, IRP_B, NC_STATUS_MORE_PROCESSING_REQUIRED));
+    HT_EQ_U32(m_rd8(NULL, IRP_B + NC_IRP_LOCATION), 2);        /* the upper's location, current again */
+    /* the upper driver completes it itself later */
+    HT_CHECK(nc_irp_complete_begin(&M, IRP_B));
+    HT_CHECK(nc_irp_walk(&M, IRP_B, &c));
+    HT_EQ_U32(c.routine, 0xAAAA0000u);
+    HT_CHECK(nc_irp_routine_returned(&M, IRP_B, 0));
+    HT_CHECK(!nc_irp_walk(&M, IRP_B, &c));
+}
+
+/* As many IofCallDriver steps as the IRP has locations; one more is
+ * NO_MORE_IRP_STACK_LOCATIONS. */
+static void test_no_location(void)
+{
+    setup();
+    nc_irp_init(&M, IRP_C, NC_IRP_BASE + 3 * NC_SL_SIZE, 3);
+    uint32_t routine, sp;
+    HT_CHECK(nc_irp_down(&M, IRP_C, DEV_UP, &routine, &sp));
+    HT_CHECK(nc_irp_down(&M, IRP_C, DEV_UP, &routine, &sp));
+    HT_CHECK(nc_irp_down(&M, IRP_C, DEV_LOW, &routine, &sp));
+    HT_EQ_U32(sp, sl(IRP_C, 0));
+    HT_CHECK(!nc_irp_down(&M, IRP_C, DEV_LOW, &routine, &sp));
+}
+
+/* Control: a routine runs on success, on error or on cancel as asked; a
+ * location without one passes PendingReturned up. */
+static void test_control_flags(void)
+{
+    setup();
+    nc_irp_init(&M, IRP_C, NC_IRP_BASE + 2 * NC_SL_SIZE, 2);
+    uint32_t routine, sp;
+    set_routine(sl(IRP_C, 1), 0xCCCC0000u, 0, NC_SL_ON_ERROR);  /* the originator's: on error */
+    HT_CHECK(nc_irp_down(&M, IRP_C, DEV_UP, &routine, &sp));
+    set_routine(sl(IRP_C, 0), 0xDDDD0000u, 0, NC_SL_ON_ERROR);
+    HT_CHECK(nc_irp_down(&M, IRP_C, DEV_LOW, &routine, &sp));
+    m_wr32(NULL, IRP_C + NC_IRP_STATUS, 0);                     /* success: neither runs */
+    HT_CHECK(nc_irp_complete_begin(&M, IRP_C));
+    NcIrpCall c;
+    HT_CHECK(!nc_irp_walk(&M, IRP_C, &c));
+    HT_EQ_U32(m_rd8(NULL, IRP_C + NC_IRP_PENDING), 0);          /* nothing returned pending */
+    /* the lower's pending passes up through the upper's location to the IRP */
+    setup();
+    nc_irp_init(&M, IRP_C, NC_IRP_BASE + 2 * NC_SL_SIZE, 2);
+    HT_CHECK(nc_irp_down(&M, IRP_C, DEV_UP, &routine, &sp));
+    g_mem[sl(IRP_C, 0) + NC_SL_CONTROL - BASE] = NC_SL_PENDING;  /* the lower returned pending */
+    HT_CHECK(nc_irp_down(&M, IRP_C, DEV_LOW, &routine, &sp));
+    HT_CHECK(nc_irp_complete_begin(&M, IRP_C));
+    HT_CHECK(!nc_irp_walk(&M, IRP_C, &c));
+    HT_EQ_U32(m_rd8(NULL, IRP_C + NC_IRP_PENDING), 1);
+    /* an error runs the error routine; a cancel runs the cancel one */
+    setup();
+    nc_irp_init(&M, IRP_C, NC_IRP_BASE + 2 * NC_SL_SIZE, 2);
+    HT_CHECK(nc_irp_down(&M, IRP_C, DEV_UP, &routine, &sp));
+    set_routine(sl(IRP_C, 0), 0xDDDD0000u, 0x33, NC_SL_ON_ERROR);
+    HT_CHECK(nc_irp_down(&M, IRP_C, DEV_LOW, &routine, &sp));
+    m_wr32(NULL, IRP_C + NC_IRP_STATUS, 0xC0000001u);
+    HT_CHECK(nc_irp_complete_begin(&M, IRP_C));
+    HT_CHECK(nc_irp_walk(&M, IRP_C, &c));
+    HT_EQ_U32(c.routine, 0xDDDD0000u);
+    HT_EQ_U32(c.args[2], 0x33);
+    setup();
+    nc_irp_init(&M, IRP_C, NC_IRP_BASE + 2 * NC_SL_SIZE, 2);
+    HT_CHECK(nc_irp_down(&M, IRP_C, DEV_UP, &routine, &sp));
+    set_routine(sl(IRP_C, 0), 0xEEEE0000u, 0, NC_SL_ON_CANCEL);
+    HT_CHECK(nc_irp_down(&M, IRP_C, DEV_LOW, &routine, &sp));
+    g_mem[IRP_C + NC_IRP_CANCEL - BASE] = 1;
+    HT_CHECK(nc_irp_complete_begin(&M, IRP_C));
+    HT_CHECK(nc_irp_walk(&M, IRP_C, &c));
+    HT_EQ_U32(c.routine, 0xEEEE0000u);
+}
+
+/* A major function past the table, or a device without a driver: no routine. */
+static void test_dispatch(void)
+{
+    setup();
+    nc_irp_init(&M, IRP_A, NC_IRP_BASE + NC_SL_SIZE, 1);
+    uint32_t routine = 1, sp;
+    g_mem[sl(IRP_A, 0) + NC_SL_MAJOR - BASE] = 0x0F;
+    HT_CHECK(nc_irp_down(&M, IRP_A, DEV_UP, &routine, &sp));
+    HT_EQ_U32(routine, 0);
+    nc_irp_init(&M, IRP_A, NC_IRP_BASE + NC_SL_SIZE, 1);
+    g_mem[sl(IRP_A, 0) + NC_SL_MAJOR - BASE] = 0x0A;
+    HT_CHECK(nc_irp_down(&M, IRP_A, BASE + 0x500u, &routine, &sp)); /* the kernel's own: no driver */
+    HT_EQ_U32(routine, 0);
+}
+
+static void test_device_queue(void)
+{
+    setup();
+    const uint32_t q = DEV_LOW + NC_DEV_QUEUE;
+    const uint32_t e1 = IRP_A + NC_IRP_QUEUE_ENTRY, e2 = IRP_B + NC_IRP_QUEUE_ENTRY, e3 = IRP_C + NC_IRP_QUEUE_ENTRY;
+    HT_CHECK(!nc_devq_insert(&M, q, e1, false, 0));     /* idle: busy now, not queued */
+    HT_EQ_U32(m_rd8(NULL, q + NC_DQ_BUSY), 1);
+    HT_CHECK(nc_devq_insert(&M, q, e2, false, 0));
+    HT_CHECK(nc_devq_insert(&M, q, e3, false, 0));
+    HT_EQ_U32(nc_devq_remove(&M, q, false, 0), e2);     /* in order */
+    HT_CHECK(nc_devq_remove_entry(&M, e3));
+    HT_CHECK(!nc_devq_remove_entry(&M, e3));
+    HT_EQ_U32(nc_devq_remove(&M, q, false, 0), 0);      /* empty: idle */
+    HT_EQ_U32(m_rd8(NULL, q + NC_DQ_BUSY), 0);
+    /* by key: after those of its key or lower; the first of a key or above */
+    HT_CHECK(!nc_devq_insert(&M, q, e1, true, 5));
+    HT_CHECK(nc_devq_insert(&M, q, e2, true, 9));
+    HT_CHECK(nc_devq_insert(&M, q, e3, true, 3));
+    HT_EQ_U32(nc_devq_remove(&M, q, true, 4), e2);
+    HT_EQ_U32(nc_devq_remove(&M, q, true, 10), e3);     /* none at 10 or above: the first */
+    HT_EQ_U32(nc_devq_remove(&M, q, true, 0), 0);
+}
+
+/* IoStartPacket and IoStartNextPacket: StartIo for the first, the rest queued;
+ * a next packet asked for inside StartIo starts after it returns. */
+static void test_start_io(void)
+{
+    setup();
+    const uint32_t q = DEV_LOW + NC_DEV_QUEUE;
+    /* IoStartPacket(A) on an idle device: StartIo at once */
+    HT_CHECK(!nc_devq_insert(&M, q, IRP_A + NC_IRP_QUEUE_ENTRY, false, 0));
+    HT_EQ_U32(nc_startio_begin(&M, DEV_LOW, IRP_A), 0x00300000u);
+    HT_EQ_U32(m_rd32(NULL, DEV_LOW + NC_DEV_CURRENT_IRP), IRP_A);
+    /* inside StartIo: IoStartPacket(B) queues it */
+    HT_CHECK(nc_devq_insert(&M, q, IRP_B + NC_IRP_QUEUE_ENTRY, false, 0));
+    /* inside StartIo: IoStartNextPacket waits for StartIo's return */
+    uint32_t irp = 0;
+    HT_EQ_INT(nc_startio_next(&M, DEV_LOW, false, 0, &irp), NC_STARTIO_LATER);
+    bool by_key;
+    uint32_t key;
+    HT_CHECK(nc_startio_returned(&M, DEV_LOW, &by_key, &key));
+    HT_CHECK(!by_key);
+    HT_EQ_INT(nc_startio_next(&M, DEV_LOW, by_key, key, &irp), NC_STARTIO_START);
+    HT_EQ_U32(irp, IRP_B);
+    HT_EQ_U32(nc_startio_begin(&M, DEV_LOW, IRP_B), 0x00300000u);
+    HT_CHECK(!nc_startio_returned(&M, DEV_LOW, &by_key, &key));    /* nothing asked meanwhile */
+    /* B done (a DPC asks for the next): nothing queued, the device idle */
+    HT_EQ_INT(nc_startio_next(&M, DEV_LOW, false, 0, &irp), NC_STARTIO_IDLE);
+    HT_EQ_U32(m_rd32(NULL, DEV_LOW + NC_DEV_CURRENT_IRP), 0);
+    HT_EQ_U32(m_rd8(NULL, q + NC_DQ_BUSY), 0);
+    /* a driver without StartIo: the IRP current, nothing to run */
+    HT_EQ_U32(nc_startio_begin(&M, DEV_UP, IRP_C), 0);
+    HT_EQ_U32(m_rd32(NULL, DEV_UP + NC_DEV_CURRENT_IRP), IRP_C);
+    HT_EQ_U32(m_rd8(NULL, DEV_UP + NC_DEV_STARTIO) & NC_STARTIO_INSIDE, 0);
+}
+
+int main(void)
+{
+    test_init();
+    test_stack_walk();
+    test_more_processing();
+    test_no_location();
+    test_control_flags();
+    test_dispatch();
+    test_device_queue();
+    test_start_io();
+    if (ht_failures) {
+        fprintf(stderr, "%d failures\n", ht_failures);
+        return 1;
+    }
+    printf("test_iorp: all passed\n");
+    return 0;
+}
diff --git a/tests/hle/test_kdma.c b/tests/hle/test_kdma.c
new file mode 100644
index 0000000000000000000000000000000000000000..032075248efc6f391e75ad2971a4a4f2dfb4c4ae
--- /dev/null
+++ b/tests/hle/test_kdma.c
@@ -0,0 +1,55 @@
+/* Copyright (C) 2026-present PortareOS */
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Kelvin's context DMA objects (hw/xbox/hle/pb/kdma.h): the context each
+ * offset names and the address it makes. */
+#include "hw/xbox/hle/pb/kdma.h"
+#include "hle_test.h"
+
+/* SET_TEXTURE_FORMAT's context field: 1 A, 2 B */
+static void test_texture(void)
+{
+    HT_EQ_U32(hle_kdma_texture(0x00010608 | 1), HLE_KDMA_A);
+    HT_EQ_U32(hle_kdma_texture(0x00010608 | 2), HLE_KDMA_B);
+}
+
+/* the palette's context, start (base added; 0 is a palette too) and
+ * entries (256 >> length) */
+static void test_palette(void)
+{
+    uint32_t pa, n;
+    HT_EQ_U32(hle_kdma_palette(0x00123440 | 1), HLE_KDMA_B);
+    HT_EQ_U32(hle_kdma_palette(0x00123440), HLE_KDMA_A);
+    hle_kdma_palette_ref(0x00123440 | 4 | 1, 0, &pa, &n);
+    HT_EQ_U32(pa, 0x00123440);
+    HT_EQ_U32(n, 128);
+    /* the word 0: 256 entries at the start of context A, wherever it is */
+    hle_kdma_palette_ref(0, 0x03000000, &pa, &n);
+    HT_EQ_U32(pa, 0x03000000);
+    HT_EQ_U32(n, 256);
+    hle_kdma_palette_ref(0, 0, &pa, &n);
+    HT_EQ_U32(pa, 0);
+    HT_EQ_U32(n, 256);
+    hle_kdma_palette_ref(0x40 | 0xC, 0x02000000, &pa, &n);
+    HT_EQ_U32(pa, 0x02000040);
+    HT_EQ_U32(n, 32);
+    /* an adjust below 64 bytes doesn't move it off its alignment */
+    hle_kdma_palette_ref(0x00123440, 0x20, &pa, &n);
+    HT_EQ_U32(pa & 0x3F, 0);
+}
+
+/* bit 31 picks vertex context B; the rest is the offset */
+static void test_array(void)
+{
+    HT_EQ_U32(hle_kdma_array(0x00001000), HLE_KDMA_VERTEX_A);
+    HT_EQ_U32(hle_kdma_array(0x80001000), HLE_KDMA_VERTEX_B);
+    HT_EQ_U32(hle_kdma_array_at(0x80001000, 0), 0x00001000);
+    HT_EQ_U32(hle_kdma_array_at(0x00001000, 0x02000000), 0x02001000);
+}
+
+int main(void)
+{
+    HT_RUN(test_texture);
+    HT_RUN(test_palette);
+    HT_RUN(test_array);
+    HT_DONE();
+}
diff --git a/tests/hle/test_objslot.c b/tests/hle/test_objslot.c
new file mode 100644
index 0000000000000000000000000000000000000000..a7b0c68c20d34c8ce77f73c37828a769fe883f59
--- /dev/null
+++ b/tests/hle/test_objslot.c
@@ -0,0 +1,59 @@
+#include "hw/xbox/hle/pb/objslot.h"
+#include "hle_test.h"
+
+#define N 128
+
+static HlePbSlot slots[N];
+
+static void full_table(void)
+{
+    for (unsigned i = 0; i < N; i++) {
+        slots[i] = (HlePbSlot){ .id = 100 + i, .bound = 1000 + i };
+    }
+}
+
+/* A retired slot (id 0) in a full table, no depth target bound (ds 0): the
+ * free slot is taken, not mistaken for the depth target and skipped. */
+static void test_free_slot_first(void)
+{
+    full_table();
+    slots[57].id = 0;
+    slots[57].bound = 0;
+    const uint32_t refs[] = { 100, 0, 101, 102 };      /* rt, ds (none), shown, made */
+    HT_EQ_INT(hle_pb_evict_choice(slots, N, refs, 4), 57);
+    HT_CHECK(!hle_pb_slot_held(&slots[57], refs, 4));
+    /* before one bound longer ago, or never */
+    slots[3].bound = 0;
+    HT_EQ_INT(hle_pb_evict_choice(slots, N, refs, 4), 57);
+}
+
+/* No free slot: the one bound longest ago, held ones skipped. */
+static void test_least_recently_bound(void)
+{
+    full_table();
+    const uint32_t refs[] = { 100, 0, 101, 102, 103 };  /* rt, ds, shown, made, a z-read's source */
+    HT_EQ_INT(hle_pb_evict_choice(slots, N, refs, 5), 4);
+    slots[4].kept = true;                               /* a cube */
+    HT_EQ_INT(hle_pb_evict_choice(slots, N, refs, 5), 5);
+    HT_CHECK(hle_pb_slot_held(&slots[0], refs, 5));
+    HT_CHECK(hle_pb_slot_held(&slots[4], refs, 5));
+    HT_CHECK(!hle_pb_slot_held(&slots[5], refs, 5));
+}
+
+/* Every slot held: none. */
+static void test_all_held(void)
+{
+    full_table();
+    for (unsigned i = 0; i < N; i++) {
+        slots[i].kept = true;
+    }
+    HT_EQ_INT(hle_pb_evict_choice(slots, N, NULL, 0), -1);
+}
+
+int main(void)
+{
+    HT_RUN(test_free_slot_first);
+    HT_RUN(test_least_recently_bound);
+    HT_RUN(test_all_held);
+    HT_DONE();
+}
