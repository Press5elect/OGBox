+/* Every 5 s from the frame thread (d->lock held), into the session log:
+ * whether the APU runs (GP frames a second: 1500 in real time; the share
+ * of turns with them stopped, and why), its interrupt (raised, the guest's
+ * acknowledges, IEN/ISTS), the voices on its lists and how many play, the
+ * output ring and the device's grains, and DirectSound's mailbox waits. A
+ * game that waits on its sound (a stream's packets, a voice's position or
+ * notification, the GP taking a command) shows here what does not move.
+ * NC_APU_DIAG=0 turns it off. */
+#define DIAG_US 5000000
+static void apu_diag(MCPXAPUState *d)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("NC_APU_DIAG");
+        on = !(e && e[0] == '0');
+    }
+    const int64_t now = apu_host_us();
+    if (!on || now - g_diag.at_us < DIAG_US) {
+        return;
+    }
+    if (!g_diag.at_us) {
+        g_diag.at_us = now;
+        return;
+    }
+    const double s = (double)(now - g_diag.at_us) / 1e6;
+    g_diag.at_us = now;
+    const uint32_t fectl = apu_ld(&d->regs[NV_PAPU_FECTL]), sectl = apu_ld(&d->regs[NV_PAPU_SECTL]);
+    static const uint32_t k_top[3] = {NV_PAPU_TVL2D, NV_PAPU_TVL3D, NV_PAPU_TVLMP};
+    unsigned n[3] = {0}, act[3] = {0};
+    for (unsigned l = 0; l < 3 && apu_ld(&d->regs[NV_PAPU_VPVADDR]); l++) {   /* (no voice array yet: none) */
+        uint32_t h = apu_ld(&d->regs[k_top[l]]) & 0xFFFF;
+        while (h != 0xFFFF && n[l] < MCPX_HW_MAX_VOICES) {
+            const uint8_t *vp = apu_ram_ptr(apu_ld(&d->regs[NV_PAPU_VPVADDR]) + h * NV_PAVS_SIZE, NV_PAVS_SIZE);
+            if (!vp) {
+                break;
+            }
+            n[l]++;
+            act[l] += (apu_rd32(vp + NV_PAVS_VOICE_PAR_STATE) & NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE) != 0;
+            h = apu_rd32(vp + NV_PAVS_VOICE_TAR_PITCH_LINK) & NV_PAVS_VOICE_TAR_PITCH_LINK_NEXT_VOICE_HANDLE;
+        }
+    }
+    uint32_t cb = 0, short_cb = 0;
+    if (!g_apu_stats) {
