+/* A kernel device's IRP, done and its status in the IRP. */
+static uint32_t kernel_device(NcKernel *k, uint32_t dev, uint32_t irp, uint32_t sp)
+{
+    uint32_t info;
+    const uint32_t st = device_irp(k, dev, irp, sp, &info);
+    nc_vm_wr32(k->vm, irp + NC_IRP_STATUS, st);
+    nc_vm_wr32(k->vm, irp + NC_IRP_INFORMATION, info);
+    return st;
+}
