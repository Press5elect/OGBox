+    HT_CHECK(strstr(buf, "vec4 t1 = sampk(1u, nvproj(vTex1).xy, 2u, 1u);") != NULL);
+    /* the taps at level 0 through the level-0 sampler (bits 24-31), at an
+     * explicit LOD; the other side of the branch by gradients taken before
