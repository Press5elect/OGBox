+    if (fd < 0 || dup2(fd, nf->fd) < 0) {
+        nc_log("hakuX-native-io", "regrow %s: reopening it failed: %s", nf->path, strerror(errno));
+        if (fd >= 0) {
+            close(fd);
+        }
+        return false;
+    }
+    close(fd);
+    nf->old_path[0] = '\0';
+    nf->old_size = 0;
+    return true;
