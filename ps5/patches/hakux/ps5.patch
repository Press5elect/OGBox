+
+/* The savestate's form is FEX's (cpu.h NcCpuState). A native state keeps
+ * what FEX's has no place for in what a 32-bit guest leaves unused: the
+ * FXSAVE header (FSW with the stack top, FOP, the pointers) in xmm[8..9],
+ * EFLAGS whole in xmm[10], a marker in xmm[15]. FEX's flags come across
+ * bit by bit (its pf_raw/af_raw approximated); x87 registers and SSE as
+ * they are. */
+#define NATIVE_STATE_MAGIC 0x45564954414E434Eull /* "NCNATIVE" */
+
+void nc_context_export(const NcCpuContext *c, NcCpuState *s)
+{
+    const NcCtx *d = cctx(c);
+    memset(s, 0, sizeof(*s));
+    s->rip = (uint32_t)d->rip;
+    for (int i = 0; i < 8; i++) {
+        s->gregs[i] = (uint32_t)d->regs[i];
+    }
+    const uint32_t fl = (uint32_t)d->eflags;
+    for (unsigned b = 0; b < 32; b++) {
+        s->flags[b] = (fl >> b) & 1;
+    }
+    s->pf_raw = (fl & 0x4u) ? 0 : 1;        /* even parity of the low byte: PF */
+    s->af_raw = (fl & 0x10u) ? 0x10 : 0;
+    for (int i = 0; i < 8; i++) {
+        memcpy(s->xmm[i], d->fx + 160 + 16 * i, 16);
+        memcpy(s->mm[i], d->fx + 32 + 16 * i, 16);
+    }
+    memcpy(s->xmm[8], d->fx, 32);          /* FCW FSW FTW FOP FIP FCS FDP FDS MXCSR MASK */
+    s->xmm[10][0] = d->eflags;
+    s->xmm[15][0] = NATIVE_STATE_MAGIC;
+    memcpy(&s->mxcsr, d->fx + 24, 4);
+    memcpy(&s->fcw, d->fx, 2);
+    s->ftw = d->fx[4];
+    s->cs_idx = ncn_guest_cs;
+    s->fs_idx = 0x28;
+    s->fs_cached = g_cpu ? g_cpu->fs_base : 0;
+}
+
+void nc_context_import(NcCpuContext *c, const NcCpuState *s)
+{
+    memset(c, 0, sizeof(*c));
+    NcCtx *d = ctx(c);
+    d->rip = (uint32_t)s->rip;
+    for (int i = 0; i < 8; i++) {
+        d->regs[i] = (uint32_t)s->gregs[i];
+    }
+    for (int i = 0; i < 8; i++) {
+        memcpy(d->fx + 160 + 16 * i, s->xmm[i], 16);
+        memcpy(d->fx + 32 + 16 * i, s->mm[i], 16);
+    }
+    if (s->xmm[15][0] == NATIVE_STATE_MAGIC) {
+        memcpy(d->fx, s->xmm[8], 32);
+        d->eflags = s->xmm[10][0];
+        return;
+    }
+    /* a FEX state: its flags bit by bit, the x87 control and tags it keeps
+     * (the stack top is lost: FEX keeps it outside these) */
+    uint32_t fl = 0x2;
+    for (unsigned b = 0; b < 32; b++) {
+        if (b != 2 && b != 4 && s->flags[b]) {
+            fl |= 1u << b;
+        }
+    }
+    fl |= __builtin_parity(s->pf_raw & 0xFF) ? 0 : 0x4u;
+    fl |= (s->af_raw & 0x10) ? 0x10u : 0;
+    d->eflags = fl;
+    memcpy(d->fx, &s->fcw, 2);
+    d->fx[4] = s->ftw;
+    memcpy(d->fx + 24, &s->mxcsr, 4);
+    const uint32_t mask = 0xFFFF;
+    memcpy(d->fx + 28, &mask, 4);
+}
+
+/* ---- interrupts and system ops ---- */
+
+static bool no_interrupt_at(const NcCpu *cpu, uint32_t eip)
+{
+    return eip >= cpu->noint_lo && eip < cpu->noint_hi;
+}
+
+static void sysop(NcCpu *cpu, NcFrame *f, enum NcSysOp op, unsigned size)
+{
+    cpu->st.sysops++;
+    cpu->last_eip = (uint32_t)f->rip;
+    if (!cpu->cfg.sysop(cpu->cfg.opaque, f, op, size)) {
+        nc_log("hakuX-native", "cpu: unhandled system op %d at %08x", (int)op, (uint32_t)f->rip);
+        emergency("FATAL: unhandled system op %d at guest eip %08x: abort", (int)op, (uint32_t)f->rip);
+        abort();
+    }
+}
+
+/* At a system op's end: a requested interrupt goes to the kernel before the
+ * guest runs on (FEX: at the next block's start), unless the guest is inside
+ * a no-interrupt range (stepped out of it first). */
+static void after_sysop(NcCpu *cpu, NcFrame *f)
+{
+    for (int n = 0; n < 8 && __atomic_load_n(&cpu->pending, __ATOMIC_ACQUIRE); n++) {
+        if (no_interrupt_at(cpu, (uint32_t)f->rip)) {
+            cpu->stepping = true;
+            return;
+        }
+        sysop(cpu, f, NC_SYSOP_INTERRUPT, 0);
+    }
+}
+
+static void stats_tick(NcCpu *cpu)
+{
+    const uint64_t now = rdtsc();
+    if (!cpu->st_t0) {
+        cpu->st_t0 = now;
+        return;
+    }
+    const uint64_t dt = now - cpu->st_t0;
+    if (dt < 5 * g_tsc_hz) {
+        return;
+    }
+    const double s = (double)dt / (double)g_tsc_hz;
+    /* the signals by what they were (an interrupt's kick is "irq": a signal
+     * by nature; cli/sti, in/out, int3 and the fixups' int 3Fh are #GPs the
+     * gate can't take) */
+    static const char *const k_names[32] = {
+        [NC_SYSOP_NONE] = "irq", [NC_SYSOP_IN] = "in", [NC_SYSOP_OUT] = "out", [NC_SYSOP_INS] = "ins",
+        [NC_SYSOP_OUTS] = "outs", [NC_SYSOP_CLI] = "cli", [NC_SYSOP_STI] = "sti", [NC_SYSOP_HLT] = "hlt",
+        [NC_SYSOP_INT] = "int", [NC_SYSOP_INT3] = "int3", [NC_SYSOP_UD2] = "ud2", [NC_SYSOP_CPUID] = "cpuid",
+        [NC_SYSOP_RDMSR] = "rdmsr", [NC_SYSOP_WRMSR] = "wrmsr", [NC_SYSOP_OTHER] = "other",
+    };
+    char kinds[256];
+    int kn = 0;
+    kinds[0] = 0;
+    for (unsigned k = 0; k < 32 && kn < (int)sizeof(kinds) - 24; k++) {
+        const uint64_t d = cpu->st.by_kind[k] - cpu->st_kind0[k];
+        cpu->st_kind0[k] = cpu->st.by_kind[k];
+        if (d) {
+            kn += snprintf(kinds + kn, sizeof(kinds) - (size_t)kn, " %s %.0f", k_names[k] ? k_names[k] : "op",
+                           (double)d / s);
+        }
+    }
+    nc_log("hakuX-native-cpu", "%.0f system ops/s (%.0f by signal, %.0f by the gate); signals/s by kind:%s; %llu kicks "
+           "(%llu in the gate's way in, taken at its end; %llu stray steps stopped), "
+           "%llu steps, rdtsc %llu, cpuid %llu, pushfd/popfd %llu, fs: rewrites %llu, fs:/gs: page faults %.0f/s",
+           (cpu->st.sysops - cpu->st_sysops0) / s, (cpu->st.signals - cpu->st_sig0) / s,
+           (cpu->st.gate_calls - cpu->st_gate0) / s, kinds, (unsigned long long)cpu->st.kicks,
+           (unsigned long long)cpu->st.gate_entry_kicks, (unsigned long long)cpu->st.gate_steps_stopped,
+           (unsigned long long)cpu->st.steps, (unsigned long long)cpu->st.rdtsc, (unsigned long long)cpu->st.cpuid,
+           (unsigned long long)cpu->st.flags_insns, (unsigned long long)cpu->st.fs_rewrites,
+           (double)(__atomic_load_n(&cpu->st.seg_faults, __ATOMIC_RELAXED) - cpu->st_seg0) / s);
+    /* OGBox 0.0.8: how long the kicks took to reach their handler (an interrupt for the guest's
+     * code waits that long) */
+    if (cpu->kick_n) {
+        nc_log("hakuX-native-cpu", "kicks to their handler: %llu, the longest %.2f ms, %llu over 4 ms",
+               (unsigned long long)cpu->kick_n, (double)cpu->kick_lat_max * 1000.0 / (double)g_tsc_hz,
+               (unsigned long long)cpu->kick_late);
+        cpu->kick_n = cpu->kick_late = cpu->kick_lat_max = 0;
+    }
+    if (cpu->nrsqrt) {
+        unsigned armed = 0;
+        for (unsigned i = 0; i < cpu->nrsqrt; i++) {
+            armed += cpu->rsqrt_sites[i].armed;
+        }
+        nc_log("hakuX-native-cpu", "RSQRT sites: %u of %u trapped, %.0f instructions/s given Intel's estimates (%llu "
+               "in all), %llu run as they are (a source not in RAM)", armed, cpu->nrsqrt,
+               (double)(cpu->st.rsqrt - cpu->st_rsqrt0) / s, (unsigned long long)cpu->st.rsqrt,
+               (unsigned long long)cpu->st.rsqrt_native);
+        cpu->st_rsqrt0 = cpu->st.rsqrt;
+    }
+    cpu->st_seg0 = __atomic_load_n(&cpu->st.seg_faults, __ATOMIC_RELAXED);
+    cpu->st_t0 = now;
+    cpu->st_sysops0 = cpu->st.sysops;
+    cpu->st_sig0 = cpu->st.signals;
+    cpu->st_gate0 = cpu->st.gate_calls;
+}
+
+/* A system op from a signal: the ucontext is the frame. */
+static void uc_sysop(NcCpu *cpu, ucontext_t *u, enum NcSysOp op, unsigned size)
+{
+    NcFrame *f = &cpu->frame;
+    cpu->st.by_kind[(unsigned)op < 32 ? (unsigned)op : 31]++;
+    ncn_frame_from_uc(f, u, true);
+    if (op != NC_SYSOP_NONE) {
+        sysop(cpu, f, op, size);
+    }
+    after_sysop(cpu, f);
+    ncn_frame_to_uc(f, u, true);
+    stats_tick(cpu);
+}
+
+void ncn_gate_dispatch(NcFrame *f)
+{
+    NcCpu *cpu = g_cpu;
+    __atomic_store_n(&cpu->in_host, 1, __ATOMIC_SEQ_CST);
+    f->eflags = (f->pad[0] & EFLAGS_KEEP) | 0x2u | (g_vif ? NC_EFLAGS_IF : 0);
+    cpu->st.gate_calls++;
+    /* EIP is after the far call: the trampoline's int 0x3F form, which the
+     * kernel reads for the ordinal */
+    sysop(cpu, f, NC_SYSOP_INT, 2);
+    after_sysop(cpu, f);
+    g_vif = (f->eflags & NC_EFLAGS_IF) != 0;
+    f->pad[1] = (f->eflags & EFLAGS_KEEP) | 0x202u | (cpu->stepping ? NC_EFLAGS_TF : 0);
+    stats_tick(cpu);
+    /* the last thing here (0.1.43): the gate's tail (cpu_native_asm.S) looks
+     * at the request after this, and a kick from then on steps to the guest */
+    __atomic_store_n(&cpu->in_host, 0, __ATOMIC_SEQ_CST);
+}
+
+/* OGBox 0.1.43: the gate's tail found a request made after the kernel call's
+ * own look (its kick skipped: in_host, or on the way in): taken here; 1 when
+ * the tail should look again, 0 to go on to the guest (stepped out of a
+ * no-interrupt range first, or nothing to do). */
+int ncn_gate_again(NcFrame *f)
+{
+    NcCpu *cpu = g_cpu;
+    if (!__atomic_load_n(&cpu->pending, __ATOMIC_ACQUIRE) || cpu->stepping) {
+        return 0;
+    }
+    __atomic_store_n(&cpu->in_host, 1, __ATOMIC_SEQ_CST);
+    after_sysop(cpu, f);
+    g_vif = (f->eflags & NC_EFLAGS_IF) != 0;
+    f->pad[1] = (f->eflags & EFLAGS_KEEP) | 0x202u | (cpu->stepping ? NC_EFLAGS_TF : 0);
+    __atomic_store_n(&cpu->in_host, 0, __ATOMIC_SEQ_CST);
+    return !cpu->stepping;
+}
+
+/* ---- the fault handler ---- */
+
+static void pass_on(int sig, siginfo_t *info, void *context)
+{
+    for (size_t i = 0; i < NSIGNALS; i++) {
+        if (k_signals[i] != sig) {
+            continue;
+        }
+        struct sigaction *old = &g_prev[i];
+        if (old->sa_flags & SA_SIGINFO) {
+            if (old->sa_sigaction) {
+                old->sa_sigaction(sig, info, context);
+                return;
+            }
+        } else if (old->sa_handler != SIG_DFL && old->sa_handler != SIG_IGN && old->sa_handler) {
+            old->sa_handler(sig);
+            return;
+        }
+    }
+    const ucontext_t *u = context;
+    emergency("FATAL: signal %d (code %d) at %#llx (cs %#x%s), address %p, last guest eip %08x: no handler "
+              "before the native CPU's takes it; the default action ends the process", sig, info ? info->si_code : 0,
+              (unsigned long long)C_RIP(u), C_CS(u), C_CS(u) == ncn_guest_cs ? ", guest code" : "",
+              info ? info->si_addr : NULL, g_cpu ? g_cpu->last_eip : 0);
+    signal(sig, SIG_DFL); /* the instruction runs again and the default action takes the process */
+}
+
+/* Writes a guest code byte through the host's view (the page may be write
+ * protected for tracking). */
+static bool code_write(NcCpu *cpu, uint32_t va, uint8_t b)
+{
+    const uint32_t pa = cpu->vm ? nc_vm_phys(cpu->vm, va) : UINT32_MAX;
+    if (pa == UINT32_MAX || pa >= cpu->vm->ram_size) {
+        return false;
+    }
+    cpu->vm->phys[pa] = b;
+    return true;
+}
+
+static uint64_t guest_tsc(NcCpu *cpu)
+{
+    const uint64_t t = rdtsc() - cpu->cycle_offset;
+    return (uint64_t)(((unsigned __int128)t * cpu->tsc_ratio) >> 32);
+}
+
+static void push32(NcFrame *f, uint32_t v)
+{
+    const uint32_t esp = (uint32_t)f->regs[NC_ESP] - 4;
+    nc_wr32((void *)(uintptr_t)esp, v);
+    f->regs[NC_ESP] = esp;
+}
+
+static uint32_t pop32(NcFrame *f)
+{
+    const uint32_t esp = (uint32_t)f->regs[NC_ESP];
+    const uint32_t v = nc_rd32((const void *)(uintptr_t)esp);
+    f->regs[NC_ESP] = esp + 4;
+    return v;
+}
+
+/* A CLI that trapped: its popfd, when the sweep left it, is found by
+ * following the code (fallthrough, short and near jumps) a little way. */
+static void cli_lookahead(NcCpu *cpu, uint32_t eip)
+{
+    if (!cpu->vm) {
+        return;
+    }
+    uint32_t va = eip;
+    for (int n = 0; n < 64; n++) {
+        if (nc_vm_phys(cpu->vm, va) == UINT32_MAX || nc_vm_phys(cpu->vm, va + 15) == UINT32_MAX) {
+            return;
+        }
+        NcX86Insn in;
+        if (!nc_x86_decode((const uint8_t *)(uintptr_t)va, 15, va, &in)) {
+            return;
+        }
+        if (in.op == 0x9D && in.prefixes == 0) {
+            ncn_patch_add(cpu->vm, va, NC_PATCH_POPFD);
+            return;
+        }
+        if (in.op == 0xFB || in.flow == NC_FLOW_RET || in.flow == NC_FLOW_JMP_IND || in.flow == NC_FLOW_INT ||
+            in.flow == NC_FLOW_STOP || in.flow == NC_FLOW_CALL_IND) {
+            return;                     /* sti, or the path leaves */
+        }
+        va = in.flow == NC_FLOW_JMP ? in.target : va + in.len;
+    }
+}
+
+/* SIDT/SGDT at a patched site (ud2 over 0F 01; the ModRM after): the
+ * kernel's IDT (NcCpuConfig) and a flat GDT. */
+static void table_store(NcCpu *cpu, NcFrame *f, uint32_t eip, bool idt)
+{
+    const uint8_t *m = (const uint8_t *)(uintptr_t)(eip + 2);
+    uint32_t ea;
+    unsigned len;
+    if (!nc_x86_modrm_ea(f, m, &ea, &len)) {
+        return;
+    }
+    const uint16_t limit = idt ? cpu->cfg.idt_limit : 0x3F;
+    const uint32_t base = idt ? cpu->cfg.idt_base : 0;
+    nc_wr16((void *)(uintptr_t)ea, limit);
+    nc_wr32((void *)(uintptr_t)(ea + 2), base);
+    f->rip = eip + 2 + len;
+}
+
+/* Whether the instruction at ip has an fs: prefix; rewrites it to gs:. */
+static bool fs_rewrite(NcCpu *cpu, uint32_t eip)
+{
+    const uint8_t *ip = (const uint8_t *)(uintptr_t)eip;
+    for (unsigned i = 0; i < 14; i++) {
+        const uint8_t b = ip[i];
+        if (b == 0x64) {
+            if (code_write(cpu, eip + i, 0x65)) {
+                cpu->st.fs_rewrites++;
+                return true;
+            }
+            return false;
+        }
+        if (!(b == 0x26 || b == 0x2E || b == 0x36 || b == 0x3E || b == 0x65 || b == 0x66 || b == 0x67 ||
+              b == 0xF0 || b == 0xF2 || b == 0xF3)) {
+            return false;
+        }
+    }
+    return false;
+}
+
+void nc_cpu_native_seg_fault(uint32_t eip, bool fs)
+{
+    NcCpu *cpu = g_cpu;
+    if (!cpu) {
+        return;
+    }
+    __atomic_add_fetch(&cpu->st.seg_faults, 1, __ATOMIC_RELAXED);
+    if (fs) {
+        static unsigned said;
+        const bool ok = fs_rewrite(cpu, eip);
+        if (said < 4) {
+            said++;
+            nc_log("hakuX-native", "cpu: an fs: access at %08x faulted (the host's FS base, not a #GP): %s", eip,
+                   ok ? "made gs: (the KPCR's GS base) from now on" : "left as it is (not in RAM)");
+        }
+    }
+}
+
+/* ---- RSQRT sites: Intel's estimates on an AMD host (NC_RSQRT_SITES) ----
+ *
+ * hakuX-lr's KVM prototype (its #219) on the native CPU. RSQRTSS and RSQRTPS
+ * are table lookups, and their last bits differ between vendors: Xbox titles
+ * were made on the Pentium III's (Intel's), while the PS5's Zen 2, where the
+ * guest's SSE runs as it is, gives AMD's. Code that compares or accumulates
+ * those bits can take another path there.
+ *
+ * NC_RSQRT_SITES: guest instruction addresses in hexadecimal, separated by
+ * commas, up to 64 (0x10000 or above), each the start of an RSQRTSS or
+ * RSQRTPS with its prefixes, for an A/B test of one title's code (never
+ * looked for by a scan: code and data can't be told apart). Unset, the
+ * default, nothing is patched, built or checked. On an AMD host (its own
+ * CPUID, not the Pentium III the kernel answers the guest with) a site's
+ * first byte becomes an int3 while the instruction is there, and its trap
+ * gives the destination Intel's estimates, as the instruction would have
+ * written it: a scalar's upper lanes, MXCSR, EFLAGS and the other registers
+ * the guest's. The estimate is the host's own XORed with what its input's
+ * bucket needs (rsqrt.c: an index made at nc_cpu_create from this host's
+ * estimates against Bochs' tables; refused where one XOR a bucket does not
+ * do it). Any other host runs the instructions as they are: Intel's are the
+ * reference.
+ *
+ * Register and RAM sources, 32- and 16-bit addressing, fs: and gs: (the
+ * KPCR, as the guest's own accesses see them). A source that isn't RAM (not
+ * mapped, a device) or a packed one off 16-byte alignment runs as it is: the
+ * site's byte goes back and the guest's own instruction faults as it would;
+ * the site is patched again at the next refresh. Refreshes: each run's start
+ * and nc_cpu_invalidate (a section loaded or unloaded, code the title or a
+ * mod rewrote, the title's page tables): a site whose bytes are no longer an
+ * RSQRT loses its int3 (on its physical page when its mapping went first),
+ * one that is an RSQRT again gets it. A page the contiguous allocator moves
+ * takes the int3 along and the site follows it. A savestate is written
+ * without the int3s (nc_cpu_native_rsqrt_hold). Code changed without an
+ * invalidation is found at the trap and runs as it is. Every corrected
+ * instruction costs a signal (microseconds): the stats line counts them;
+ * measure frame times before using it beyond a test. */
+static NcRsqrt g_rsqrt;         /* this host's correction index: made once (2 MiB) */
+
+static uint8_t *rsqrt_byte(const NcCpu *cpu, uint32_t va)
+{
+    const uint32_t pa = nc_vm_phys(cpu->vm, va);
+    return pa == UINT32_MAX || pa >= cpu->vm->ram_size ? NULL : cpu->vm->phys + pa;
+}
+
+/* Up to n bytes from va through the host's view (never protected), as far
+ * as they are mapped RAM: how many. */
+static unsigned rsqrt_read(const NcCpu *cpu, uint32_t va, uint8_t *b, unsigned n)
+{
+    unsigned i = 0;
+    for (const uint8_t *p; i < n && (p = rsqrt_byte(cpu, va + i)) != NULL; i++) {
+        b[i] = *p;
+    }
+    return i;
+}
+
+/* The site's int3 off its physical page, whatever maps it now, while that
+ * page still holds the int3 and the rest of the instruction (within the
+ * page). An unmap removes the mapping before the invalidation comes, so the
+ * address no longer leads there; a page reused for anything else is left. */
+static void rsqrt_unpatch_phys(NcCpu *cpu, const RsqrtSite *s)
+{
+    const NcVm *vm = cpu->vm;
+    if (s->pa >= vm->ram_size || !s->len) {
+        return;
+    }
+    uint32_t n = s->len;
+    if (n > NC_PAGE - s->pa % NC_PAGE) {
+        n = NC_PAGE - s->pa % NC_PAGE;      /* the next page isn't this one's neighbour */
+    }
+    if (n > vm->ram_size - s->pa) {
+        n = vm->ram_size - s->pa;
+    }
+    uint8_t *p = vm->phys + s->pa;
+    if (p[0] == 0xCC && !memcmp(p + 1, s->bytes + 1, n - 1u)) {
+        p[0] = s->bytes[0];
+    }
+}
+
+/* A patched site whose page moved (the contiguous allocator copies mapped
+ * pages out of a block's way: vm.c relocate), the int3 with it: the site
+ * follows when the new page holds the int3 and the rest of the instruction,
+ * and the old page loses its int3. Anything else there is a replacement
+ * mapping's, left alone. */
+static void rsqrt_follow(NcCpu *cpu, RsqrtSite *s)
+{
+    const uint32_t pa = nc_vm_phys(cpu->vm, s->eip);
+    if (!s->armed || pa == s->pa || pa == UINT32_MAX || pa >= cpu->vm->ram_size) {
+        return;
+    }
+    uint8_t cur[15];
+    if (rsqrt_read(cpu, s->eip, cur, s->len) == s->len && cur[0] == 0xCC &&
+        !memcmp(cur + 1, s->bytes + 1, s->len - 1u)) {
+        rsqrt_unpatch_phys(cpu, s);
+        s->pa = pa;
+    }
+}
+
+/* The site unpatched: through its mapping while that still leads to the
+ * site's page, else on the page itself (unmapped, or another page there). */
+static void rsqrt_disarm(NcCpu *cpu, RsqrtSite *s)
+{
+    if (s->armed) {
+        if (nc_vm_phys(cpu->vm, s->eip) == s->pa) {
+            uint8_t *p = rsqrt_byte(cpu, s->eip);
+            if (p && *p == 0xCC) {
+                *p = s->bytes[0];
+            }
+        } else {
+            rsqrt_unpatch_phys(cpu, s);
+        }
+    }
+    s->armed = false;
+}
+
+/* The instruction at the site as it would be without our int3. */
+static bool rsqrt_decode_site(NcCpu *cpu, RsqrtSite *s, uint8_t bytes[15], const uint32_t regs[8],
+                              NcRsqrtInsn *in)
+{
+    rsqrt_follow(cpu, s);
+    const unsigned n = rsqrt_read(cpu, s->eip, bytes, 15);
+    if (s->armed && n && bytes[0] == 0xCC && nc_vm_phys(cpu->vm, s->eip) == s->pa) {
+        bytes[0] = s->bytes[0];
+    }
+    return nc_rsqrt_decode(bytes, n, regs, cpu->fs_base, cpu->fs_base, in);
+}
+
+static void rsqrt_restore(NcCpu *cpu)
+{
+    for (unsigned i = 0; i < cpu->nrsqrt; i++) {
+        RsqrtSite *s = &cpu->rsqrt_sites[i];
+        rsqrt_follow(cpu, s);
+        rsqrt_disarm(cpu, s);
+    }
+}
+
+/* The sites in [va, va + len) looked at again (on the guest CPU's thread). */
+static void rsqrt_refresh(NcCpu *cpu, uint32_t va, uint32_t len)
+{
+    static const uint32_t no_regs[8];
+    if (!cpu->vm) {
+        return;
+    }
+    for (unsigned i = 0; i < cpu->nrsqrt; i++) {
+        RsqrtSite *s = &cpu->rsqrt_sites[i];
+        if ((uint64_t)s->eip + 15 <= va || s->eip >= (uint64_t)va + len) {
+            continue;
+        }
+        uint8_t bytes[15] = {0};
+        NcRsqrtInsn in;
+        if (!rsqrt_decode_site(cpu, s, bytes, no_regs, &in)) {
+            /* not loaded yet, unloaded, or not an RSQRT (a replaced
+             * instruction may still hold our byte, an unmapped page does) */
+            rsqrt_disarm(cpu, s);
+            if (rsqrt_byte(cpu, s->eip) && !s->said_off) {
+                s->said_off = true;
+                nc_log("hakuX-native-cpu", "RSQRT site %08x: not an RSQRTSS or RSQRTPS there (%02x %02x %02x %02x): "
+                       "left as it is", s->eip, bytes[0], bytes[1], bytes[2], bytes[3]);
+            }
+            continue;
+        }
+        bool overlap = false;
+        for (unsigned j = 0; j < cpu->nrsqrt; j++) {
+            const RsqrtSite *o = &cpu->rsqrt_sites[j];
+            overlap |= j != i && o->armed && s->eip < o->eip + o->len && o->eip < s->eip + in.len;
+        }
+        if (overlap) {
+            continue;
+        }
+        s->len = (uint8_t)in.len;
+        memcpy(s->bytes, bytes, in.len);
+        s->pa = nc_vm_phys(cpu->vm, s->eip);
+        uint8_t *p = rsqrt_byte(cpu, s->eip);
+        s->armed = p != NULL;
+        if (p) {
+            *p = 0xCC;
+        }
+        if (s->armed && !s->said_on) {
+            s->said_on = true;
+            nc_log("hakuX-native-cpu", "RSQRT site %08x: %s (%u bytes) trapped for Intel's estimates", s->eip,
+                   in.scalar ? "rsqrtss" : "rsqrtps", in.len);
+        }
+    }
+}
+
+/* An int3 at at: a patched site's, its instruction done here (true); false
+ * for anyone else's. */
+static bool rsqrt_trap(NcCpu *cpu, ucontext_t *u, uint32_t at)
+{
+    if (!cpu->vm) {
+        return false;
+    }
+    for (unsigned i = 0; i < cpu->nrsqrt; i++) {
+        RsqrtSite *s = &cpu->rsqrt_sites[i];
+        if (!s->armed || s->eip != at) {
+            continue;
+        }
+        rsqrt_follow(cpu, s);
+        const uint8_t *b0 = rsqrt_byte(cpu, at);
+        if (nc_vm_phys(cpu->vm, at) != s->pa || !b0 || *b0 != 0xCC) {
+            rsqrt_disarm(cpu, s);
+            return false;       /* a replacement mapping's own int3 */
+        }
+        uint32_t regs[8];
+        for (unsigned r = 0; r < 8; r++) {
+            regs[r] = (uint32_t)C_REG(u, r);
+        }
+        uint8_t bytes[15];
+        NcRsqrtInsn in;
+        if (!rsqrt_decode_site(cpu, s, bytes, regs, &in) || in.len != s->len || memcmp(bytes, s->bytes, s->len)) {
+            /* changed code (no invalidation): it runs from its original first byte */
+            rsqrt_disarm(cpu, s);
+            C_RIP(u) = at;
+            return true;
+        }
+        const unsigned count = in.scalar ? 1 : 4;
+        uint8_t input[16];
+        bool ok = C_FX(u) != NULL;      /* the guest's SSE in the signal's frame (always, in guest code) */
+        if (ok && in.mem) {
+            ok = (in.scalar || !(in.address & 15)) && (uint64_t)in.address + count * 4 <= (1ull << 32);
+            if (ok) {
+                nc_vm_will_read(in.address, count * 4);     /* what the HLE owes a page without access */
+                ok = rsqrt_read(cpu, in.address, input, count * 4) == count * 4;
+            }
+        }
+        if (!ok) {
+            /* the guest's own instruction: its fault, as without the site */
+            static unsigned said;
+            if (said < 16) {
+                said++;
+                nc_log("hakuX-native-cpu", "RSQRT site %08x: %s %08x: runs as it is (AMD's estimate), patched "
+                       "again at the next refresh", at, !in.mem ? "no SSE state in the frame, source" :
+                       in.scalar || !(in.address & 15) ? "its source is not RAM" : "its source is not 16-byte aligned",
+                       in.mem ? in.address : in.src);
+            }
+            rsqrt_disarm(cpu, s);
+            cpu->st.rsqrt_native++;
+            C_RIP(u) = at;
+            return true;
+        }
+        NcFrame *f = &cpu->frame;
+        ncn_frame_from_uc(f, u, true);
+        if (!in.mem) {
+            memcpy(input, f->fx + 160 + 16 * in.src, count * 4);
+        }
+        for (unsigned j = 0; j < count; j++) {
+            uint32_t v;
+            memcpy(&v, input + 4 * j, 4);
+            v = nc_rsqrt_correct(&g_rsqrt, v);
+            memcpy(f->fx + 160 + 16 * in.dst + 4 * j, &v, 4);
+        }
+        /* RSQRT raises no numeric exception: a scalar's upper lanes, MXCSR,
+         * x87/MMX, the GPRs and EFLAGS stay the guest's */
+        f->rip = at + in.len;
+        ncn_frame_to_uc(f, u, true);
+        cpu->st.rsqrt++;
+        return true;
+    }
+    return false;
+}
+
+bool ncn_rsqrt_setup(NcCpu *cpu, const char *list, bool amd)
+{
+    if (cpu->vm) {
+        rsqrt_restore(cpu);
+    }
+    cpu->nrsqrt = 0;
+    if (!list || !list[0]) {
+        return true;
+    }
+    if (!amd) {
+        nc_log("hakuX-native-cpu", "NC_RSQRT_SITES: the host's CPU is not AMD's: its own RSQRT estimates run "
+               "(Intel's are the reference), no sites");
+        return true;
+    }
+    uint32_t at[MAX_RSQRT_SITES];
+    unsigned n = 0;
+    bool ok = true;
+    for (const char *p = list; ok;) {
+        while (*p == ' ' || *p == '\t') {
+            p++;
+        }
+        const bool hex = (*p >= '0' && *p <= '9') || (*p >= 'a' && *p <= 'f') || (*p >= 'A' && *p <= 'F');
+        if (!hex || n == MAX_RSQRT_SITES) {
+            ok = false;
+            break;
+        }
+        char *end;
+        errno = 0;
+        const unsigned long v = strtoul(p, &end, 16);
+        if (errno || v < 0x10000u || v > UINT32_MAX - 14u) {
+            ok = false;
+            break;
+        }
+        for (unsigned i = 0; i < n; i++) {
+            ok &= at[i] != (uint32_t)v;
+        }
+        at[n++] = (uint32_t)v;
+        p = end;
+        while (*p == ' ' || *p == '\t') {
+            p++;
+        }
+        if (!*p) {
+            break;
+        }
+        ok &= *p++ == ',';
+    }
+    if (!ok) {
+        nc_log("hakuX-native-cpu", "NC_RSQRT_SITES=\"%.80s\": not up to %u different hexadecimal addresses (0x10000 "
+               "or above) separated by commas: no sites", list, MAX_RSQRT_SITES);
+        return false;
+    }
+    if (!g_rsqrt.index && !nc_rsqrt_init(&g_rsqrt)) {
+        nc_log("hakuX-native-cpu", "NC_RSQRT_SITES: this host's RSQRT estimates differ from Intel's by more than "
+               "one XOR an input bucket (or no memory for the index): no sites");
+        return false;
+    }
+    memset(cpu->rsqrt_sites, 0, sizeof(cpu->rsqrt_sites));
+    for (unsigned i = 0; i < n; i++) {
+        cpu->rsqrt_sites[i].eip = at[i];
+    }
+    cpu->nrsqrt = n;
+    nc_log("hakuX-native-cpu", "RSQRT: %u sites take Intel's estimates (NC_RSQRT_SITES, an AMD host): %u XOR "
+           "corrections from this host's own", n, g_rsqrt.ndelta);
+    return true;
+}
+
+void nc_cpu_native_rsqrt_hold(NcCpu *cpu, bool hold)
+{
+    if (!cpu || !cpu->nrsqrt || !cpu->vm) {
+        return;
+    }
+    if (hold) {
+        rsqrt_restore(cpu);
+    } else {
+        rsqrt_refresh(cpu, 0, UINT32_MAX);
+    }
+}
+
+/* A UMIP-trapped store of a system register (sldt, str, smsw): value to
+ * the r/m operand (memory: 16 bits; a register: zero-extended). */
+static bool store_umip(NcCpu *cpu, ucontext_t *u, const uint8_t *ip, const NcX86Insn *in, unsigned len, uint32_t v,
+                       unsigned bytes)
+{
+    NcFrame *f = &cpu->frame;
+    ncn_frame_from_uc(f, u, false);
+    const uint8_t *m = ip + in->prefixes + 2;
+    uint32_t ea;
+    unsigned ml;
+    if ((m[0] >> 6) == 3) {
+        f->regs[m[0] & 7] = v;
+    } else if (nc_x86_modrm_ea(f, m, &ea, &ml)) {
+        nc_wr16((void *)(uintptr_t)ea, (uint16_t)v);
+    } else {
+        return false;
+    }
+    (void)bytes;
+    f->rip += len;
+    ncn_frame_to_uc(f, u, false);
+    return true;
+}
+
+/* A #GP in guest code: which system op, if it is one. */
+static void on_gp(NcCpu *cpu, ucontext_t *u, int sig, siginfo_t *info)
+{
+    const uint32_t eip = (uint32_t)C_RIP(u);
+    if (fs_rewrite(cpu, eip)) {
+        return;                         /* runs again, through GS (the KPCR) */
+    }
+    const uint8_t *ip = (const uint8_t *)(uintptr_t)eip;
+    NcX86Insn in;
+    const unsigned len = nc_x86_decode(ip, 15, eip, &in);
+    const unsigned op = in.op, reg = (in.modrm >> 3) & 7;
+    enum NcSysOp sop = NC_SYSOP_OTHER;
+    if (!len) {
+        uc_sysop(cpu, u, NC_SYSOP_OTHER, 1);
+        return;
+    }
+    switch (op) {
+    case 0xCD: sop = NC_SYSOP_INT; break;
+    case 0xCE: sop = NC_SYSOP_INTO; break;
+    case 0xF1: sop = NC_SYSOP_INT1; break;
+    case 0xFA: sop = NC_SYSOP_CLI; break;
+    case 0xFB: sop = NC_SYSOP_STI; break;
+    case 0xE4: case 0xE5: case 0xEC: case 0xED: sop = NC_SYSOP_IN; break;
+    case 0xE6: case 0xE7: case 0xEE: case 0xEF: sop = NC_SYSOP_OUT; break;
+    case 0x6C: case 0x6D: sop = NC_SYSOP_INS; break;
+    case 0x6E: case 0x6F: sop = NC_SYSOP_OUTS; break;
+    case 0x0F06: sop = NC_SYSOP_CLTS; break;
+    case 0x0F08: sop = NC_SYSOP_INVD; break;
+    case 0x0F09: sop = NC_SYSOP_WBINVD; break;
+    case 0x0F20: case 0x0F22: sop = NC_SYSOP_MOVCR; break;
+    case 0x0F21: case 0x0F23: sop = NC_SYSOP_MOVDR; break;
+    case 0x0F30: sop = NC_SYSOP_WRMSR; break;
+    case 0x0F32: sop = NC_SYSOP_RDMSR; break;
+    case 0x0F33: sop = NC_SYSOP_RDPMC; break;
+    case 0x0FA2: sop = NC_SYSOP_CPUID; cpu->st.cpuid++; break;   /* CPUID faulting */
+    case 0x0F00:
+        if (reg <= 1) {
+            /* sldt / str (UMIP): 0, no LDT or task register the guest sees */
+            if (store_umip(cpu, u, ip, &in, len, 0, 2)) {
+                return;
+            }
+        }
+        sop = reg == 2 ? NC_SYSOP_LLDT : reg == 3 ? NC_SYSOP_LTR : NC_SYSOP_OTHER;
+        break;
+    case 0x0F01:
+        if (reg == 7) {
+            sop = NC_SYSOP_INVLPG;
+        } else if (reg == 2) {
+            sop = NC_SYSOP_LGDT;
+        } else if (reg == 3) {
+            sop = NC_SYSOP_LIDT;
+        } else if (reg == 6) {
+            sop = NC_SYSOP_LMSW;
+        } else if (reg == 4) {
+            /* smsw (UMIP): CR0's low word as the Xbox kernel leaves it */
+            if (store_umip(cpu, u, ip, &in, len, 0x003B, 2)) {
+                return;
+            }
+        } else if (reg <= 1 && (in.modrm >> 6) != 3) {
+            /* sidt / sgdt faulting (UMIP without the host's emulation) */
+            NcFrame *f = &cpu->frame;
+            ncn_frame_from_uc(f, u, false);
+            const uint8_t *m = ip + in.prefixes + 2;
+            uint32_t ea;
+            unsigned ml;
+            if (nc_x86_modrm_ea(f, m, &ea, &ml)) {
+                nc_wr16((void *)(uintptr_t)ea, reg ? cpu->cfg.idt_limit : 0x3F);
+                nc_wr32((void *)(uintptr_t)(ea + 2), reg ? cpu->cfg.idt_base : 0);
+                f->rip = eip + len;
+                ncn_frame_to_uc(f, u, false);
+                return;
+            }
+        }
+        break;
+    case 0xF4: {
+        /* HLT: the guest stops (the kernel's stop stub) */
+        cpu->running = 0;
+        ncn_frame_from_uc(&cpu->frame, u, true);
+        nc_longjmp(cpu->exit_env, 1);   /* the signal mask: nc_cpu_run unmasks */
+    }
+    case 0xCF: {
+        /* iretd from the title's #PF handler (CS 0 in its frame, kernel.c):
+         * completed here with the IF it pops (ring 3 can't) */
+        if (in.opsize16) {
+            break;
+        }
+        NcFrame *f = &cpu->frame;
+        ncn_frame_from_uc(f, u, true);
+        const uint32_t esp = (uint32_t)f->regs[NC_ESP];
+        const uint16_t cs = (uint16_t)nc_rd32((const void *)(uintptr_t)(esp + 4));
+        if (cs != 0 && cs != 0x08) {
+            break;
+        }
+        const uint32_t to = pop32(f);
+        pop32(f);
+        const uint32_t fl = pop32(f);
+        f->rip = to;
+        f->eflags = (f->eflags & ~(uint64_t)(POPF_MASK | NC_EFLAGS_IF)) | (fl & (POPF_MASK | NC_EFLAGS_IF)) | 0x2u;
+        cpu->st.signals++;
+        if (fl & NC_EFLAGS_IF) {
+            /* interrupts held meanwhile, now; EIP is already `to` (0.1.9: not
+             * set again after it: the STI may have switched threads) */
+            sysop(cpu, f, NC_SYSOP_STI, 0);
+        }
+        after_sysop(cpu, f);
+        ncn_frame_to_uc(f, u, true);
+        return;
+    }
+    default:
+        break;
+    }
+    if (sop == NC_SYSOP_OTHER && op != 0x0F01 && op != 0x0F00 && op != 0xCF) {
+        /* not a system instruction: a genuine fault, the core's to report */
+        pass_on(sig, info, u);
+        return;
+    }
+    cpu->st.signals++;
+    uc_sysop(cpu, u, sop, len);
+    if (sop == NC_SYSOP_CLI) {
+        cli_lookahead(cpu, eip + len);
+    }
+}
+
+static void on_fault_body(int sig, siginfo_t *info, void *context);
+
+/* The signal stack's room left, on the vCPU thread's own (else SIZE_MAX). */
+static size_t altstack_left(const NcCpu *cpu)
+{
+    const uintptr_t sp = (uintptr_t)__builtin_frame_address(0), lo = (uintptr_t)cpu->altstack;
+    return cpu->altstack && sp >= lo && sp < lo + ALTSTACK_SIZE ? sp - lo : SIZE_MAX;
+}
+
+static void check_depth(NcCpu *cpu, int sig, const ucontext_t *u)
+{
+    static int warned_room, warned_depth;
+    if (t_depth > 4 && !warned_depth) {
+        warned_depth = 1;
+        emergency("the native CPU's handlers nested %d deep (signal %d at %#llx, cs %#x, last guest eip %08x)",
+                  t_depth, sig, (unsigned long long)C_RIP(u), C_CS(u), cpu ? cpu->last_eip : 0);
+    }
+    if (cpu && !warned_room && altstack_left(cpu) < (512u << 10)) {
+        warned_room = 1;
+        emergency("the signal stack has %zu KiB of %u left (signal %d at %#llx, last guest eip %08x, depth %d)",
+                  altstack_left(cpu) >> 10, ALTSTACK_SIZE >> 10, sig, (unsigned long long)C_RIP(u),
+                  cpu->last_eip, t_depth);
+    }
+}
+
+static bool in_gate_exit(uintptr_t pc);
+
+static void on_fault(int sig, siginfo_t *info, void *context)
+{
+    NcCpu *cpu = g_cpu;
+    if (++t_depth > 16) {
+        /* a handler that faults again and again: the crash report, now,
+         * before the signal stack runs out and nothing can be said */
+        const ucontext_t *u = context;
+        emergency("FATAL: the native CPU's fault handler re-entered %d times: signal %d (code %d) at %#llx (cs %#x), "
+                  "address %p, last guest eip %08x", t_depth, sig, info ? info->si_code : 0,
+                  (unsigned long long)C_RIP(u), C_CS(u), info ? info->si_addr : NULL, cpu ? cpu->last_eip : 0);
+        t_depth = 0;
+        pass_on(sig, info, context);
+        return;
+    }
+    check_depth(cpu, sig, context);
+    on_fault_body(sig, info, context);
+    t_depth--;
+}
+
+static void on_fault_body(int sig, siginfo_t *info, void *context)
+{
+    ucontext_t *u = context;
+    NcCpu *cpu = g_cpu;
+    if (!cpu || !in_guest(u) || !cpu->running || !pthread_equal(cpu->thread, pthread_self())) {
+        if (cpu && sig == SIGTRAP && info->si_code == TRAP_TRACE && cpu->gate_step && C_CS(u) == cpu->host_cs &&
+            pthread_equal(cpu->thread, pthread_self())) {
+            if (in_gate_exit((uintptr_t)C_RIP(u))) {
+                C_EFL(u) |= NC_EFLAGS_TF;   /* on to the guest (FreeBSD clears it at each step) */
+            } else {
+                /* never through host code (0.1.43): the request waits for
+                 * the next kernel entry */
+                cpu->gate_step = false;
+                C_EFL(u) &= ~(uint64_t)NC_EFLAGS_TF;
+                cpu->st.gate_steps_stopped++;
+            }
+            return;
+        }
+        if (cpu && sig == SIGTRAP && info->si_code == TRAP_TRACE && cpu->stepping && C_CS(u) == cpu->host_cs &&
+            pthread_equal(cpu->thread, pthread_self())) {
+            /* stepped into the gate (a kernel call's far call): it takes
+             * the interrupt at its end */
+            C_EFL(u) &= ~(uint64_t)NC_EFLAGS_TF;
+            cpu->stepping = false;
+            return;
+        }
+#if defined(__linux__)
+        if (cpu && cpu->cpuid_faults && sig == SIGSEGV && C_TRAPNO(u) == 13 &&
+            pthread_equal(cpu->thread, pthread_self())) {
+            /* host code's cpuid on the vCPU thread (a library's feature
+             * check) while guest cpuid faults: run it with faulting off */
+            const uint8_t *ip = (const uint8_t *)(uintptr_t)C_RIP(u);
+            if (ip[0] == 0x0F && ip[1] == 0xA2) {
+                uint32_t a = (uint32_t)C_GREG(u, REG_RAX), b, c = (uint32_t)C_GREG(u, REG_RCX), d;
+                syscall(SYS_arch_prctl, ARCH_SET_CPUID, 1);
+                __asm__ volatile("cpuid" : "+a"(a), "=b"(b), "+c"(c), "=d"(d));
+                syscall(SYS_arch_prctl, ARCH_SET_CPUID, 0);
+                C_GREG(u, REG_RAX) = a, C_GREG(u, REG_RBX) = b, C_GREG(u, REG_RCX) = c, C_GREG(u, REG_RDX) = d;
+                C_RIP(u) += 2;
+                return;
+            }
+        }
+#endif
+        pass_on(sig, info, context);
+        return;
+    }
+    const unsigned trap = C_TRAPNO(u);
+    const uint32_t eip = (uint32_t)C_RIP(u);
+    if (trap == TRAP_GP && (sig == SIGSEGV || sig == SIGBUS)) {
+        /* #GP: Linux's SIGSEGV (trap 13); FreeBSD's SIGBUS (T_PROTFLT 9) */
+        on_gp(cpu, u, sig, info);
+        return;
+    }
+    if (sig == SIGILL) {
+        uint8_t orig[2];
+        const int kind = ncn_patch_kind(eip, orig);
+        if (kind == NC_PATCH_RDTSC) {
+            const uint64_t t = guest_tsc(cpu);
+            C_REG(u, RAX) = (uint32_t)t;
+            C_REG(u, RDX) = (uint32_t)(t >> 32);
+            C_RIP(u) += 2;
+            cpu->st.rdtsc++;
+            nc_mmio_site_rdtsc(eip, u);     /* 0.1.38: a hot one runs natively in a stub */
+            return;
+        }
+        cpu->st.signals++;
+        if (kind == NC_PATCH_CPUID) {
+            cpu->st.cpuid++;
+            uc_sysop(cpu, u, NC_SYSOP_CPUID, 2);
+            return;
+        }
+        if (kind == NC_PATCH_SIDT || kind == NC_PATCH_SGDT) {
+            NcFrame *f = &cpu->frame;
+            ncn_frame_from_uc(f, u, false);
+            table_store(cpu, f, eip, kind == NC_PATCH_SIDT);
+            ncn_frame_to_uc(f, u, false);
+            return;
+        }
+        const uint8_t *ip = (const uint8_t *)(uintptr_t)eip;
+        if (ip[0] == 0x0F && ip[1] == 0x0B) {
+            uc_sysop(cpu, u, NC_SYSOP_UD2, 2);
+            return;
+        }
+        pass_on(sig, info, context);
+        return;
+    }
+    if (sig == SIGTRAP) {
+        if (info->si_code == TRAP_TRACE && cpu->gate_step) {
+            /* back in the guest from the gate with a request it missed */
+            cpu->gate_step = false;
+            C_EFL(u) &= ~(uint64_t)NC_EFLAGS_TF;
+            if (__atomic_load_n(&cpu->pending, __ATOMIC_ACQUIRE) && !no_interrupt_at(cpu, eip)) {
+                cpu->st.signals++;
+                uc_sysop(cpu, u, NC_SYSOP_NONE, 0);
+            }
+            return;
+        }
+        if (info->si_code == TRAP_TRACE) {
+            /* a single step: out of the no-interrupt range yet? */
+            cpu->st.steps++;
+            if (cpu->stepping && no_interrupt_at(cpu, eip)) {
+                C_EFL(u) |= NC_EFLAGS_TF;   /* again (FreeBSD clears it in the saved context) */
+                return;
+            }
+            cpu->stepping = false;
+            C_EFL(u) &= ~(uint64_t)NC_EFLAGS_TF;
+            if (info->si_code == TRAP_TRACE) {
+                if (__atomic_load_n(&cpu->pending, __ATOMIC_ACQUIRE)) {
+                    cpu->st.signals++;
+                    uc_sysop(cpu, u, NC_SYSOP_NONE, 0);
+                }
+                return;
+            }
+        }
+        /* int3: EIP is after it */
+        const uint32_t at = eip - 1;
+        const int kind = ncn_patch_kind(at, NULL);
+        NcFrame *f = &cpu->frame;
+        if (kind == NC_PATCH_PUSHFD) {
+            ncn_frame_from_uc(f, u, false);
+            push32(f, ((uint32_t)f->eflags & ~0x30100u) | 0x2u);
+            f->rip = at + 1;
+            ncn_frame_to_uc(f, u, false);
+            cpu->st.flags_insns++;
+            return;
+        }
+        if (kind == NC_PATCH_POPFD) {
+            ncn_frame_from_uc(f, u, true);
+            const bool was = (f->eflags & NC_EFLAGS_IF) != 0;
+            const uint32_t v = pop32(f);
+            f->eflags = (f->eflags & ~(uint64_t)(POPF_MASK | NC_EFLAGS_IF)) | (v & (POPF_MASK | NC_EFLAGS_IF)) | 0x2u;
+            f->rip = at + 1;
+            cpu->st.flags_insns++;
+            if (!was && (v & NC_EFLAGS_IF)) {
+                /* interrupts the kernel held while IF was clear: now */
+                cpu->st.signals++;
+                /* 0.1.9: no `f->rip = at + 1` after it. The STI may switch
+                 * threads (the kernel delivers the interrupt that was held:
+                 * an ISR or DPC thread runs next), and the frame is then the
+                 * other thread's: setting its EIP to this popfd sent it into
+                 * the wrong code (DirectSound's critical sections:
+                 * Burnout 3's music stream never resumed). EIP was set
+                 * above, before the sysop saved this thread. */
+                sysop(cpu, f, NC_SYSOP_STI, 0);
+            }
+            after_sysop(cpu, f);
+            ncn_frame_to_uc(f, u, true);
+            return;
+        }
+        if (cpu->nrsqrt && rsqrt_trap(cpu, u, at)) {
+            cpu->st.signals++;          /* an RSQRT site's (NC_RSQRT_SITES) */
+            return;
+        }
+        C_RIP(u) = at;
+        cpu->st.signals++;
+        uc_sysop(cpu, u, NC_SYSOP_INT3, 1);
+        return;
+    }
+    /* #PF and the rest: the core's (device registers, write tracking,
+     * paging, the title's handler), through the handler before ours */
+    pass_on(sig, info, context);
+}
+
+extern const uint8_t ncn_gate_code_begin[], ncn_gate_code_end[], ncn_enter_end[], ncn_gate_after_call[],
+    ncn_gate_looked[];
+
+/* OGBox 0.1.43: the gate's way back to the guest only: ncn_enter and the
+ * gate's tail after ncn_gate_dispatch, straight-line code to the iretq. Up to
+ * 0.1.42 the whole gate counted, its way in too (the far call's landing up to
+ * the call of ncn_gate_dispatch, before in_host is set): a kick landing there
+ * set TF, and the trap handler kept it set "on to the guest" through the whole
+ * kernel call, one signal per host instruction. A device access through the
+ * gate (0.1.38's sites) or a polled kernel call ran a thousand times slower:
+ * the hitches of 0.1 to 12 s, the guest's CPU seemingly "halted" (the
+ * sampler's gate samples read as idle, see glue.c), the stall probe always in
+ * the system's signal wrapper. On the way in nothing is needed: the request
+ * stays pending and ncn_gate_dispatch takes it at the kernel call's end. */
+static bool in_gate_exit(uintptr_t pc)
+{
+    return (pc >= (uintptr_t)ncn_gate_code_begin && pc < (uintptr_t)ncn_enter_end) ||
+           (pc >= (uintptr_t)ncn_gate_looked && pc < (uintptr_t)ncn_gate_code_end);
+}
+
+/* the way in, and the tail up to its look at the request (which sees it) */
+static bool in_gate_entry(uintptr_t pc)
+{
+    return pc >= (uintptr_t)ncn_enter_end && pc < (uintptr_t)ncn_gate_looked;
+}
+
+static void on_kick(int sig, siginfo_t *info, void *context)
+{
+    (void)sig;
+    (void)info;
+    ucontext_t *u = context;
+    NcCpu *cpu = g_cpu;
+    if (!cpu) {
+        return;
+    }
+    const int saved = errno;
+    __atomic_store_n(&cpu->kicked, 0, __ATOMIC_RELEASE);
+    if (pthread_equal(cpu->thread, pthread_self())) {
+        const uint64_t sent = __atomic_exchange_n(&cpu->kick_sent, 0, __ATOMIC_ACQ_REL);
+        if (sent) {
+            const uint64_t lat = rdtsc() - sent;
+            cpu->kick_n++;
+            cpu->kick_late += lat > g_tsc_hz / 250;
+            cpu->kick_lat_max = lat > cpu->kick_lat_max ? lat : cpu->kick_lat_max;
+        }
+        if (in_guest(u)) {
+            cpu->last_eip = (uint32_t)C_RIP(u);
+        }
+        if (__atomic_load_n(&cpu->smp_req, __ATOMIC_ACQUIRE)) {
+            /* a sampler's question: where the vCPU is right now */
+            cpu->smp_where = in_guest(u) ? NC_SAMPLE_GUEST
+                             : __atomic_load_n(&cpu->in_host, __ATOMIC_RELAXED) ? NC_SAMPLE_GATE : NC_SAMPLE_HOST;
+            cpu->smp_eip = in_guest(u) ? (uint32_t)C_RIP(u) : cpu->last_eip;
+            if (in_guest(u)) {
+                for (unsigned r = 0; r < 8; r++) {
+                    cpu->smp_regs[r] = (uint32_t)C_REG(u, r);
+                }
+                cpu->smp_regs[8] = (uint32_t)C_EFL(u);
+            }
+            cpu->smp_regs_ok = in_guest(u);
+            __atomic_store_n(&cpu->smp_req, 0, __ATOMIC_RELAXED);
+            __atomic_add_fetch(&cpu->smp_seq, 1, __ATOMIC_RELEASE);
+        }
+    }
+    if (cpu->running && in_guest(u) && pthread_equal(cpu->thread, pthread_self()) &&
+        __atomic_load_n(&cpu->pending, __ATOMIC_ACQUIRE)) {
+        cpu->st.kicks++;
+        if (no_interrupt_at(cpu, (uint32_t)C_RIP(u))) {
+            cpu->stepping = true;
+            C_EFL(u) |= NC_EFLAGS_TF;
+        } else {
+            cpu->st.signals++;
+            uc_sysop(cpu, u, NC_SYSOP_NONE, 0);
+        }
+    } else if (cpu->running && pthread_equal(cpu->thread, pthread_self()) && C_CS(u) == cpu->host_cs &&
+               !__atomic_load_n(&cpu->in_host, __ATOMIC_SEQ_CST) && __atomic_load_n(&cpu->pending, __ATOMIC_ACQUIRE)) {
+        if (in_gate_exit((uintptr_t)C_RIP(u))) {
+            /* the gate's way back to the guest, past its last look at the
+             * request: stepped into the guest, which takes it there */
+            cpu->gate_step = true;
+            C_EFL(u) |= NC_EFLAGS_TF;
+        } else if (in_gate_entry((uintptr_t)C_RIP(u))) {
+            cpu->st.gate_entry_kicks++;     /* taken at the kernel call's end */
+        }
+    }
+    errno = saved;
+}
+
+/* ---- the interface ---- */
+
+void nc_cpu_request_interrupt(NcCpu *cpu)
+{
+    if (!cpu) {
+        return;
+    }
+    __atomic_store_n(&cpu->pending, 1, __ATOMIC_SEQ_CST);
+    if (!cpu->running || __atomic_load_n(&cpu->in_host, __ATOMIC_SEQ_CST) ||
+        pthread_equal(cpu->thread, pthread_self())) {
+        return;                         /* the system op's end takes it */
+    }
+    if (!__atomic_exchange_n(&cpu->kicked, 1, __ATOMIC_ACQ_REL)) {
+        __atomic_store_n(&cpu->kick_sent, rdtsc(), __ATOMIC_RELEASE);
+        pthread_kill(cpu->thread, NC_KICK_SIGNAL);
+    }
+}
+
+/* FreeBSD: the handlers' entry wrappers (cpu_native_asm.S) fxsave the live
+ * x87/SSE (the guest's) into fx, set the host's MXCSR and x87 defaults, run
+ * these, and fxrstor fx on the way out. */
+void ncn_fault_entry(int sig, siginfo_t *info, void *context);
+void ncn_kick_entry(int sig, siginfo_t *info, void *context);
+void ncn_on_fault_fx(int sig, siginfo_t *info, void *context, uint8_t *fx);
+void ncn_on_kick_fx(int sig, siginfo_t *info, void *context, uint8_t *fx);
+
+#if FX_LIVE
+/* OGBox 0.1.24: where the guest's x87/SSE is in a signal on the console.
+ *
+ * The comment above (and this file until OGBox 0.1.22) took the guest's x87
+ * and SSE to be live in the registers when a handler runs. On the console the
+ * handler starts with a fresh FPU (0.1.22 searched the frame for the
+ * registers' image at every entry: they were blank), and sigreturn loads the
+ * thread's FPU back from the copy the kernel saved in the frame: OGBox's test
+ * disc (tests/xbox/ogbox-tests, t_cpu.c) had three threads come back from
+ * switches with the interrupted thread's control word, MXCSR and x87 values,
+ * and a write near the SDK header's mc_fpstate (0.1.21, 0.1.23) changed what
+ * was loaded (an unmasked exception on the next x87 instruction). That place
+ * itself holds no FXSAVE image (0.1.23's line: a "control word" of 9787, 7 of
+ * 256 bytes nonzero), so the console's frame is laid out otherwise.
+ *
+ * So the copy is found by what every FXSAVE image has: at +28 MXCSR_MASK
+ * (0000ffff, or 0002ffff with DAZ), at +24 an MXCSR within it, at +0 a control
+ * word with bit 6 set and bits 7, 13-15 clear, and at +4 a tag byte. The frame
+ * from the ucontext to the siginfo after it is searched on the first signal, in
+ * 16-byte steps; the place is said in the log with the frame's bytes (once, for
+ * checking), and from then on the guest's x87/SSE is the image there: the
+ * handler reads it and a thread switch writes the next thread's into it. When
+ * none is found, the wrapper's buffer stays the guest's state (0.1.20's
+ * behaviour: no switch keeps a thread's own floating point, but nothing is
+ * written into the frame). */
+static long g_fx_off = -2;     /* -2: not looked yet; -1: none; else from the ucontext */
+
+static size_t frame_span(const void *context, const siginfo_t *info)
+{
+    const uint8_t *u = (const uint8_t *)context;
+    size_t span = sizeof(ucontext_t);
+    if ((const uint8_t *)info > u && (size_t)((const uint8_t *)info - u) < 8192 &&
+        (size_t)((const uint8_t *)info - u) > span) {
+        span = (size_t)((const uint8_t *)info - u);
+    }
+    return span;
+}
+
+static void frame_dump(const void *context, size_t span)
+{
+    const uint8_t *u = (const uint8_t *)context;
+    for (size_t off = 0; off < span && off < 2048; off += 32) {
+        char line[160];
+        int n = snprintf(line, sizeof(line), "+%04zx:", off);
+        for (size_t k = off; k < off + 32 && k < span && n < (int)sizeof(line) - 4; k++) {
+            n += snprintf(line + n, sizeof(line) - (size_t)n, " %02x", u[k]);
+        }
+        nc_log("hakuX-native-cpu", "signal frame %s", line);
+    }
+}
+
+static void frame_find(const void *context, const siginfo_t *info)
+{
+    const uint8_t *u = (const uint8_t *)context;
+    const size_t span = frame_span(context, info);
+    long found = -1;
+    unsigned matches = 0;
+    for (size_t off = 0; off + 512 <= span; off += 16) {
+        const uint8_t *p = u + off;
+        uint32_t mask, mx;
+        uint16_t cw;
+        memcpy(&mask, p + 28, 4);
+        memcpy(&mx, p + 24, 4);
+        memcpy(&cw, p, 2);
+        if ((mask != 0x0000FFFFu && mask != 0x0002FFFFu) || (mx & ~mask) != 0) {
+            continue;
+        }
+        if ((cw & 0x0040) == 0 || (cw & 0xE080) != 0) {
+            continue;
+        }
+        matches++;
+        if (found < 0) {
+            found = (long)off;
+        }
+    }
+    g_fx_off = found;
+    const ucontext_t *uc = (const ucontext_t *)context;
+    if (found >= 0) {
+        uint16_t cw;
+        uint32_t mx;
+        memcpy(&cw, u + found, 2);
+        memcpy(&mx, u + found + 24, 4);
+        nc_log("hakuX-native-cpu", "signal frame FPU: an FXSAVE image at +%ld in the ucontext (the SDK's mc_fpstate: "
+               "+%ld; %u places look like one in %zu bytes): control word %04x, MXCSR %08x. The guest's x87/SSE is "
+               "that image from here on",
+               found, (long)offsetof(ucontext_t, uc_mcontext.mc_fpstate), matches, span, cw, mx);
+    } else {
+        nc_log("hakuX-native-cpu", "signal frame FPU: no FXSAVE image in the frame's %zu bytes (format %lx, owned "
+               "%lx): the guest's x87/SSE stays the handler's registers (thread switches don't keep it)", span,
+               (unsigned long)uc->uc_mcontext.mc_fpformat, (unsigned long)uc->uc_mcontext.mc_ownedfp);
+    }
+    frame_dump(context, span);
+}
+
+static uint8_t *frame_fx(void *context, siginfo_t *info, uint8_t *fx)
+{
+    if (g_fx_off == -2) {
+        frame_find(context, info);
+    }
+    return g_fx_off >= 0 ? (uint8_t *)context + g_fx_off : fx;
+}
+
+void ncn_on_fault_fx(int sig, siginfo_t *info, void *context, uint8_t *fx)
+{
+    uint8_t *const outer = t_live_fx;
+    t_live_fx = frame_fx(context, info, fx);
+    on_fault(sig, info, context);
+    t_live_fx = outer;
+}
+
+void ncn_on_kick_fx(int sig, siginfo_t *info, void *context, uint8_t *fx)
+{
+    uint8_t *const outer = t_live_fx;
+    t_live_fx = frame_fx(context, info, fx);
+    on_kick(sig, info, context);
+    t_live_fx = outer;
+}
+#endif
+
+static void install_handlers(void)
+{
+    static bool done;
+    if (done) {
+        return;
+    }
+    done = true;
+    struct sigaction sa;
+    memset(&sa, 0, sizeof(sa));
+#if FX_LIVE
+    sa.sa_sigaction = ncn_fault_entry;
+#else
+    sa.sa_sigaction = on_fault;
+#endif
+    /* NODEFER: a system op's host code may fault (write tracking) */
+    sa.sa_flags = SA_SIGINFO | SA_ONSTACK | SA_NODEFER;
+    sigemptyset(&sa.sa_mask);
+    sigaddset(&sa.sa_mask, NC_KICK_SIGNAL);
+    for (size_t i = 0; i < NSIGNALS; i++) {
+        sigaction(k_signals[i], &sa, &g_prev[i]);
+    }
+    memset(&sa, 0, sizeof(sa));
+#if FX_LIVE
+    sa.sa_sigaction = ncn_kick_entry;
+#else
+    sa.sa_sigaction = on_kick;
+#endif
+    sa.sa_flags = SA_SIGINFO | SA_ONSTACK | SA_RESTART;
+    sigemptyset(&sa.sa_mask);
+    sigaction(NC_KICK_SIGNAL, &sa, NULL);
+}
+
+/* The guest's GS: the KPCR. Linux: an LDT data segment based there (a null
+ * selector would fault in compatibility mode); the PS5: its GS base
+ * (sysarch AMD64_SET_GSBASE) with the selector its 32-bit segments use. */
+static uint16_t gs_selector(uint32_t base)
+{
+#if defined(__linux__)
+    struct user_desc d;
+    memset(&d, 0, sizeof(d));
+    d.entry_number = 0;
+    d.base_addr = base;
+    d.limit = 0xFFFFF;
+    d.seg_32bit = 1;
+    d.limit_in_pages = 1;
+    d.useable = 1;
+    if (syscall(SYS_modify_ldt, 1, &d, sizeof(d)) != 0) {
+        nc_log("hakuX-native", "cpu: modify_ldt failed (%s): no GS for the guest", strerror(errno));
+        return 0;
+    }
+    return (uint16_t)((0 << 3) | 4 | 3);
+#else
+    (void)base;
+    return 0;   /* the GS base itself, per thread (thread_setup) */
+#endif
+}
+
+/* sigaltstack is an ordinary libkernel import (Kelvin calls it so on the
+ * console). 0.1.0 used a run-time lookup that cannot find libkernel in this
+ * title, so the handlers ran on the guest's stack, and the kernel could not
+ * write the signal frame there (sendsig's copyout faulted on a guest stack
+ * page not yet present, and the title got SIGILL). */
+static int altstack(const stack_t *ss)
+{
+    return sigaltstack(ss, NULL);
+}
+
+/* A host stack for the gate or the signals: anonymous memory on Linux,
+ * the heap on the PS5 (its flexible memory is small; the platform heap is
+ * direct memory). */
+static uint8_t *host_stack(size_t bytes)
+{
+#if defined(__linux__)
+    void *p = mmap(NULL, bytes, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    return p == MAP_FAILED ? NULL : p;
+#else
+    /* Touched now: the kernel writes signal frames here and cannot fault a
+     * page in while it does. */
+    uint8_t *p = malloc(bytes);
+    if (p)
+        memset(p, 0, bytes);
+    return p;
+#endif
+}
+
+NcCpu *nc_cpu_create(const NcCpuConfig *cfg, uint32_t fs_base)
+{
+    /* one vCPU: static, 64-byte aligned (the frame's FXSAVE image) */
+    static NcCpu s_cpu __attribute__((aligned(64)));
+    NcCpu *cpu = &s_cpu;
+    memset(cpu, 0, sizeof(*cpu));
+    cpu->cfg = *cfg;
+    cpu->fs_base = fs_base;
+    cpu->host_cs = ncn_read_cs();
+    cpu->host_ss = ncn_read_ss();
+    ncn_guest_cs = NC_GUEST_CS;
+    ncn_guest_ss = cpu->host_ss;
+    uint32_t mx = 0x1F80;
+    __asm__ volatile("stmxcsr %0" : "=m"(mx));
+    ncn_host_mxcsr = mx;
+    cpu->gs_sel = gs_selector(fs_base);
+#if defined(__linux__)
+    if (!cpu->gs_sel) {
+        return NULL;
+    }
+#endif
+    cpu->tsc_ratio = (uint64_t)(((unsigned __int128)XBOX_TSC_HZ << 32) / ncn_tsc_hz());
+    cpu->cycle_offset = rdtsc();
+    cpu->noint_lo = cpu->noint_hi = 0;
+
+    /* the reset state: EFLAGS 0x202, FCW 0x27F (the Xbox kernel's: double
+     * precision), MXCSR 0x1F80 */
+    memset(&cpu->reset, 0, sizeof(cpu->reset));
+    cpu->reset.eflags = 0x202;
+    const uint16_t fcw = 0x27F;
+    memcpy(cpu->reset.fx, &fcw, 2);
+    const uint32_t mxcsr = 0x1F80, mask = 0xFFFF;
+    memcpy(cpu->reset.fx + 24, &mxcsr, 4);
+    memcpy(cpu->reset.fx + 28, &mask, 4);
+
+    cpu->gate_stack = host_stack(GATE_STACK_SIZE);
+    if (!cpu->gate_stack) {
+        return NULL;
+    }
+    ncn_gate_stack = (uint64_t)((uintptr_t)(cpu->gate_stack + GATE_STACK_SIZE - 64) & ~(uintptr_t)15);
+    ncn_gate_frame = &cpu->frame;
+    ncn_gate_pending = &cpu->pending;
+    g_cpu = cpu;
+    install_handlers();
+    {   /* opt-in (unset: nothing): the host's own CPUID decides */
+        const char *sites = getenv("NC_RSQRT_SITES");
+        if (sites && sites[0]) {
+            ncn_rsqrt_setup(cpu, sites, nc_rsqrt_host_amd());
+        }
+    }
+    nc_log("hakuX-native", "cpu: native x86 (guest cs %#x, host cs %#x ss %#x, GS %#x at the KPCR %08x); TSC %llu Hz, "
+           "rdtsc at %llu Hz", ncn_guest_cs, cpu->host_cs, cpu->host_ss, cpu->gs_sel, fs_base,
+           (unsigned long long)ncn_tsc_hz(), XBOX_TSC_HZ);
+    return cpu;
+}
+
+static void tsc_publish(NcCpu *cpu)
+{
+    if (cpu->vm) {
+        ncn_tsc_publish(cpu->vm, cpu->cycle_offset, cpu->tsc_ratio);
+    }
+}
+
+void nc_cpu_native_attach(NcCpu *cpu, NcVm *vm, uint32_t noint_lo, uint32_t noint_hi)
+{
+    cpu->vm = vm;
+    tsc_publish(cpu);
+    cpu->noint_lo = noint_lo;
+    cpu->noint_hi = noint_hi;
+}
+
+uint16_t nc_cpu_native_host_cs(void)
+{
+    return ncn_read_cs();
+}
+
+bool nc_cpu_native_gate_wanted(void)
+{
+    const char *e = getenv("NC_NATIVE_GATE");
+    return !(e && e[0] == '0');
+}
+
+uint32_t nc_cpu_native_gate_install(NcCpu *cpu, uint8_t *host, uint32_t va)
+{
+    (void)cpu;
+    /* movabs r11, ncn_gate_entry ; jmp r11 */
+    const uint64_t target = (uint64_t)(uintptr_t)&ncn_gate_entry;
+    host[0] = 0x49;
+    host[1] = 0xBB;
+    memcpy(host + 2, &target, 8);
+    host[10] = 0x41;
+    host[11] = 0xFF;
+    host[12] = 0xE3;
+    host[13] = host[14] = host[15] = 0xCC;
+    return va;
+}
+
+/* The vCPU thread's own setup: its signal stack, GS and DS/ES, cpuid. */
+static void thread_setup(NcCpu *cpu)
+{
+    cpu->thread = pthread_self();
+    if (!cpu->altstack) {
+        /* signals in guest code must not run on the guest's stack */
+        cpu->altstack = host_stack(ALTSTACK_SIZE);
+        if (cpu->altstack) {
+            stack_t ss;
+            memset(&ss, 0, sizeof(ss));
+            ss.ss_sp = cpu->altstack;
+            ss.ss_size = ALTSTACK_SIZE;
+            if (altstack(&ss) != 0) {
+                nc_log("hakuX-native", "cpu: sigaltstack failed (%s)", strerror(errno));
+            }
+        }
+    }
+    sigset_t set;
+    sigemptyset(&set);
+    sigaddset(&set, NC_KICK_SIGNAL);
+    for (size_t i = 0; i < NSIGNALS; i++) {
+        sigaddset(&set, k_signals[i]);
+    }
+    pthread_sigmask(SIG_UNBLOCK, &set, NULL);
+    ncn_load_segs(cpu->gs_sel, cpu->host_ss);
+#if defined(__PROSPERO__) || defined(__FreeBSD__)
+    {   /* GS = the KPCR, for this thread (the console refuses LDT segments) */
+        uint64_t base = cpu->fs_base;
+        if (sysarch(AMD64_SET_GSBASE, &base) != 0) {
+            nc_log("hakuX-native", "cpu: AMD64_SET_GSBASE failed (%s): no GS for the guest", strerror(errno));
+        }
+    }
+#endif
+#if defined(__linux__)
+    const char *e = getenv("NC_NATIVE_CPUID_FAULT");
+    if (!(e && e[0] == '0') && !cpu->cpuid_faults) {
+        cpu->cpuid_faults = syscall(SYS_arch_prctl, ARCH_SET_CPUID, 0) == 0;
+        nc_log("hakuX-native", "cpu: cpuid faulting %s", cpu->cpuid_faults ? "on (every guest cpuid traps)"
+                                                                             : "unavailable (the sweep's sites only)");
+    }
+#endif
+}
+
+void nc_cpu_run(NcCpu *cpu, const NcCpuContext *c)
+{
+    thread_setup(cpu);
+    nc_frame_load(&cpu->frame, c);
+    g_vif = (cpu->frame.eflags & NC_EFLAGS_IF) != 0;
+    if (cpu->nrsqrt) {
+        rsqrt_refresh(cpu, 0, UINT32_MAX);  /* the sections loaded before, a savestate's RAM */
+    }
+    if (nc_setjmp(cpu->exit_env)) {
+        /* out of the handler by a jump: what it blocked, unblocked */
+        sigset_t set;
+        sigemptyset(&set);
+        sigaddset(&set, NC_KICK_SIGNAL);
+        for (size_t i = 0; i < NSIGNALS; i++) {
+            sigaddset(&set, k_signals[i]);
+        }
+        pthread_sigmask(SIG_UNBLOCK, &set, NULL);
+        cpu->running = 0;
+        t_depth = 0;           /* the handlers it jumped out of */
+        cpu->stepping = false;
+        cpu->gate_step = false;
+#if FX_LIVE
+        t_live_fx = NULL;   /* the handler's buffer it jumped out of */
+#endif
+        nc_log("hakuX-native-cpu", "run ends at %08x: %llu system ops (%llu by signal, %llu by the gate), %llu kicks, "
+               "rdtsc %llu", (uint32_t)cpu->frame.rip, (unsigned long long)cpu->st.sysops,
+               (unsigned long long)cpu->st.signals, (unsigned long long)cpu->st.gate_calls,
+               (unsigned long long)cpu->st.kicks, (unsigned long long)cpu->st.rdtsc);
+        return;
+    }
+    cpu->running = 1;
+    /* a request made before the run (a savestate's start) goes first */
+    if (__atomic_load_n(&cpu->pending, __ATOMIC_ACQUIRE)) {
+        __atomic_store_n(&cpu->in_host, 1, __ATOMIC_SEQ_CST);
+        after_sysop(cpu, &cpu->frame);
+        __atomic_store_n(&cpu->in_host, 0, __ATOMIC_SEQ_CST);
+        g_vif = (cpu->frame.eflags & NC_EFLAGS_IF) != 0;
+    }
+    cpu->frame.pad[1] = (cpu->frame.eflags & EFLAGS_KEEP) | 0x202u | (cpu->stepping ? NC_EFLAGS_TF : 0);
+    ncn_enter(&cpu->frame, ncn_guest_cs, ncn_guest_ss);
+}
+
+void nc_cpu_invalidate(NcCpu *cpu, uint32_t va, uint32_t len)
+{
+    /* nothing translated: x86 code runs as it is; the RSQRT sites there are
+     * looked at again */
+    if (cpu && cpu->nrsqrt) {
+        rsqrt_refresh(cpu, va, len);
+    }
+}
+
+bool nc_cpu_x87_single_check(NcCpu *cpu)
+{
+    (void)cpu;
+    return false;   /* the host's x87 has the precision control */
+}
+
+bool nc_cpu_x87_single(NcCpu *cpu)
+{
+    (void)cpu;
+    return false;
+}
+
+void nc_cpu_x87_single_restore(NcCpu *cpu)
+{
+    (void)cpu;
+}
+
+void nc_cpu_cycle_offset_add(NcCpu *cpu, uint64_t ticks)
+{
+    cpu->cycle_offset += ticks;
+    tsc_publish(cpu);
+}
+
+uint64_t nc_cpu_host_cycles(void)
+{
+    return rdtsc();
+}
+
+uint64_t nc_cpu_guest_cycles(NcCpu *cpu)
+{
+    return rdtsc() - cpu->cycle_offset;
+}
+
+void nc_cpu_guest_cycles_set(NcCpu *cpu, uint64_t ticks)
+{
+    cpu->cycle_offset = rdtsc() - ticks;
+    tsc_publish(cpu);
+}
+
+/* Guest code runs at its own addresses: a host PC below 4 GiB is the
+ * guest's, except the window's start the host keeps (the PS5 title's
+ * libc.prx at 0x80000000, NC_HOLE_END). */
+static bool guest_pc(uintptr_t pc)
+{
+    const uint32_t hole = NC_HOLE_END;
+    if (hole && pc >= 0x80000000ull && pc < (uint64_t)hole) {
+        return false;
+    }
+    /* the host's code entries in the window's first page (a host that took
+     * the window's start back: vmhost.h nc_vmhost_window_low), run by host
+     * threads; guest code never runs from physical page 0 */
+    if (pc - 0x80000000ull < NC_VMHOST_LOW_PAGE && nc_vmhost_window_low_active()) {
+        return false;
+    }
+    return pc && pc < (1ull << 32);
+}
+
+uint32_t nc_cpu_guest_eip_at(NcCpu *cpu, uintptr_t host_pc)
+{
+    (void)cpu;
+    return guest_pc(host_pc) ? (uint32_t)host_pc : 0;
+}
+
+bool nc_cpu_sample_pc(NcCpu *cpu, uintptr_t host_pc, uint32_t *eip)
+{
+    if (guest_pc(host_pc)) {
+        *eip = (uint32_t)host_pc;
+        return true;
+    }
+    /* host code (a kernel call, a trap's handler): the guest's EIP when it
+     * left its code, kept at each system op and kick */
+    *eip = cpu ? cpu->last_eip : 0;
+    return false;
+}
+
+bool nc_cpu_native_sample_regs(NcCpu *cpu, uint32_t regs[9])
+{
+    if (!cpu || !cpu->smp_regs_ok) {
+        return false;
+    }
+    memcpy(regs, cpu->smp_regs, sizeof(cpu->smp_regs));
+    return true;
+}
+
+uint32_t nc_cpu_native_last_eip(NcCpu *cpu)
+{
+    return cpu ? cpu->last_eip : 0;
+}
+
+bool nc_cpu_native_sample(NcCpu *cpu, uint32_t *eip, int *where)
+{
+    if (!cpu || !cpu->running) {
+        return false;
+    }
+    if (pthread_equal(cpu->thread, pthread_self())) {
+        *eip = cpu->last_eip;
+        *where = NC_SAMPLE_HOST;
+        return true;
+    }
+    if (__atomic_load_n(&cpu->in_host, __ATOMIC_SEQ_CST)) {
+        /* in a kernel call through the gate: no signal needed */
+        *eip = cpu->last_eip;
+        *where = NC_SAMPLE_GATE;
+        return true;
+    }
+    const uint32_t seq = __atomic_load_n(&cpu->smp_seq, __ATOMIC_ACQUIRE);
+    __atomic_store_n(&cpu->smp_req, 1, __ATOMIC_RELEASE);
+    if (pthread_kill(cpu->thread, NC_KICK_SIGNAL) != 0) {
+        __atomic_store_n(&cpu->smp_req, 0, __ATOMIC_RELAXED);
+        return false;
+    }
+    /* the kick handler answers at the vCPU's next instruction: microseconds */
+    for (int i = 0; i < 200; i++) {
+        if (__atomic_load_n(&cpu->smp_seq, __ATOMIC_ACQUIRE) != seq) {
+            *eip = cpu->smp_eip;
+            *where = cpu->smp_where;
+            return true;
+        }
+        const struct timespec ts = {0, 10000};
+        nanosleep(&ts, NULL);
+    }
+    __atomic_store_n(&cpu->smp_req, 0, __ATOMIC_RELAXED);
+    *eip = cpu->last_eip;
+    *where = NC_SAMPLE_HOST;
+    return true;
+}
+
+NcFrame *nc_cpu_fault_frame(NcCpu *cpu, void *ucontext)
+{
+    if (!cpu || !in_guest(ucontext) || !pthread_equal(cpu->thread, pthread_self())) {
+        return NULL;
+    }
+    ncn_frame_from_uc(&cpu->frame, ucontext, true);
+    return &cpu->frame;
+}
+
+void nc_cpu_fault_resume(NcCpu *cpu, void *ucontext)
+{
+    after_sysop(cpu, &cpu->frame);
+    ncn_frame_to_uc(&cpu->frame, ucontext, true);
+}
+
+bool nc_cpu_fault_is_write(const void *ucontext)
+{
+    return (C_ERR((const ucontext_t *)ucontext) & 2) != 0;
+}
+
+bool nc_cpu_unaligned_fault(NcCpu *cpu, int code, void *ucontext)
+{
+    (void)cpu, (void)code, (void)ucontext;
+    return false;   /* x86 does unaligned atomics */
+}
+
+bool nc_cpu_callret_fault(NcCpu *cpu, uintptr_t fault_addr, void *ucontext)
+{
+    (void)cpu, (void)fault_addr, (void)ucontext;
+    return false;   /* no call-ret shadow stack */
+}
+
+uint32_t ncn_seg_base(void)
+{
+    return g_cpu ? g_cpu->fs_base : 0;
+}
+
+uintptr_t nc_cpu_ucontext_pc(const void *ucontext)
+{
+    return ncn_uc_pc(ucontext);
+}
+
+void nc_cpu_native_stats(NcCpu *cpu, NcNativeStats *out)
+{
+    *out = cpu->st;
+}
diff --git a/native/cpu/cpu_native.h b/native/cpu/cpu_native.h
new file mode 100644
index 0000000000000000000000000000000000000000..e1986fe31c48ef90560f67c0c6b4101392279b68
--- /dev/null
+++ b/native/cpu/cpu_native.h
@@ -0,0 +1,161 @@
+/*
+ * hakuX native core — native CPU backend: what the rest of the native core
+ * shares with it (cpu.h is the backend-neutral interface).
+ *
+ * Copyright (C) 2026 Press5elect
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * Additional terms (GPL-3.0 section 7(b)): keep the attribution "OGBox by
+ * Press5elect" (github.com/Press5elect/OGBox, NOTICE).
+ *
+ * The title's 32-bit code runs on the host's CPU in compatibility mode at
+ * its own addresses (guest VA == host VA, native/cpu/vmhost.h). One host
+ * thread, the vCPU, runs every guest thread; the kernel switches between
+ * them inside system ops by rewriting the frame (nc_frame_save/load), as it
+ * does with FEX. The guest leaves its code through faults (privileged
+ * instructions, int 0x3F, device registers, patched rdtsc/cpuid) or, for
+ * kernel calls, through a far call into 64-bit code (the gate).
+ */
+#ifndef NATIVE_CPU_CPU_NATIVE_H
+#define NATIVE_CPU_CPU_NATIVE_H
+
+#include "native/cpu/cpu.h"
+#include "native/core/vm.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The guest register file during a system op. The layout is cpu_native_asm.S's. */
+struct NcFrame {
+    uint64_t regs[8];      /* +0   x86 order; the low 32 bits are the guest's */
+    uint64_t rip;          /* +64  EIP */
+    uint64_t eflags;       /* +72  EFLAGS, IF the virtual one */
+    uint64_t pad[6];       /* +80 */
+    uint8_t fx[512];       /* +128 FXSAVE image: x87, MMX, SSE, MXCSR */
+} __attribute__((aligned(64)));
+
+#define NC_FRAME_FX 128
+#define NC_EFLAGS_IF 0x200u
+#define NC_EFLAGS_TF 0x100u
+#define NC_EFLAGS_DF 0x400u
+
+/* A ucontext_t's guest registers into f (with the FXSAVE image when fx),
+ * and back. IF stays the frame's (the virtual IF) and is set in the host's. */
+void ncn_frame_from_uc(NcFrame *f, const void *ucontext, bool fx);
+void ncn_frame_to_uc(const NcFrame *f, void *ucontext, bool fx);
+
+/* The host's PC in a ucontext_t (fault reports). */
+uintptr_t ncn_uc_pc(const void *ucontext);
+/* Whether a ucontext_t was interrupted in guest code (the compat CS). */
+bool ncn_uc_in_guest(const void *ucontext);
+
+/* After nc_cpu_create: the VM (code patches write through its never
+ * protected view) and the kernel's guest-code range where no interrupt is
+ * taken mid-way ([lo, hi): the fast paths, which keep state in registers
+ * across their kernel call). */
+void nc_cpu_native_attach(NcCpu *cpu, NcVm *vm, uint32_t noint_lo, uint32_t noint_hi);
+
+/* The kernel-call gate (phase 2): the 64-bit landing a guest far call
+ * reaches, written at va (16 bytes, in guest memory below 4 GiB), and the
+ * far pointer (6 bytes: offset, selector) a `call far [ptr]` or the bytes
+ * of a direct `9A` far call need. 0 when the gate can't be used. */
+uint32_t nc_cpu_native_gate_install(NcCpu *cpu, uint8_t *host, uint32_t va);
+uint16_t nc_cpu_native_host_cs(void);
+/* NC_NATIVE_GATE=0 turns the gate off (every kernel call an int 0x3F
+ * fault): asked before the kernel lays out its trampolines. */
+bool nc_cpu_native_gate_wanted(void);
+
+/* The code sweep (codepatch.c): an executable section [va, va + len) just
+ * loaded; rdtsc and cpuid at instruction boundaries become ud2, sidt/sgdt
+ * too, pushfd/popfd int3, each site logged. Code is written through the
+ * VM's host view (the page may be write-protected). */
+void nc_cpu_native_code_loaded(NcVm *vm, uint32_t va, uint32_t len, const char *name);
+
+enum NcPatchKind { NC_PATCH_NONE, NC_PATCH_RDTSC, NC_PATCH_CPUID, NC_PATCH_PUSHFD, NC_PATCH_POPFD,
+                   NC_PATCH_SIDT, NC_PATCH_SGDT };
+/* The patch at va, its original bytes in orig[2] (sidt/sgdt: the ModRM and
+ * what follows stay in place after the ud2). */
+int ncn_patch_kind(uint32_t va, uint8_t orig[2]);
+/* A site found after the sweep (a CLI's popfd): patched now. */
+void ncn_patch_add(NcVm *vm, uint32_t va, int kind);
+/* Counts for the stats line. */
+void ncn_patch_counts(unsigned *rdtsc, unsigned *cpuid, unsigned *flags);
+
+/* The base of the guest's fs:/gs: (the KPCR), for decoded accesses. */
+uint32_t ncn_seg_base(void);
+
+/* The rdtsc stubs' area and their data words (base 8 bytes, ratio 4) in
+ * guest memory (the kernel area), set before the first sweep; and the
+ * values the stubs scale by, written there (cpu_native.c, at each change
+ * of the guest's time base). */
+void ncn_tsc_stubs_setup(uint32_t area_va, uint32_t area_len, uint32_t data_va);
+/* The guest-code TSC sequence (EDX:EAX the guest's TSC, flags and the
+ * other registers kept) at p: its length, 0 when not set up. */
+unsigned ncn_tsc_emit(uint8_t *p);
+/* (kernel/mmiosite.c) A trapped rdtsc at eip emulated (the context past it):
+ * counted, and after a number the site runs the sequence in a stub. */
+void nc_mmio_site_rdtsc(uint32_t eip, void *ucontext);
+void ncn_tsc_publish(NcVm *vm, uint64_t base, uint64_t ratio);
+
+/* Host TSC (nc_cpu_host_cycles) and its frequency, measured once. */
+uint64_t ncn_tsc_hz(void);
+
+/* The samplers (the HLE's hitch monitor and perf capture, native/hle/glue.c):
+ * where the vCPU is now, asked from another thread. In guest code the kick
+ * signal (SIGUSR2, the handler that keeps the guest's x87/SSE) reads its EIP;
+ * in a kernel call through the gate, or in host code, *eip is the guest's
+ * EIP when it left its code (kept at each system op and kick). false: no
+ * vCPU running, or the signal could not be sent. */
+enum { NC_SAMPLE_GUEST, NC_SAMPLE_GATE, NC_SAMPLE_HOST };
+bool nc_cpu_native_sample(NcCpu *cpu, uint32_t *eip, int *where);
+/* The last sample's guest registers (EAX, ECX, EDX, EBX, ESP, EBP, ESI, EDI,
+ * EFLAGS) when it was taken in guest code; false otherwise. Read right after
+ * nc_cpu_native_sample on the same thread (the next sample replaces them). */
+bool nc_cpu_native_sample_regs(NcCpu *cpu, uint32_t regs[9]);
+/* The guest's EIP at the last system op or kick (racy: diagnostics). */
+uint32_t nc_cpu_native_last_eip(NcCpu *cpu);
+/* The host's line for the native CPU's last words (a fatal signal, an
+ * unhandled system op), written at once from a signal handler: weak, by
+ * default to standard error; the PS5 title writes its boot log. */
+void nc_host_emergency_write(const char *text, size_t len);
+
+/* For the stats: system ops by path since the start. */
+typedef struct NcNativeStats {
+    uint64_t signals;       /* guest exits through a signal */
+    uint64_t gate_calls;    /* kernel calls through the gate */
+    uint64_t sysops;        /* system ops handed to the kernel */
+    uint64_t kicks;         /* interrupt signals delivered in guest code */
+    uint64_t steps;         /* single steps (to leave a no-interrupt range) */
+    uint64_t gate_entry_kicks;      /* kicks on the gate's way in (0.1.43: left to its end) */
+    uint64_t gate_steps_stopped;    /* gate steps that reached host code (0.1.43: stopped) */
+    uint64_t rdtsc, cpuid, flags_insns, fs_rewrites;
+    uint64_t seg_faults;    /* page faults of fs:/gs: accesses (emulated; nc_cpu_native_seg_fault) */
+    uint64_t by_kind[32];   /* signals by system op (enum NcSysOp; 0: an interrupt from a kick) */
+    uint64_t rsqrt;         /* RSQRT sites' instructions given Intel's estimates (NC_RSQRT_SITES) */
+    uint64_t rsqrt_native;  /* and those run as they are (a source not in RAM) */
+} NcNativeStats;
+void nc_cpu_native_stats(NcCpu *cpu, NcNativeStats *out);
+
+/* The RSQRT sites (cpu_native.c, NC_RSQRT_SITES): Intel's RSQRTSS/RSQRTPS
+ * estimates at the listed guest instructions on an AMD host. nc_cpu_create
+ * sets them up from the variable (when it is set) with the host's own CPUID;
+ * a test on another host passes amd itself. list: hexadecimal addresses
+ * separated by commas, up to 64. False when the list is malformed or this
+ * host's estimates can't be corrected (no sites then: nothing patched). */
+bool ncn_rsqrt_setup(NcCpu *cpu, const char *list, bool amd);
+/* A savestate is being written (hold): the sites' int3s out of guest RAM,
+ * and back after it (!hold). Nothing without sites. On the guest CPU's
+ * thread, the guest stopped (save.c, at its pause point). */
+void nc_cpu_native_rsqrt_hold(NcCpu *cpu, bool hold);
+/* (core/mmio.c) A guest page fault of an instruction with an fs: or gs:
+ * prefix at eip, emulated against the KPCR: an fs: prefix becomes gs: (the
+ * guest's GS base is the KPCR) so the next run of it needs no fault. On the
+ * PS5 an fs: access doesn't #GP (the host's FS base, truncated, is used),
+ * so the #GP path that rewrites it on Linux never sees it. */
+void nc_cpu_native_seg_fault(uint32_t eip, bool fs);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/native/cpu/cpu_native_asm.S b/native/cpu/cpu_native_asm.S
new file mode 100644
index 0000000000000000000000000000000000000000..79fe2a7ac419cf342092367107b6b5db45eba472
--- /dev/null
+++ b/native/cpu/cpu_native_asm.S
@@ -0,0 +1,176 @@
+/*
+ * hakuX native core — native CPU backend: entering guest code and the
+ * 64-bit end of the kernel-call gate.
+ *
+ * Copyright (C) 2026 Press5elect
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * Additional terms (GPL-3.0 section 7(b)): keep the attribution "OGBox by
+ * Press5elect" (github.com/Press5elect/OGBox, NOTICE).
+ *
+ * After Kelvin's cpu_asm.S (PS5_Kelvin, same author and licence).
+ *
+ *   ncn_enter       host -> guest: the frame's x87/SSE state, its registers,
+ *                   and an iretq into the 32-bit code segment at its EIP and
+ *                   ESP with the EFLAGS cpu_native.c prepared (+88). Never
+ *                   returns: the guest leaves through faults and the gate.
+ *   ncn_gate_entry  a guest kernel call's far call lands here (through the
+ *                   16-byte trampoline in the kernel area): the guest's
+ *                   registers, flags and FXSAVE image go into the frame,
+ *                   ncn_gate_dispatch runs on the gate's host stack, and the
+ *                   guest resumes from the frame (another thread's, maybe).
+ *
+ * NcFrame (cpu_native.h): regs +0 (8 x 8), rip +64, eflags +72, the gate's
+ * raw RFLAGS +80, the entry RFLAGS +88, FXSAVE image +128.
+ */
+    .intel_syntax noprefix
+    .text
+
+/* void ncn_enter(NcFrame *f, uint64_t cs, uint64_t ss) */
+    .p2align 4
+    .globl ncn_gate_code_begin
+ncn_gate_code_begin:
+    .globl ncn_enter
+    .type ncn_enter, @function
+ncn_enter:
+    mov r11, rdi
+    fxrstor [r11 + 128]
+    push rdx                        /* SS */
+    mov eax, dword ptr [r11 + 32]
+    push rax                        /* RSP: ESP, zero-extended */
+    push qword ptr [r11 + 88]       /* RFLAGS */
+    push rsi                        /* CS */
+    mov eax, dword ptr [r11 + 64]
+    push rax                        /* RIP */
+    mov eax, dword ptr [r11 + 0]
+    mov ecx, dword ptr [r11 + 8]
+    mov edx, dword ptr [r11 + 16]
+    mov ebx, dword ptr [r11 + 24]
+    mov ebp, dword ptr [r11 + 40]
+    mov esi, dword ptr [r11 + 48]
+    mov edi, dword ptr [r11 + 56]
+    iretq
+    .globl ncn_enter_end
+ncn_enter_end:
+    .size ncn_enter, . - ncn_enter
+
+/* The gate: 64-bit code entered by `call far` from the guest, RSP the
+ * guest's stack with its return CS:EIP on top (two dwords). From here to
+ * ncn_gate_code_end (with ncn_enter, its way back) is "the gate's code" a
+ * kick can land in (cpu_native.c in_gate_code). */
+    .p2align 4
+    .globl ncn_gate_entry
+    .type ncn_gate_entry, @function
+ncn_gate_entry:
+    mov esp, esp                    /* RSP's upper half: undefined after compatibility mode */
+    mov r11, qword ptr [rip + ncn_gate_frame]
+    mov dword ptr [r11 + 0], eax
+    mov dword ptr [r11 + 8], ecx
+    mov dword ptr [r11 + 16], edx
+    mov dword ptr [r11 + 24], ebx
+    mov dword ptr [r11 + 40], ebp
+    mov dword ptr [r11 + 48], esi
+    mov dword ptr [r11 + 56], edi
+    mov eax, dword ptr [rsp]        /* the return EIP: after the far call */
+    mov dword ptr [r11 + 64], eax
+    mov dword ptr [r11 + 68], 0
+    lea eax, [rsp + 8]              /* ESP without the far return */
+    mov dword ptr [r11 + 32], eax
+    pushfq
+    pop rax
+    mov qword ptr [r11 + 80], rax
+    fxsave [r11 + 128]
+    mov rsp, qword ptr [rip + ncn_gate_stack]
+    cld
+    ldmxcsr dword ptr [rip + ncn_host_mxcsr]
+    fninit
+    mov rdi, r11
+    call ncn_gate_dispatch
+    /* OGBox 0.1.43: from here (and ncn_enter) the gate's way back to the
+     * guest, where a kick may single-step to it; before here its way in,
+     * where ncn_gate_dispatch takes a pending request at its end. */
+    .globl ncn_gate_after_call
+ncn_gate_after_call:
+    /* in_host is 0 now: a request made since ncn_gate_dispatch looked, its
+     * kick skipped or landed before this look, is taken here */
+1:  mov rax, qword ptr [rip + ncn_gate_pending]
+    cmp dword ptr [rax], 0
+    .globl ncn_gate_looked
+ncn_gate_looked:
+    jne 2f
+3:  mov rdi, qword ptr [rip + ncn_gate_frame]
+    movzx esi, word ptr [rip + ncn_guest_cs]
+    movzx edx, word ptr [rip + ncn_guest_ss]
+    jmp ncn_enter
+2:  mov rdi, qword ptr [rip + ncn_gate_frame]
+    call ncn_gate_again
+    test eax, eax
+    jnz 1b
+    jmp 3b
+    .size ncn_gate_entry, . - ncn_gate_entry
+    .globl ncn_gate_code_end
+ncn_gate_code_end:
+
+/* uint16_t ncn_read_cs(void), ncn_read_ss(void) */
+    .globl ncn_read_cs
+ncn_read_cs:
+    mov ax, cs
+    movzx eax, ax
+    ret
+    .globl ncn_read_ss
+ncn_read_ss:
+    mov ax, ss
+    movzx eax, ax
+    ret
+
+/* void ncn_load_segs(uint16_t gs, uint16_t data): GS (the guest's KPCR,
+ * from the LDT on Linux) and DS/ES (a null DS/ES faults in compatibility
+ * mode) on this thread. */
+    .globl ncn_load_segs
+ncn_load_segs:
+    test edi, edi
+    jz 1f
+    mov gs, di
+1:  mov ds, si
+    mov es, si
+    ret
+
+#if defined(__PROSPERO__) || defined(__FreeBSD__)
+/* Signal handler entries (FreeBSD, the PS5): the guest's x87/SSE are live
+ * in the registers when a handler runs, not in its mcontext. Saved here into
+ * a buffer on the handler's stack (fx, the C handler's 4th argument), the
+ * host's MXCSR and x87 defaults set for the C code, and restored last: what
+ * the handler left in the buffer is what the guest resumes with. */
+    .p2align 4
+    .globl ncn_fault_entry
+ncn_fault_entry:
+    push rbp
+    mov rbp, rsp
+    sub rsp, 528
+    and rsp, -64
+    fxsave [rsp]
+    ldmxcsr dword ptr [rip + ncn_host_mxcsr]
+    fninit
+    mov rcx, rsp
+    call ncn_on_fault_fx
+    fxrstor [rsp]
+    leave
+    ret
+
+    .p2align 4
+    .globl ncn_kick_entry
+ncn_kick_entry:
+    push rbp
+    mov rbp, rsp
+    sub rsp, 528
+    and rsp, -64
+    fxsave [rsp]
+    ldmxcsr dword ptr [rip + ncn_host_mxcsr]
+    fninit
+    mov rcx, rsp
+    call ncn_on_kick_fx
+    fxrstor [rsp]
+    leave
+    ret
+#endif
+
+    .section .note.GNU-stack, "", @progbits
diff --git a/native/cpu/intel_rsqrt_table.inc b/native/cpu/intel_rsqrt_table.inc
new file mode 100644
index 0000000000000000000000000000000000000000..230eb6a5b1bd2bf8ed843dd32817778d0148207b
--- /dev/null
+++ b/native/cpu/intel_rsqrt_table.inc
@@ -0,0 +1,142 @@
+/* Intel RSQRT mantissas from Bochs cpu/sse_rcp.cc, blob
+ * e8a777a0d94be9ae49c7f6407bba5de17748cb77.
+ * Copyright (c) 2003-2018 Stanislav Shwartsman.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ *
