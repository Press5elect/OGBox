+
+
+static int snprintf_safe_copy(char *buf, size_t cap, const char *s)
+{
+    size_t i = 0;
+    while (s[i] && i + 1 < cap) {
+        buf[i] = s[i];
+        i++;
+    }
+    buf[i] = 0;
+    return (int)i;
+}
+
+/* ps5-native (OGBox 0.1.32): a formatter of its own, with no lock and no allocation. The PS5's
+ * vsnprintf formats a double through the C library's dtoa, which takes a lock and allocates: in
+ * Def Jam the emulated CPU's thread stopped in it for 300 ms and more (the 0.1.31 freeze probe:
+ * stats_tick's nc_log, inside libSceLibcInternal's printf), the game's interrupts late meanwhile.
+ * Every line nc_log and hle_log write is formatted here: d i u x X o c s p f F e g %, flags
+ * - 0 + space #, width and precision (numbers or *), lengths hh h l ll z j t L. Doubles in fixed
+ * notation (e and g too), up to 1e18; beyond, a power of ten. */
+typedef struct FmtOut {
+    char *p;
+    size_t n, cap;
+} FmtOut;
+
+static void fo_c(FmtOut *o, char c)
+{
+    if (o->n + 1 < o->cap) {
+        o->p[o->n] = c;
+    }
+    o->n++;
+}
+
+static void fo_pad(FmtOut *o, char c, int n)
+{
+    while (n-- > 0) {
+        fo_c(o, c);
+    }
+}
+
+/* digits of v in base, into tmp from its end: the start */
+static char *fmt_u64(char *end, unsigned long long v, unsigned base, bool upper)
+{
+    const char *dig = upper ? "0123456789ABCDEF" : "0123456789abcdef";
+    char *q = end;
+    do {
+        *--q = dig[v % base];
+        v /= base;
+    } while (v);
+    return q;
+}
+
+static void fo_field(FmtOut *o, const char *prefix, const char *body, int blen, int width, bool left,
+                     bool zero, int zeros)
+{
+    const int plen = (int)strlen(prefix);
+    int total = plen + zeros + blen;
+    if (!left && !zero) {
+        fo_pad(o, ' ', width - total);
+    }
+    for (int i = 0; i < plen; i++) {
+        fo_c(o, prefix[i]);
+    }
+    if (!left && zero) {
+        fo_pad(o, '0', width - total);
+    }
+    fo_pad(o, '0', zeros);
+    for (int i = 0; i < blen; i++) {
+        fo_c(o, body[i]);
+    }
+    if (left) {
+        fo_pad(o, ' ', width - total);
+    }
+}
+
+static int fmt_double(char *buf, size_t cap, double v, int prec)
+{
+    int n = 0;
+    if (v != v) {
+        return snprintf_safe_copy(buf, cap, "nan");
+    }
+    if (v > 1.7e308 || v < -1.7e308) {
+        return snprintf_safe_copy(buf, cap, v < 0 ? "-inf" : "inf");
+    }
+    if (v < 0) {
+        buf[n++] = '-';
+        v = -v;
+    }
+    if (prec > 9) {
+        prec = 9;
+    }
+    int exp10 = 0;
+    while (v >= 1e18) {
+        v /= 10.0;
+        exp10++;
+    }
+    unsigned long long scale = 1;
+    for (int i = 0; i < prec; i++) {
+        scale *= 10;
+    }
+    unsigned long long ip = (unsigned long long)v;
+    double frac = v - (double)ip;
+    unsigned long long fp = (unsigned long long)(frac * (double)scale + 0.5);
+    if (fp >= scale) {
+        fp -= scale;
+        ip++;
+    }
+    char tmp[32];
+    char *q = fmt_u64(tmp + sizeof(tmp), ip, 10, false);
+    while (q < tmp + sizeof(tmp) && (size_t)n + 1 < cap) {
+        buf[n++] = *q++;
+    }
+    if (prec > 0 && (size_t)n + 1 < cap) {
+        buf[n++] = '.';
+        char f[16];
+        for (int i = prec - 1; i >= 0; i--) {
+            f[i] = (char)('0' + fp % 10);
+            fp /= 10;
+        }
+        for (int i = 0; i < prec && (size_t)n + 1 < cap; i++) {
+            buf[n++] = f[i];
+        }
+    }
+    if (exp10 && (size_t)n + 6 < cap) {
+        buf[n++] = 'e';
+        buf[n++] = '+';
+        char *e = fmt_u64(tmp + sizeof(tmp), (unsigned long long)exp10, 10, false);
+        while (e < tmp + sizeof(tmp)) {
+            buf[n++] = *e++;
+        }
+    }
+    buf[n] = 0;
+    return n;
+}
+
+int nc_vfmt(char *dst, size_t cap, const char *fmt, va_list ap)
+{
+    FmtOut o = {dst, 0, cap};
+    for (const char *f = fmt; *f; f++) {
+        if (*f != '%') {
+            fo_c(&o, *f);
+            continue;
+        }
+        f++;
+        bool left = false, zero = false, plus = false, space = false, alt = false;
+        for (;; f++) {
+            if (*f == '-') left = true;
+            else if (*f == '0') zero = true;
+            else if (*f == '+') plus = true;
+            else if (*f == ' ') space = true;
+            else if (*f == '#') alt = true;
+            else break;
+        }
+        int width = 0, prec = -1;
+        if (*f == '*') {
+            width = va_arg(ap, int);
+            if (width < 0) {
+                left = true;
+                width = -width;
+            }
+            f++;
+        } else {
+            while (*f >= '0' && *f <= '9') {
+                width = width * 10 + (*f++ - '0');
+            }
+        }
+        if (*f == '.') {
+            f++;
+            prec = 0;
+            if (*f == '*') {
+                prec = va_arg(ap, int);
+                f++;
+            } else {
+                while (*f >= '0' && *f <= '9') {
+                    prec = prec * 10 + (*f++ - '0');
+                }
+            }
+        }
+        int len = 0;                        /* 0 int, 1 long, 2 long long/size/intmax/ptrdiff, -1 short, -2 char */
+        for (;; f++) {
+            if (*f == 'l') len = len == 1 ? 2 : 1;
+            else if (*f == 'h') len = len == -1 ? -2 : -1;
+            else if (*f == 'z' || *f == 'j' || *f == 't' || *f == 'q') len = 2;
+            else if (*f == 'L') len = 2;
+            else break;
+        }
+        const char c = *f;
+        if (!c) {
+            break;
+        }
+        char tmp[64];
+        char *end = tmp + sizeof(tmp);
+        switch (c) {
+        case '%':
+            fo_c(&o, '%');
+            break;
+        case 'c': {
+            char ch = (char)va_arg(ap, int);
+            fo_field(&o, "", &ch, 1, width, left, false, 0);
+            break;
+        }
+        case 's': {
+            const char *str = va_arg(ap, const char *);
+            if (!str) {
+                str = "(null)";
+            }
+            int sl = 0;
+            while (str[sl] && (prec < 0 || sl < prec)) {
+                sl++;
+            }
+            fo_field(&o, "", str, sl, width, left, false, 0);
+            break;
+        }
+        case 'd': case 'i': {
+            long long v = len == 2 ? va_arg(ap, long long) : len == 1 ? va_arg(ap, long) : va_arg(ap, int);
+            if (len == -1) v = (short)v;
+            if (len == -2) v = (signed char)v;
+            unsigned long long u = v < 0 ? 0ull - (unsigned long long)v : (unsigned long long)v;
+            char *q = (prec == 0 && u == 0) ? end : fmt_u64(end, u, 10, false);
+            const int bl = (int)(end - q);
+            fo_field(&o, v < 0 ? "-" : plus ? "+" : space ? " " : "", q, bl, width, left, zero && prec < 0,
+                     prec > bl ? prec - bl : 0);
+            break;
+        }
+        case 'u': case 'x': case 'X': case 'o': case 'p': {
+            unsigned long long u;
+            if (c == 'p') {
+                u = (unsigned long long)(uintptr_t)va_arg(ap, void *);
+            } else {
+                u = len == 2 ? va_arg(ap, unsigned long long) : len == 1 ? va_arg(ap, unsigned long)
+                                                                         : va_arg(ap, unsigned int);
+                if (len == -1) u = (unsigned short)u;
+                if (len == -2) u = (unsigned char)u;
+            }
+            const unsigned base = c == 'o' ? 8 : c == 'u' ? 10 : 16;
+            char *q = (prec == 0 && u == 0) ? end : fmt_u64(end, u, base, c == 'X');
+            const int bl = (int)(end - q);
+            const char *prefix = c == 'p' ? "0x" : (alt && u && base == 16) ? (c == 'X' ? "0X" : "0x")
+                               : (alt && base == 8) ? "0" : "";
+            fo_field(&o, prefix, q, bl, width, left, zero && prec < 0, prec > bl ? prec - bl : 0);
+            break;
+        }
+        case 'f': case 'F': case 'e': case 'E': case 'g': case 'G': case 'a': case 'A': {
+            const double v = va_arg(ap, double);
+            char db[48];
+            int bl = fmt_double(db, sizeof(db), v, prec < 0 ? 6 : prec);
+            const bool neg = db[0] == '-';
+            fo_field(&o, neg ? "-" : plus ? "+" : space ? " " : "", db + neg, bl - neg, width, left, zero, 0);
+            break;
+        }
+        case 'n':
+            (void)va_arg(ap, void *);
+            break;
+        default:
+            fo_c(&o, '%');
+            fo_c(&o, c);
+            break;
+        }
+    }
+    if (cap) {
+        dst[o.n < cap ? o.n : cap - 1] = 0;
+    }
+    return (int)o.n;
+}
+
+int nc_fmt(char *dst, size_t cap, const char *fmt, ...)
 {
-    char buf[1024];
     va_list ap;
     va_start(ap, fmt);
-    vsnprintf(buf, sizeof(buf), fmt, ap);
+    const int n = nc_vfmt(dst, cap, fmt, ap);
     va_end(ap);
-    fprintf(stderr, "%s: %s\n", tag, buf);
+    return n;
+}
+
+void nc_log_flush(void)
+{
+    if (g_async <= 0) {
+        return;
+    }
+    if (pthread_mutex_trylock(&g_mu) != 0) {
+        return;     /* (a crash inside the lock: what is queued stays) */
+    }
+    drain_locked();
+    pthread_mutex_unlock(&g_mu);
+}
+
+void nc_logv(const char *tag, const char *fmt, va_list ap)
+{
+    char buf[1024];
+    nc_vfmt(buf, sizeof(buf), fmt, ap);
 #ifdef __ANDROID__
     __android_log_write(ANDROID_LOG_INFO, tag, buf);
 #endif
+    pthread_once(&g_once, start_writer);
+    char line[1200];
+    int n = nc_fmt(line, sizeof(line), "%s: %s\n", tag, buf);
+    if (n <= 0) {
+        return;
+    }
+    if ((size_t)n >= sizeof(line)) {
+        n = (int)sizeof(line) - 1;
+        line[n - 1] = '\n';
+    }
+    if (!g_async) {
+        fwrite(line, 1, (size_t)n, stderr);
+        return;
+    }
+    pthread_mutex_lock(&g_mu);
+    if (g_sync_until_ns) {
+        if (log_now_ns() < g_sync_until_ns) {
+            drain_locked();                 /* what is queued first, in order */
+            fwrite(line, 1, (size_t)n, stderr);
+            fflush(stderr);
+            pthread_mutex_unlock(&g_mu);
+            return;
+        }
+        g_sync_until_ns = 0;
+    }
+    if (g_head - g_tail + (size_t)n > LOG_RING) {
+        g_dropped++;
+    } else {
+        const size_t at = g_head % LOG_RING, first = (size_t)n < LOG_RING - at ? (size_t)n : LOG_RING - at;
+        memcpy(g_ring + at, line, first);
+        memcpy(g_ring, line + first, (size_t)n - first);
+        g_head += (size_t)n;
+        pthread_cond_signal(&g_cv);
+    }
+    pthread_mutex_unlock(&g_mu);
+}
+
+void nc_log(const char *tag, const char *fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt);
+    nc_logv(tag, fmt, ap);
+    va_end(ap);
 }
 
