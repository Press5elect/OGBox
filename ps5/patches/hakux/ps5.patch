+/* OGBox 0.0.8: exact depth (wbuf 2) takes (z w) / w where a corner was at or behind the eye, vW
+ * elsewhere, the polygon offset on the chosen z; W-buffering (1) keeps vW alone */
+static void test_exact_depth_clip(void)
+{
+    uint32_t rs[HLE_PS_REGS] = { 0 };
+    rs[HLE_PS_RGB_IN] = IN4(R_T0, R_V0, R_ZERO, R_ZERO);
