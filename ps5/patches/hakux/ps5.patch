+
+/* Guest VA [va, va + len) onto RAM [pa, pa + len) in the host. With the
+ * native CPU guest VA is host VA (vmhost.h); what falls in the contiguous
+ * window's unmappable start (NC_HOLE_END) stays unmapped: the guest's
+ * accesses there are emulated (core/mmio.c), the host's go through vm->phys
+ * (nc_vm_host). */
+static bool host_map(NcVm *vm, uint32_t va, uint32_t pa, uint32_t len)
+{
+#if defined(NC_CPU_NATIVE)
+    const uint32_t hole = NC_HOLE_END;
+    if (hole && va < hole && va + (uint64_t)len > NC_CONTIG_WINDOW) {
+        const uint32_t lo = va > NC_CONTIG_WINDOW ? va : NC_CONTIG_WINDOW;
+        const uint32_t hi = va + (uint64_t)len < hole ? va + len : hole;
+        if (lo > va && !host_map(vm, va, pa, lo - va)) {
+            return false;
+        }
+        return hi >= va + len || host_map(vm, hi, pa + (hi - va), va + len - hi);
+    }
+    return nc_vmhost_map(va, vm->ram_fd, pa, len);
+#else
+    void *want = vm->base + va;
+    return mmap(want, len, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_FIXED, vm->ram_fd, pa) == want;
+#endif
+}
+
+/* The host's page for guest mappings (nc_vm_host_page): 4 KiB, the Xbox's,
+ * except on a host whose pages are larger (the PS5: 16 KiB; NC_HOST_PAGE
+ * forces it on Linux to exercise that path). Then a guest VA block of one
+ * host page maps one physical block of the same size, VA and PA congruent:
+ * the block is bound to its VA while any of its 4 KiB pages is mapped
+ * there (g_blk_va), the block's other pages held for it (g_orphan: in use,
+ * not mapped, freed when the binding ends). */
+static uint32_t g_hp = NC_PAGE;
+static uint32_t *g_blk_va;      /* per physical block: the VA block bound to it, or 0 */
+static uint8_t *g_orphan;       /* per physical page: held by its block's binding */
+
+/* OGBox 0.1.58: the title's RAM (NcVm.guest_size). Pages the title holds: used and not a block's
+ * leftover (g_orphan); allocations end where the Xbox's would, at guest_size of those. Contiguous
+ * and kernel memory stays below guest_size (its physical addresses are the title's); only the
+ * VA blocks of virtual memory use the RAM above it. */
+static uint32_t guest_top(const NcVm *vm)
+{
+    return vm->guest_size && vm->guest_size < vm->ram_size ? vm->guest_size : vm->ram_size;
+}
+
+/* OGBox 0.0.2: a contiguous block's alignment pages (vm.h nc_vm_slack_bytes) were the title's up to
+ * 0.0.1. On the console they stay free: MmAllocateContiguousMemoryEx takes the aligned block from
+ * the top down and the pages up to the next block are left for other allocations, and counted as
+ * free. A title that asks for many small aligned blocks lost them all: one that takes 277 blocks
+ * of its 44 MiB, most of them 8 KiB at 16 KiB alignment, had 2.2 MiB less than on the console,
+ * ran out at a level's load and read through the null its allocation returned. */
+uint32_t (*nc_vm_slack_bytes)(void);
+
+static uint32_t guest_held(const NcVm *vm)
+{
+    uint32_t n = 0;
+    const uint32_t pages = vm->ram_size / NC_PAGE;
+    for (uint32_t p = 0; p < pages; p++) {
+        n += vm->page_used[p] && !(g_orphan && g_orphan[p]);
+    }
+    const uint32_t slack = nc_vm_slack_bytes ? nc_vm_slack_bytes() / NC_PAGE : 0;
+    return n > slack ? n - slack : 0;
+}
+
+/* Room for pages more of the title's (always, where guest and host RAM are the same size). */
+static bool guest_room(const NcVm *vm, uint32_t pages)
+{
+    if (guest_top(vm) == vm->ram_size) {
+        return true;
+    }
+    const uint32_t limit = vm->guest_size / NC_PAGE;
+    const uint32_t held = guest_held(vm);
+    if (held + pages <= limit) {
+        return true;
+    }
+    static unsigned said;
+    if (said++ < 16) {
+        nc_log("hakuX-native", "vm: the title's %u MiB are used up (%u KiB held, %u KiB asked)", vm->guest_size >> 20,
+               held * (NC_PAGE >> 10), pages * (NC_PAGE >> 10));
+    }
+    return false;
+}
+
+void nc_vm_orphans_rebuild(NcVm *vm)
+{
+    if (g_hp <= NC_PAGE || !g_orphan) {
+        return;
+    }
+    const uint32_t pages = vm->ram_size / NC_PAGE, bp = g_hp / NC_PAGE;
+    unsigned n = 0;
+    for (uint32_t p = 0; p < pages; p++) {
+        const uint32_t va = vm->rmap[p];
+        const bool mapped = va && vm->pte[va / NC_PAGE] == ((p * NC_PAGE) | NC_PTE_VALID);
+        g_orphan[p] = vm->page_used[p] && !mapped && g_blk_va[p / bp];
+        n += g_orphan[p];
+    }
+    nc_log("hakuX-native", "vm: %u KiB held beside the title's pages in %u KiB blocks; the title's %u MiB: %u KiB free",
+           n * (NC_PAGE >> 10), g_hp >> 10, vm->guest_size >> 20, nc_vm_guest_free(vm) >> 10);
+}
+
+uint32_t nc_vm_guest_free(const NcVm *vm)
+{
+    const uint32_t limit = vm->guest_size / NC_PAGE, held = guest_held(vm);
+    return held < limit ? (limit - held) * NC_PAGE : 0;
+}
+
+uint32_t nc_vm_host_page(void)
+{
+    return g_hp;
+}
+
+/* mprotect of guest VA [va, va + len), the window's unmappable start left
+ * alone (none of it is the guest's: NC_HOLE_END). With host pages
+ * larger than the Xbox's, the whole host pages around it (the PS5 rounds
+ * the same way). */
+/* OGBox 0.1.18: mprotect's failures, counted and said. Each protection change splits the
+ * host's map of the guest's RAM (three views of 64 MiB, pages of 16 KiB: up to ~12000 ranges),
+ * and the console's kernel refuses a split past its limit (ENOMEM), silently up to 0.1.17: the
+ * page then stayed writable, its stores were never seen, and the HLE drew from stale textures
+ * (Manhunt: "dirty pages 0/s" from 70 s on, wrong and missing textures, the scene black with the
+ * HUD left; Burnout 3's colour streaks). */
+static unsigned g_mprotect_failures;
+static int g_mprotect_errno;
+static bool g_mprotect_failed_now;   /* since the last check (nc_vm_protect_failed) */
+
+static void guest_mprotect(NcVm *vm, uint32_t va, uint32_t len, int prot)
+{
+#if defined(NC_CPU_NATIVE)
+    const uint32_t hole = NC_HOLE_END;
+    if (hole && va < hole && va + (uint64_t)len > NC_CONTIG_WINDOW) {
+        const uint32_t lo = va > NC_CONTIG_WINDOW ? va : NC_CONTIG_WINDOW;
+        const uint32_t hi = va + (uint64_t)len < hole ? va + len : hole;
+        if (lo > va) {
+            guest_mprotect(vm, va, lo - va, prot);
+        }
+        if (hi < va + (uint64_t)len) {
+            guest_mprotect(vm, hi, va + len - hi, prot);
+        }
+        return;
+    }
+    /* The host's code entries in the window's first host page (a host that
+     * took that start back, nc_vmhost_window_low): never without access, so
+     * the host's calls into them keep running. */
+    if (prot == PROT_NONE && nc_vmhost_window_low_active() && va < NC_CONTIG_WINDOW + NC_VMHOST_LOW_PAGE &&
+        va + (uint64_t)len > NC_CONTIG_WINDOW) {
+        const uint64_t end = (uint64_t)va + len;
+        if (va < NC_CONTIG_WINDOW) {
+            guest_mprotect(vm, va, NC_CONTIG_WINDOW - va, prot);
+        }
+        if (end > NC_CONTIG_WINDOW + NC_VMHOST_LOW_PAGE) {
+            guest_mprotect(vm, NC_CONTIG_WINDOW + NC_VMHOST_LOW_PAGE,
+                           (uint32_t)(end - (NC_CONTIG_WINDOW + NC_VMHOST_LOW_PAGE)), prot);
+        }
+        return;
+    }
+#if defined(__PROSPERO__)
+    /* The PS5: a user page with read and execute but not write is
+     * execute-only there, and a data read of it ends the process at once
+     * (SYSTEM_XO_VIOLATION in klog: no signal, nothing to catch; OGBox 0.1.5
+     * died so reading 0x80000000 while the low page was watched). So a page
+     * keeps execute only while it is writable too: a page write tracking
+     * cleans is read-only without execute, and guest code that runs from it
+     * faults once like a store does (dirty.c nc_hle_dirty_fault: marked
+     * written, opened read/write/execute, run again); a spurious "written"
+     * costs the HLE an upload, never a wrong picture. The window's first
+     * page (the host's code entries, nc_vmhost_window_low) is never
+     * protected here at all: libkernel runs them on host threads. */
+    if (prot != (PROT_READ | PROT_WRITE | PROT_EXEC) && nc_vmhost_window_low_active() &&
+        va < NC_CONTIG_WINDOW + NC_VMHOST_LOW_PAGE && va + (uint64_t)len > NC_CONTIG_WINDOW) {
+        const uint64_t end = (uint64_t)va + len;
+        if (va < NC_CONTIG_WINDOW) {
+            guest_mprotect(vm, va, NC_CONTIG_WINDOW - va, prot);
+        }
+        if (end > NC_CONTIG_WINDOW + NC_VMHOST_LOW_PAGE) {
+            guest_mprotect(vm, NC_CONTIG_WINDOW + NC_VMHOST_LOW_PAGE,
+                           (uint32_t)(end - (NC_CONTIG_WINDOW + NC_VMHOST_LOW_PAGE)), prot);
+        }
+        return;
+    }
+    if (prot & PROT_WRITE) {
+        prot |= PROT_EXEC;              /* guest code runs from guest memory itself */
+    }
+#else
+    if (prot != PROT_NONE) {
+        prot |= PROT_EXEC;              /* guest code runs from guest memory itself */
+    }
+#endif
+    if (g_hp > NC_PAGE) {
+        const uint64_t end = ((uint64_t)va + len + g_hp - 1) & ~(uint64_t)(g_hp - 1);
+        va &= ~(g_hp - 1);
+        len = (uint32_t)(end - va);
+    }
+#endif
+    if (mprotect(vm->base + va, len, prot) != 0) {
+        g_mprotect_errno = errno;
+        g_mprotect_failed_now = true;
+        if (g_mprotect_failures++ < 8) {
+            nc_log("hakuX-native-vm", "mprotect %08x+%x prot %d failed: %s (failure %u)", va, len, prot,
+                   strerror(errno), g_mprotect_failures);
+        }
+    }
+}
+
+unsigned nc_vm_protect_failures(int *last_errno)
+{
+    if (last_errno) {
+        *last_errno = g_mprotect_errno;
+    }
+    return g_mprotect_failures;
+}
+
+/* The console's map of the guest's RAM made whole again: every view set to one protection in one
+ * call each (adjacent ranges with the same protection merge), then the pages write tracking
+ * cleaned armed again in runs, and the pages without access closed again. Called when an mprotect
+ * failed (protect_run): the next arming then has a fresh map. Returns false when even that fails. */
+static void prot_views(NcVm *vm, uint32_t page, uint32_t n, int prot);
+static bool consolidate(NcVm *vm)
+{
+    static unsigned done;
+    const uint32_t pages = vm->ram_size / NC_PAGE;
+    g_mprotect_failed_now = false;
+    guest_mprotect(vm, NC_CONTIG_WINDOW, vm->ram_size, PROT_READ | PROT_WRITE);
+    guest_mprotect(vm, NC_GPU_WINDOW, vm->ram_size, PROT_READ | PROT_WRITE);
+    for (uint32_t i = 0; i < pages;) {
+        const uint32_t va = vm->rmap[i];
+        uint32_t k = 1;
+        if (va && nc_vm_phys(vm, va) == i * NC_PAGE) {
+            while (i + k < pages && vm->rmap[i + k] == va + k * NC_PAGE && nc_vm_phys(vm, va + k * NC_PAGE) == (i + k) * NC_PAGE) {
+                k++;
+            }
+            guest_mprotect(vm, va, k * NC_PAGE, PROT_READ | PROT_WRITE);
+        }
+        i += k;
+    }
+    /* back to what tracking wants, in runs of the same (host pages) */
+    const uint32_t bp = g_hp / NC_PAGE;
+    unsigned armed = 0, closed = 0;
+    for (uint32_t i = 0; i < pages;) {
+        bool na = false, clean = false;
+        for (uint32_t j = i; j < i + bp && j < pages; j++) {
+            na |= g_na && __atomic_load_n(&g_na[j], __ATOMIC_ACQUIRE);
+            clean |= __atomic_load_n(&vm->wp[j], __ATOMIC_ACQUIRE) == NC_WP_CLEAN;
+        }
+        uint32_t k = bp;
+        for (; i + k < pages; k += bp) {
+            bool na2 = false, clean2 = false;
+            for (uint32_t j = i + k; j < i + k + bp && j < pages; j++) {
+                na2 |= g_na && __atomic_load_n(&g_na[j], __ATOMIC_ACQUIRE);
+                clean2 |= __atomic_load_n(&vm->wp[j], __ATOMIC_ACQUIRE) == NC_WP_CLEAN;
+            }
+            if (na2 != na || clean2 != clean) {
+                break;
+            }
+        }
+        if (i + k > pages) {
+            k = pages - i;
+        }
+        if (na) {
+            prot_views(vm, i, k, PROT_NONE);
+            closed += k;
+        } else if (clean) {
+            prot_views(vm, i, k, PROT_READ);
+            armed += k;
+        }
+        i += k;
+    }
+    done++;
+    nc_log("hakuX-native-vm", "the RAM map made whole (%u): %u pages armed again, %u closed, after %u mprotect failures (%s)%s",
+           done, armed, closed, g_mprotect_failures, strerror(g_mprotect_errno),
+           g_mprotect_failed_now ? "; still failing" : "");
+    return !g_mprotect_failed_now;
+}
 
