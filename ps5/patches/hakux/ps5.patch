+           cur, g_reader.n, oldest ? (double)(now - oldest) / 1e6 : 0.0, g_reader.ndone, g_reader.busy,
+           (unsigned long long)g_reader.queued_total, (unsigned long long)g_reader.read_total,
+           (unsigned long long)g_reader.completed_total, (unsigned long long)g_reader.failed_total,
+           g_reader.last_done_ns ? (double)(now - g_reader.last_done_ns) / 1e9 : -1.0, g_read_lines);
