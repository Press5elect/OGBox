+/*
+ * hakuX native core — the APU's output without AAudio (hosts other than
+ * Android: the Linux build, the PS5 title until it has its own backend).
+ *
+ * Copyright (C) 2026 Press5elect
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * Additional terms (GPL-3.0 section 7(b)): keep the attribution "OGBox by
+ * Press5elect" (github.com/Press5elect/OGBox, NOTICE).
+ *
+ * Stand-ins for the AAudio calls out.c makes: no stream ever opens, so
+ * out.c's reopen thread drains the ring at the device's rate (the sound goes
+ * nowhere, the APU keeps its timing), as it does on a phone with no output.
+ */
+#ifndef NATIVE_DEV_APU_OUT_NULL_H
+#define NATIVE_DEV_APU_OUT_NULL_H
+
+#include <stdint.h>
+
+typedef int32_t aaudio_result_t;
+typedef int32_t aaudio_data_callback_result_t;
+typedef struct AAudioStream AAudioStream;
+typedef struct AAudioStreamBuilder AAudioStreamBuilder;
+typedef aaudio_data_callback_result_t (*AAudioStream_dataCallback)(AAudioStream *, void *, void *, int32_t);
+typedef void (*AAudioStream_errorCallback)(AAudioStream *, void *, aaudio_result_t);
+
+enum {
+    AAUDIO_OK = 0,
+    AAUDIO_ERROR_UNAVAILABLE = -889,
+    AAUDIO_CALLBACK_RESULT_CONTINUE = 0,
+    AAUDIO_FORMAT_PCM_I16 = 1,
+    AAUDIO_PERFORMANCE_MODE_LOW_LATENCY = 12,
+};
+
+static inline const char *AAudio_convertResultToText(aaudio_result_t r)
+{
+    (void)r;
+    return "no audio backend on this host";
+}
+static inline aaudio_result_t AAudio_createStreamBuilder(AAudioStreamBuilder **b)
+{
+    *b = 0;
+    return AAUDIO_ERROR_UNAVAILABLE;
+}
+static inline void AAudioStreamBuilder_setSampleRate(AAudioStreamBuilder *b, int32_t v) { (void)b, (void)v; }
+static inline void AAudioStreamBuilder_setChannelCount(AAudioStreamBuilder *b, int32_t v) { (void)b, (void)v; }
+static inline void AAudioStreamBuilder_setFormat(AAudioStreamBuilder *b, int32_t v) { (void)b, (void)v; }
+static inline void AAudioStreamBuilder_setPerformanceMode(AAudioStreamBuilder *b, int32_t v) { (void)b, (void)v; }
+static inline void AAudioStreamBuilder_setFramesPerDataCallback(AAudioStreamBuilder *b, int32_t v) { (void)b, (void)v; }
+static inline void AAudioStreamBuilder_setDataCallback(AAudioStreamBuilder *b, AAudioStream_dataCallback cb, void *u)
+{
+    (void)b, (void)cb, (void)u;
+}
+static inline void AAudioStreamBuilder_setErrorCallback(AAudioStreamBuilder *b, AAudioStream_errorCallback cb, void *u)
+{
+    (void)b, (void)cb, (void)u;
+}
+static inline aaudio_result_t AAudioStreamBuilder_openStream(AAudioStreamBuilder *b, AAudioStream **s)
+{
+    (void)b;
+    *s = 0;
+    return AAUDIO_ERROR_UNAVAILABLE;
+}
+static inline void AAudioStreamBuilder_delete(AAudioStreamBuilder *b) { (void)b; }
+static inline aaudio_result_t AAudioStream_requestStart(AAudioStream *s) { (void)s; return AAUDIO_ERROR_UNAVAILABLE; }
+static inline aaudio_result_t AAudioStream_requestPause(AAudioStream *s) { (void)s; return AAUDIO_ERROR_UNAVAILABLE; }
+static inline aaudio_result_t AAudioStream_requestStop(AAudioStream *s) { (void)s; return AAUDIO_ERROR_UNAVAILABLE; }
+static inline aaudio_result_t AAudioStream_close(AAudioStream *s) { (void)s; return AAUDIO_OK; }
+
+#endif
