diff --git a/tests/native/linux/apu_stereo.c b/tests/native/linux/apu_stereo.c
new file mode 100644
index 0000000000000000000000000000000000000000..4892e223ba1c3abd9c7824e5b4002c3de86ccb6e
--- /dev/null
+++ b/tests/native/linux/apu_stereo.c
@@ -0,0 +1,451 @@
+/* The VP's own mix (MON_VP, the default without the DSP) through the real
+ * voice processing: voices set up and started by the PIO methods
+ * DirectSound sends (mcpx_apu_vp_write), their PCM read from guest RAM
+ * through the scatter-gather table, a frame mixed by mcpx_apu_vp_frame and
+ * read from the monitor's output. Ordinary 2D stereo voices are mixed by
+ * their sends (vp/stereo_route.h); 3D voices, multipass groups and voices
+ * with other sends keep the monitor's mix; the full-DSP monitor leaves the
+ * monitor's output alone and fills the mix bins. A voice reused for a new
+ * sound starts its HRTF filter from silence. One worker and several give
+ * the same output. No guest executable or sound device: the frame thread
+ * stays parked (SECTL off) and this test runs the frames. */
+#include <math.h>
+
+#include "native/dev/apu/apu_int.h"
+#include "native/dev/dev.h"
+#include "native/core/irq.h"
+#include "native/core/mmio.h"
+#include "native/core/vm.h"
+
+static unsigned failures;
+
+static void check(bool ok, const char *what)
+{
+    printf("%s: %s\n", ok ? "PASS" : "FAIL", what);
+    failures += !ok;
+}
+
+#define RAM_SIZE   (1u << 20)
+#define VOICES_PA  0x10000u     /* the voice table: 256 x 128 bytes */
+#define SGE_PA     0x20000u     /* the scatter-gather table */
+#define PCM_PA     0x30000u     /* sample pages, mapped in order */
+#define PCM_PAGES  64u
+#define LOOP_FRAMES 64u         /* each voice loops 64 sample frames */
+
+static uint8_t *g_ram;
+static MCPXAPUState *d;
+
+static void wr32(uint32_t pa, uint32_t v)
+{
+    memcpy(g_ram + pa, &v, 4);
+}
+
+static void pio(uint32_t method, uint32_t arg)
+{
+    mcpx_apu_vp_write(d, method, arg, 4);
+}
+
+/* A fresh APU with its voice table, an identity scatter-gather table over
+ * the sample pages, and empty voice lists */
+static void apu_up(bool dsp, bool hrtf, unsigned workers)
+{
+    static NcVm vm;
+    memset(g_ram, 0, RAM_SIZE);
+    vm = (NcVm){.phys = g_ram, .ram_size = RAM_SIZE};
+    char w[8];
+    snprintf(w, sizeof(w), "%u", workers);
+    setenv("NC_APU_WORKERS", w, 1);
+    setenv("NC_APU_DSP", dsp ? "1" : "0", 1);
+    setenv("NC_APU_HRTF", hrtf ? "1" : "0", 1);
+    unsetenv("NC_TRACE_APU");
+    nc_dev_apu_init(&vm);
+    d = g_state;
+    for (uint32_t p = 0; p < PCM_PAGES; p++) {
+        wr32(SGE_PA + 8 * p, PCM_PA + 0x1000 * p);
+    }
+    d->regs[NV_PAPU_VPVADDR] = VOICES_PA;
+    d->regs[NV_PAPU_VPSGEADDR] = SGE_PA;
+    mcpx_apu_vp_refresh_voice_cache(d, VOICES_PA);
+    d->regs[NV_PAPU_TVL2D] = d->regs[NV_PAPU_TVL3D] = d->regs[NV_PAPU_TVLMP] = 0xFFFF;
+}
+
+static void apu_down(void)
+{
+    nc_dev_apu_stop();
+    nc_dev_apu_free();
+    nc_mmio_reset();
+    nc_irq_reset();
+}
+
+/* Sample page p holds LOOP_FRAMES 16-bit frames of l (and r, stereo) */
+static void pcm_page(uint32_t p, bool stereo, int16_t l, int16_t r)
+{
+    int16_t *s = (int16_t *)(g_ram + PCM_PA + 0x1000 * p);
+    for (uint32_t i = 0; i < LOOP_FRAMES; i++) {
+        s[stereo ? 2 * i : i] = l;
+        if (stereo) {
+            s[2 * i + 1] = r;
+        }
+    }
+}
+
+typedef struct {
+    uint16_t handle;
+    unsigned list;              /* NV1BA0_PIO_SET_ANTECEDENT_VOICE_LIST_*_TOP */
+    bool stereo;
+    uint32_t page;              /* its samples' page (a byte offset of page x 4 KiB) */
+    int bin[8];
+    uint16_t vol[8];
+    uint32_t fmt_extra;         /* multipass, its bin, clear-mix */
+    uint16_t hrtf;              /* 3D: its HRTF entry, HRTF_NULL_HANDLE for none */
+} Voice;
+
+static Voice voice(uint16_t handle, unsigned list, bool stereo, uint32_t page)
+{
+    Voice v = {.handle = handle, .list = list, .stereo = stereo, .page = page, .hrtf = HRTF_NULL_HANDLE};
+    for (int b = 0; b < 8; b++) {
+        v.bin[b] = b;
+        v.vol[b] = 0xFFF;
+    }
+    return v;
+}
+
+static void start(const Voice *v)
+{
+    pio(NV1BA0_PIO_SET_CURRENT_VOICE, v->handle);
+    pio(NV1BA0_PIO_SET_VOICE_CFG_VBIN, (uint32_t)v->bin[0] | v->bin[1] << 5 | v->bin[2] << 10 |
+                                           v->bin[3] << 16 | v->bin[4] << 21 | (uint32_t)v->bin[5] << 26);
+    /* a block a sample frame: DirectSound's samples per block are the
+     * voice's channels (the field holds one less) */
+    pio(NV1BA0_PIO_SET_VOICE_CFG_FMT,
+        (uint32_t)v->bin[6] | v->bin[7] << 5 | v->fmt_extra |
+            (v->stereo ? NV_PAVS_VOICE_CFG_FMT_STEREO | 1u << 16 : 0) |
+            NV_PAVS_VOICE_CFG_FMT_LOOP | NV_PAVS_VOICE_CFG_FMT_SAMPLE_SIZE_S16 << 28 |
+            (uint32_t)NV_PAVS_VOICE_CFG_FMT_CONTAINER_SIZE_B16 << 30);
+    const uint16_t *a = v->vol;
+    pio(NV1BA0_PIO_SET_VOICE_TAR_VOLA, (a[6] & 0xF) | (uint32_t)a[0] << 4 | (a[7] & 0xF) << 16 | (uint32_t)a[1] << 20);
+    pio(NV1BA0_PIO_SET_VOICE_TAR_VOLB,
+        (a[6] >> 4 & 0xF) | (uint32_t)a[2] << 4 | (a[7] >> 4 & 0xF) << 16 | (uint32_t)a[3] << 20);
+    pio(NV1BA0_PIO_SET_VOICE_TAR_VOLC,
+        (a[6] >> 8 & 0xF) | (uint32_t)a[4] << 4 | (a[7] >> 8 & 0xF) << 16 | (uint32_t)a[5] << 20);
+    pio(NV1BA0_PIO_SET_VOICE_TAR_PITCH, 0);
+    pio(NV1BA0_PIO_SET_VOICE_TAR_HRTF, v->hrtf);
+    pio(NV1BA0_PIO_SET_VOICE_CFG_BUF_BASE, 0x1000 * v->page);
+    pio(NV1BA0_PIO_SET_VOICE_CFG_BUF_LBO, 0);
+    pio(NV1BA0_PIO_SET_VOICE_CFG_BUF_EBO, LOOP_FRAMES - 1);
+    pio(NV1BA0_PIO_SET_ANTECEDENT_VOICE, v->list << 16);
+    pio(NV1BA0_PIO_VOICE_ON, v->handle);        /* envelopes off: full level */
+}
+
+static int16_t g_out[NUM_SAMPLES_PER_FRAME][2];
+static float g_mixbins[NUM_MIXBINS][NUM_SAMPLES_PER_FRAME];
+
+/* n frames; the monitor's output of the last (frame_buf's first 32 pairs:
+ * ep_frame_div stays 0 here) and its mix bins */
+static void frames(int n)
+{
+    for (int f = 0; f < n; f++) {
+        pthread_mutex_lock(&d->lock);
+        memset(d->monitor.frame_buf, 0, sizeof(d->monitor.frame_buf));
+        memset(g_mixbins, 0, sizeof(g_mixbins));
+        mcpx_apu_vp_frame(d, g_mixbins);
+        memcpy(g_out, d->monitor.frame_buf, sizeof(g_out));
+        pthread_mutex_unlock(&d->lock);
+    }
+}
+
+static float attenuation(uint16_t vol)
+{
+    return vol == 0xFFF ? 0.0f : powf(10.0f, vol / (64.0f * -20.0f));
+}
+
+/* the monitor's 16-bit sample of x */
+static int pcm(float x)
+{
+    return (int)(fminf(fmaxf(x, -1.0f), 1.0f) * 32767.0f);
+}
+
+static bool all(int ch, int want, int tol)
+{
+    for (int i = 0; i < NUM_SAMPLES_PER_FRAME; i++) {
+        if (abs(g_out[i][ch] - want) > tol) {
+            printf("  sample %d channel %d: %d, expected %d\n", i, ch, g_out[i][ch], want);
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool channels_equal(void)
+{
+    for (int i = 0; i < NUM_SAMPLES_PER_FRAME; i++) {
+        if (g_out[i][0] != g_out[i][1]) {
+            return false;
+        }
+    }
+    return true;
+}
+
+#define HALF 16384              /* 0.5 */
+
+static void test_2d_mono_panned(void)
+{
+    apu_up(false, true, 1);
+    pcm_page(0, false, HALF, 0);
+    Voice v = voice(100, NV1BA0_PIO_SET_ANTECEDENT_VOICE_LIST_2D_TOP, false, 0);
+    v.vol[0] = 0;               /* front left, 0 dB; front right muted */
+    start(&v);
+    frames(4);
+    check(all(0, pcm(0.5f), 1) && all(1, 0, 0), "2D mono to front left only: left 0.5, right exactly 0");
+    apu_down();
+
+    apu_up(false, true, 1);
+    pcm_page(0, false, HALF, 0);
+    v.vol[0] = 0x040;           /* -1 dB */
+    v.vol[1] = 0x300;           /* -12 dB */
+    start(&v);
+    frames(4);
+    const float l = 0.5f * attenuation(0x040), r = 0.5f * attenuation(0x300);
+    check(all(0, pcm(l), 1) && all(1, pcm(r), 1),
+          "2D mono, unequal sends: each speaker at its own send's attenuation");
+    apu_down();
+}
+
+static void test_2d_stereo(void)
+{
+    apu_up(false, true, 1);
+    pcm_page(0, true, HALF, -HALF / 2);
+    Voice v = voice(101, NV1BA0_PIO_SET_ANTECEDENT_VOICE_LIST_2D_TOP, true, 0);
+    v.vol[0] = 0x080;           /* slot 0 (source left) to front left */
+    v.vol[1] = 0x100;           /* slot 1 (source right) to front right */
+    start(&v);
+    frames(4);
+    check(all(0, pcm(0.5f * attenuation(0x080)), 1) && all(1, pcm(-0.25f * attenuation(0x100)), 1),
+          "2D stereo: each source channel to its speaker at its gain");
+    apu_down();
+
+    apu_up(false, true, 1);
+    pcm_page(0, true, HALF, -HALF / 2);
+    v.bin[0] = 1;               /* reordered: slot 0 to front right, slot 1 to front left */
+    v.bin[1] = 0;
+    start(&v);
+    frames(4);
+    check(all(1, pcm(0.5f * attenuation(0x080)), 1) && all(0, pcm(-0.25f * attenuation(0x100)), 1),
+          "2D stereo, reordered bins: destination by bin, source by slot");
+    apu_down();
+}
+
+static void test_2d_headroom(void)
+{
+    apu_up(false, true, 1);
+    pcm_page(0, false, HALF, 0);
+    pio(NV1BA0_PIO_SET_SUBMIX_HEADROOM + 4 * 0, 1);
+    pio(NV1BA0_PIO_SET_SUBMIX_HEADROOM + 4 * 1, 2);
+    Voice v = voice(102, NV1BA0_PIO_SET_ANTECEDENT_VOICE_LIST_2D_TOP, false, 0);
+    v.vol[0] = v.vol[1] = 0;
+    start(&v);
+    frames(4);
+    check(all(0, pcm(0.25f), 1) && all(1, pcm(0.125f), 1), "2D headroom: each bin's own, kept");
+    apu_down();
+}
+
+/* a send to the centre: the monitor's mix, the loudest send's gain on both
+ * channels */
+static void test_2d_centre_unsupported(void)
+{
+    apu_up(false, true, 1);
+    pcm_page(0, false, HALF, 0);
+    Voice v = voice(103, NV1BA0_PIO_SET_ANTECEDENT_VOICE_LIST_2D_TOP, false, 0);
+    v.vol[0] = 0x300;
+    v.vol[2] = 0;               /* front centre, 0 dB */
+    start(&v);
+    frames(4);
+    check(all(0, pcm(0.5f), 1) && channels_equal(), "2D with a centre send: the monitor's mix kept");
+    apu_down();
+}
+
+/* A 3D voice: the monitor's mix (no panning by its sends), with the HRTF
+ * filter off, or on with an entry that passes its input (tap 0 both ears) */
+static void test_3d(void)
+{
+    for (int hrtf = 0; hrtf < 2; hrtf++) {
+        apu_up(false, hrtf, 1);
+        pcm_page(0, false, HALF, 0);
+        pio(NV1BA0_PIO_SET_HRTF_SUBMIXES, 0 | 1 << 8 | 2 << 16 | 3 << 24);
+        pio(NV1BA0_PIO_SET_CURRENT_HRTF_ENTRY, 5);
+        pio(NV1BA0_PIO_SET_HRIR, 127 | 127 << 8);   /* taps 0: 127/128, normalized to 1 */
+        Voice v = voice(7, NV1BA0_PIO_SET_ANTECEDENT_VOICE_LIST_3D_TOP, false, 0);
+        v.vol[0] = 0;               /* hrtf_submix 0 (front left), 0 dB */
+        v.vol[1] = 0x300;           /* front right, -12 dB */
+        v.hrtf = 5;
+        start(&v);
+        frames(hrtf ? 40 : 4);
+        check(channels_equal() && (hrtf || all(0, pcm(0.5f), 1)),
+              hrtf ? "3D voice, HRTF on: the monitor's mix kept (both channels alike)"
+                   : "3D voice, HRTF off: the monitor's mix kept (0.5 on both channels)");
+        apu_down();
+    }
+}
+
+/* A multipass group: a source voice into the multipass bin at -6 dB, its
+ * destination from it to both front bins at 0 dB: the destination's mix
+ * of the source, once */
+static void test_multipass(void)
+{
+    apu_up(false, true, 1);
+    pcm_page(0, false, HALF, 0);
+    Voice dst = voice(200, NV1BA0_PIO_SET_ANTECEDENT_VOICE_LIST_MP_TOP, false, 1);
+    dst.fmt_extra = NV_PAVS_VOICE_CFG_FMT_MULTIPASS | MULTIPASS_BIN << 16 | NV_PAVS_VOICE_CFG_FMT_CLEAR_MIX;
+    dst.vol[0] = dst.vol[1] = 0;
+    Voice src = voice(201, NV1BA0_PIO_SET_ANTECEDENT_VOICE_LIST_MP_TOP, false, 0);
+    src.bin[0] = MULTIPASS_BIN;
+    src.vol[0] = 0x180;
+    start(&dst);                /* the list's top is the last started: src, then dst */
+    start(&src);
+    frames(4);
+    check(all(0, pcm(0.5f * attenuation(0x180)), 1) && channels_equal(),
+          "multipass group: the destination's mix of its source, once");
+    apu_down();
+}
+
+/* The full-DSP monitor: the voice's sends into the mix bins, nothing in the
+ * monitor's output */
+static void test_full_dsp(void)
+{
+    apu_up(true, true, 1);
+    pcm_page(0, false, HALF, 0);
+    Voice v = voice(104, NV1BA0_PIO_SET_ANTECEDENT_VOICE_LIST_2D_TOP, false, 0);
+    v.vol[0] = 0;
+    v.vol[1] = 0x300;
+    start(&v);
+    frames(4);
+    bool bins = true;
+    for (int i = 0; i < NUM_SAMPLES_PER_FRAME; i++) {
+        bins &= fabsf(g_mixbins[0][i] - 0.5f) < 1e-4f && fabsf(g_mixbins[1][i] - 0.5f * attenuation(0x300)) < 1e-4f;
+    }
+    check(bins && all(0, 0, 0) && all(1, 0, 0), "full-DSP monitor: mix bins by send, monitor output untouched");
+    apu_down();
+}
+
+/* A 3D voice that played through a delayed HRTF entry, started again on
+ * silence: silence from the first frame (its previous sound's tail is
+ * cleared at VOICE_ON) */
+static void test_voice_reuse_hrtf_history(void)
+{
+    apu_up(false, true, 1);
+    pcm_page(0, false, HALF, 0);
+    pcm_page(1, false, 0, 0);
+    pio(NV1BA0_PIO_SET_HRTF_SUBMIXES, 0 | 1 << 8 | 2 << 16 | 3 << 24);
+    pio(NV1BA0_PIO_SET_CURRENT_HRTF_ENTRY, 9);
+    pio(NV1BA0_PIO_SET_HRIR_X, 127 | 127 << 8);     /* tap 30 both ears: a 30-sample delay */
+    Voice v = voice(8, NV1BA0_PIO_SET_ANTECEDENT_VOICE_LIST_3D_TOP, false, 0);
+    v.vol[0] = v.vol[1] = 0;
+    v.hrtf = 9;
+    start(&v);
+    frames(60);
+    const bool sounding = g_out[NUM_SAMPLES_PER_FRAME - 1][0] > 1000;
+    d->regs[NV_PAPU_TVL3D] = 0xFFFF;                /* the list again empty: started anew */
+    v.page = 1;                                     /* on silence */
+    start(&v);
+    frames(1);
+    check(sounding && all(0, 0, 0) && all(1, 0, 0), "reused 3D voice: its new sound starts from silence");
+    apu_down();
+}
+
+/* Twelve voices (eligible, a centre send, 3D): one worker and four give the
+ * same output, to the rounding of the sums' order */
+static void twelve_voices(unsigned workers, int16_t out[NUM_SAMPLES_PER_FRAME][2])
+{
+    apu_up(false, true, workers);
+    for (uint32_t p = 0; p < 12; p++) {
+        pcm_page(p, p % 3 == 1, (int16_t)(1000 + 700 * p), (int16_t)(-300 * p));
+    }
+    pio(NV1BA0_PIO_SET_HRTF_SUBMIXES, 0 | 1 << 8 | 2 << 16 | 3 << 24);
+    for (uint16_t k = 0; k < 12; k++) {
+        const bool three_d = k % 4 == 3;
+        Voice v = voice(three_d ? k : 100 + k,
+                        three_d ? NV1BA0_PIO_SET_ANTECEDENT_VOICE_LIST_3D_TOP : NV1BA0_PIO_SET_ANTECEDENT_VOICE_LIST_2D_TOP,
+                        k % 3 == 1, k);
+        v.vol[0] = (uint16_t)(0x40 * k);
+        v.vol[1] = (uint16_t)(0x300 - 0x30 * k);
+        if (k % 5 == 2) {
+            v.vol[2] = 0x100;   /* a centre send: the monitor's mix */
+        }
+        start(&v);
+    }
+    frames(4);
+    memcpy(out, g_out, sizeof(g_out));
+    apu_down();
+}
+
+static void test_workers(void)
+{
+    int16_t one[NUM_SAMPLES_PER_FRAME][2], four[NUM_SAMPLES_PER_FRAME][2];
+    twelve_voices(1, one);
+    twelve_voices(4, four);
+    int worst = 0;
+    bool sound = false;
+    for (int i = 0; i < NUM_SAMPLES_PER_FRAME; i++) {
+        for (int ch = 0; ch < 2; ch++) {
+            worst = MAX(worst, abs(one[i][ch] - four[i][ch]));
+            sound |= one[i][ch] != 0;
+        }
+    }
+    printf("  workers: largest difference %d (of 12 voices)\n", worst);
+    check(sound && worst <= 12, "one worker and four: the same output (within a step a voice)");
+}
+
+/* `apu-stereo-smoke bench`: a fixed workload's throughput (not a test, and
+ * not a Nova figure): 64 ordinary 2D voices, 32 with a centre send, 32 3D,
+ * one worker, 3000 frames */
+static int bench(void)
+{
+    apu_up(false, true, 1);
+    for (uint32_t p = 0; p < PCM_PAGES; p++) {
+        pcm_page(p, p % 2, (int16_t)(500 + 97 * p), (int16_t)(-200 - 31 * p));
+    }
+    pio(NV1BA0_PIO_SET_HRTF_SUBMIXES, 0 | 1 << 8 | 2 << 16 | 3 << 24);
+    for (uint16_t k = 0; k < 128; k++) {
+        const bool three_d = k >= 96;
+        Voice v = voice(three_d ? k - 96 : 64 + k,
+                        three_d ? NV1BA0_PIO_SET_ANTECEDENT_VOICE_LIST_3D_TOP : NV1BA0_PIO_SET_ANTECEDENT_VOICE_LIST_2D_TOP,
+                        k % 2, k % PCM_PAGES);
+        v.vol[0] = (uint16_t)(0x100 + 3 * k);
+        v.vol[1] = (uint16_t)(0x200 - k);
+        if (k >= 64 && k < 96) {
+            v.vol[2] = 0x180;
+        }
+        start(&v);
+    }
+    frames(100);
+    struct timespec t0, t1;
+    clock_gettime(CLOCK_MONOTONIC, &t0);
+    frames(3000);
+    clock_gettime(CLOCK_MONOTONIC, &t1);
+    const double s = (t1.tv_sec - t0.tv_sec) + (t1.tv_nsec - t0.tv_nsec) / 1e9;
+    printf("bench: 128 voices, 3000 frames in %.3f s: %.0f frames/s (%.1fx real time), %.2f us a frame\n", s,
+           3000 / s, 3000 / s / 1500.0, s / 3000 * 1e6);
+    apu_down();
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    alarm(30);
+    g_ram = calloc(1, RAM_SIZE);
+    if (argc > 1 && !strcmp(argv[1], "bench")) {
+        return bench();
+    }
+    test_2d_mono_panned();
+    test_2d_stereo();
+    test_2d_headroom();
+    test_2d_centre_unsupported();
+    test_3d();
+    test_multipass();
+    test_full_dsp();
+    test_voice_reuse_hrtf_history();
+    test_workers();
+    free(g_ram);
+    return failures ? 1 : 0;
+}
diff --git a/tests/native/linux/contig_run.c b/tests/native/linux/contig_run.c
new file mode 100644
index 0000000000000000000000000000000000000000..6b93d8e37477abcbe1f968cca311eacb5e89f23c
--- /dev/null
+++ b/tests/native/linux/contig_run.c
@@ -0,0 +1,77 @@
+/* Copyright (C) 2026-present PortareOS */
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Tests for contiguous runs, ownership boundaries, and scratch limits. */
+#include "native/kernel/contig_run.h"
+
+#include <stdbool.h>
+#include <stdio.h>
+#include <time.h>
+
+static int g_fail;
+static uint64_t g_scratch[4096];
+
+static void check(bool ok, const char *what)
+{
+    printf("%s %s\n", ok ? "PASS" : "FAIL", what);
+    g_fail += !ok;
+}
+
+static uint32_t run(const NcContigRun *b, unsigned n, uint32_t pa, uint32_t limit)
+{
+    return nc_contig_run_end(b, n, pa, limit, g_scratch, 4096);
+}
+
+int main(void)
+{
+    /* Adjacent blocks from the same caller, in arbitrary order. */
+    const NcContigRun same[] = {
+        {0x01200000, 0x100000, 0, 0xcab47}, {0x01000000, 0x100000, 0, 0xcab47},
+        {0x01100000, 0x100000, 0, 0xcab47}, {0x03000000, 0x1000, 0, 0x1234},
+    };
+    check(run(same, 4, 0x01000000, 0x0112c000) == 0x01200000, "the same caller's next block carries a target on");
+    check(run(same, 4, 0x01000000, 0x01258000) == 0x01300000, "through several blocks, to the target's end");
+    check(run(same, 4, 0x01000000, 0x01080000) == 0x01100000, "a target inside its block: the block's end");
+    check(run(same, 4, 0x01000000, 0) == 0x01100000, "no limit: the block's end");
+    check(run(same, 4, 0x02000000, 0x02100000) == 0, "no block holds the address: 0");
+
+    /* Adjacent allocations from different callers must remain separate. */
+    const NcContigRun other[] = {{0x03c00000, 0x96000, 0, 0x100}, {0x03c96000, 0x96000, 0, 0x200}};
+    check(run(other, 2, 0x03c00000, 0x03d2c000) == 0x03c96000, "another caller's adjacent block ends the run");
+
+    /* Distinguish unallocated gaps from reserved alignment slack. */
+    const NcContigRun gap[] = {{0x01000000, 0x100000, 0, 7}, {0x01101000, 0x100000, 0, 7}};
+    check(run(gap, 2, 0x01000000, 0x01180000) == 0x01100000, "a page between the blocks ends the run");
+    const NcContigRun slack[] = {{0x01000000, 0xff000, 0x1000, 7}, {0x01100000, 0x100000, 0, 7}};
+    check(run(slack, 2, 0x01000000, 0x01180000) == 0x01200000, "a block after the last one's slack carries it on");
+
+    /* Time 300 adjacent blocks in a reverse-ordered table of 5,000. */
+    static NcContigRun many[5000];
+    for (unsigned i = 0; i < 5000; i++) {
+        many[i] = (NcContigRun){0x01000000 + (4999 - i) * 0x1000u, 0x1000, 0, 9};
+    }
+    struct timespec t0, t1;
+    clock_gettime(CLOCK_MONOTONIC, &t0);
+    bool ok = true;
+    for (unsigned r = 0; r < 1000; r++) {
+        ok &= run(many, 5000, 0x01000000, 0x0112c000) == 0x0112c000;
+    }
+    clock_gettime(CLOCK_MONOTONIC, &t1);
+    const double ms = (t1.tv_sec - t0.tv_sec) * 1e3 + (t1.tv_nsec - t0.tv_nsec) / 1e6;
+    printf("5,000 blocks, a 300-block run: %.1f us a call\n", ms);
+    check(ok, "a run over 300 of 5,000 4 KiB blocks");
+    check(ms < 2000, "... in under 2 ms a call");
+    /* An undersized scratch buffer must not drop blocks or skip gaps. */
+    static NcContigRun lots[6000];
+    for (unsigned i = 0; i < 6000; i++) {
+        lots[i] = (NcContigRun){0x01000000 + (5999 - i) * 0x1000u, 0x1000, 0, 9};
+    }
+    check(nc_contig_run_end(lots, 6000, 0x01000000, 0x01000000 + 6000 * 0x1000u, g_scratch, 4096) ==
+          0x01000000 + 6000 * 0x1000u, "6,000 candidates through 4,096 entries: every block");
+    check(nc_contig_run_end(lots, 20, 0x01000000 + 5980 * 0x1000u, 0x03000000, g_scratch, 8) ==
+          0x01000000 + 6000 * 0x1000u, "20 through 8 entries: every block");
+    lots[3000].pa = 0x01800000;             /* leave a gap */
+    check(nc_contig_run_end(lots, 6000, 0x01000000, 0x01000000 + 6000 * 0x1000u, g_scratch, 4096) ==
+          0x01000000 + 2999 * 0x1000u, "... and a gap still ends the run");
+    printf("%s\n", g_fail ? "FAILED" : "all passed");
+    return g_fail != 0;
+}
diff --git a/tests/native/linux/wback.c b/tests/native/linux/wback.c
new file mode 100644
index 0000000000000000000000000000000000000000..887a7f97452a3135012632f5ed907f696ad4be14
--- /dev/null
+++ b/tests/native/linux/wback.c
@@ -0,0 +1,388 @@
+/*
+ * Copyright (C) 2026 Press5elect
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * Additional terms (GPL-3.0 section 7(b)): keep the attribution "OGBox by
+ * Press5elect" (github.com/Press5elect/OGBox, NOTICE).
+ */
+/*
+ * Tests for the cache drives' write-back (native/kernel/wback.c), on the host's file system with
+ * a slow writer (nc_wb_test_delay_us): what a game reads, sizes and finds after a quit.
+ *   cc -DNC_WB_TEST -std=gnu11 -O1 -pthread -I. tests/native/linux/wback.c native/kernel/wback.c
+ */
+#include "native/kernel/wback.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+
+extern unsigned nc_wb_test_delay_us;
+static int g_fail, g_quiet;
+
+void nc_log(const char *tag, const char *fmt, ...)
+{
+    if (g_quiet) {
+        return;
+    }
+    va_list ap;
+    va_start(ap, fmt);
+    printf("  [%s] ", tag);
+    vprintf(fmt, ap);
+    printf("\n");
+    va_end(ap);
+}
+
+static void check(bool ok, const char *what)
+{
+    printf("%s %s\n", ok ? "PASS" : "FAIL", what);
+    g_fail += !ok;
+}
+
+static char g_dir[256];
+
+static void path_of(char *out, size_t n, const char *name)
+{
+    snprintf(out, n, "%s/%s", g_dir, name);
+}
+
+static uint64_t ino_of(int fd)
+{
+    struct stat st;
+    fstat(fd, &st);
+    return (uint64_t)st.st_ino;
+}
+
+static uint64_t disk_size(int fd)
+{
+    struct stat st;
+    fstat(fd, &st);
+    return (uint64_t)st.st_size;
+}
+
+static uint32_t rnd(void)
+{
+    static uint64_t x = 0x9E3779B97F4A7C15ull;
+    x ^= x << 13;
+    x ^= x >> 7;
+    x ^= x << 17;
+    return (uint32_t)x;
+}
+
+/* 1. a file written 4 KiB at a time with a reference copy: reads and sizes while it is held,
+ * random rewrites over it, the host file at the end */
+static void t_reads(void)
+{
+    char p[300];
+    path_of(p, sizeof(p), "copy.bin");
+    const int fd = open(p, O_RDWR | O_CREAT | O_TRUNC, 0644);
+    const uint64_t ino = ino_of(fd);
+    const uint32_t total = 6u << 20;
+    uint8_t *model = calloc(1, total + 65536), *buf = malloc(1 << 20);
+    uint32_t end = 0;
+    bool reads_ok = true, sizes_ok = true, held_seen = false;
+    for (uint32_t off = 0; off < total; off += 4096) {
+        uint8_t chunk[4096];
+        for (int i = 0; i < 4096; i++) {
+            chunk[i] = (uint8_t)rnd();
+        }
+        memcpy(model + off, chunk, 4096);
+        if (!nc_wb_write(fd, ino, p, off, chunk, 4096)) {
+            reads_ok = false;
+        }
+        end = off + 4096;
+        sizes_ok &= nc_wb_size(ino, disk_size(fd)) == end;
+        held_seen |= nc_wb_holds(ino) && disk_size(fd) < end;
+        if ((off >> 12) % 16 == 0) {    /* a read of what is there so far, anywhere */
+            const uint32_t a = rnd() % end, n = 1 + rnd() % (end - a < 300000 ? end - a : 300000);
+            reads_ok &= nc_wb_read(fd, ino, a, buf, n) && !memcmp(buf, model + a, n);
+        }
+        if ((off >> 12) % 64 == 7) {    /* a rewrite somewhere before (an index updated) */
+            const uint32_t a = rnd() % end, n = 1 + rnd() % (end - a < 9000 ? end - a : 9000);
+            uint8_t w[9000];
+            for (uint32_t i = 0; i < n; i++) {
+                w[i] = (uint8_t)rnd();
+            }
+            memcpy(model + a, w, n);
+            reads_ok &= nc_wb_write(fd, ino, p, a, w, n);
+        }
+    }
+    check(held_seen, "reads: bytes held while the slow writer is behind");
+    check(sizes_ok, "reads: the size counts the held bytes");
+    check(reads_ok, "reads: every read while held is the reference's bytes");
+    nc_wb_drain_all();
+    uint8_t *disk = malloc(total);
+    const bool all = pread(fd, disk, total, 0) == (ssize_t)total && disk_size(fd) == total;
+    check(all && !memcmp(disk, model, total), "reads: the host file once written is the reference");
+    check(!nc_wb_holds(ino) && nc_wb_size(ino, 123) == 123, "reads: nothing held after");
+    free(disk);
+    free(model);
+    free(buf);
+    close(fd);
+}
+
+/* 2. a write past the end (a gap reads as zeros), cut back, grown */
+static void t_truncate(void)
+{
+    char p[300];
+    path_of(p, sizeof(p), "cut.bin");
+    const int fd = open(p, O_RDWR | O_CREAT | O_TRUNC, 0644);
+    const uint64_t ino = ino_of(fd);
+    uint8_t a[100000], b[100000];
+    memset(a, 0xAA, sizeof(a));
+    nc_wb_write(fd, ino, p, 0, a, 50000);
+    nc_wb_write(fd, ino, p, 80000, a, 20000);     /* a gap 50000..80000 */
+    uint8_t r[100000];
+    bool ok = nc_wb_size(ino, disk_size(fd)) == 100000 && nc_wb_read(fd, ino, 0, r, 100000);
+    memset(b, 0xAA, sizeof(b));
+    memset(b + 50000, 0, 30000);
+    check(ok && !memcmp(r, b, 100000), "truncate: a gap past the end reads as zeros");
+    nc_wb_truncate(ino, 60000);
+    ok = ftruncate(fd, 60000) == 0;
+    check(ok && nc_wb_size(ino, disk_size(fd)) == 60000, "truncate: the size is the cut");
+    ok = nc_wb_read(fd, ino, 0, r, 60000) && !memcmp(r, b, 60000);
+    check(ok, "truncate: what is left reads as before");
+    ok = ftruncate(fd, 70000) == 0;   /* grown again: zeros past the cut */
+    memset(b + 60000, 0, 10000);
+    ok = ok && nc_wb_size(ino, disk_size(fd)) == 70000 && nc_wb_read(fd, ino, 0, r, 70000) && !memcmp(r, b, 70000);
+    check(ok, "truncate: grown again, zeros past the cut");
+    nc_wb_drain_all();
+    ok = disk_size(fd) == 70000 && pread(fd, r, 70000, 0) == 70000 && !memcmp(r, b, 70000);
+    check(ok, "truncate: the host file once written");
+    close(fd);
+}
+
+/* 3. two files written at once, each with its reference */
+static void t_two(void)
+{
+    char p1[300], p2[300];
+    path_of(p1, sizeof(p1), "one.bin");
+    path_of(p2, sizeof(p2), "two.bin");
+    const int f1 = open(p1, O_RDWR | O_CREAT | O_TRUNC, 0644), f2 = open(p2, O_RDWR | O_CREAT | O_TRUNC, 0644);
+    const uint64_t i1 = ino_of(f1), i2 = ino_of(f2);
+    const uint32_t n = 2u << 20;
+    uint8_t *m1 = malloc(n), *m2 = malloc(n), *r = malloc(n);
+    bool ok = true;
+    for (uint32_t off = 0; off < n; off += 4096) {
+        for (int i = 0; i < 4096; i++) {
+            m1[off + i] = (uint8_t)rnd();
+            m2[off + i] = (uint8_t)rnd();
+        }
+        ok &= nc_wb_write(f1, i1, p1, off, m1 + off, 4096) && nc_wb_write(f2, i2, p2, off, m2 + off, 4096);
+    }
+    ok &= nc_wb_read(f1, i1, 0, r, n) && !memcmp(r, m1, n) && nc_wb_read(f2, i2, 0, r, n) && !memcmp(r, m2, n);
+    check(ok, "two files: interleaved writes read back each its own");
+    nc_wb_drain(i2);    /* the second first */
+    check(!nc_wb_holds(i2), "two files: a drain writes the file asked for");
+    nc_wb_drain_all();
+    ok = pread(f1, r, n, 0) == (ssize_t)n && !memcmp(r, m1, n) && pread(f2, r, n, 0) == (ssize_t)n && !memcmp(r, m2, n);
+    check(ok, "two files: the host files once written");
+    free(m1);
+    free(m2);
+    free(r);
+    close(f1);
+    close(f2);
+}
+
+/* 4. times set while held: kept after the bytes land */
+static void t_times(void)
+{
+    char p[300];
+    path_of(p, sizeof(p), "times.bin");
+    const int fd = open(p, O_RDWR | O_CREAT | O_TRUNC, 0644);
+    const uint64_t ino = ino_of(fd);
+    uint8_t d[65536] = {1};
+    for (int i = 0; i < 16; i++) {
+        nc_wb_write(fd, ino, p, (uint64_t)i * sizeof(d), d, sizeof(d));
+    }
+    struct timeval tv[2] = {{1000000000, 0}, {1100000000, 0}};
+    futimes(fd, tv);
+    nc_wb_times(ino, tv);
+    nc_wb_drain_all();
+    struct stat st;
+    fstat(fd, &st);
+    check(st.st_mtime == 1100000000, "times: a time set while held stands once the bytes land");
+    close(fd);
+}
+
+/* 5. a file deleted while held: its bytes dropped, nothing breaks */
+static void t_deleted(void)
+{
+    char p[300];
+    path_of(p, sizeof(p), "gone.bin");
+    const int fd = open(p, O_RDWR | O_CREAT | O_TRUNC, 0644);
+    const uint64_t ino = ino_of(fd);
+    uint8_t d[65536] = {2};
+    for (int i = 0; i < 32; i++) {
+        nc_wb_write(fd, ino, p, (uint64_t)i * sizeof(d), d, sizeof(d));
+    }
+    nc_wb_deleted(ino);
+    unlink(p);
+    check(!nc_wb_holds(ino), "deleted: nothing held for it");
+    nc_wb_drain_all();
+    check(access(p, F_OK) != 0, "deleted: the file stays gone");
+    close(fd);
+}
+
+/* 5b. a cache drive formatted while its files are held: their bytes dropped, the folder empty */
+static void t_format(void)
+{
+    char d[300], f1[400], f2[400];
+    path_of(d, sizeof(d), "fmt");
+    mkdir(d, 0755);
+    snprintf(f1, sizeof(f1), "%s/a.bin", d);
+    snprintf(f2, sizeof(f2), "%s/b.bin", d);
+    const int a = open(f1, O_RDWR | O_CREAT | O_TRUNC, 0644), b = open(f2, O_RDWR | O_CREAT | O_TRUNC, 0644);
+    uint8_t x[65536] = {5};
+    for (int i = 0; i < 16; i++) {
+        nc_wb_write(a, ino_of(a), f1, (uint64_t)i * sizeof(x), x, sizeof(x));
+        nc_wb_write(b, ino_of(b), f2, (uint64_t)i * sizeof(x), x, sizeof(x));
+    }
+    nc_wb_deleted_under(d);
+    unlink(f1);
+    unlink(f2);
+    check(!nc_wb_holds(ino_of(a)) && !nc_wb_holds(ino_of(b)), "format: nothing held for the folder's files");
+    nc_wb_drain_all();
+    check(access(f1, F_OK) != 0 && access(f2, F_OK) != 0, "format: the folder stays empty");
+    close(a);
+    close(b);
+}
+
+/* 6. a cap of 1 MiB: writes past it wait, all land */
+static void t_cap(void)
+{
+    char p[300];
+    path_of(p, sizeof(p), "cap.bin");
+    const int fd = open(p, O_RDWR | O_CREAT | O_TRUNC, 0644);
+    const uint64_t ino = ino_of(fd);
+    uint8_t *m = malloc(8u << 20);
+    for (uint32_t i = 0; i < (8u << 20); i++) {
+        m[i] = (uint8_t)(i * 7 + 3);
+    }
+    bool ok = true;
+    for (uint32_t off = 0; off < (8u << 20); off += 65536) {
+        ok &= nc_wb_write(fd, ino, p, off, m + off, 65536);
+    }
+    NcWbStats st;
+    nc_wb_stats(&st);
+    nc_wb_drain_all();
+    uint8_t *r = malloc(8u << 20);
+    ok &= pread(fd, r, 8u << 20, 0) == (ssize_t)(8u << 20) && !memcmp(r, m, 8u << 20);
+    check(ok && st.held_max <= (1u << 20) + 65536, "cap: at most the cap held, every byte lands");
+    free(m);
+    free(r);
+    close(fd);
+}
+
+/* 7. a run that quits with bytes held (a child that exits), then the next start: the files left
+ * part-written are deleted, the ones written whole stay; a rename while held is followed */
+static void t_quit(void)
+{
+    char j[300], done[300], part[300], tmp[300], fin[300], dir1[300], dir2[300], deep[400];
+    path_of(j, sizeof(j), "journal");
+    path_of(done, sizeof(done), "done.bin");
+    path_of(part, sizeof(part), "part.bin");
+    path_of(tmp, sizeof(tmp), "X.tmp");
+    path_of(fin, sizeof(fin), "X");
+    path_of(dir1, sizeof(dir1), "d1");
+    path_of(dir2, sizeof(dir2), "d2");
+    snprintf(deep, sizeof(deep), "%s/inner.bin", dir1);
+    mkdir(dir1, 0755);
+    const pid_t pid = fork();
+    if (!pid) {
+        g_quiet = 1;
+        nc_wb_start(j, 64u << 20);
+        nc_wb_test_delay_us = 0;
+        uint8_t d[65536];
+        memset(d, 3, sizeof(d));
+        int fd = open(done, O_RDWR | O_CREAT | O_TRUNC, 0644);
+        for (int i = 0; i < 8; i++) {
+            nc_wb_write(fd, ino_of(fd), done, (uint64_t)i * sizeof(d), d, sizeof(d));
+        }
+        nc_wb_drain_all();
+        nc_wb_test_delay_us = 200000;   /* slow now: the rest stays held */
+        fd = open(part, O_RDWR | O_CREAT | O_TRUNC, 0644);
+        for (int i = 0; i < 256; i++) {     /* 16 MiB: 3 s at 0.2 s a MiB, past the quit */
+            nc_wb_write(fd, ino_of(fd), part, (uint64_t)i * sizeof(d), d, sizeof(d));
+        }
+        fd = open(tmp, O_RDWR | O_CREAT | O_TRUNC, 0644);
+        for (int i = 0; i < 64; i++) {
+            nc_wb_write(fd, ino_of(fd), tmp, (uint64_t)i * sizeof(d), d, sizeof(d));
+        }
+        usleep(500000);                 /* some of it out, its "B" too */
+        rename(tmp, fin);               /* Riddick's X.tmp to X, while held */
+        nc_wb_renamed(tmp, fin);
+        fd = open(deep, O_RDWR | O_CREAT | O_TRUNC, 0644);
+        for (int i = 0; i < 64; i++) {
+            nc_wb_write(fd, ino_of(fd), deep, (uint64_t)i * sizeof(d), d, sizeof(d));
+        }
+        usleep(1500000);
+        rename(dir1, dir2);             /* its folder renamed while held */
+        nc_wb_renamed(dir1, dir2);
+        _exit(0);                       /* quit with bytes held */
+    }
+    int status;
+    waitpid(pid, &status, 0);
+    char deep2[400];
+    snprintf(deep2, sizeof(deep2), "%s/inner.bin", dir2);
+    check(access(part, F_OK) == 0 && access(fin, F_OK) == 0 && access(deep2, F_OK) == 0,
+          "quit: the part-written files are there after the quit");
+    const pid_t pid2 = fork();
+    if (!pid2) {
+        nc_wb_start(j, 64u << 20);      /* the next start */
+        _exit(0);
+    }
+    waitpid(pid2, &status, 0);
+    struct stat st;
+    check(stat(done, &st) == 0 && st.st_size == 8 * 65536, "quit: a file written whole stays");
+    check(access(part, F_OK) != 0, "quit: a file left part-written is deleted at the next start");
+    check(access(fin, F_OK) != 0 && access(tmp, F_OK) != 0, "quit: a part-written file renamed while held is deleted");
+    check(access(deep2, F_OK) != 0, "quit: one in a folder renamed while held is deleted");
+}
+
+int main(void)
+{
+    snprintf(g_dir, sizeof(g_dir), "/tmp/wbtest.XXXXXX");
+    if (!mkdtemp(g_dir)) {
+        return 2;
+    }
+    t_quit();   /* (forks first: a child has no write-back thread of its parent's) */
+    char p2[300];
+    path_of(p2, sizeof(p2), "journal-cap");
+    /* (the cap: in a child, with a cap of its own) */
+    const pid_t pid = fork();
+    if (!pid) {
+        g_quiet = 1;
+        nc_wb_start(p2, 1u << 20);
+        nc_wb_test_delay_us = 1000;
+        t_cap();
+        fflush(stdout);
+        _exit(g_fail);
+    }
+    int status;
+    waitpid(pid, &status, 0);
+    g_fail += WEXITSTATUS(status);
+
+    char j[300];
+    path_of(j, sizeof(j), "journal-main");
+    nc_wb_start(j, 64u << 20);
+    nc_wb_test_delay_us = 2000;         /* 2 ms a write: the writer behind */
+    t_reads();
+    t_truncate();
+    t_two();
+    t_times();
+    t_deleted();
+    t_format();
+    nc_wb_drain_all();
+    NcWbStats st;
+    nc_wb_stats(&st);
+    printf("written %.1f MiB in %llu writes, held at most %.1f MiB, %llu drains\n", st.written / 1048576.0,
+           (unsigned long long)st.writes, st.held_max / 1048576.0, (unsigned long long)st.drains);
+    printf("%s (%d failed)\n", g_fail ? "FAIL" : "ALL PASS", g_fail);
+    return g_fail != 0;
+}
diff --git a/tests/native/ob/ob_test.c b/tests/native/ob/ob_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..f7fa8f543fe119b60459e851c7c3df25a10cbad5
--- /dev/null
+++ b/tests/native/ob/ob_test.c
@@ -0,0 +1,158 @@
+/*
+ * Host test of native/kernel/ob.c's named objects: what XAPI's CreateEvent
+ * (NtCreateEvent with a name relative to ObWin32NamedObjectsDirectory, -4,
+ * and OBJ_OPENIF) and OpenEvent (ObOpenObjectByName) do with them.
+ *
+ *   gcc -O1 -I<repo> tests/native/ob/ob_test.c native/kernel/ob.c -o ob_test && ./ob_test
+ */
+#include "native/kernel/kernel.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/mman.h>
+
+static int g_fail;
+static NcKernel g_k;
+static NcVm g_vm;
+static NcKFn g_open, g_close;
+static uint32_t g_pool = 0x80100000u;
+
+/* What ob.c needs of the rest of the kernel. */
+void nc_log(const char *tag, const char *fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt);
+    printf("%s: ", tag);
+    vprintf(fmt, ap);
+    printf("\n");
+    va_end(ap);
+}
+
+void nc_kernel_impl(NcKernel *k, const char *name, NcKFn fn)
+{
+    if (!strcmp(name, "ObOpenObjectByName")) {
+        g_open = fn;
+    } else if (!strcmp(name, "NtClose")) {
+        g_close = fn;
+    }
+}
+
+uint32_t nc_pool_alloc(NcKernel *k, uint32_t size)
+{
+    const uint32_t va = g_pool;
+    g_pool += (size + 15) & ~15u;
+    return va;
+}
+
+void nc_pool_free(NcKernel *k, uint32_t va, uint32_t size)
+{
+}
+
+void nc_io_close(NcKernel *k, uint32_t object)
+{
+}
+
+uint32_t nc_io_open_by_name(NcKernel *k, uint32_t oa, uint32_t type_va, uint32_t handle_out)
+{
+    return 0xC0000034u;   /* (io.c's directories and devices: none here) */
+}
+
+static void check(bool ok, const char *what)
+{
+    g_fail += !ok;
+    printf("%s %s\n", ok ? "PASS" : "FAIL", what);
+}
+
+#define EVENT_TYPE 0x80012400u
+#define SEM_TYPE   0x80012780u
+#define DATA       0x00011000u
+
+/* An OBJECT_ATTRIBUTES { RootDirectory, ObjectName, Attributes } at oa with
+ * its OBJECT_STRING and characters after it. */
+static uint32_t attributes(uint32_t oa, uint32_t root, const char *name, uint32_t flags)
+{
+    const uint32_t str = oa + 12, chars = oa + 20;
+    nc_vm_wr32(&g_vm, oa, root);
+    nc_vm_wr32(&g_vm, oa + 4, str);
+    nc_vm_wr32(&g_vm, oa + 8, flags);
+    nc_vm_wr32(&g_vm, str, (uint32_t)strlen(name) * 0x10001u);
+    nc_vm_wr32(&g_vm, str + 4, chars);
+    memcpy(nc_vm_host(&g_vm, chars), name, strlen(name));
+    return oa;
+}
+
+static uint32_t open_by_name(uint32_t oa, uint32_t type, uint32_t *handle)
+{
+    const uint32_t out = DATA + 0xF00;
+    const uint32_t args[4] = { oa, type, 0, out };
+    const uint32_t status = (uint32_t)g_open(&g_k, NULL, args);
+    *handle = nc_vm_rd32(&g_vm, out);
+    return status;
+}
+
+static void close_handle(uint32_t handle)
+{
+    const uint32_t args[1] = { handle };
+    g_close(&g_k, NULL, args);
+}
+
+int main(void)
+{
+    /* the guest's address space: its data page and the pool, the rest unmapped */
+    uint8_t *space = mmap(NULL, 1ull << 32, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+    if (space == MAP_FAILED || mprotect(space + DATA, 0x1000, PROT_READ | PROT_WRITE) ||
+        mprotect(space + g_pool, 0x10000, PROT_READ | PROT_WRITE)) {
+        printf("FAIL guest address space\n");
+        return 1;
+    }
+    g_vm.base = space;
+    g_k.vm = &g_vm;
+    g_k.type_va[NC_OB_EVENT] = EVENT_TYPE;
+    g_k.type_va[NC_OB_SEMAPHORE] = SEM_TYPE;
+    nc_ob_register(&g_k);
+    check(g_open && g_close, "ObOpenObjectByName and NtClose registered");
+
+    const uint32_t create = attributes(DATA + 0x000, 0xFFFFFFFCu, "TestEvent", 0x80);   /* OBJ_OPENIF */
+    const uint32_t again = attributes(DATA + 0x100, 0xFFFFFFFCu, "TestEvent", 0);
+    const uint32_t other = attributes(DATA + 0x200, 0xFFFFFFFCu, "tESTeVENT", 0);
+    const uint32_t missing = attributes(DATA + 0x300, 0xFFFFFFFCu, "Missing", 0);
+    const uint32_t absolute = attributes(DATA + 0x400, 0, "\\BaseNamedObjects\\TestEvent", 0);
+    const uint32_t nameless = attributes(DATA + 0x500, 0xFFFFFFFCu, "", 0);
+
+    uint32_t status, h;
+    bool fresh;
+    const uint32_t ev = nc_ob_create_named(&g_k, NC_OB_EVENT, 0x10, create, &status, &fresh);
+    check(ev && status == NC_STATUS_SUCCESS && fresh, "a named event is created");
+    const uint32_t h1 = nc_ob_handle(&g_k, ev, NC_OB_EVENT);
+
+    const uint32_t ev2 = nc_ob_create_named(&g_k, NC_OB_EVENT, 0x10, create, &status, &fresh);
+    check(ev2 == ev && status == 0x40000000u && !fresh, "OBJ_OPENIF opens it: STATUS_OBJECT_NAME_EXISTS");
+    const uint32_t h2 = nc_ob_handle(&g_k, ev2, NC_OB_EVENT);
+    check(!nc_ob_create_named(&g_k, NC_OB_EVENT, 0x10, again, &status, &fresh) && status == 0xC0000035u,
+          "without OBJ_OPENIF: STATUS_OBJECT_NAME_COLLISION");
+    check(!nc_ob_create_named(&g_k, NC_OB_SEMAPHORE, 0x14, create, &status, &fresh) && status == 0xC0000024u,
+          "a semaphore of that name: STATUS_OBJECT_TYPE_MISMATCH");
+
+    check(open_by_name(other, EVENT_TYPE, &h) == NC_STATUS_SUCCESS && nc_ob_lookup(&g_k, h, NULL) == ev,
+          "ObOpenObjectByName finds it without case");
+    close_handle(h);
+    check(open_by_name(absolute, 0, &h) == NC_STATUS_SUCCESS && nc_ob_lookup(&g_k, h, NULL) == ev,
+          "... by its \\BaseNamedObjects name, of any type");
+    close_handle(h);
+    check(open_by_name(other, SEM_TYPE, &h) == 0xC0000024u && !h, "... not as a semaphore");
+    check(open_by_name(missing, EVENT_TYPE, &h) == 0xC0000034u && !h, "a name nobody made: not found");
+    check(open_by_name(nameless, EVENT_TYPE, &h) == 0xC0000033u, "no name: invalid");
+
+    const uint32_t plain = nc_ob_create_named(&g_k, NC_OB_EVENT, 0x10, 0, &status, &fresh);
+    check(plain && plain != ev && status == NC_STATUS_SUCCESS && fresh, "no ObjectAttributes: an unnamed event");
+
+    close_handle(h1);
+    check(open_by_name(other, EVENT_TYPE, &h) == NC_STATUS_SUCCESS, "the name stays while a handle is open");
+    close_handle(h);
+    close_handle(h2);
+    check(open_by_name(other, EVENT_TYPE, &h) == 0xC0000034u, "the last handle closed: the name is gone");
+
+    printf("%s\n", g_fail ? "FAILED" : "all passed");
+    return g_fail != 0;
+}
diff --git a/tests/native/xc/xc_test.c b/tests/native/xc/xc_test.c
index e395c08bf234029c93399a9a8f9bb1594bb8f37a..db5b14e0f08c0fb90d7507bb463dc2b60ddce95f 100644
--- a/tests/native/xc/xc_test.c
+++ b/tests/native/xc/xc_test.c
@@ -2,6 +2,9 @@
  * Host test of native/kernel/xc_crypto.c against published vectors:
  * FIPS 180-1 (SHA-1), RFC 2202 (HMAC-SHA1), FIPS 46 worked example (DES),
  * the classic RC4 vector, and modexp against a 128-bit reference.
+ * Also checks that a signature from nc_xc_sign verifies with the synthetic
+ * XePublicKeyData, and that a private-key blob (a 512-bit RSA key openssl
+ * made) undoes its public key.
  *
  *   gcc -O1 -I<repo> tests/native/xc/xc_test.c native/kernel/xc_crypto.c -o xc_test && ./xc_test
