+/* An overwritten file still empty (nothing written since): its side file renamed back over it
+ * and the handle's descriptor pointed at it, the side file used up. False: nothing changed. */
+static bool regrow_by_rename(NcFile *nf)
+{
+    struct stat st;
+    if (fstat(nf->fd, &st) != 0 || st.st_size != 0) {
+        return false;
+    }
+    if (rename(nf->old_path, nf->host) != 0) {
+        return false;
