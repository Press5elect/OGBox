+/* ps5-native (OGBox 0.1.31): a device access that took long, logged with its device, register
+ * and time (the first 32, then one a second). Def Jam's interrupts reached it a quarter second
+ * late with "no kernel entry meanwhile": the emulated CPU stopped inside one guest instruction,
+ * which only a device access (a fault into its handler, the device's lock) can take that long. */
+static uint64_t slow_clock_ns(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+
+static void slow_note(const NcMmioDev *dev, uint32_t addr, bool store, uint64_t t0)
+{
+    const uint64_t took = slow_clock_ns() - t0;
+    if (took < 5000000ull) {
+        return;
+    }
+    static unsigned logged;
+    static uint64_t last_ns;
+    const uint64_t now = t0 + took;
+    if (logged < 32 || now - last_ns > 1000000000ull) {
+        logged++;
+        last_ns = now;
+        nc_log("hakuX-native-mmio", "slow device access: %s %s +%x took %.1f ms", dev->name ? dev->name : "?",
+               store ? "write" : "read", addr - dev->base, took / 1e6);
+    }
+}
+
+static bool mem_rw(void *opaque, uint32_t addr, unsigned n, uint8_t *buf, bool store)
+{
+    MemCtx *m = opaque;
+    const NcMmioDev *dev = m->ram_only ? NULL : dev_at(addr);
+    if (dev) {
+        uint64_t v = 0;
+        const uint64_t t0 = slow_clock_ns();
+        for (unsigned o = 0; o < n; o += 8) {
+            const unsigned k = n - o > 8 ? 8 : n - o;
+            if (store) {
+                v = 0;
+                memcpy(&v, buf + o, k);
+                dev->write(dev->opaque, addr + o - dev->base, v, k);
+            } else {
+                v = dev->read(dev->opaque, addr + o - dev->base, k);
+                memcpy(buf + o, &v, k);
+            }
+        }
+        slow_note(dev, addr, store, t0);
+        if (n <= 8) {
+            memcpy(&v, buf, n);
+        }
+        g_total++;
+        count(addr, store, v);
+        m->dev = dev, m->addr = addr, m->v = v, m->bytes = n, m->store = store;
+        return true;
+    }
+    /* RAM through the host's view, a page at a time */
+    const uint32_t in_page = NC_PAGE - (addr & (NC_PAGE - 1));
+    if (n > in_page) {
+        return mem_rw(opaque, addr, in_page, buf, store) && mem_rw(opaque, addr + in_page, n - in_page, buf + in_page, store);
+    }
+    const uint32_t pa = in_hole(addr) ? addr - NC_CONTIG_WINDOW : nc_vm_phys(m->vm, addr);
+    if (pa == UINT32_MAX || (uint64_t)pa + n > m->vm->ram_size) {
+        return false;
+    }
+    if (store) {
+        if (m->stored) {
+            m->stored(pa, n);
+        }
+        memcpy(m->vm->phys + pa, buf, n);
+    } else {
+        memcpy(buf, m->vm->phys + pa, n);
+    }
+    return true;
+}
+
+static void mmio_log(const MemCtx *m)
+{
+    static int trace_left = -1;
+    static uint32_t trace_lo, trace_hi;
+    if (trace_left < 0) {
+        const char *t = getenv("NC_TRACE_MMIO");
+        trace_left = 0;
