+ * callouts (continuations, kernel.h). With none registered a thread is created and ends as
+ * before, nothing in between. */
+#define NOTIFY_MAX 8
+
+static uint32_t notify_va(const NcKernel *k, unsigned i)
+{
+    return k->kpcr_va + NC_KPCR_THREAD_NOTIFY + 4 * i;
+}
+
+static bool notify_any(NcKernel *k)
+{
+    for (unsigned i = 0; i < NOTIFY_MAX; i++) {
+        if (nc_vm_rd32(k->vm, notify_va(k, i))) {
+            return true;
+        }
+    }
+    return false;
