+/* ------------------------------------------------------------- queues
+ *
+ * KQUEUE as the Xbox kernel lays it out: the dispatcher header (SignalState
+ * the entries in it), EntryListHead, CurrentCount, MaximumCount and
+ * ThreadListHead. A removal's wait takes its first entry and returns it as
+ * the wait's result, so a thread blocked in KeRemoveQueue wakes with the
+ * entry an insert gave it. Threads aren't made the queue's (KTHREAD.Queue): its
+ * MaximumCount, the concurrency NT's queues keep, isn't enforced here (a
+ * waiter gets an entry whenever there is one). From portare-ch's hakuX-lr
+ * (bcef60528b, GPL-2.0-or-later), its thread association left out. */
+
+static void q_list_init(NcKernel *k, uint32_t head)
+{
+    nc_vm_wr32(k->vm, head, head);
+    nc_vm_wr32(k->vm, head + 4, head);
+}
+
+static bool q_list_empty(NcKernel *k, uint32_t head)
+{
+    return nc_vm_rd32(k->vm, head) == head;
+}
+
+static void q_list_insert(NcKernel *k, uint32_t head, uint32_t entry, bool at_head)
+{
+    const uint32_t prev = at_head ? head : nc_vm_rd32(k->vm, head + 4);
+    const uint32_t next = nc_vm_rd32(k->vm, prev);
+    nc_vm_wr32(k->vm, entry, next);
+    nc_vm_wr32(k->vm, entry + 4, prev);
+    nc_vm_wr32(k->vm, prev, entry);
+    nc_vm_wr32(k->vm, next + 4, entry);
+}
+
+static void q_list_remove(NcKernel *k, uint32_t entry)
+{
+    const uint32_t next = nc_vm_rd32(k->vm, entry), prev = nc_vm_rd32(k->vm, entry + 4);
+    nc_vm_wr32(k->vm, prev, next);
+    nc_vm_wr32(k->vm, next + 4, prev);
+}
+
+void nc_ke_queue_init(NcKernel *k, uint32_t q, uint32_t count)
+{
+    init_header(k, q, OBJ_QUEUE, QUEUE_SIZE / 4, 0);
+    q_list_init(k, q + QUEUE_ENTRIES);
+    nc_vm_wr32(k->vm, q + QUEUE_CURRENT, 0);
+    nc_vm_wr32(k->vm, q + QUEUE_MAXIMUM, count ? count : 1);   /* 0: the processors' */
+    q_list_init(k, q + QUEUE_THREADS);
+}
+
+/* The queue's first entry, out of it; 0 if it has none (its SignalState put right). */
+static uint32_t queue_take(NcKernel *k, uint32_t q)
+{
+    if (q_list_empty(k, q + QUEUE_ENTRIES)) {
+        set_signal_state(k, q, 0);
+        return 0;
+    }
+    const uint32_t e = nc_vm_rd32(k->vm, q + QUEUE_ENTRIES);
+    q_list_remove(k, e);
+    const int32_t left = signal_state(k, q) - 1;
+    set_signal_state(k, q, left > 0 ? left : 0);
+    return e;
+}
+
+uint32_t nc_ke_queue_insert(NcKernel *k, uint32_t q, uint32_t entry, bool at_head)
+{
+    const int32_t old = signal_state(k, q);
+    q_list_insert(k, q + QUEUE_ENTRIES, entry, at_head);
+    set_signal_state(k, q, old + 1);
+    signaled(k, q, 0); /* a waiter takes it */
+    return (uint32_t)old;
+}
+
+int32_t nc_ke_queue_depth(NcKernel *k, uint32_t q)
+{
+    return signal_state(k, q);
+}
+
+/* A removal from queue q: an entry there now is taken at once (the wait's
+ * quantum charged, as a wait satisfied without waiting); else the thread
+ * waits (marked a removal of kind mark, take) or the poll times out. The
+ * entry, or STATUS_TIMEOUT; NtRemoveIoCompletion's status for its mark. */
+static uint32_t queue_remove(NcKernel *k, uint32_t q, uint32_t timeout_va, uint32_t mark, const uint32_t *out)
+{
+    if (signal_state(k, q) > 0 && !q_list_empty(k, q + QUEUE_ENTRIES)) {
+        const uint32_t entry = queue_take(k, q);
+        nc_ps_charge_wait(k);
+        return mark == QUEUE_IO_REMOVE ? nc_io_completion_removed(k, entry, out) : entry;
+    }
+    const uint32_t r = wait(k, &q, 1, false, timeout_va, 0, false);
+    NcThread *t = k->current;
+    if (t && t->state == NC_T_WAITING && t->wait.count == 1 && t->wait.objects[0] == q) {
+        t->wait.objects[1] = mark;      /* the wait's end takes the entry (take) */
+        if (out) {
+            memcpy(&t->wait.objects[2], out, 3 * sizeof(uint32_t));
+        }
+    }
+    return r;
+}
+
+uint32_t nc_ke_queue_remove_io(NcKernel *k, uint32_t q, uint32_t timeout_va, const uint32_t out[3])
+{
+    return queue_remove(k, q, timeout_va, QUEUE_IO_REMOVE, out);
+}
