+/* ps5-native (OGBox 0.1.33): the clock's wait, on time. A timed wait on the PS5 (a condition
+ * variable's) wakes its thread a scheduler tick late, up to some 18 ms: the clock that should
+ * interrupt the guest every millisecond did so about 55 times a second while the guest ran, so its
+ * timers, sleeps and timeouts came 10 to 18 ms late (Def Jam: a Sleep(1) of its streaming thread
+ * still waiting after 8 ms; the XAPI timer queue's event for the sound thread 55 times a second;
+ * the menu's video held up behind it). The wait is now a sleep that stops short by what this
+ * console's sleeps were seen to overshoot, the rest spun (yielding), and a re-arm for an earlier
+ * time is seen within 50 us. With the lock let go meanwhile. Returns true when re-armed earlier
+ * (the guest time `wake` no longer the earliest). NC_CLOCK_SPIN=0: the plain timed wait. */
+static uint64_t clock_host_now(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+
+static bool clock_sleep_until(uint64_t host, uint64_t wake)
+{
+    static int spin = -1;
+    static uint64_t late_ns = 2000000ull;   /* the sleeps' overshoot seen, the margin spun */
+    static uint64_t said_ns;
+    if (spin < 0) {
+        const char *e = getenv("NC_CLOCK_SPIN");
+#if defined(__PROSPERO__)
+        spin = !e || atoi(e) != 0;
+#else
+        spin = e && atoi(e) != 0;
+#endif
+    }
+    if (!spin) {
+        const struct timespec ts = {(time_t)(host / 1000000000ull), (long)(host % 1000000000ull)};
+        return pthread_cond_timedwait(&g_clock_cv, &g_clock_mu, &ts) == 0;
+    }
+    pthread_mutex_unlock(&g_clock_mu);
+    bool rearmed = false;
+    uint64_t now = clock_host_now();
+    if (host > now + late_ns + 200000ull) {
+        const uint64_t until = host - late_ns;
+        const struct timespec ts = {(time_t)(until / 1000000000ull), (long)(until % 1000000000ull)};
+        clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &ts, NULL);
+        now = clock_host_now();
+        const uint64_t over = now > until ? now - until : 0;
+        /* the margin follows the overshoot: up at once, down slowly; 0.2 to 20 ms */
+        late_ns = over + over / 4 > late_ns ? over + over / 4 : late_ns - late_ns / 64;
+        late_ns = late_ns < 200000ull ? 200000ull : late_ns > 20000000ull ? 20000000ull : late_ns;
+        if (now - said_ns > 30000000000ull) {
+            said_ns = now;
+            nc_log("hakuX-native", "clock: the host's sleeps overshoot by about %.2f ms; that much is spun",
+                   (double)late_ns / 1e6);
+        }
+    }
+    for (unsigned n = 0; now < host; n++) {
+        const uint64_t due = __atomic_load_n(&g_clock_due, __ATOMIC_ACQUIRE);
+        if (due && due < wake) {
+            rearmed = true;
+            break;
+        }
+        if (n & 1) {
+            sched_yield();
+        } else {
+            for (int i = 0; i < 64; i++) {
+#if defined(__x86_64__) || defined(__i386__)
+                __builtin_ia32_pause();
+#endif
+            }
+        }
+        now = clock_host_now();
+    }
+    pthread_mutex_lock(&g_clock_mu);
+    return rearmed;
+}
