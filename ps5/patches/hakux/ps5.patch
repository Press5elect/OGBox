+    memset(h, 0, sizeof(h));
+    h[1][3] = 3.0f;
+    impulse_response(h, 0.0f, y);
+    memset(w0, 0, sizeof(w0));
+    memset(w1, 0, sizeof(w1));
+    w1[3] = 1.0f;
+    expect(y[0], w0);
+    expect(y[1], w1);
+    /* the first ear's sum 1: as it is (0.5 at tap 0, -0.5 at tap 4); the
+     * second normalized (4 at tap 2: 1) */
+    memset(h, 0, sizeof(h));
+    h[0][0] = 0.5f;
+    h[0][4] = -0.5f;
+    h[1][2] = 4.0f;
+    impulse_response(h, 0.0f, y);
+    memset(w0, 0, sizeof(w0));
+    memset(w1, 0, sizeof(w1));
