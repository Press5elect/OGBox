+static void le_hex(uint8_t *dst, size_t len, const char *hex)
+{
+    memset(dst, 0, len);
+    const size_t n = strlen(hex);
+    for (size_t i = 0; i < n && i / 2 < len; i++) {
+        const char c = hex[n - 1 - i];
