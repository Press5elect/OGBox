+++ b/native/kernel/wback.c
@@ -0,0 +1,847 @@
+/*
+ * Copyright (C) 2026 Press5elect
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * Additional terms (GPL-3.0 section 7(b)): keep the attribution "OGBox by
+ * Press5elect" (github.com/Press5elect/OGBox, NOTICE).
+ */
+/*
+ * OGBox 0.0.9: a cache drive's writes held in memory and written to the host files behind the game.
+ *
+ * The PS5 lets a title write about 1.3 GiB at full speed and then about 2 MiB/s, however it
+ * writes; the budget carries over between the title's starts and refills only while it doesn't
+ * write (the platform layer's docs/PROBE.md, "Sustained writes"). WWE WrestleMania 21 copies its
+ * movies and sound to its cache drive, 4 KiB at a time, and waits for the copy before a match:
+ * minutes. Here a cache drive's write completes at once into memory, and one thread (wback_thread)
+ * writes what is held to the host files in the order the game wrote it, as fast as the console
+ * lets it. What the game reads, sizes and lists of a file counts its held bytes (io.c asks here).
+ *
+ * The journal, a file the game can't see: before a file's first held bytes reach the host,
+ * "B <path>"; once the last of them have, "D <path>"; a rename of a file or folder that has bytes
+ * held, "R <old>\t<new>". At the next start a file whose last line is "B" (the run quit with its
+ * bytes still held) is deleted: the game finds it missing and copies it again, not cut short.
+ */
+#include "native/kernel/wback.h"
+#include "native/core/nc.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+#define WB_PATH 512
+#define WB_EXTENT (1u << 20)         /* a held extent grows to this, then another starts */
+#define WB_FIRST (64u << 10)         /* an extent's first buffer */
+
+typedef struct WbItem WbItem;
+
+typedef struct WbFile {
+    uint64_t ino;
+    int fd;                          /* a duplicate of the game's descriptor */
+    char path[WB_PATH];              /* the host path (renames follow), for the journal */
+    uint64_t end;                    /* past the furthest held byte */
+    unsigned items;                  /* its items not yet done */
+    bool begun;                      /* its "B" is in the journal */
+    bool dead;                       /* deleted: its bytes go nowhere, no "D" */
+    WbItem *first, *last;            /* its items, in order */
+    struct WbFile *next;
+} WbFile;
+
+enum { IT_BEGIN, IT_DATA, IT_TIMES };
+
+struct WbItem {
+    int kind;
+    WbFile *f;
+    uint64_t off;
+    uint32_t len, cap;
+    uint8_t *buf;
+    struct timeval tv[2];
+    bool inflight;
+    WbItem *prev, *next;             /* all items, in order */
+    WbItem *fnext;                   /* its file's */
+};
+
+static struct {
+    pthread_mutex_t mu, jmu;         /* jmu: the journal's lines in order with renames */
+    pthread_cond_t work, done;
+    bool on;
+    size_t cap;
+    WbItem *head, *tail;
+    WbFile *files;
+    unsigned nfiles;
+    uint64_t promote;                /* a file drained: its items first (0: none) */
+    uint64_t logged_64m;
+    bool told_clear;
+    unsigned nbegin;                 /* "B" items queued */
+    int journal;
+    NcWbStats st;
+    char cur[WB_PATH];               /* OGBox 0.0.9: the file being written (nc_wb_current) */
+} g = {.mu = PTHREAD_MUTEX_INITIALIZER, .jmu = PTHREAD_MUTEX_INITIALIZER,
+       .work = PTHREAD_COND_INITIALIZER, .done = PTHREAD_COND_INITIALIZER, .journal = -1};
+
+#ifdef NC_WB_TEST
+unsigned nc_wb_test_delay_us;
+#endif
+
+static double now_s(void)
+{
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return (double)t.tv_sec + t.tv_nsec / 1e9;
+}
+
+/* ------------------------------------------------------------------ journal */
+
+static void journal_line(char kind, const char *a, const char *b)
+{
+    if (g.journal < 0) {
+        return;
+    }
+    char line[2 * WB_PATH + 8];
+    const int n = b ? snprintf(line, sizeof(line), "%c %s\t%s\n", kind, a, b)
+                    : snprintf(line, sizeof(line), "%c %s\n", kind, a);
+    if (n > 0 && (size_t)n < sizeof(line) && write(g.journal, line, (size_t)n) != n) {
+        static unsigned s_failed;
+        if (s_failed++ < 4) {
+            nc_log("hakuX-native-wb", "journal: a line not written: %s", strerror(errno));
+        }
+    }
+}
+
+/* The journal a run before left: the files it left with bytes held, deleted. Each path's latest
+ * line decides (a rename moves a file's state to the new path, over what was there). */
+typedef struct Rec {
+    char path[WB_PATH];
+    bool open;                       /* its latest line "B" */
+} Rec;
+
+static void rec_forget(Rec *r, unsigned *n, const char *path)
+{
+    for (unsigned i = 0; i < *n;) {
+        if (!strcmp(r[i].path, path)) {
+            r[i] = r[--*n];
+        } else {
+            i++;
+        }
+    }
+}
+
+static void recover(const char *journal)
+{
+    FILE *f = fopen(journal, "r");
+    if (!f) {
+        return;
+    }
+    Rec *r = NULL;
+    unsigned n = 0, cap = 0, lines = 0;
+    char line[2 * WB_PATH + 8];
+    while (fgets(line, sizeof(line), f)) {
+        line[strcspn(line, "\n")] = 0;
+        if (strlen(line) < 3 || line[1] != ' ') {
+            continue;
+        }
+        lines++;
+        const char kind = line[0];
+        char *a = line + 2;
+        if (kind == 'R') {
+            char *b = strchr(a, '\t');
+            if (!b) {
+                continue;
+            }
+            *b++ = 0;
+            const size_t al = strlen(a);
+            if (al >= WB_PATH || strlen(b) >= WB_PATH) {
+                continue;
+            }
+            /* the records under the old name move to the new one, over any record already there
+             * (the file now at that path is the moved one) */
+            bool *moved = calloc(n ? n : 1, sizeof(*moved));
+            if (!moved) {
+                continue;
+            }
+            for (unsigned i = 0; i < n; i++) {
+                char to[WB_PATH];
+                if (!strncmp(r[i].path, a, al) && (r[i].path[al] == 0 || r[i].path[al] == '/') &&
+                    (size_t)snprintf(to, sizeof(to), "%s%s", b, r[i].path + al) < sizeof(to)) {
+                    snprintf(r[i].path, sizeof(r[i].path), "%s", to);
+                    moved[i] = true;
+                }
+            }
+            unsigned kept = 0;
+            for (unsigned i = 0; i < n; i++) {
+                bool replaced = false;
+                for (unsigned j = 0; j < n && !moved[i] && !replaced; j++) {
+                    replaced = moved[j] && !strcmp(r[j].path, r[i].path);
+                }
+                if (!replaced) {
+                    r[kept++] = r[i];
+                }
+            }
+            n = kept;
+            free(moved);
+            continue;
+        }
+        if (kind != 'B' && kind != 'D') {
+            continue;
+        }
+        if (strlen(a) >= WB_PATH) {
+            continue;                   /* (never cut short: a shorter path is another file) */
+        }
+        rec_forget(r, &n, a);
+        if (n == cap) {
+            cap = cap ? 2 * cap : 64;
+            Rec *grown = realloc(r, cap * sizeof(*r));
+            if (!grown) {
+                break;
+            }
+            r = grown;
+        }
+        memcpy(r[n].path, a, strlen(a) + 1);
+        r[n].open = kind == 'B';
+        n++;
+    }
+    fclose(f);
+    unsigned gone = 0;
+    for (unsigned i = 0; i < n; i++) {
+        struct stat st;
+        if (!r[i].open || lstat(r[i].path, &st) != 0 || !S_ISREG(st.st_mode)) {
+            continue;
+        }
+        if (unlink(r[i].path) == 0) {
+            gone++;
+            nc_log("hakuX-native-wb", "%s: left part-written when the last run quit (its bytes still held): "
+                   "deleted, for the game to copy again", r[i].path);
+        }
+    }
+    free(r);
+    nc_log("hakuX-native-wb", "the last run's journal: %u lines, %u file(s) left part-written deleted", lines, gone);
+}
+
+/* ------------------------------------------------------------------ files and items */
+
+static WbFile *file_find(uint64_t ino)
+{
+    for (WbFile *f = g.files; f; f = f->next) {
+        if (f->ino == ino) {
+            return f;
+        }
+    }
+    return NULL;
+}
+
+static void item_push(WbItem *it)
+{
+    it->prev = g.tail;
+    it->next = NULL;
+    if (g.tail) {
+        g.tail->next = it;
+    } else {
+        g.head = it;
+    }
+    g.tail = it;
+    WbFile *f = it->f;
+    it->fnext = NULL;
+    if (f->last) {
+        f->last->fnext = it;
+    } else {
+        f->first = it;
+    }
+    f->last = it;
+    f->items++;
+    g.nbegin += it->kind == IT_BEGIN;
+}
+
+/* Done: off the lists (it is its file's first: a file's items go in order). */
+static void item_drop(WbItem *it)
+{
+    if (it->prev) {
+        it->prev->next = it->next;
+    } else {
+        g.head = it->next;
+    }
+    if (it->next) {
+        it->next->prev = it->prev;
+    } else {
+        g.tail = it->prev;
+    }
+    WbFile *f = it->f;
+    f->first = it->fnext;
+    if (f->last == it) {
+        f->last = NULL;
+    }
+    f->items--;
+    g.nbegin -= it->kind == IT_BEGIN;
+    if (it->kind == IT_DATA) {
+        g.st.held -= it->len;
+    }
+    free(it->buf);
+    free(it);
+}
+
+static void file_free(WbFile *f)
+{
+    WbFile **p = &g.files;
+    while (*p && *p != f) {
+        p = &(*p)->next;
+    }
+    if (*p) {
+        *p = f->next;
+    }
+    if (f->fd >= 0) {
+        close(f->fd);
+    }
+    g.nfiles--;
+    free(f);
+}
+
+static bool write_all(int fd, const uint8_t *p, size_t n, uint64_t off)
+{
+    while (n) {
+        const ssize_t w = pwrite(fd, p, n, (off_t)off);
+        if (w < 0 && errno == EINTR) {
+            continue;
+        }
+        if (w <= 0) {
+            return false;
+        }
+        p += w;
+        n -= (size_t)w;
+        off += (uint64_t)w;
+    }
+    return true;
+}
+
+static void *wback_thread(void *arg)
+{
+    (void)arg;
+    pthread_mutex_lock(&g.mu);
+    for (;;) {
+        while (!g.head) {
+            pthread_cond_wait(&g.work, &g.mu);
+        }
+        WbItem *it = NULL;
+        /* a "B" first, ahead of the queue: it only says a file may be part-written, and the sooner
+         * it is in the journal the shorter the time a quit leaves a new file empty and unmarked */
+        for (WbItem *b = g.nbegin ? g.head : NULL; b && !it; b = b->next) {
+            if (b->kind == IT_BEGIN) {
+                it = b;
+            }
+        }
+        if (!it && g.promote) {
+            WbFile *pf = file_find(g.promote);
+            it = pf ? pf->first : NULL;
+        }
+        if (!it) {
+            it = g.head;
+        }
+        WbFile *f = it->f;
+        it->inflight = true;
+        const bool dead = f->dead;
+        char path[WB_PATH];
+        snprintf(path, sizeof(path), "%s", f->path);
+        snprintf(g.cur, sizeof(g.cur), "%s", f->path);
+        pthread_mutex_unlock(&g.mu);
+
+        bool ok = true;
+        if (it->kind == IT_BEGIN) {
+            pthread_mutex_lock(&g.jmu);
+            pthread_mutex_lock(&g.mu);
+            snprintf(path, sizeof(path), "%s", f->path);    /* a rename since */
+            pthread_mutex_unlock(&g.mu);
+            journal_line('B', path, NULL);
+            pthread_mutex_lock(&g.mu);
+            f->begun = true;
+            pthread_mutex_unlock(&g.mu);
+            pthread_mutex_unlock(&g.jmu);
+        } else if (it->kind == IT_DATA && !dead && it->len) {
+#ifdef NC_WB_TEST
+            if (nc_wb_test_delay_us) {
+                usleep(nc_wb_test_delay_us);    /* (a slow host: the console's once its budget is spent) */
+            }
+#endif
+            const double t0 = now_s();
+            ok = write_all(f->fd, it->buf, it->len, it->off);
+            const double dt = now_s() - t0;
+            pthread_mutex_lock(&g.mu);
+            g.st.written += it->len;
+            g.st.writes++;
+            g.st.write_s += dt;
+            if (dt * 1e3 > g.st.slowest_ms) {
+                g.st.slowest_ms = dt * 1e3;
+            }
+            pthread_mutex_unlock(&g.mu);
+            if (!ok) {
+                static unsigned s_failed;
+                if (s_failed++ < 8) {
+                    nc_log("hakuX-native-wb", "%s +%llx %u bytes not written: %s (first 8)", path,
+                           (unsigned long long)it->off, it->len, strerror(errno));
+                }
+            }
+        } else if (it->kind == IT_TIMES && !dead) {
+            futimes(f->fd, it->tv);
+        }
+
+        pthread_mutex_lock(&g.mu);
+        item_drop(it);
+        if (!f->items) {
+            /* its held bytes are all out: "D" (unless more came meanwhile, or it was deleted), and
+             * the entry goes (only this thread frees one: none is in use elsewhere then) */
+            const bool tell = f->begun && !f->dead;
+            f->begun = false;
+            if (tell) {
+                pthread_mutex_unlock(&g.mu);
+                pthread_mutex_lock(&g.jmu);
+                pthread_mutex_lock(&g.mu);
+                snprintf(path, sizeof(path), "%s", f->path);
+                const bool still = !f->items;
+                pthread_mutex_unlock(&g.mu);
+                if (still) {
+                    journal_line('D', path, NULL);
+                }
+                pthread_mutex_unlock(&g.jmu);
+                pthread_mutex_lock(&g.mu);
+            }
+            if (!f->items) {
+                file_free(f);
+            }
+        }
+        if (g.st.written >> 26 != g.logged_64m) {   /* every 64 MiB written */
+            g.logged_64m = g.st.written >> 26;
+            const NcWbStats st = g.st;
+            pthread_mutex_unlock(&g.mu);
+            nc_log("hakuX-native-wb", "%.0f MiB written behind the game in %.0f s of writing (slowest write %.0f ms); "
+                   "%.1f MiB still held", st.written / 1048576.0, st.write_s, st.slowest_ms, st.held / 1048576.0);
+            pthread_mutex_lock(&g.mu);
+        }
+        if (!g.head && g.st.held_max >= (8u << 20) && !g.told_clear) {
+            g.told_clear = true;
+            const NcWbStats st = g.st;
+            pthread_mutex_unlock(&g.mu);
+            nc_log("hakuX-native-wb", "all written: %.0f MiB behind the game (%.0f MiB held at most), %.0f s of writing",
+                   st.written / 1048576.0, st.held_max / 1048576.0, st.write_s);
+            pthread_mutex_lock(&g.mu);
+        }
+        pthread_cond_broadcast(&g.done);
+    }
+    return NULL;
+}
+
+/* ------------------------------------------------------------------ the API */
+
+void nc_wb_start(const char *journal, size_t cap)
+{
+    pthread_mutex_lock(&g.mu);
+    const bool was = g.on;
+    pthread_mutex_unlock(&g.mu);
+    if (was) {
+        return;
+    }
+    recover(journal);
+    g.journal = open(journal, O_WRONLY | O_CREAT | O_TRUNC | O_APPEND | O_CLOEXEC, 0666);
+    if (g.journal >= 0) {
+        fchmod(g.journal, 0666);
+    } else {
+        nc_log("hakuX-native-wb", "journal %s: %s (a file left part-written won't be found)", journal, strerror(errno));
+    }
+    g.cap = cap;
+    pthread_t t;
+    if (pthread_create(&t, NULL, wback_thread, NULL) != 0) {
+        nc_log("hakuX-native-wb", "no thread: the cache drives' writes go to the disk as before");
+        return;
+    }
+    pthread_detach(t);
+    pthread_mutex_lock(&g.mu);
+    g.on = true;
+    pthread_mutex_unlock(&g.mu);
+    nc_log("hakuX-native-wb", "the cache drives' writes held in memory (up to %zu MiB) and written behind the game; "
+           "journal %s", cap >> 20, journal);
+}
+
+bool nc_wb_on(void)
+{
+    return __atomic_load_n(&g.on, __ATOMIC_ACQUIRE);
+}
+
+bool nc_wb_write(int fd, uint64_t ino, const char *host, uint64_t off, const void *data, uint32_t len)
+{
+    if (!nc_wb_on() || !len) {
+        return false;
+    }
+    pthread_mutex_lock(&g.mu);
+    if (g.st.held && g.st.held + len > g.cap) {
+        const double t0 = now_s();
+        g.st.waits_cap++;
+        while (g.st.held && g.st.held + len > g.cap) {
+            pthread_cond_wait(&g.done, &g.mu);
+        }
+        g.st.drain_s += now_s() - t0;
+    }
+    WbFile *f = file_find(ino);
+    if (!f) {
+        f = calloc(1, sizeof(*f));
+        const int dup_fd = f ? dup(fd) : -1;
+        if (dup_fd < 0) {
+            free(f);
+            pthread_mutex_unlock(&g.mu);
+            return false;
+        }
+        f->ino = ino;
+        f->fd = dup_fd;
+        snprintf(f->path, sizeof(f->path), "%s", host);
+        f->next = g.files;
+        g.files = f;
+        g.nfiles++;
+        g.st.files++;
+    }
+    f->dead = false;
+    if (!f->items) {
+        WbItem *b = calloc(1, sizeof(*b));
+        if (!b) {
+            pthread_mutex_unlock(&g.mu);
+            return false;
+        }
+        b->kind = IT_BEGIN;
+        b->f = f;
+        item_push(b);
+    }
+    /* on the file's last extent when that is the last of all (nothing after it to overtake) and
+     * not being written: a file written in order, as a copy is, goes out in large pieces */
+    WbItem *e = f->last;
+    if (e && e == g.tail && e->kind == IT_DATA && !e->inflight && off >= e->off && off <= e->off + e->len &&
+        off + len - e->off <= WB_EXTENT) {
+        const uint32_t need = (uint32_t)(off + len - e->off);
+        if (need > e->cap) {
+            uint32_t c = e->cap ? e->cap : WB_FIRST;
+            while (c < need) {
+                c *= 2;
+            }
+            uint8_t *nb = realloc(e->buf, c > WB_EXTENT ? WB_EXTENT : c);
+            if (!nb) {
+                e = NULL;
+            } else {
+                e->buf = nb;
+                e->cap = c > WB_EXTENT ? WB_EXTENT : c;
+            }
+        }
+        if (e) {
+            memcpy(e->buf + (off - e->off), data, len);
+            if (need > e->len) {
+                g.st.held += need - e->len;
+                e->len = need;
+            }
+        }
+    } else {
+        e = NULL;
+    }
+    if (!e) {
+        WbItem *it = calloc(1, sizeof(*it));
+        const uint32_t c = len > WB_FIRST ? len : WB_FIRST;
+        uint8_t *buf = it ? malloc(c) : NULL;
+        if (!buf) {
+            free(it);
+            if (f->items == 1 && f->first && f->first->kind == IT_BEGIN && !f->first->inflight) {
+                item_drop(f->first);    /* (its "B" alone) */
+            }
+            if (!f->items) {
+                file_free(f);
+            }
+            pthread_mutex_unlock(&g.mu);
+            return false;
+        }
+        it->kind = IT_DATA;
+        it->f = f;
+        it->off = off;
+        it->len = len;
+        it->cap = c;
+        it->buf = buf;
+        memcpy(buf, data, len);
+        item_push(it);
+        g.st.held += len;
+    }
+    if (off + len > f->end) {
+        f->end = off + len;
+    }
+    if (g.st.held > g.st.held_max) {
+        g.st.held_max = g.st.held;
+    }
+    g.told_clear = false;
+    pthread_cond_signal(&g.work);
+    pthread_mutex_unlock(&g.mu);
+    return true;
+}
+
+bool nc_wb_holds(uint64_t ino)
+{
+    if (!nc_wb_on()) {
+        return false;
+    }
+    pthread_mutex_lock(&g.mu);
+    const WbFile *f = g.head ? file_find(ino) : NULL;
+    const bool held = f && f->items && !f->dead;
+    pthread_mutex_unlock(&g.mu);
+    return held;
+}
+
+uint64_t nc_wb_size(uint64_t ino, uint64_t disk)
+{
+    if (!nc_wb_on()) {
+        return disk;
+    }
+    pthread_mutex_lock(&g.mu);
+    const WbFile *f = g.head ? file_find(ino) : NULL;
+    const uint64_t s = f && f->items && !f->dead && f->end > disk ? f->end : disk;
+    pthread_mutex_unlock(&g.mu);
+    return s;
+}
+
+bool nc_wb_read(int fd, uint64_t ino, uint64_t off, uint8_t *buf, uint32_t len)
+{
+    if (!nc_wb_on()) {
+        return pread(fd, buf, len, (off_t)off) == (ssize_t)len;
+    }
+    pthread_mutex_lock(&g.mu);
+    const WbFile *f = g.head ? file_find(ino) : NULL;
+    if (!f || !f->items || f->dead) {
+        pthread_mutex_unlock(&g.mu);
+        return pread(fd, buf, len, (off_t)off) == (ssize_t)len;
+    }
+    /* under the lock: an item leaves only once its bytes are on the host, and only with it */
+    ssize_t n = 0;
+    while ((uint32_t)n < len) {
+        const ssize_t r = pread(fd, buf + n, len - (uint32_t)n, (off_t)(off + (uint64_t)n));
+        if (r < 0 && errno == EINTR) {
+            continue;
+        }
+        if (r < 0) {
+            pthread_mutex_unlock(&g.mu);
+            return false;
+        }
+        if (r == 0) {
+            break;
+        }
+        n += r;
+    }
+    memset(buf + n, 0, len - (uint32_t)n);
+    for (const WbItem *it = f->first; it; it = it->fnext) {
+        if (it->kind != IT_DATA || !it->len) {
+            continue;
+        }
+        const uint64_t a = it->off > off ? it->off : off;
+        const uint64_t b = it->off + it->len < off + len ? it->off + it->len : off + len;
+        if (a < b) {
+            memcpy(buf + (a - off), it->buf + (a - it->off), (size_t)(b - a));
+        }
+    }
+    pthread_mutex_unlock(&g.mu);
+    return true;
+}
+
+void nc_wb_truncate(uint64_t ino, uint64_t size)
+{
+    if (!nc_wb_on()) {
+        return;
+    }
+    pthread_mutex_lock(&g.mu);
+    for (;;) {
+        WbFile *f = file_find(ino);
+        if (!f) {
+            break;
+        }
+        bool waiting = false;
+        for (WbItem *it = f->first; it; it = it->fnext) {
+            if (it->kind != IT_DATA || it->off + it->len <= size) {
+                continue;
+            }
+            if (it->inflight) {
+                waiting = true;         /* its bytes past the end are going out: after them */
+                break;
+            }
+            const uint32_t keep = it->off >= size ? 0 : (uint32_t)(size - it->off);
+            g.st.held -= it->len - keep;
+            it->len = keep;
+        }
+        if (!waiting) {
+            if (f->end > size) {
+                f->end = size;
+            }
+            break;
+        }
+        pthread_cond_wait(&g.done, &g.mu);
+    }
+    pthread_mutex_unlock(&g.mu);
+}
+
+void nc_wb_times(uint64_t ino, const struct timeval tv[2])
+{
+    if (!nc_wb_on()) {
+        return;
+    }
+    pthread_mutex_lock(&g.mu);
+    WbFile *f = g.head ? file_find(ino) : NULL;
+    if (f && f->items && !f->dead) {
+        WbItem *it = calloc(1, sizeof(*it));
+        if (it) {
+            it->kind = IT_TIMES;
+            it->f = f;
+            it->tv[0] = tv[0];
+            it->tv[1] = tv[1];
+            item_push(it);
+            pthread_cond_signal(&g.work);
+        }
+    }
+    pthread_mutex_unlock(&g.mu);
+}
+
+void nc_wb_deleted(uint64_t ino)
+{
+    if (!nc_wb_on()) {
+        return;
+    }
+    pthread_mutex_lock(&g.mu);
+    WbFile *f = file_find(ino);
+    if (f) {
+        f->dead = true;
+        for (WbItem *it = f->first; it; it = it->fnext) {
+            if (it->kind == IT_DATA && !it->inflight) {
+                g.st.held -= it->len;
+                it->len = 0;
+            }
+        }
+        f->end = 0;
+    }
+    pthread_mutex_unlock(&g.mu);
+}
+
+void nc_wb_deleted_under(const char *dir)
+{
+    if (!nc_wb_on()) {
+        return;
+    }
+    const size_t dl = strlen(dir);
+    pthread_mutex_lock(&g.mu);
+    for (WbFile *f = g.files; f; f = f->next) {
+        if (!strncmp(f->path, dir, dl) && f->path[dl] == '/') {
+            f->dead = true;
+            for (WbItem *it = f->first; it; it = it->fnext) {
+                if (it->kind == IT_DATA && !it->inflight) {
+                    g.st.held -= it->len;
+                    it->len = 0;
+                }
+            }
+            f->end = 0;
+        }
+    }
+    /* and a write of one of them under way ends first: the caller replaces the files next (a
+     * format, a state's drive put back) */
+    for (;;) {
+        bool busy = false;
+        for (const WbItem *it = g.head; it && !busy; it = it->next) {
+            busy = it->inflight && it->kind == IT_DATA && it->len && !strncmp(it->f->path, dir, dl) &&
+                   it->f->path[dl] == '/';
+        }
+        if (!busy) {
+            break;
+        }
+        pthread_cond_wait(&g.done, &g.mu);
+    }
+    pthread_mutex_unlock(&g.mu);
+}
+
+void nc_wb_renamed(const char *old_path, const char *new_path)
+{
+    if (!nc_wb_on()) {
+        return;
+    }
+    const size_t ol = strlen(old_path);
+    pthread_mutex_lock(&g.jmu);
+    pthread_mutex_lock(&g.mu);
+    bool begun = false;
+    char (*mark)[WB_PATH] = NULL;       /* held, its "B" not yet written: written now, at its new name */
+    unsigned nmark = 0;
+    for (WbFile *f = g.files; f; f = f->next) {
+        if (!strncmp(f->path, old_path, ol) && (f->path[ol] == 0 || f->path[ol] == '/')) {
+            char moved[WB_PATH];
+            if ((size_t)snprintf(moved, sizeof(moved), "%s%s", new_path, f->path + ol) < sizeof(moved)) {
+                snprintf(f->path, sizeof(f->path), "%s", moved);
+            }
+            if (f->begun) {
+                begun = true;
+            } else if (f->items && !f->dead) {
+                void *grown = realloc(mark, (nmark + 1) * sizeof(*mark));
+                if (grown) {
+                    mark = grown;
+                    snprintf(mark[nmark++], WB_PATH, "%s", f->path);
+                    f->begun = true;
+                }
+            }
+        }
+    }
+    pthread_mutex_unlock(&g.mu);
+    /* a game renames a file it has finished writing (Riddick's cache: X.tmp to X): the new name
+     * must not outlive a quit part-written */
+    if (begun) {
+        journal_line('R', old_path, new_path);
+    }
+    for (unsigned i = 0; i < nmark; i++) {
+        journal_line('B', mark[i], NULL);
+    }
+    free(mark);
+    pthread_mutex_unlock(&g.jmu);
+}
+
+void nc_wb_drain(uint64_t ino)
+{
+    if (!nc_wb_on()) {
+        return;
+    }
+    pthread_mutex_lock(&g.mu);
+    WbFile *f = file_find(ino);
+    if (f && f->items) {
+        const double t0 = now_s();
+        const uint64_t was = g.promote;
+        g.promote = ino;
+        g.st.drains++;
+        pthread_cond_signal(&g.work);
+        while ((f = file_find(ino)) && f->items) {
+            pthread_cond_wait(&g.done, &g.mu);
+        }
+        g.promote = was;
+        g.st.drain_s += now_s() - t0;
+    }
+    pthread_mutex_unlock(&g.mu);
+}
+
+void nc_wb_drain_all(void)
+{
+    if (!nc_wb_on()) {
+        return;
+    }
+    pthread_mutex_lock(&g.mu);
+    if (g.head) {
+        const double t0 = now_s();
+        g.st.drains++;
+        while (g.head) {
+            pthread_cond_wait(&g.done, &g.mu);
+        }
+        g.st.drain_s += now_s() - t0;
+    }
+    pthread_mutex_unlock(&g.mu);
+}
+
+void nc_wb_current(char *path, size_t n)
+{
+    pthread_mutex_lock(&g.mu);
+    snprintf(path, n, "%s", g.head ? g.cur : "");
+    pthread_mutex_unlock(&g.mu);
+}
+
+void nc_wb_stats(NcWbStats *s)
+{
+    pthread_mutex_lock(&g.mu);
+    *s = g.st;
+    pthread_mutex_unlock(&g.mu);
+}
