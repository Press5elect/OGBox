+/* OGBox: before the title is replaced (sceSystemServiceLoadExec, back to its game list): the
+ * GPU's work on this device finished, so none is left running when the process goes. The
+ * caller has paused the guest (nc_pause_set) and given the decoder and the render thread time to
+ * stop. 0, or the VkResult; -1 without a device. OGBox by Press5elect. */
+int hle_vk_exit_idle(void)
+{
+    if (!g_hvk.dev) {
+        return -1;
+    }
+    hle_vk_queue_lock();
+    const VkResult r = T.vkDeviceWaitIdle(g_hvk.dev);
+    hle_vk_queue_unlock();
+    return (int)r;
+}
