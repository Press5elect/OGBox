+                   pblk);
+            return false;
+        }
+        if (!host_map(vm, (uint32_t)vblk, pblk, g_hp)) {
+            nc_log("hakuX-native", "vm: map va=%08x pa=%08x len=%x failed: %s", (uint32_t)vblk, pblk, g_hp,
