+ * Press5elect" (github.com/Press5elect/OGBox, NOTICE).
+ *
+ * A minimal XDVDFS image writer, for the host tests only: builds an XISO in
+ * memory from a tree of nodes so the reader can be checked against known
+ * contents.
+ */
+#ifndef KELVIN_TEST_XDVDFS_WRITER_H
+#define KELVIN_TEST_XDVDFS_WRITER_H
+
+#include <stddef.h>
+#include <stdint.h>
