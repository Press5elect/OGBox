+ * XPP, XMV, WMADEC, XNET, XONLINE...), never these. NC_NATIVE_SWEEP_DATA=1
+ * sweeps them anyway (diagnostics). */
+static bool data_section(const char *name)
+{
+    static const char *const prefixes[] = {
+        ".rdata", ".data", ".bss", ".idata", ".edata", ".reloc", ".tls", ".CRT", ".rsrc", ".pdata",
+        "$$X",      /* $$XTIMAGE, $$XSIMAGE: the title's images */
+        "DOLBY",    /* the APU DSP's microcode, not x86 */
+        "XON_RD", "XNET_RD", "XPP_RD",
+    };
+    if (!name || !name[0] || !strcmp(name, "?")) {
+        return false;   /* no name to go by: the flag decides */
+    }
+    for (size_t i = 0; i < sizeof(prefixes) / sizeof(prefixes[0]); i++) {
+        if (!strncmp(name, prefixes[i], strlen(prefixes[i]))) {
+            return true;
+        }
+    }
+    const size_t n = strnlen(name, 64);
+    return n > 3 && !strncmp(name + n - 3, "_RD", 3); /* a library's read-only data */
