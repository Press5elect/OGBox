+
+/* ---- the history of guest memory operations (nc_vm_hist) ---- */
+
+#define VM_HIST 8192u
+static struct VmOp {
+    uint64_t ns;
+    uint32_t va, len, pa, eip;
+    uint16_t thread;
+    uint8_t op;
+} g_hist[VM_HIST];
+static uint32_t g_hist_n;      /* operations recorded, all time */
+void (*nc_vm_hist_who)(uint32_t *eip, uint32_t *thread);
+
+static uint64_t hist_now_ns(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+
+void nc_vm_hist(unsigned op, uint32_t va, uint32_t len, uint32_t pa)
+{
+    uint32_t eip = 0, thread = 0;
+    if (nc_vm_hist_who) {
+        nc_vm_hist_who(&eip, &thread);
+    }
+    const uint32_t i = __atomic_fetch_add(&g_hist_n, 1, __ATOMIC_RELAXED) % VM_HIST;
+    g_hist[i] = (struct VmOp){hist_now_ns(), va, len, pa, eip, (uint16_t)thread, (uint8_t)op};
+}
+
+static const char *hist_name(unsigned op)
+{
+    static const char *const names[] = {"?", "map", "unmap", "reserve", "commit", "decommit", "release",
+                                        "contiguous", "contiguous free", "section load", "section free",
+                                        "kernel stack", "kernel stack free", "FAILED", "host unmap"};
+    return op < sizeof(names) / sizeof(names[0]) ? names[op] : "?";
+}
+
+void nc_vm_hist_dump(const NcVm *vm, uint32_t va)
+{
+    const uint32_t lo = va > 0x10000u ? va - 0x10000u : 0, hi = va < 0xFFFF0000u ? va + 0x10000u : 0xFFFFFFFFu;
+    const uint32_t total = __atomic_load_n(&g_hist_n, __ATOMIC_ACQUIRE);
+    const uint32_t have = total < VM_HIST ? total : VM_HIST;
+    const uint64_t now = hist_now_ns();
+    nc_log("hakuX-native-vm", "history around %08x (%u operations recorded in all, the last %u kept; host pages %u "
+           "KiB):", va, total, have, g_hp >> 10);
+    unsigned shown = 0;
+    for (uint32_t k = 0; k < have && shown < 48; k++) {
+        const struct VmOp *o = &g_hist[(total - 1 - k) % VM_HIST];
+        const uint64_t end = (uint64_t)o->va + (o->len ? o->len : 1);
+        const bool near = o->op == NC_VMOP_CONTIG || o->op == NC_VMOP_CONTIG_FREE
+                              ? (o->pa != UINT32_MAX && vm->pte && nc_vm_phys(vm, va) != UINT32_MAX &&
+                                 nc_vm_phys(vm, va) >= o->pa && nc_vm_phys(vm, va) < o->pa + o->len)
+                              : false;
+        if (!near && (end <= lo || o->va >= hi)) {
+            continue;
+        }
+        shown++;
