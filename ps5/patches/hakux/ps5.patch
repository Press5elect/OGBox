+           "short ones moving the next %s), stubs at %08x-%08x", g_on ? "on" : "off (NC_MMIO_GATE=0)",
+           g_hits_needed, g_short ? "instructions" : "instructions: off (NC_MMIO_GATE_SHORT=0)", g_lo, g_hi);
