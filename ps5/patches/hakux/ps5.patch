+/* OGBox 0.0.9: the simple lowercase, the inverse of nc_rtl_upcase over the same scripts
+ * (RtlDowncaseUnicodeChar) */
+static inline uint16_t nc_rtl_downcase(uint16_t c)
+{
+    if (c >= 'A' && c <= 'Z') {
+        return (uint16_t)(c + 32);
+    }
+    if (c >= 0xC0 && c <= 0xDE && c != 0xD7) {
+        return (uint16_t)(c + 32);          /* Latin-1 capitals (not the multiplication sign) */
+    }
+    if (c == 0x178) {
+        return 0xFF;
+    }
+    if (c >= 0x100 && c <= 0x17F) {        /* Latin Extended-A: case pairs */
+        if (c <= 0x137 || (c >= 0x14A && c <= 0x177)) {
+            return (uint16_t)(c & 1 ? c : c + 1);     /* upper even, lower odd */
+        }
+        if ((c >= 0x139 && c <= 0x148) || (c >= 0x179 && c <= 0x17E)) {
+            return (uint16_t)(c & 1 ? c + 1 : c);     /* upper odd, lower even */
+        }
+        return c;
+    }
+    if (c >= 0x391 && c <= 0x3A9 && c != 0x3A2) {
+        return (uint16_t)(c + 32);          /* Greek */
+    }
+    if (c >= 0x410 && c <= 0x42F) {
+        return (uint16_t)(c + 32);          /* Cyrillic */
+    }
+    if (c >= 0x400 && c <= 0x40F) {
+        return (uint16_t)(c + 80);
+    }
+    if (c >= 0xFF21 && c <= 0xFF3A) {
+        return (uint16_t)(c + 32);          /* fullwidth Latin */
+    }
+    return c;
+}
+
 #endif
