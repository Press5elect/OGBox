+    }
+    const char *why = !frames_stopped(d) ? "running"
+                      : GET_MASK(sectl, NV_PAPU_SECTL_XCNTMODE) == NV_PAPU_SECTL_XCNTMODE_OFF ? "stopped: SECTL's XCNTMODE off"
+                                                                                            : "stopped: the FE halted";
+    nc_log("hakuX-apu", "per s: GP frames %.0f (%s; stopped turns %.0f) EP frames out %.0f, out ring %d bytes, grains %.0f "
+           "(short %.0f) | irq raised %.0f, acks %u total, IEN %08x ISTS %08x FECTL %08x (method %04x) SECTL %08x "
+           "XGSCNT %08x | GP %s EP %s (DSP frames %s) | voices 2d %u (%u active) 3d %u (%u) mp %u (%u) | "
+           "mailbox waits %.0f, VOICE_OFFs waiting %s",
+           g_diag.frames / s, why, g_diag.stopped / s, g_diag.pushed / s, apu_out_queued(), cb / s, short_cb / s,
+           g_diag.irq_up / s, apu_ld(&d->ists_writes), apu_ld(&d->regs[NV_PAPU_IEN]), apu_ld(&d->regs[NV_PAPU_ISTS]),
+           fectl, apu_ld(&d->regs[NV_PAPU_FEDECMETH]) & 0xFFFF, sectl,
+           (uint32_t)(gscnt_now() - apu_ld(&d->regs[NV_PAPU_XGSCNT])),
+           (apu_ld(&d->gp.regs[NV_PAPU_GPRST]) & 3u) == 3u ? "running" : "in reset",
+           (apu_ld(&d->ep.regs[NV_PAPU_EPRST]) & 3u) == 3u ? "running" : "in reset",
+           g_apu_config.use_dsp ? "whole" : "1000 cycles", n[0], act[0], n[1], act[1], n[2], act[2],
+           apu_xchg(&g_diag.spins, 0) / s, mcpx_apu_vp_off_pending() ? "yes" : "no");
