index 0000000000000000000000000000000000000000..f45e1143370a66c81a2fe71945dda45dcc6d9d9d
--- /dev/null
+++ b/native/core/folder.c
@@ -0,0 +1,555 @@
+/*
+ * hakuX native core — an extracted game's folder read as a disc (folder.h).
+ *
+ * Copyright (C) 2026 Press5elect
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * Additional terms (GPL-3.0 section 7(b)): keep the attribution "OGBox by Press5elect"; see NOTICE.
+ *
+ * The image is made as it is read, as an XISO of the folder would be laid out: the volume
+ * descriptor at sector 32, then each folder's table and each file on sectors of their own, handed
+ * out in the order they become known. A folder is listed when its parent's table is made (its own
+ * table's size is its entries'), and its table is made when it is first read, so a game's boot
+ * lists only what it opens (and the disc's folder cache, xdvdfs.c, the rest on its thread). A
+ * table's entries are sorted as the Xbox compares names (case-insensitive), each one's right child
+ * the next: a tree the console's search and hakuX's walk both read. Files are read from the host
+ * as their sectors are; at most FOLDER_OPEN_MAX of them open at once (a share's layer gives 16).
+ */
+#include "native/core/folder.h"
+#include "native/core/nc.h"
+
+#include <ctype.h>
+#include <dirent.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#define SECTOR 2048u
+#define VD_SECTOR 32u
+#define FIRST_SECTOR 34u            /* the root's table: after the volume descriptor */
+#define ENTRY_MAX_OFF (0xFFFFu * 4u)  /* a child's offset is a u16 of dwords */
+#define FOLDER_OPEN_MAX 8
+
+typedef struct Node {
+    char *name;                     /* on the disc */
+    char *host;                     /* on the host */
+    uint64_t size;                  /* a file's bytes; a folder's table's */
+    uint32_t sector;
+    uint32_t first, count;          /* a folder's children, once listed */
+    bool dir, listed, placed;
+    uint8_t *table;                 /* a folder's, once made */
+} Node;
+
+typedef struct Extent {
+    uint32_t sector, count, node;
+} Extent;
+
+typedef struct OpenFile {
+    uint32_t node;
+    int fd;
+    uint64_t used;
+} OpenFile;
+
+struct NcFolder {
+    const NcFolderIo *io;
+    pthread_mutex_t lock;
+    Node *n;
+    uint32_t nn, ncap;
+    Extent *x;
+    uint32_t nx, xcap;
+    uint32_t next;                  /* the next free sector */
+    OpenFile open[FOLDER_OPEN_MAX];
+    uint64_t tick;
+    char *alias;                    /* the XBE to boot, there as default.xbe; NULL: default.xbe itself */
+    uint8_t vd[SECTOR];
+};
+
+typedef struct Found {
+    char *name;
+    bool dir;
+    uint64_t size;
+} Found;
+
+typedef struct Gather {
+    Found *e;
+    size_t n, cap;
+    bool nomem;
+} Gather;
+
+static void gather(void *ctx, const char *name, bool is_dir, uint64_t size)
+{
+    Gather *g = ctx;
+    const size_t len = strlen(name);
+    if (!len || len > 255 || !strcmp(name, ".") || !strcmp(name, "..")) {
+        return;
+    }
+    for (size_t i = 0; i < len; i++) {
+        if ((unsigned char)name[i] < 0x20) {
+            return;
+        }
+    }
+    if (g->n == g->cap) {
+        const size_t cap = g->cap ? g->cap * 2 : 64;
+        Found *e = realloc(g->e, cap * sizeof(*e));
+        if (!e) {
+            g->nomem = true;
+            return;
+        }
+        g->e = e;
+        g->cap = cap;
+    }
+    if (!(g->e[g->n].name = strdup(name))) {
+        g->nomem = true;
+        return;
+    }
+    g->e[g->n].dir = is_dir;
+    g->e[g->n].size = size;
+    g->n++;
+}
+
+/* The Xbox's order of names: byte by byte, letters as capitals. */
+static int name_cmp(const char *a, const char *b)
+{
+    for (;; a++, b++) {
+        const int x = toupper((unsigned char)*a), y = toupper((unsigned char)*b);
+        if (x != y || !x) {
+            return x - y;
+        }
+    }
+}
+
+static int found_cmp(const void *a, const void *b)
+{
+    return name_cmp(((const Found *)a)->name, ((const Found *)b)->name);
+}
+
+static char *join(const char *folder, const char *name)
+{
+    const size_t a = strlen(folder), b = strlen(name);
+    char *p = malloc(a + b + 2);
+    if (p) {
+        memcpy(p, folder, a);
+        p[a] = '/';
+        memcpy(p + a + 1, name, b + 1);
+    }
+    return p;
+}
+
+static uint32_t entry_len(const char *name)
+{
+    return (14u + (uint32_t)strlen(name) + 3u) & ~3u;
+}
+
+/* A table's size for these names in this order, and each entry's offset (offs may be NULL). */
+static uint32_t table_layout(const Node *n, uint32_t first, uint32_t count, uint32_t *offs)
+{
+    uint32_t off = 0;
+    for (uint32_t k = 0; k < count; k++) {
+        const uint32_t len = entry_len(n[first + k].name);
+        if (off % SECTOR + len > SECTOR) {
+            off = (off + SECTOR - 1) / SECTOR * SECTOR;    /* an entry stays in its sector */
+        }
+        if (offs) {
+            offs[k] = off;
+        }
+        off += len;
+    }
+    const uint32_t size = (off + SECTOR - 1) / SECTOR * SECTOR;
+    return size ? size : SECTOR;    /* an empty folder: a sector of padding, as extract-xiso writes */
+}
+
+static bool grow_nodes(NcFolder *f, uint32_t more)
+{
+    if (f->nn + more <= f->ncap) {
+        return true;
+    }
+    uint32_t cap = f->ncap ? f->ncap : 256;
+    while (cap < f->nn + more) {
+        cap *= 2;
+    }
+    Node *n = realloc(f->n, cap * sizeof(*n));
+    if (!n) {
+        return false;
+    }
+    f->n = n;
+    f->ncap = cap;
+    return true;
+}
+
+/* A folder's children (its table's size with them). In the root, the XBE to boot is there as
+ * default.xbe too, in the place of the folder's own default.xbe. */
+static bool node_list(NcFolder *f, uint32_t i)
+{
+    if (f->n[i].listed) {
+        return true;
+    }
+    f->n[i].listed = true;
+    f->n[i].size = SECTOR;
+    Gather g = {0};
+    const bool ok = f->io->list(f->n[i].host, gather, &g) && !g.nomem;
+    if (!ok) {
+        nc_log("hakuX-native", "disc: the folder %s can't be listed: read as empty", f->n[i].host);
+    }
+    if (ok && i == 0 && f->alias) {
+        const char *source = NULL;
+        uint64_t size = 0;
+        for (size_t k = 0; k < g.n; k++) {
+            if (!g.e[k].dir && !name_cmp(g.e[k].name, f->alias)) {
+                source = g.e[k].name;
+                size = g.e[k].size;
+            }
+        }
+        if (source) {
+            for (size_t k = 0; k < g.n; k++) {
+                if (!name_cmp(g.e[k].name, "default.xbe")) {
+                    free(g.e[k].name);
+                    g.e[k] = g.e[--g.n];
+                    break;
+                }
+            }
+            /* the host name of the XBE, as default.xbe: its node's host path is fixed below */
+            gather(&g, "default.xbe", false, size);
+        }
+    }
+    if (g.n) {
+        qsort(g.e, g.n, sizeof(*g.e), found_cmp);
+    }
+    uint32_t count = 0;
+    if (!grow_nodes(f, (uint32_t)g.n)) {
+        g.n = 0;
+    }
+    const uint32_t first = f->nn;
+    uint32_t off = 0;
+    for (size_t k = 0; k < g.n; k++) {
+        if (count && !name_cmp(g.e[k].name, f->n[first + count - 1].name)) {
+            continue;                   /* the same name but for its case (a case-sensitive host) */
+        }
+        if (!g.e[k].dir && g.e[k].size > 0xFFFFFFFFull) {
+            nc_log("hakuX-native", "disc: %s/%s is over 4 GiB: left out", f->n[i].host, g.e[k].name);
+            continue;
+        }
+        const uint32_t len = entry_len(g.e[k].name);
+        if (off % SECTOR + len > SECTOR) {
+            off = (off + SECTOR - 1) / SECTOR * SECTOR;
+        }
+        if (off > ENTRY_MAX_OFF) {
+            nc_log("hakuX-native", "disc: %s has more entries than a disc's folder holds: the rest left out",
+                   f->n[i].host);
+            break;
+        }
+        off += len;
+        Node *c = &f->n[first + count];
+        memset(c, 0, sizeof(*c));
+        const bool alias = i == 0 && f->alias && !name_cmp(g.e[k].name, "default.xbe");
+        c->name = strdup(alias ? "default.xbe" : g.e[k].name);
+        c->host = join(f->n[i].host, alias ? f->alias : g.e[k].name);
+        if (!c->name || !c->host) {
+            free(c->name);
+            free(c->host);
+            break;
+        }
+        c->dir = g.e[k].dir;
+        c->size = c->dir ? 0 : g.e[k].size;
+        count++;
+    }
+    for (size_t k = 0; k < g.n; k++) {
+        free(g.e[k].name);
+    }
+    free(g.e);
+    f->nn = first + count;
+    f->n[i].first = first;
+    f->n[i].count = count;
+    f->n[i].size = table_layout(f->n, first, count, NULL);
+    return ok;
+}
+
+/* The node's sectors handed out (a folder listed first: its table's size). */
+static bool node_place(NcFolder *f, uint32_t i)
+{
+    Node *n = &f->n[i];
+    if (n->placed) {
+        return true;
+    }
+    const uint64_t count = (n->size + SECTOR - 1) / SECTOR;
+    if (!count) {
+        n->placed = true;           /* an empty file: sector 0, nothing to read */
+        return true;
+    }
+    if ((uint64_t)f->next + count > 0xFFFFFFFFull) {
+        return false;
+    }
+    if (f->nx == f->xcap) {
+        const uint32_t cap = f->xcap ? f->xcap * 2 : 256;
+        Extent *x = realloc(f->x, cap * sizeof(*x));
+        if (!x) {
+            return false;
+        }
+        f->x = x;
+        f->xcap = cap;
+    }
+    n->sector = f->next;
+    n->placed = true;
+    f->x[f->nx++] = (Extent){f->next, (uint32_t)count, i};
+    f->next += (uint32_t)count;
+    return true;
+}
+
+static void wr16(uint8_t *p, uint32_t v)
+{
+    p[0] = (uint8_t)v;
+    p[1] = (uint8_t)(v >> 8);
+}
+
+static void wr32(uint8_t *p, uint32_t v)
+{
+    wr16(p, v);
+    wr16(p + 2, v >> 16);
+}
+
+/* A folder's table: its children placed (its folders listed for their tables' sizes), then their
+ * entries. */
+static bool node_build(NcFolder *f, uint32_t i)
+{
+    if (f->n[i].table) {
+        return true;
+    }
+    const uint32_t first = f->n[i].first, count = f->n[i].count;
+    for (uint32_t k = 0; k < count; k++) {
+        if (f->n[first + k].dir) {
+            node_list(f, first + k);
+        }
+        if (!node_place(f, first + k)) {
+            return false;
+        }
+    }
+    const uint32_t size = (uint32_t)f->n[i].size;
+    uint8_t *t = malloc(size);
+    uint32_t *offs = malloc((count ? count : 1) * sizeof(*offs));
+    if (!t || !offs) {
+        free(t);
+        free(offs);
+        return false;
+    }
+    memset(t, 0xFF, size);
+    table_layout(f->n, first, count, offs);
+    for (uint32_t k = 0; k < count; k++) {
+        const Node *c = &f->n[first + k];
+        uint8_t *e = t + offs[k];
+        const size_t len = strlen(c->name);
+        wr16(e, 0);
+        wr16(e + 2, k + 1 < count ? offs[k + 1] / 4u : 0);
+        wr32(e + 4, c->sector);
+        wr32(e + 8, (uint32_t)c->size);
+        e[12] = c->dir ? 0x10 : 0x20;
+        e[13] = (uint8_t)len;
+        memcpy(e + 14, c->name, len);
+    }
+    free(offs);
+    f->n[i].table = t;
+    return true;
+}
+
+static const Extent *extent_at(const NcFolder *f, uint32_t sector)
+{
+    uint32_t lo = 0, hi = f->nx;
+    while (lo < hi) {
+        const uint32_t mid = (lo + hi) / 2;
+        if (f->x[mid].sector <= sector) {
+            lo = mid + 1;
+        } else {
+            hi = mid;
+        }
+    }
+    if (!lo) {
+        return NULL;
+    }
+    const Extent *e = &f->x[lo - 1];
+    return sector < e->sector + e->count ? e : NULL;
+}
+
+/* A file's descriptor: kept open, the least used of FOLDER_OPEN_MAX closed for it. */
+static int file_fd(NcFolder *f, uint32_t node)
+{
+    OpenFile *spare = &f->open[0];
+    for (unsigned k = 0; k < FOLDER_OPEN_MAX; k++) {
+        OpenFile *o = &f->open[k];
+        if (o->fd >= 0 && o->node == node) {
+            o->used = ++f->tick;
+            return o->fd;
+        }
+        if (o->fd < 0 || (spare->fd >= 0 && o->used < spare->used)) {
+            spare = o;
+        }
+    }
+    if (spare->fd >= 0) {
+        f->io->close(spare->fd);
+        spare->fd = -1;
+    }
+    const int fd = f->io->open(f->n[node].host);
+    if (fd < 0) {
+        nc_log("hakuX-native", "disc: %s can't be opened", f->n[node].host);
+        return -1;
+    }
+    *spare = (OpenFile){node, fd, ++f->tick};
+    return fd;
+}
+
+static bool pread_all(int fd, uint8_t *p, size_t len, uint64_t off)
+{
+    while (len) {
+        const ssize_t n = pread(fd, p, len, (off_t)off);
+        if (n <= 0) {
+            return false;
+        }
+        p += n;
+        len -= (size_t)n;
+        off += (uint64_t)n;
+    }
+    return true;
+}
+
+bool nc_folder_read(NcFolder *f, void *buf, size_t len, uint64_t off)
+{
+    uint8_t *out = buf;
+    bool ok = true;
+    pthread_mutex_lock(&f->lock);
+    while (len && ok) {
+        const uint64_t sector64 = off / SECTOR;
+        const uint32_t in = (uint32_t)(off % SECTOR);
+        size_t n = SECTOR - in < len ? SECTOR - in : len;
+        if (sector64 < FIRST_SECTOR || sector64 > 0xFFFFFFFFull) {
+            if (sector64 == VD_SECTOR) {
+                memcpy(out, f->vd + in, n);
+            } else {
+                memset(out, 0, n);
+            }
+        } else {
+            const uint32_t sector = (uint32_t)sector64;
+            const Extent *e = extent_at(f, sector);
+            if (!e) {
+                memset(out, 0, n);      /* past what is handed out */
+            } else {
+                const uint64_t at = (uint64_t)(sector - e->sector) * SECTOR + in;
+                const uint64_t room = (uint64_t)e->count * SECTOR - at;
+                n = room < len ? (size_t)room : len;
+                const uint32_t node = e->node;
+                if (f->n[node].dir) {
+                    ok = node_build(f, node);
+                    if (ok) {
+                        memcpy(out, f->n[node].table + at, n);
+                    }
+                } else {
+                    const uint64_t size = f->n[node].size;
+                    const size_t data = at < size ? (size - at < n ? (size_t)(size - at) : n) : 0;
+                    if (data) {
+                        const int fd = file_fd(f, node);
+                        ok = fd >= 0 && pread_all(fd, out, data, at);
+                    }
+                    memset(out + data, 0, n - data);
+                }
+            }
+        }
+        out += n;
+        off += n;
+        len -= n;
+    }
+    pthread_mutex_unlock(&f->lock);
+    return ok;
+}
+
+static int posix_open(const char *path)
+{
+    return open(path, O_RDONLY | O_CLOEXEC);
+}
+
+static void posix_close(int fd)
+{
+    close(fd);
+}
+
+static bool posix_list(const char *path, void (*fn)(void *, const char *, bool, uint64_t), void *ctx)
+{
+    DIR *d = opendir(path);
+    if (!d) {
+        return false;
+    }
+    for (struct dirent *e; (e = readdir(d));) {
+        if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) {
+            continue;
+        }
+        char *p = join(path, e->d_name);
+        struct stat st;
+        if (p && stat(p, &st) == 0) {
+            fn(ctx, e->d_name, S_ISDIR(st.st_mode), S_ISREG(st.st_mode) ? (uint64_t)st.st_size : 0);
+        }
+        free(p);
+    }
+    closedir(d);
+    return true;
+}
+
+const NcFolderIo nc_folder_posix_io = {posix_open, posix_close, posix_list};
+
+NcFolder *nc_folder_open(const char *folder, const char *xbe, const NcFolderIo *io)
+{
+    NcFolder *f = calloc(1, sizeof(*f));
+    if (!f) {
+        return NULL;
+    }
+    f->io = io ? io : &nc_folder_posix_io;
+    pthread_mutex_init(&f->lock, NULL);
+    for (unsigned k = 0; k < FOLDER_OPEN_MAX; k++) {
+        f->open[k].fd = -1;
+    }
+    f->next = FIRST_SECTOR;
+    if (xbe && *xbe && name_cmp(xbe, "default.xbe")) {
+        f->alias = strdup(xbe);
+    }
+    if (!grow_nodes(f, 1)) {
+        nc_folder_close(f);
+        return NULL;
+    }
+    Node *root = &f->n[0];
+    memset(root, 0, sizeof(*root));
+    root->name = strdup("");
+    root->host = strdup(folder);
+    root->dir = true;
+    f->nn = 1;
+    if (!root->name || !root->host || !node_list(f, 0) || !node_place(f, 0)) {
+        nc_folder_close(f);
+        return NULL;
+    }
+    static const char magic[] = "MICROSOFT*XBOX*MEDIA";
+    memcpy(f->vd, magic, 20);
+    wr32(f->vd + 20, f->n[0].sector);
+    wr32(f->vd + 24, (uint32_t)f->n[0].size);
+    memcpy(f->vd + 0x7EC, magic, 20);
+    nc_log("hakuX-native", "disc: the folder %s read as a disc (%u entries at its root%s%s)", folder,
+           f->n[0].count, f->alias ? ", booting " : "", f->alias ? f->alias : "");
+    return f;
+}
+
+void nc_folder_close(NcFolder *f)
+{
+    if (!f) {
+        return;
+    }
+    for (unsigned k = 0; k < FOLDER_OPEN_MAX; k++) {
+        if (f->open[k].fd >= 0) {
+            f->io->close(f->open[k].fd);
+        }
+    }
+    for (uint32_t i = 0; i < f->nn; i++) {
+        free(f->n[i].name);
+        free(f->n[i].host);
+        free(f->n[i].table);
+    }
+    free(f->n);
+    free(f->x);
+    free(f->alias);
+    pthread_mutex_destroy(&f->lock);
+    free(f);
+}
