diff --git a/tests/hle/test_pvideo.c b/tests/hle/test_pvideo.c
new file mode 100644
index 0000000000000000000000000000000000000000..c2fdd329befd8525378579bd9476ab16e17f6a94
--- /dev/null
+++ b/tests/hle/test_pvideo.c
@@ -0,0 +1,200 @@
+/* Copyright (C) 2026-present PortareOS */
+/* PVIDEO register and YUV conversion tests. */
+#include "hw/xbox/hle/pb/pvideo.h"
+#include "hle_test.h"
+#include <string.h>
+
+#define WH(w, h) ((uint32_t)(w) | (uint32_t)(h) << 16)
+
+static bool near(float a, float b)
+{
+    return fabsf(a - b) < 1e-4f;
+}
+
+/* No scaling. */
+static void test_unity(void)
+{
+    HlePvideoRegs r = { .size_in = WH(640, 480), .ds_dx = HLE_PVIDEO_UNITY,
+                        .dt_dy = HLE_PVIDEO_UNITY, .size_out = WH(640, 480),
+                        .format = 0x10500 };
+    HlePvideo p = hle_pvideo_decode(&r);
+    HT_EQ_U32(p.in_w, 640);
+    HT_EQ_U32(p.in_h, 480);
+    HT_CHECK(p.scale_x == 1.0f && p.scale_y == 1.0f);
+    HT_CHECK(p.in_x == 0.0f && p.in_y == 0.0f);
+    HT_EQ_U32(p.out_w, 640);
+    HT_EQ_U32(p.out_h, 480);
+    HT_CHECK(!p.color_key_on);          /* 0x10500: YUY2, pitch 1280, no key */
+}
+
+/* Scale 480 input lines into SpyHunter's 437-line window. */
+static void test_shrink(void)
+{
+    HlePvideoRegs r = { .size_in = WH(640, 480), .ds_dx = HLE_PVIDEO_UNITY,
+                        .dt_dy = (480u << 20) / 437, .point_out = WH(0, 21),
+                        .size_out = WH(640, 437) };
+    HlePvideo p = hle_pvideo_decode(&r);
+    HT_EQ_U32(p.in_h, 480);
+    HT_CHECK(near(p.scale_y, 480.0f / 437.0f));
+    HT_EQ_U32(p.out_y, 21);
+    HT_EQ_U32(p.out_h, 437);
+    /* 720 wide into 640 (Worms 4: Mayhem): all 720 columns */
+    r = (HlePvideoRegs){ .size_in = WH(720, 480), .ds_dx = (720u << 20) / 640,
+                         .dt_dy = HLE_PVIDEO_UNITY, .size_out = WH(640, 480) };
+    p = hle_pvideo_decode(&r);
+    HT_EQ_U32(p.in_w, 720);
+    HT_CHECK(near(p.scale_x, 1.125f));
+}
+
+/* Cap oversized inputs and stretch smaller ones. */
+static void test_cap(void)
+{
+    HlePvideoRegs r = { .size_in = WH(1024, 1024), .ds_dx = HLE_PVIDEO_UNITY,
+                        .dt_dy = HLE_PVIDEO_UNITY, .size_out = WH(640, 480) };
+    HlePvideo p = hle_pvideo_decode(&r);
+    HT_EQ_U32(p.in_w, 640);
+    HT_EQ_U32(p.in_h, 480);
+    r = (HlePvideoRegs){ .size_in = WH(640, 448), .ds_dx = HLE_PVIDEO_UNITY,
+                         .dt_dy = (448u << 20) / 480, .size_out = WH(640, 480) };
+    p = hle_pvideo_decode(&r);
+    HT_EQ_U32(p.in_h, 448);
+    HT_CHECK(near(p.scale_y, 448.0f / 480.0f));
+    /* from POINT_IN on: 720 columns shown from x 80 at unity in a 640
+     * window read all 720, rows from y 16 their 16 more */
+    r = (HlePvideoRegs){ .size_in = WH(720, 576), .point_in = (80u * 16) | (16u * 16) << 16,
+                         .ds_dx = HLE_PVIDEO_UNITY, .dt_dy = HLE_PVIDEO_UNITY,
+                         .size_out = WH(640, 480) };
+    p = hle_pvideo_decode(&r);
+    HT_EQ_U32(p.in_w, 720);
+    HT_EQ_U32(p.in_h, 496);
+    r.size_in = WH(2047, 2047);         /* still SIZE_IN's at most, and no more than needed */
+    p = hle_pvideo_decode(&r);
+    HT_EQ_U32(p.in_w, 720);
+    HT_EQ_U32(p.in_h, 496);
+    r.size_in = WH(700, 480);
+    p = hle_pvideo_decode(&r);
+    HT_EQ_U32(p.in_w, 700);
+    HT_EQ_U32(p.in_h, 480);
+}
+
+/* Fractional POINT_IN coordinates and colour-key enable bit. */
+static void test_point_in_key(void)
+{
+    HlePvideoRegs r = { .size_in = WH(640, 480), .point_in = (8u * 16 + 8) | (4u * 16 + 3) << 16,
+                        .ds_dx = HLE_PVIDEO_UNITY, .dt_dy = HLE_PVIDEO_UNITY,
+                        .size_out = WH(640, 480), .format = 0x110500, .color_key = 0xFF101010 };
+    HlePvideo p = hle_pvideo_decode(&r);
+    HT_CHECK(near(p.in_x, 8.5f));
+    HT_CHECK(near(p.in_y, 4.125f));
+    HT_CHECK(p.color_key_on);
+    HT_EQ_U32(p.color_key, 0xFF101010);
+}
+
+static uint8_t clip8(int v)
+{
+    return v < 0 ? 0 : v > 255 ? 255 : (uint8_t)v;
+}
+
+/* Colour controls, BT.709 and bit-exact default BT.601 conversion. */
+static void test_color(void)
+{
+    HlePvideoRegs r = { .size_in = WH(640, 480), .size_out = WH(640, 480),
+                        .luminance = 0xFFC00800, .chrominance = 0x0800F800, .format = 0x1010500 };
+    HlePvideo p = hle_pvideo_decode(&r);
+    HT_EQ_INT(p.color.contrast, 0x800);
+    HT_EQ_INT(p.color.brightness, -64);
+    HT_EQ_INT(p.color.sat_cos, -0x800);
+    HT_EQ_INT(p.color.sat_sin, 0x800);
+    HT_CHECK(p.color.bt709);
+    r.luminance = r.chrominance = HLE_PVIDEO_ONE;
+    r.format = 0x10500;
+    p = hle_pvideo_decode(&r);
+    HT_CHECK(hle_pvideo_color_default(&p.color));
+    unsigned bad = 0;
+    for (int Y = 0; Y < 256; Y++) {
+        for (int U = 0; U < 256; U++) {
+            for (int V = 0; V < 256; V++) {
+                const int y = Y - 16, u = U - 128, v = V - 128, c = 298 * y;
+                uint8_t q[3];
+                hle_pvideo_yuv(&p.color, Y, U, V, q);
+                bad += q[0] != clip8((c + 516 * u + 128) >> 8) ||
+                       q[1] != clip8((c - 100 * u - 208 * v + 128) >> 8) ||
+                       q[2] != clip8((c + 409 * v + 128) >> 8);
+            }
+        }
+    }
+    HT_EQ_U32(bad, 0);
+    /* BT.709: white, black, and its red (Y 63, Cb 102, Cr 240) */
+    HlePvideoColor c = { HLE_PVIDEO_ONE, 0, HLE_PVIDEO_ONE, 0, true };
+    uint8_t q[3];
+    hle_pvideo_yuv(&c, 235, 128, 128, q);
+    HT_CHECK(q[0] == 255 && q[1] == 255 && q[2] == 255);
+    hle_pvideo_yuv(&c, 16, 128, 128, q);
+    HT_CHECK(q[0] == 0 && q[1] == 0 && q[2] == 0);
+    hle_pvideo_yuv(&c, 63, 102, 240, q);
+    HT_CHECK(q[2] >= 254 && q[1] <= 1 && q[0] <= 1);
+    /* half contrast: white is mid grey; no saturation: grey whatever U, V;
+     * a half turn of the hue: U and V negated */
+    c = (HlePvideoColor){ 0x800, 0, HLE_PVIDEO_ONE, 0, false };
+    hle_pvideo_yuv(&c, 235, 128, 128, q);
+    HT_CHECK(q[0] == q[1] && q[1] == q[2] && q[0] >= 126 && q[0] <= 129);
+    c = (HlePvideoColor){ HLE_PVIDEO_ONE, 0, 0, 0, false };
+    hle_pvideo_yuv(&c, 100, 30, 220, q);
+    HT_CHECK(q[0] == q[1] && q[1] == q[2]);
+    uint8_t n[3];
+    c = (HlePvideoColor){ HLE_PVIDEO_ONE, 0, -HLE_PVIDEO_ONE, 0, false };
+    hle_pvideo_yuv(&c, 100, 30, 220, q);
+    c.sat_cos = HLE_PVIDEO_ONE;
+    hle_pvideo_yuv(&c, 100, 226, 36, n);
+    HT_CHECK(q[0] == n[0] && q[1] == n[1] && q[2] == n[2]);
+}
+
+/* Odd-width YUY2/UYVY: every pixel is written in both colour paths. */
+static void test_convert_odd(void)
+{
+    uint8_t src[2 * 64];
+    for (unsigned i = 0; i < sizeof(src); i++) {
+        src[i] = (uint8_t)(16 + (i * 37) % 220);
+    }
+    const HlePvideoColor def = { HLE_PVIDEO_ONE, 0, HLE_PVIDEO_ONE, 0, false };
+    const HlePvideoColor warm = { 0x1200, 8, 0xF00, 0x100, true };
+    const HlePvideoColor *cs[3] = { NULL, &def, &warm };
+    uint8_t ref[3 * 2 * 4];
+    for (unsigned uyvy = 0; uyvy < 2; uyvy++) {
+        for (unsigned ci = 0; ci < 3; ci++) {
+            uint8_t dst[3 * 2 * 4];
+            memset(dst, 0xCD, sizeof(dst));
+            hle_pvideo_convert(src, 64, 3, 2, uyvy, cs[ci], dst);
+            unsigned unwritten = 0;
+            for (unsigned i = 0; i < 6; i++) {
+                unwritten += dst[4 * i + 3] != 255;
+            }
+            HT_EQ_U32(unwritten, 0);
+            /* the last pixel of each row: the second pair's first Y */
+            for (unsigned row = 0; row < 2; row++) {
+                const uint8_t *l = src + row * 64 + 4;
+                const int Y = uyvy ? l[1] : l[0], U = uyvy ? l[0] : l[1], V = uyvy ? l[2] : l[3];
+                uint8_t q[3];
+                hle_pvideo_yuv(cs[ci] ? cs[ci] : &def, Y, U, V, q);
+                const uint8_t *o = dst + (row * 3 + 2) * 4;
+                HT_CHECK(o[0] == q[0] && o[1] == q[1] && o[2] == q[2]);
+            }
+            if (ci == 0) {
+                memcpy(ref, dst, sizeof(ref));
+            } else if (ci == 1) {
+                HT_CHECK(memcmp(ref, dst, sizeof(ref)) == 0);  /* the defaults: as plain */
+            }
+        }
+    }
+}
+
+int main(void)
+{
+    HT_RUN(test_unity);
+    HT_RUN(test_shrink);
+    HT_RUN(test_cap);
+    HT_RUN(test_point_in_key);
+    HT_RUN(test_color);
+    HT_RUN(test_convert_odd);
+    HT_DONE();
+}
diff --git a/tests/hle/test_rsqrt.c b/tests/hle/test_rsqrt.c
new file mode 100644
index 0000000000000000000000000000000000000000..c8faf3bc42af595da3a6d86767d7e893e4b13db3
--- /dev/null
+++ b/tests/hle/test_rsqrt.c
@@ -0,0 +1,252 @@
+/* Copyright (C) 2026-present PortareOS */
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* native/cpu/rsqrt.c, the native CPU's RSQRT sites (NC_RSQRT_SITES): the
+ * operand decoder, Intel's reference (Bochs' tables) and the XOR correction
+ * index, from this host's estimates and from synthetic ones (an AMD host's
+ * kind on any host). After hakuX-lr's tests/native/kvm/rsqrt_test.c (#219).
+ * `test_rsqrt --exhaustive` checks every binary32 bit pattern through this
+ * host's index against the reference. */
+#include "native/cpu/rsqrt.h"
+#include "hle_test.h"
+
+#include <emmintrin.h>
+#include <stdlib.h>
+
+static const uint32_t k_regs[8] = {0x100, 0x20, 0x30, 0xFFE0, 0x400, 0x500, 0x40, 0x50};
+
+static void test_decoder(void)
+{
+    NcRsqrtInsn in;
+    const uint8_t scalar[] = {0xF3, 0x0F, 0x52, 0xD9}; /* rsqrtss xmm3, xmm1 */
+    HT_CHECK(nc_rsqrt_decode(scalar, sizeof(scalar), k_regs, 0, 0, &in));
+    HT_CHECK(in.scalar && !in.mem);
+    HT_EQ_INT(in.len, 4);
+    HT_EQ_INT(in.dst, 3);
+    HT_EQ_INT(in.src, 1);
+    const uint8_t packed[] = {0x0F, 0x52, 0xE7}; /* rsqrtps xmm4, xmm7 */
+    HT_CHECK(nc_rsqrt_decode(packed, sizeof(packed), k_regs, 0, 0, &in));
+    HT_CHECK(!in.scalar && !in.mem);
+    HT_EQ_INT(in.len, 3);
+    HT_EQ_INT(in.dst, 4);
+    HT_EQ_INT(in.src, 7);
+    /* fs:[eax + ecx*4 - 16] */
+    const uint8_t sib[] = {0x64, 0xF3, 0x0F, 0x52, 0x5C, 0x88, 0xF0};
+    HT_CHECK(nc_rsqrt_decode(sib, sizeof(sib), k_regs, 0x7000, 0, &in) && in.mem);
+    HT_EQ_INT(in.len, sizeof(sib));
+    HT_EQ_U32(in.address, 0x7170);
+    /* gs:[eax + ecx*4 - 16]: the native CPU's GS is based at the KPCR too */
+    const uint8_t gs[] = {0x65, 0xF3, 0x0F, 0x52, 0x5C, 0x88, 0xF0};
+    HT_CHECK(nc_rsqrt_decode(gs, sizeof(gs), k_regs, 0x7000, 0x9000, &in) && in.mem);
+    HT_EQ_U32(in.address, 0x9170);
+    /* the last override wins: fs: then ds: is flat */
+    const uint8_t fs_ds[] = {0x64, 0x3E, 0x0F, 0x52, 0x00};
+    HT_CHECK(nc_rsqrt_decode(fs_ds, sizeof(fs_ds), k_regs, 0x7000, 0x9000, &in));
+    HT_EQ_U32(in.address, 0x100);
+    const uint8_t absolute[] = {0x0F, 0x52, 0x05, 0x40, 0x30, 0x20, 0x10}; /* [0x10203040] */
+    HT_CHECK(nc_rsqrt_decode(absolute, sizeof(absolute), k_regs, 0, 0, &in) && in.mem);
+    HT_EQ_U32(in.address, 0x10203040u);
+    HT_EQ_INT(in.len, sizeof(absolute));
+    const uint8_t esp[] = {0xF3, 0x0F, 0x52, 0x44, 0x24, 0x08}; /* [esp + 8] */
+    HT_CHECK(nc_rsqrt_decode(esp, sizeof(esp), k_regs, 0, 0, &in) && in.mem);
+    HT_EQ_U32(in.address, 0x408);
+    HT_EQ_INT(in.dst, 0);
+    const uint8_t ebp[] = {0x0F, 0x52, 0x95, 0x00, 0xFF, 0xFF, 0xFF}; /* xmm2, [ebp - 0x100] */
+    HT_CHECK(nc_rsqrt_decode(ebp, sizeof(ebp), k_regs, 0, 0, &in) && in.mem);
+    HT_EQ_U32(in.address, 0x400);
+    HT_EQ_INT(in.dst, 2);
+    const uint8_t scaled[] = {0x0F, 0x52, 0x0C, 0xF5, 0x00, 0x10, 0x00, 0x00}; /* xmm1, [esi*8 + 0x1000] */
+    HT_CHECK(nc_rsqrt_decode(scaled, sizeof(scaled), k_regs, 0, 0, &in) && in.mem);
+    HT_EQ_U32(in.address, 0x1200);
+    HT_EQ_INT(in.len, sizeof(scaled));
+    const uint8_t addr16[] = {0x67, 0xF3, 0x0F, 0x52, 0x00}; /* [bx + si], wrapped at 64 KiB */
+    HT_CHECK(nc_rsqrt_decode(addr16, sizeof(addr16), k_regs, 0, 0, &in));
+    HT_EQ_U32(in.address, 0x20);
+    const uint8_t abs16[] = {0x64, 0x67, 0x0F, 0x52, 0x06, 0xCD, 0xAB}; /* fs:[0xABCD] */
+    HT_CHECK(nc_rsqrt_decode(abs16, sizeof(abs16), k_regs, 0x10000, 0, &in));
+    HT_EQ_U32(in.address, 0x1ABCD);
+    bool truncated = true;
+    for (unsigned i = 0; i < sizeof(sib); i++) {
+        truncated &= !nc_rsqrt_decode(sib, i, k_regs, 0, 0, &in);
+    }
+    HT_CHECK(truncated); /* prefixes, opcode, ModRM, SIB and displacement cut short */
+    /* other opcodes and the prefixes RSQRT doesn't take */
+    const uint8_t wrong[][4] = {{0xF2, 0x0F, 0x52, 0xC0}, {0x66, 0x0F, 0x52, 0xC0},
+                                {0xF0, 0x0F, 0x52, 0xC0}, {0xF3, 0x0F, 0x51, 0xC0},
+                                {0xF3, 0x0F, 0x53, 0xC0}, {0xCC, 0x0F, 0x52, 0xC0}};
+    for (unsigned i = 0; i < sizeof(wrong) / sizeof(wrong[0]); i++) {
+        HT_CHECK(!nc_rsqrt_decode(wrong[i], sizeof(wrong[i]), k_regs, 0, 0, &in));
+    }
+    const uint8_t too_long[] = {0x64, 0x64, 0x64, 0x64, 0x64, 0x64, 0x64, 0x64,
+                                0x64, 0x64, 0x64, 0x64, 0x64, 0xF3, 0x0F, 0x52, 0xC0};
+    HT_CHECK(!nc_rsqrt_decode(too_long, sizeof(too_long), k_regs, 0, 0, &in)); /* 15 bytes at most */
+}
+
+/* The values the reference must give: the four inputs Xbox code saw differ,
+ * Intel Skylake's published rsqrt(256), Bochs' results for the range's
+ * ends and pi, the special values. */
+static const struct { uint32_t input, expected; } k_cases[] = {
+    {0x3F800000, 0x3F7FF000}, {0x40800000, 0x3EFFF000},
+    {0x3E800000, 0x3FFFF000}, {0x41800000, 0x3E7FF000},
+    {0x43800000, 0x3D7FF000},
+    {0x00800000, 0x5EFFF000}, {0x7F7FFFFF, 0x1F800800}, {0x40490FDB, 0x3F107000},
+    {0, 0x7F800000}, {0x80000000, 0xFF800000},
+    {1, 0x7F800000}, {0x807FFFFF, 0xFF800000},
+    {0x7F800000, 0}, {0xFF800000, 0xFFC00000},
+    {0xBF800000, 0xFFC00000}, {0x7F800001, 0x7FC00001},
+    {0xFF800123, 0xFFC00123}, {0x7FC12345, 0x7FC12345},
+};
+
+static void test_reference(void)
+{
+    for (unsigned i = 0; i < sizeof(k_cases) / sizeof(k_cases[0]); i++) {
+        HT_EQ_U32(nc_rsqrt_intel(k_cases[i].input), k_cases[i].expected);
+    }
+    /* Every table entry through the reference: the mantissas, FNV-1a, as
+     * Bochs' cpu/sse_rcp.cc (blob e8a777a0) has them (entry << 8): an edit
+     * of intel_rsqrt_table.inc shows here. */
+    uint32_t h = 2166136261u;
+    for (uint32_t k = 0; k < 2048; k++) {
+        const uint32_t bits = (126u + (k >> 10)) << 23 | (k & 1023u) << 13;
+        const uint32_t m = nc_rsqrt_intel(bits) & 0x7FFFFFu;
+        HT_CHECK((m & 0x7FFu) == 0); /* 12-bit estimates */
+        for (unsigned b = 0; b < 4; b++) {
+            h = (h ^ ((m >> (8 * b)) & 0xFFu)) * 16777619u;
+        }
+    }
+    HT_EQ_U32(h, 0xCEC24648u);
+    /* one result for a whole bucket: the index's premise */
+    bool flat = true;
+    for (uint32_t b = 0x3F000; b < 0x3F800; b += 7) {
+        flat &= nc_rsqrt_intel(b << 11) == nc_rsqrt_intel(b << 11 | 2047u);
+    }
+    HT_CHECK(flat);
+}
+
+static uint32_t next(uint32_t *x)
+{
+    *x ^= *x << 13;
+    *x ^= *x >> 17;
+    *x ^= *x << 5;
+    return *x;
+}
+
+/* The index from this host's own estimates (an Intel host's: one XOR, 0). */
+static void test_index_host(void)
+{
+    NcRsqrt r;
+    HT_CHECK(nc_rsqrt_init(&r));
+    if (!r.index) {
+        return;
+    }
+    printf("  host: %s, %u distinct XOR corrections\n", nc_rsqrt_host_amd() ? "AMD" : "not AMD", r.ndelta);
+    for (unsigned i = 0; i < sizeof(k_cases) / sizeof(k_cases[0]); i++) {
+        HT_EQ_U32(nc_rsqrt_correct(&r, k_cases[i].input), k_cases[i].expected);
+    }
+    uint32_t x = 1;
+    unsigned bad = 0;
+    for (uint32_t i = 0; i < (1u << 21); i++) {
+        const uint32_t bits = next(&x);
+        bad += nc_rsqrt_correct(&r, bits) != nc_rsqrt_intel(bits);
+        bad += nc_rsqrt_correct(&r, i << 11) != nc_rsqrt_intel(i << 11);
+        bad += nc_rsqrt_correct(&r, i << 11 | 2047u) != nc_rsqrt_intel(i << 11 | 2047u);
+    }
+    HT_EQ_INT(bad, 0);
+    /* the guest's MXCSR (rounding, sticky flags) is neither read nor changed */
+    const unsigned saved = _mm_getcsr();
+    for (unsigned rc = 0; rc < 4; rc++) {
+        const unsigned want = 0x1F95u | (rc << 13);
+        _mm_setcsr(want);
+        const uint32_t got = nc_rsqrt_correct(&r, 0x3F800000);
+        const unsigned now = _mm_getcsr();
+        _mm_setcsr(saved);
+        HT_EQ_U32(got, 0x3F7FF000);
+        HT_EQ_U32(now, want);
+    }
+    nc_rsqrt_destroy(&r);
+    HT_CHECK(!r.index && !r.ndelta);
+}
+
+/* An estimator unlike Intel's in some buckets' last bits, as AMD's is: one
+ * of eight XORs a bucket, the specials Intel's. */
+static uint32_t fake_bucketed(uint32_t bits)
+{
+    const uint32_t e = nc_rsqrt_intel(bits);
+    const uint32_t b = bits >> 11;
+    if ((bits & 0x7FFFFFFFu) < 0x00800000u || (bits & 0x7FFFFFFFu) >= 0x7F800000u || (bits >> 31)) {
+        return e;
+    }
+    return e ^ (((b * 2654435761u) >> 29) << 11);
+}
+
+/* A difference inside a bucket: no XOR per bucket corrects it. */
+static uint32_t fake_unbucketed(uint32_t bits)
+{
+    return nc_rsqrt_intel(bits) ^ (bits & 1);
+}
+
+/* 512 differences: more than the palette holds. */
+static uint32_t fake_wide(uint32_t bits)
+{
+    return nc_rsqrt_intel(bits) ^ (((bits >> 11) & 0x1FFu) << 2);
+}
+
+static void test_index_synthetic(void)
+{
+    NcRsqrt r;
+    HT_CHECK(nc_rsqrt_build(&r, fake_bucketed));
+    HT_EQ_INT(r.ndelta, 8);
+    if (r.index) {
+        uint32_t x = 7;
+        unsigned bad = 0, differ = 0;
+        for (uint32_t i = 0; i < (1u << 21); i++) {
+            const uint32_t bits = next(&x);
+            differ += fake_bucketed(bits) != nc_rsqrt_intel(bits);
+            bad += nc_rsqrt_fix(&r, bits, fake_bucketed(bits)) != nc_rsqrt_intel(bits);
+            bad += nc_rsqrt_fix(&r, i << 11, fake_bucketed(i << 11)) != nc_rsqrt_intel(i << 11);
+            bad += nc_rsqrt_fix(&r, i << 11 | 2047u, fake_bucketed(i << 11 | 2047u)) != nc_rsqrt_intel(i << 11 | 2047u);
+        }
+        HT_CHECK(differ > (1u << 19)); /* most inputs were wrong before */
+        HT_EQ_INT(bad, 0);
+        for (unsigned i = 0; i < sizeof(k_cases) / sizeof(k_cases[0]); i++) {
+            HT_EQ_U32(nc_rsqrt_fix(&r, k_cases[i].input, fake_bucketed(k_cases[i].input)), k_cases[i].expected);
+        }
+    }
+    nc_rsqrt_destroy(&r);
+    HT_CHECK(!nc_rsqrt_build(&r, fake_unbucketed));
+    HT_CHECK(!r.index && !r.ndelta);
+    HT_CHECK(!nc_rsqrt_build(&r, fake_wide));
+    HT_CHECK(!r.index && !r.ndelta);
+}
+
+static void test_exhaustive(void)
+{
+    NcRsqrt r;
+    HT_CHECK(nc_rsqrt_init(&r));
+    if (!r.index) {
+        return;
+    }
+    for (uint64_t i = 0; i < (1ull << 32); i++) {
+        const uint32_t bits = (uint32_t)i;
+        if (nc_rsqrt_correct(&r, bits) != nc_rsqrt_intel(bits)) {
+            HT_EQ_U32(nc_rsqrt_correct(&r, bits), nc_rsqrt_intel(bits));
+            break;
+        }
+        if ((i & ((1u << 28) - 1)) == (1u << 28) - 1) {
+            printf("  checked %llu / 4294967296 bit patterns\n", (unsigned long long)i + 1);
+        }
+    }
+    nc_rsqrt_destroy(&r);
+}
+
+int main(int argc, char **argv)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    HT_RUN(test_decoder);
+    HT_RUN(test_reference);
+    HT_RUN(test_index_host);
+    HT_RUN(test_index_synthetic);
+    if (argc == 2 && !strcmp(argv[1], "--exhaustive")) {
+        HT_RUN(test_exhaustive);
+    }
+    HT_DONE();
+}
diff --git a/tests/hle/test_rtl_fmt.c b/tests/hle/test_rtl_fmt.c
new file mode 100644
index 0000000000000000000000000000000000000000..d7de77416641117d27a9d4cce6e01e5709ce63ee
--- /dev/null
+++ b/tests/hle/test_rtl_fmt.c
@@ -0,0 +1,328 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Host test of native/kernel/rtl_fmt.h, the kernel's printf family
+ * (RtlSprintf, RtlSnprintf, RtlVsprintf, RtlVsnprintf): its printf part of
+ * hakuX-lr's tests/native/rtl/text_test.c (39db3c4403), as it was.
+ */
+#include "native/kernel/rtl_fmt.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+static int g_fail, g_pass;
+
+static void check(int ok, const char *fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt);
+    if (!ok) {
+        printf("FAIL ");
+        vprintf(fmt, ap);
+        printf("\n");
+    }
+    va_end(ap);
+    g_fail += !ok;
+    g_pass += !!ok;
+}
+
+/* ------------------------------------------------------------ printf */
+
+#define MEM_BASE 0x10000u
+static uint8_t g_mem[4096];
+static size_t g_mem_used;
+
+typedef struct FakeArgs {
+    const uint32_t *w;
+    size_t n, i;
+} FakeArgs;
+
+static uint32_t fake_arg(void *ctx)
+{
+    FakeArgs *a = ctx;
+    return a->i < a->n ? a->w[a->i++] : 0;
+}
+
+static void *fake_mem(void *ctx, uint32_t va)
+{
+    (void)ctx;
+    return va ? &g_mem[va - MEM_BASE] : NULL;
+}
+
+static uint32_t mem_put(const void *p, size_t n)
+{
+    g_mem_used = (g_mem_used + 3) & ~(size_t)3;
+    memcpy(&g_mem[g_mem_used], p, n);
+    const uint32_t va = MEM_BASE + (uint32_t)g_mem_used;
+    g_mem_used += n;
+    return va;
+}
+
+static uint32_t str(const char *s)
+{
+    return mem_put(s, strlen(s) + 1);
+}
+
+/* A terminated UTF-16 string. */
+static uint32_t wstr(const uint16_t *s)
+{
+    size_t n = 0;
+    while (s[n]) {
+        n++;
+    }
+    return mem_put(s, (n + 1) * 2);
+}
+
+/* A STRING / UNICODE_STRING. */
+static uint32_t counted(uint16_t len, uint16_t max, uint32_t buf)
+{
+    uint8_t h[8];
+    memcpy(h, &len, 2);
+    memcpy(h + 2, &max, 2);
+    memcpy(h + 4, &buf, 4);
+    return mem_put(h, 8);
+}
+
+static uint32_t dlo(double d)
+{
+    uint64_t b;
+    memcpy(&b, &d, 8);
+    return (uint32_t)b;
+}
+
+static uint32_t dhi(double d)
+{
+    uint64_t b;
+    memcpy(&b, &d, 8);
+    return (uint32_t)(b >> 32);
+}
+
+static double bits(uint64_t b)
+{
+    double d;
+    memcpy(&d, &b, 8);
+    return d;
+}
+
+/* want: the text (want_len bytes); terminated if the call should write one. */
+static void fmt_check(const char *want, size_t want_len, int want_ret, size_t cap, const char *fmt,
+                      const uint32_t *w, size_t n)
+{
+    char out[1024];
+    memset(out, 0x7E, sizeof(out));
+    FakeArgs a = {w, n, 0};
+    const NcRtlFmtIo io = {&a, fake_arg, fake_mem};
+    const int r = nc_rtl_vsnprintf(out, cap, fmt, &io);
+    const bool terminated = want_ret >= 0 && (size_t)want_ret < cap;
+    const bool ok = r == want_ret && !memcmp(out, want, want_len) &&
+                    (terminated ? out[want_len] == 0 : out[want_len] == 0x7E) && a.i == n;
+    check(ok, "printf(\"%s\") cap %zu -> \"%.*s\" %d%s (got \"%.*s\" %d, %zu of %zu args)", fmt,
+          cap == SIZE_MAX ? 0 : cap, (int)want_len, want, want_ret, terminated ? "" : " unterminated",
+          r < 0 ? (int)(cap < 64 ? cap : 64) : r, out, r, a.i, n);
+}
+
+#define PF(want, fmt, ...)                                                                                     \
+    do {                                                                                                       \
+        const uint32_t w_[] = {0, __VA_ARGS__};                                                                \
+        fmt_check(want, strlen(want), (int)strlen(want), 1024, fmt, w_ + 1, sizeof(w_) / 4 - 1);               \
+    } while (0)
+
+#define PFN(want, ret, cap, fmt, ...)                                                                          \
+    do {                                                                                                       \
+        const uint32_t w_[] = {0, __VA_ARGS__};                                                                \
+        fmt_check(want, strlen(want), ret, cap, fmt, w_ + 1, sizeof(w_) / 4 - 1);                              \
+    } while (0)
+
+static void test_printf_int(void)
+{
+    PF("plain text", "plain text");
+    PF("42", "%d", 42);
+    PF("-42", "%d", (uint32_t)-42);
+    PF("-2147483648", "%i", 0x80000000u);
+    PF("4294967295", "%u", 0xFFFFFFFFu);
+    PF("abcdef", "%x", 0xABCDEF);
+    PF("ABCDEF", "%X", 0xABCDEF);
+    PF("10", "%o", 8);
+    PF("010", "%#o", 8);
+    PF("0", "%#o", 0);
+    PF("0xff", "%#x", 255);
+    PF("0XFF", "%#X", 255);
+    PF("0", "%#x", 0);
+    PF("   42", "%5d", 42);
+    PF("42   |", "%-5d|", 42);
+    PF("00042", "%05d", 42);
+    PF("-0042", "%05d", (uint32_t)-42);
+    PF("42   |", "%-05d|", 42);
+    PF("+42", "%+d", 42);
+    PF(" 42", "% d", 42);
+    PF("+42", "%+ d", 42);
+    PF("42", "%+u", 42);
+    PF("0x002a", "%#06x", 42);
+    PF("007", "%.3d", 7);
+    PF("-007", "%.3d", (uint32_t)-7);
+    PF("     007", "%08.3d", 7);
+    PF("", "%.0d", 0);
+    PF("     |", "%5.0d|", 0);
+    PF("   42", "%*d", 5, 42);
+    PF("42   |", "%*d|", (uint32_t)-5, 42);
+    PF("007", "%.*d", 3, 7);
+    PF("7", "%.*d", (uint32_t)-1, 7);
+    PF("22136", "%hd", 0x12345678);
+    PF("-1", "%hd", 0xFFFF);
+    PF("65535", "%hu", 0xFFFFFFFFu);
+    PF("2345", "%hx", 0x12345);
+    PF("-1", "%ld", 0xFFFFFFFFu);
+    PF("-1234567890123", "%I64d", (uint32_t)-1234567890123ll, (uint32_t)((uint64_t)-1234567890123ll >> 32));
+    PF("18446744073709551615", "%I64u", 0xFFFFFFFFu, 0xFFFFFFFFu);
+    PF("123456789abcdef0", "%I64x", 0x9ABCDEF0u, 0x12345678u);
+    PF("-1234567890123", "%lld", (uint32_t)-1234567890123ll, (uint32_t)((uint64_t)-1234567890123ll >> 32));
+    PF("  0x100000000", "%#13I64x", 0, 1);
+    PF("-1", "%I32d", 0xFFFFFFFFu);
+    PF("5", "%Id", 5);
+    PF("aIqb", "a%Iqb");
+    PF("00001234", "%p", 0x1234);
+    PF("DEADBEEF", "%p", 0xDEADBEEFu);
+    PF("1 2 3", "%d %d %d", 1, 2, 3);
+    PF("x=-5, y=0x10", "x=%d, y=%#x", (uint32_t)-5, 16);
+}
+
+static void test_printf_text(void)
+{
+    const uint32_t hello = str("hello");
+    const uint32_t ab = str("ab");
+    static const uint16_t wide[] = {'w', 0xE9, 0x263A, 0};
+    const uint32_t w = wstr(wide);
+    const uint32_t ansi = counted(3, 8, str("abcdef"));
+    static const uint16_t wz[] = {'U', 'n', 'i', 0x416, 0};
+    const uint32_t uni = counted(8, 10, wstr(wz));
+    const uint32_t nobuf = counted(3, 3, 0);
+
+    PF("A", "%c", 'A');
+    PF("  A", "%3c", 'A');
+    PF("A  |", "%-3c|", 'A');
+    PF("\xE9", "%C", 0xE9);
+    PF("?", "%C", 0x263A);
+    PF("A", "%lc", 'A');
+    PF("?", "%wc", 0x3A9);
+    PF("A", "%hC", 0x141);
+    PF("A", "%c", 0x141);
+    fmt_check("a\0b", 3, 3, 1024, "a%cb", (const uint32_t[]){0}, 1);
+    PF("hello", "%s", hello);
+    PF("hel", "%.3s", hello);
+    PF("   hello", "%8s", hello);
+    PF("hello   |", "%-8s|", hello);
+    PF("hello", "%2s", hello);
+    PF("000ab", "%05s", ab);
+    PF("(null)", "%s", 0);
+    PF("(n", "%.2s", 0);
+    PF("w\xE9?", "%S", w);
+    PF("w\xE9?", "%ws", w);
+    PF("w\xE9?", "%ls", w);
+    PF("w\xE9", "%.2S", w);
+    PF("  w\xE9?", "%5S", w);
+    PF("hello", "%hS", hello);
+    PF("hello", "%hs", hello);
+    PF("(null)", "%S", 0);
+    PF("abc", "%Z", ansi);
+    PF("   abc", "%6Z", ansi);
+    PF("abc", "%.1Z", ansi);
+    PF("Uni?", "%wZ", uni);
+    PF("(null)", "%Z", 0);
+    PF("(null)", "%Z", nobuf);
+    PF("(null)", "%wZ", 0);
+    PF("hello, w\xE9?: abc", "%s, %S: %Z", hello, w, ansi);
+
+    /* %n */
+    const uint32_t cnt = mem_put("\x55\x55\x55\x55\x55\x55", 6);
+    PF("abc", "abc%n", cnt);
+    int32_t v;
+    memcpy(&v, &g_mem[cnt - MEM_BASE], 4);
+    check(v == 3 && g_mem[cnt - MEM_BASE + 4] == 0x55, "%%n stores the count (%d)", v);
+    memset(&g_mem[cnt - MEM_BASE], 0x55, 6);
+    PF("hello!", "%s!%hn", hello, cnt);
+    int16_t h;
+    memcpy(&h, &g_mem[cnt - MEM_BASE], 2);
+    check(h == 6 && g_mem[cnt - MEM_BASE + 2] == 0x55, "%%hn stores 16 bits (%d)", h);
+
+    /* not conversions */
+    PF("%", "%%");
+    PF("100%", "100%%");
+    PF("%", "%5%");
+    PF("y", "%y");
+    PF("y", "%-y");
+    PF("abc", "abc%");
+    PF("abc", "abc%-5");
+}
+
+static void test_printf_float(void)
+{
+    PF("3.140000", "%f", dlo(3.14), dhi(3.14));
+    PF("2.50", "%.2f", dlo(2.5), dhi(2.5));
+    PF("3", "%.0f", dlo(3.0), dhi(3.0));
+    PF("3.", "%#.0f", dlo(3.0), dhi(3.0));
+    PF("-0.000000", "%f", dlo(-0.0), dhi(-0.0));
+    PF("1.234568e+004", "%e", dlo(12345.678), dhi(12345.678));
+    PF("1.234568E+004", "%E", dlo(12345.678), dhi(12345.678));
+    PF("1.000000e+100", "%e", dlo(1e100), dhi(1e100));
+    PF("1.0e-300", "%.1e", dlo(1e-300), dhi(1e-300));
+    PF("0.0001", "%g", dlo(0.0001), dhi(0.0001));
+    PF("1e-005", "%g", dlo(1e-5), dhi(1e-5));
+    PF("1E+020", "%G", dlo(1e20), dhi(1e20));
+    PF("100000", "%g", dlo(100000.0), dhi(100000.0));
+    PF("1e+006", "%g", dlo(1e6), dhi(1e6));
+    PF("1.50000", "%#g", dlo(1.5), dhi(1.5));
+    PF("    -1.500", "%10.3f", dlo(-1.5), dhi(-1.5));
+    PF("-00001.500", "%010.3f", dlo(-1.5), dhi(-1.5));
+    PF("-1.500    |", "%-10.3f|", dlo(-1.5), dhi(-1.5));
+    PF("+2.0", "%+.1f", dlo(2.0), dhi(2.0));
+    PF(" 2.0", "% .1f", dlo(2.0), dhi(2.0));
+    PF("1.000000", "%lf", dlo(1.0), dhi(1.0));
+    PF("1.000000", "%Lf", dlo(1.0), dhi(1.0));
+    PF("1.500000 7", "%f %d", dlo(1.5), dhi(1.5), 7);
+
+    const double inf = bits(0x7FF0000000000000ull), ninf = bits(0xFFF0000000000000ull);
+    const double qnan = bits(0x7FF8000000000000ull), ind = bits(0xFFF8000000000000ull);
+    const double snan = bits(0x7FF0000000000001ull);
+    PF("1.#INF00", "%f", dlo(inf), dhi(inf));
+    PF("-1.#INF00", "%f", dlo(ninf), dhi(ninf));
+    PF("1", "%.0f", dlo(inf), dhi(inf));
+    PF("1.$", "%.1f", dlo(inf), dhi(inf));
+    PF("1.#J", "%.2f", dlo(inf), dhi(inf));
+    PF("1.#IO", "%.3f", dlo(inf), dhi(inf));
+    PF("1.#INF", "%.4f", dlo(inf), dhi(inf));
+    PF("1.#INF00e+000", "%e", dlo(inf), dhi(inf));
+    PF("1.#INF", "%g", dlo(inf), dhi(inf));
+    PF("  1.#INF00", "%10f", dlo(inf), dhi(inf));
+    PF("1.#QNAN0", "%f", dlo(qnan), dhi(qnan));
+    PF("-1.#IND00", "%f", dlo(ind), dhi(ind));
+    PF("1.#SNAN0", "%f", dlo(snan), dhi(snan));
+}
+
+static void test_printf_bounds(void)
+{
+    const uint32_t hw = str("hello world");
+    PFN("hello", -1, 5, "%s", hw);              /* longer: -1, no terminator */
+    PFN("hello", 5, 5, "hello");                /* exactly: the length, no terminator */
+    PFN("hello", 5, 6, "hello");                /* room for the terminator */
+    PFN("", -1, 0, "x");
+    PFN("", 0, 0, "");
+    PFN("  ", -1, 2, "%5d", 1);
+    PFN("12", -1, 2, "%d", 123);
+    PFN("hello world", 11, SIZE_MAX, "%s", hw); /* RtlSprintf */
+
+    char big[1024];
+    memset(big, '0', 511);
+    big[511] = '1';
+    big[512] = 0;
+    PF(big, "%.600d", 1);                       /* precision at most 512 */
+}
+
+int main(void)
+{
+    test_printf_int();
+    test_printf_text();
+    test_printf_float();
+    test_printf_bounds();
+    printf("%d passed, %d failed\n", g_pass, g_fail);
+    return g_fail != 0;
+}
