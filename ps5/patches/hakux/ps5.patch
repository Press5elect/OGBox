+        const size_t at = g_tail % LOG_RING, first = n < LOG_RING - at ? n : LOG_RING - at;
+        memcpy(out, g_ring + at, first);
+        memcpy(out + first, g_ring, n - first);
+        g_tail += n;
+        const unsigned dropped = g_dropped;
+        g_dropped = 0;
+        pthread_mutex_unlock(&g_mu);
+        fwrite(out, 1, n, stderr);
+        if (dropped) {
+            fprintf(stderr, "hakuX-native: (log: %u lines not kept, the buffer was full)\n", dropped);
+        }
+        fflush(stderr);
+        pthread_mutex_lock(&g_mu);
+    }
+}
+
+static void *log_writer(void *arg)
+{
+    (void)arg;
+    pthread_mutex_lock(&g_mu);
+    for (;;) {
+        while (g_head == g_tail) {
+            pthread_cond_wait(&g_cv, &g_mu);
+        }
+        drain_locked();
+    }
+    return NULL;
+}
+
+static void start_writer(void)
+{
+    const char *e = getenv("NC_LOG_SYNC");
+    g_async = e && *e ? atoi(e) == 0 : LOG_ASYNC_DEFAULT;
+    const char *s = getenv("NC_LOG_SYNC_S");
+    const long sync_s = s && *s ? atol(s) : (LOG_ASYNC_DEFAULT ? 20 : 0);
+    if (sync_s > 0) {
+        g_sync_until_ns = log_now_ns() + (uint64_t)sync_s * 1000000000ull;
+    }
+    if (g_async) {
+        pthread_t t;
+        if (pthread_create(&t, NULL, log_writer, NULL) != 0) {
+            g_async = 0;
+        } else {
+            pthread_detach(t);
+        }
+    }
