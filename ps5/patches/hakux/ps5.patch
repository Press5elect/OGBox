+    case NV1BA0_PIO_SET_VOICE_CFG_MISC: return "SET_VOICE_CFG_MISC";
+    case NV1BA0_PIO_SET_VOICE_TAR_HRTF: return "SET_VOICE_TAR_HRTF";
