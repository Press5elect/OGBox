diff --git a/native/cpu/codepatch.c b/native/cpu/codepatch.c
new file mode 100644
index 0000000000000000000000000000000000000000..034b6d9cc448a6759a72b7286e3a3d203025520d
--- /dev/null
+++ b/native/cpu/codepatch.c
@@ -0,0 +1,820 @@
+/*
+ * hakuX native core — native CPU backend: the code sweep.
+ *
+ * Copyright (C) 2026 Press5elect
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * Additional terms (GPL-3.0 section 7(b)): keep the attribution "OGBox by
+ * Press5elect" (github.com/Press5elect/OGBox, NOTICE).
+ *
+ * After Kelvin's xpatch.c (PS5_Kelvin, same author and licence); since 0.1.13
+ * with Cxbx-Reloaded's rules (src/core/kernel/support/PatchRdtsc.cpp, GPL-2.0+):
+ * when the title's executable sections load (at boot and in XeLoadSection:
+ * native/kernel/fixups.c), each is decoded from start to end and only rdtsc
+ * is patched by default:
+ *
+ *  - rdtsc (0F 31) counts at the host's TSC rate; Xbox code expects the
+ *    Pentium III's 733.333 MHz. The site becomes ud2 (0F 0B) in its own two
+ *    bytes, emulated by the fault handler (cpu_native.c) with the scaled
+ *    guest TSC. Taken only outside the XDK libraries that never read the TSC
+ *    (rdtsc_section_ok), where the byte after it is one Cxbx-Reloaded has
+ *    seen follow a real rdtsc (rdtsc_bytes_ok, with its false positives);
+ *    since 0.1.14 that test alone decides, as in Cxbx-Reloaded. The stubs of
+ *    0.1.4-0.1.12 (a jump that moves the neighbouring instructions to the
+ *    kernel area) are opt-in: env NC_SWEEP_RDTSC_STUBS=1.
+ *  - cpuid: on the PS5 (OGBox 0.0.2), one right after the instruction that
+ *    loads its leaf, for the kernel's Pentium III (cpuid_mode); elsewhere
+ *    Linux makes every guest cpuid fault. env NC_SWEEP_CPUID=1 every one,
+ *    =0 none, =leaf the PS5's rule.
+ *  - sidt/sgdt, pushfd/popfd: off by default (Cxbx-Reloaded patches
+ *    neither; the PS5's UMIP traps sidt/sgdt, and a popfd after a trapped
+ *    cli is found at run time: ncn_patch_add). env NC_SWEEP_TABLES=1,
+ *    NC_SWEEP_FLAGS=1 turn them back on for A/B runs.
+ *
+ * Instruction boundaries come from a linear sweep with the length decoder
+ * (x86dec.c) after a first pass that marks jump tables (jmp [reg*4 + table]
+ * inside the section) as data. A site is patched only where the sweep is
+ * confident it is code: at least four instructions decoded in a row before
+ * it (no undecodable byte, no padding run), or a run starting at a branch
+ * target, or six instructions after it decoding, and the instruction after
+ * it decoding too. A site the sweep didn't take still runs natively.
+ */
+#include "native/cpu/cpu_native.h"
+#include "native/cpu/x86dec.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct Site {
+    uint32_t va;
+    uint8_t kind;
+    uint8_t orig[2];
+} Site;
+
+static Site *g_sites;
+static size_t g_nsites, g_cap;
+static unsigned g_counts[8];
+
+int ncn_patch_kind(uint32_t va, uint8_t orig[2])
+{
+    size_t lo = 0, hi = g_nsites;
+    while (lo < hi) {
+        const size_t mid = (lo + hi) / 2;
+        if (g_sites[mid].va == va) {
+            if (orig) {
+                orig[0] = g_sites[mid].orig[0];
+                orig[1] = g_sites[mid].orig[1];
+            }
+            return g_sites[mid].kind;
+        }
+        if (g_sites[mid].va < va) {
+            lo = mid + 1;
+        } else {
+            hi = mid;
+        }
+    }
+    return NC_PATCH_NONE;
+}
+
+static bool site_add(uint32_t va, int kind, const uint8_t *orig)
+{
+    if (g_nsites == g_cap) {
+        const size_t cap = g_cap ? g_cap * 2 : 1024;
+        Site *n = realloc(g_sites, cap * sizeof(*n));
+        if (!n) {
+            return false;
+        }
+        g_sites = n;
+        g_cap = cap;
+    }
+    size_t at = g_nsites;
+    while (at > 0 && g_sites[at - 1].va > va) {
+        at--;
+    }
+    if (at > 0 && g_sites[at - 1].va == va) {
+        return false;
+    }
+    memmove(&g_sites[at + 1], &g_sites[at], (g_nsites - at) * sizeof(*g_sites));
+    g_sites[at] = (Site){va, (uint8_t)kind, {orig[0], orig[1]}};
+    g_nsites++;
+    g_counts[kind & 7]++;
+    return true;
+}
+
+void ncn_patch_counts(unsigned *rdtsc, unsigned *cpuid, unsigned *flags)
+{
+    *rdtsc = g_counts[NC_PATCH_RDTSC];
+    *cpuid = g_counts[NC_PATCH_CPUID];
+    *flags = g_counts[NC_PATCH_PUSHFD] + g_counts[NC_PATCH_POPFD];
+}
+
+/* A code byte, read and written through the host's view of RAM (the guest's
+ * page may be write-protected by write tracking). */
+static uint8_t *code_byte(NcVm *vm, uint32_t va)
+{
+    const uint32_t pa = nc_vm_phys(vm, va);
+    return pa == UINT32_MAX || pa >= vm->ram_size ? NULL : vm->phys + pa;
+}
+
+static bool patch(NcVm *vm, uint32_t va, int kind)
+{
+    uint8_t *b0 = code_byte(vm, va), *b1 = kind == NC_PATCH_PUSHFD || kind == NC_PATCH_POPFD ? NULL
+                                                                                             : code_byte(vm, va + 1);
+    if (!b0 || (kind != NC_PATCH_PUSHFD && kind != NC_PATCH_POPFD && !b1)) {
+        return false;
+    }
+    const uint8_t orig[2] = {*b0, b1 ? *b1 : 0};
+    if (!site_add(va, kind, orig)) {
+        return false;
+    }
+    if (b1) {
+        *b0 = 0x0F;
+        *b1 = 0x0B;             /* ud2 */
+    } else {
+        *b0 = 0xCC;             /* int3 */
+    }
+    return true;
+}
+
+/* ---- rdtsc stubs (after Kelvin's xpatch.c promote) ---- */
+
+static uint32_t g_stub_va, g_stub_end, g_stub_next, g_tsc_va;
+
+void ncn_tsc_stubs_setup(uint32_t area_va, uint32_t area_len, uint32_t data_va)
+{
+    g_stub_va = g_stub_next = area_va;
+    g_stub_end = area_va + area_len;
+    g_tsc_va = data_va;
+}
+
+static bool wr_code(NcVm *vm, uint32_t va, const uint8_t *b, unsigned n)
+{
+    for (unsigned i = 0; i < n; i++) {
+        uint8_t *p = code_byte(vm, va + i);
+        if (!p) {
+            return false;
+        }
+        *p = b[i];
+    }
+    return true;
+}
+
+void ncn_tsc_publish(NcVm *vm, uint64_t base, uint64_t ratio)
+{
+    if (!g_tsc_va) {
+        return;
+    }
+    uint8_t d[12];
+    memcpy(d, &base, 8);
+    const uint32_t r = (uint32_t)ratio;
+    memcpy(d + 8, &r, 4);
+    wr_code(vm, g_tsc_va, d, sizeof(d));
+}
+
+static uint32_t *g_targets;
+static size_t g_ntargets, g_target_cap;
+static bool g_targets_sorted;
+
+static void target_add(uint32_t va)
+{
+    if (g_ntargets == g_target_cap) {
+        const size_t cap = g_target_cap ? g_target_cap * 2 : 4096;
+        uint32_t *n = realloc(g_targets, cap * sizeof(*n));
+        if (!n) {
+            return;
+        }
+        g_targets = n;
+        g_target_cap = cap;
+    }
+    g_targets[g_ntargets++] = va;
+    g_targets_sorted = false;
+}
+
+static int cmp_u32(const void *a, const void *b)
+{
+    const uint32_t x = *(const uint32_t *)a, y = *(const uint32_t *)b;
+    return x < y ? -1 : x > y;
+}
+
+/* a collected branch target strictly inside (lo, hi) */
+static bool target_inside(uint32_t lo, uint32_t hi)
+{
+    if (!g_targets_sorted) {
+        qsort(g_targets, g_ntargets, sizeof(*g_targets), cmp_u32);
+        g_targets_sorted = true;
+    }
+    size_t a = 0, b = g_ntargets;
+    while (a < b) {
+        const size_t mid = (a + b) / 2;
+        if (g_targets[mid] <= lo) {
+            a = mid + 1;
+        } else {
+            b = mid;
+        }
+    }
+    return a < g_ntargets && g_targets[a] < hi;
+}
+
+/* pushfd ; push ecx ; push ebx ; rdtsc ; sub eax, [base] ; sbb edx, [base+4] ;
+ * mov ecx, edx ; mov ebx, [ratio] ; mul ebx ; mov eax, ecx ; mov ecx, edx ;
+ * mul ebx ; add eax, ecx ; adc edx, 0 ; pop ebx ; pop ecx ; popfd:
+ * EDX:EAX = ((TSC - base) * ratio) >> 32, as cpu_native.c's guest_tsc
+ * (ratio < 2^32: a host TSC faster than 733 MHz). */
+#define TSC_SEQ_BYTES 41u
+static void emit_tsc(uint8_t *p)
+{
+    unsigned o = 0;
+    static const uint8_t head[] = {0x9C, 0x51, 0x53, 0x0F, 0x31};
+    memcpy(p, head, sizeof(head));
+    o += sizeof(head);
+    p[o++] = 0x2B, p[o++] = 0x05;               /* sub eax, [base] */
+    nc_wr32(p + o, g_tsc_va), o += 4;
+    p[o++] = 0x1B, p[o++] = 0x15;               /* sbb edx, [base+4] */
+    nc_wr32(p + o, g_tsc_va + 4), o += 4;
+    p[o++] = 0x89, p[o++] = 0xD1;               /* mov ecx, edx */
+    p[o++] = 0x8B, p[o++] = 0x1D;               /* mov ebx, [ratio] */
+    nc_wr32(p + o, g_tsc_va + 8), o += 4;
+    static const uint8_t tail[] = {0xF7, 0xE3, 0x89, 0xC8, 0x89, 0xD1, 0xF7, 0xE3,
+                                   0x01, 0xC8, 0x83, 0xD2, 0x00, 0x5B, 0x59, 0x9D};
+    memcpy(p + o, tail, sizeof(tail));
+}
+
+/* (mmiosite.c) the sequence at p: its length, 0 without the data words */
+unsigned ncn_tsc_emit(uint8_t *p)
+{
+    if (!g_tsc_va) {
+        return 0;
+    }
+    emit_tsc(p);
+    return TSC_SEQ_BYTES;
+}
+
+static void emit_jmp(uint8_t *p, uint32_t from, uint32_t to)
+{
+    p[0] = 0xE9;
+    nc_wr32(p + 1, to - (from + 5));
+}
+
+typedef struct Prev {
+    uint32_t va;
+    unsigned len;
+    bool ok;
+} Prev;
+
+/* may this instruction move into a stub */
+static bool movable_insn(const NcX86Insn *in)
+{
+    if (in->flow != NC_FLOW_NONE) {
+        return false;
+    }
+    if (in->op == 0x9C || in->op == 0x9D || in->op == 0x0F31 || in->op == 0x0FA2 || in->op == 0xFA ||
+        in->op == 0xFB || in->op == 0x0F01) {
+        return false;
+    }
+    return !(in->op == 0x90 || in->op == 0xCC || in->op == 0x0F1F || (in->op >= 0x0F19 && in->op <= 0x0F1E));
+}
+
+/* The rdtsc at va as a jump to a stub; where the sweep goes on, or 0 when
+ * no window fits. */
+static uint32_t promote(NcVm *vm, uint32_t va, uint32_t sec_hi, const Prev *prev, unsigned nprev)
+{
+    if (!g_stub_va || !g_tsc_va) {
+        return 0;
+    }
+    uint8_t buf[TSC_SEQ_BYTES + 32];
+    NcX86Insn in;
+    uint32_t end = va + 2;
+    while (end - va < 5 && end < sec_hi) {
+        const unsigned n = nc_x86_decode(nc_vm_host(vm, end), sec_hi - end, end, &in);
+        if (!n || !movable_insn(&in)) {
+            break;
+        }
+        end += n;
+    }
+    uint32_t start = va;
+    bool forward = end - va >= 5 && !target_inside(va, end);
+    if (!forward) {
+        end = va + 2;
+        for (unsigned k = 0; k < nprev && va + 2 - start < 5; k++) {
+            if (!prev[k].ok || prev[k].va + prev[k].len != start) {
+                break;
+            }
+            start = prev[k].va;
+        }
+        if (va + 2 - start < 5 || target_inside(start, va + 2)) {
+            return 0;
+        }
+    }
+    const uint32_t before = va - start, after = end - (va + 2);
+    const uint32_t size = before + TSC_SEQ_BYTES + after + 5;
+    const uint32_t s_va = (g_stub_next + 15) & ~15u;
+    if (s_va + size > g_stub_end) {
+        return 0;
+    }
+    {
+        /* 0.1.12: the window's original bytes, so a log shows what moved */
+        char hex[3 * 40 + 1];
+        unsigned h = 0;
+        const uint8_t *o = nc_vm_host(vm, start);
+        for (uint32_t i = 0; i < end - start && i < 40; i++) {
+            h += (unsigned)snprintf(hex + h, sizeof(hex) - h, "%02x ", o[i]);
+        }
+        nc_log("hakuX-native-cpu", "rdtsc stub: %08x-%08x (rdtsc at %08x, %u before, %u after) -> stub %08x: %s",
+               start, end, va, va - start, end - (va + 2), (g_stub_next + 15) & ~15u, hex);
+    }
+    memcpy(buf, nc_vm_host(vm, start), before);
+    emit_tsc(buf + before);
+    memcpy(buf + before + TSC_SEQ_BYTES, nc_vm_host(vm, va + 2), after);
+    emit_jmp(buf + before + TSC_SEQ_BYTES + after, s_va + before + TSC_SEQ_BYTES + after, end);
+    if (!wr_code(vm, s_va, buf, size)) {
+        return 0;
+    }
+    g_stub_next = s_va + size;
+    uint8_t site[32];
+    memset(site, 0xCC, sizeof(site));               /* never reached: the jump skips them */
+    emit_jmp(site, start, s_va);
+    if (!wr_code(vm, start, site, end - start)) {
+        return 0;
+    }
+    return end;
+}
+
+/* va is a collected branch target */
+static bool target_is(uint32_t va)
+{
+    return va && target_inside(va - 1, va + 1);
+}
+
+typedef struct Region {
+    uint32_t lo, hi;
+} Region;
+
+static bool in_regions(const Region *r, size_t n, uint32_t va, uint32_t *skip_to)
+{
+    for (size_t i = 0; i < n; i++) {
+        if (va >= r[i].lo && va < r[i].hi) {
+            *skip_to = r[i].hi;
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool is_padding(const NcX86Insn *in)
+{
+    return in->op == 0x90 || in->op == 0xCC || in->op == 0x0F1F || (in->op >= 0x0F19 && in->op <= 0x0F1E);
+}
+
+/* count instructions from va decode in a row as code (none padding, none
+ * undecodable, all inside [va, hi)) */
+static bool forward_code(NcVm *vm, uint32_t va, uint32_t hi, unsigned count)
+{
+    for (unsigned i = 0; i < count; i++) {
+        if (va >= hi) {
+            return false;
+        }
+        NcX86Insn in;
+        const unsigned n = nc_x86_decode(nc_vm_host(vm, va), hi - va, va, &in);
+        if (!n || is_padding(&in) || in.op == 0x00) {
+            return false;       /* (00 00: add [eax], al, zeros more likely data) */
+        }
+        va += n;
+    }
+    return true;
+}
+
+typedef struct Report {
+    unsigned rdtsc_stub, rdtsc, cpuid, sidt, pushfd, popfd, skipped, undecodable, tables;
+} Report;
+
+static const char *kind_name(int kind)
+{
+    static const char *const names[] = {"-", "rdtsc", "cpuid", "pushfd", "popfd", "sidt", "sgdt"};
+    return kind >= 0 && kind < 7 ? names[kind] : "?";
+}
+
+/* 0.1.10: which kinds the sweep patches. sidt/sgdt never on the PS5: its
+ * UMIP makes the real ones trap (the system check, H4), so a patch adds
+ * nothing there, and a "sgdt" the sweep takes for code may be data: 0.1.9
+ * patched one inside Burnout 3's XMV section (002db1c9) and the movie
+ * decoder then read past its buffer (guest 0083c002); with the sweep off the
+ * movies played. Each kind can be switched off from boot.txt for A/B runs:
+ * env NC_SWEEP_RDTSC=0, NC_SWEEP_CPUID=0, NC_SWEEP_FLAGS=0 (pushfd/popfd),
+ * NC_SWEEP_TABLES=1 (sidt/sgdt back on). */
+static bool env_on(const char *name, bool dflt)
+{
+    const char *e = getenv(name);
+    return e && e[0] ? e[0] != '0' : dflt;
+}
+
+/* 0.1.13: the defaults follow Cxbx-Reloaded, which has run Xbox code
+ * natively on x86 for years (src/core/kernel/support/PatchRdtsc.cpp,
+ * src/devices/x86/EmuX86.cpp). It patches rdtsc only, and nothing else:
+ * cpuid runs natively (the host's answer; its CPUID emulation is only reached
+ * through an exception, which a native cpuid never raises), and pushfd/popfd
+ * are never patched (cli/sti trap by themselves). A linear sweep can't tell
+ * code from data, and every static patch it made beyond that was a chance to
+ * write into data: Burnout 3's 0.1.12 runs patched 79 "pushfd/popfd" in
+ * WMADEC, 8 in DSOUND, 3 in XNET and 4 "cpuid" in .text, and the stats
+ * showed none of them ever executed (pushfd/popfd 0, cpuid 0) while the
+ * game froze; with no sweep at all (0.1.8) it played. A popfd that does run
+ * after a cli is still found and trapped at run time (ncn_patch_add). On
+ * for A/B runs: env NC_SWEEP_CPUID=1, NC_SWEEP_FLAGS=1, NC_SWEEP_TABLES=1. */
+/* OGBox 0.0.2: cpuid. Where the host can't make every guest cpuid fault (Linux's ARCH_SET_CPUID,
+ * cpu_native.c), a native one answers with the host: on the PS5 an AMD Zen 2, family 0xF, where
+ * the Xbox's Pentium III is family 6. The XDK's voice library (XVOICE, VOICMAIL, 5849) makes its
+ * Voxware codecs only on family 6 with SSE (`cmp eax, 6` after cpuid leaf 1), and on the PS5 every
+ * codec failed: the voice queue's table stayed null, and Splinter Cell Chaos Theory (003664a2)
+ * and Double Agent (00453860) read through it at their menus. The sweep then traps the cpuid it
+ * is surest of, for the kernel's Pentium III (kernel.c cpuid): a cpuid right after the
+ * instruction that loads its leaf (`mov eax, imm32`, `xor eax, eax`), inside a run of code the
+ * usual test is sure of. Data seldom decodes as that pair in a run of code: the 0.1.12 freeze
+ * (Burnout 3, every 0f a2 in .text trapped, none of them ever run) came from trapping any.
+ * env NC_SWEEP_CPUID=1: every one the sweep is sure of, in the XDK libraries' sections too
+ * (as before); =0: none (the host's answer, as 0.0.1 on the PS5). */
+enum { CPUID_NONE, CPUID_LEAF_SET, CPUID_ALL };
+
+static int cpuid_mode(void)
+{
+    const char *e = getenv("NC_SWEEP_CPUID");
+    if (e && e[0]) {
+        /* "leaf": the PS5's rule on any host (a PC run with NC_NATIVE_CPUID_FAULT=0 stands for it) */
+        return e[0] == '0' ? CPUID_NONE : e[0] == 'l' ? CPUID_LEAF_SET : CPUID_ALL;
+    }
+#if defined(__PROSPERO__) || defined(__FreeBSD__)
+    return CPUID_LEAF_SET;
+#else
+    return CPUID_NONE;      /* Linux: every guest cpuid faults (cpu_native.c NC_NATIVE_CPUID_FAULT) */
+#endif
+}
+
+/* The instruction before va loads EAX, the leaf: mov eax, imm32 (b8), xor eax, eax (33 c0, 31 c0),
+ * or mov eax, r/m32 (8b /0: an engine's cpuid(leaf, ...) helper takes it from its argument,
+ * Chaos Theory's 0004983f `mov eax, [esp+10h] ; cpuid`). prev[0] is the last instruction decoded
+ * before it, in the same block. */
+static bool leaf_set_before(NcVm *vm, uint32_t va, const Prev *prev, unsigned nprev)
+{
+    if (!nprev || prev[0].va + prev[0].len != va) {
+        return false;
+    }
+    const uint8_t *b = code_byte(vm, prev[0].va);
+    const uint8_t *b1 = prev[0].len >= 2 ? code_byte(vm, prev[0].va + 1) : NULL;
+    if (!b) {
+        return false;
+    }
+    return (prev[0].len == 5 && *b == 0xB8) ||
+           (prev[0].len == 2 && b1 && (*b == 0x33 || *b == 0x31) && *b1 == 0xC0) ||
+           (*b == 0x8B && b1 && ((*b1 >> 3) & 7) == 0);
+}
+
+static bool kind_enabled(int kind)
+{
+#if defined(__PROSPERO__) || defined(__FreeBSD__)
+    const bool tables_default = false;
+#else
+    const bool tables_default = true;
+#endif
+    switch (kind) {
+    case NC_PATCH_RDTSC: return env_on("NC_SWEEP_RDTSC", true);
+    case NC_PATCH_CPUID: return cpuid_mode() != CPUID_NONE;
+    case NC_PATCH_PUSHFD: case NC_PATCH_POPFD: return env_on("NC_SWEEP_FLAGS", false);
+    case NC_PATCH_SIDT: case NC_PATCH_SGDT: return env_on("NC_SWEEP_TABLES", tables_default);
+    default: return true;
+    }
+}
+
+/* 0.1.13: Cxbx-Reloaded's sections for rdtsc. The XDK's libraries that are
+ * known never to read the TSC are left alone (Cxbx: DSOUND, XGRPH, XMV,
+ * XONLINE, MDLPL; added here: the other audio/video/network libraries
+ * Burnout 3 links, where the sweep found only false positives). Burnout 3's
+ * movie crash was one: "rdtsc" at XMV 002dc571 (0f 31 01 23 28 05 3a 15 1d
+ * 16) was the movie decoder's data, and the stub overwrote ten bytes of it;
+ * the decoder then read past its buffer (guest 0083c002). */
+static bool rdtsc_section_ok(const char *name)
+{
+    static const char *const never[] = {
+        "DSOUND", "XGRPH", "XMV", "XONLINE", "MDLPL",       /* Cxbx-Reloaded's */
+        "WMADEC", "WMVDEC", "XNET", "XON_RD", "DOLBY", "XACTENG", "XPP",
+    };
+    if (!name) {
+        return true;
+    }
+    for (size_t i = 0; i < sizeof(never) / sizeof(never[0]); i++) {
+        if (!strcmp(name, never[i])) {
+            return false;
+        }
+    }
+    return true;
+}
+
+/* 0.1.13: Cxbx-Reloaded's test of the byte after 0F 31 (its rdtsc_pattern,
+ * the first bytes of instructions that follow a real rdtsc in shipped
+ * titles) and its known false positives, byte for byte. */
+static bool rdtsc_bytes_ok(NcVm *vm, uint32_t va)
+{
+    static const uint8_t next_ok[] = {
+        0x89, 0xC3, 0x8B, 0xB9, 0xC7, 0x8D, 0x68, 0x5A, 0x29, 0xF3, 0xE9, 0x2B, 0x50, 0x0F, 0x3B, 0xD9,
+        0x57, 0x85, 0x83, 0x33, 0xF7, 0x8A, 0x56, 0x6A, 0x39, 0xEB, 0xF6, 0xA1, 0x01, 0xA3,
+    };
+    uint8_t b[10];              /* va-5 .. va+4 */
+    for (int i = 0; i < 10; i++) {
+        const uint8_t *p = code_byte(vm, va - 5 + (uint32_t)i);
+        b[i] = p ? *p : 0;
+    }
+#define AT(off) b[(off) + 5]
+    const uint8_t next = AT(2);
+    if (!memchr(next_ok, next, sizeof(next_ok))) {
+        return false;
+    }
+    if (next == 0x8B && ((AT(-2) == 0x88 && AT(-1) == 0x5C) || (AT(-2) == 0x24 && AT(-1) == 0x0C))) {
+        return false;
+    }
+    if (next == 0x89 && AT(4) == 0x8B && AT(-5) == 0x04) {
+        return false;
+    }
+    if (next == 0x50 && AT(-2) == 0x83 && AT(-1) == 0xE2) {
+        return false;
+    }
+    if (next == 0x01 && AT(-1) == 0xE8 && AT(3) == 0x00) {
+        return false;
+    }
+    if (next == 0xF7 && AT(-1) == 0xE8 && AT(3) == 0xFF) {
+        return false;
+    }
+#undef AT
+    return true;
+}
+
+static void sweep(NcVm *vm, uint32_t lo, uint32_t hi, int pass, Region *tables, size_t *ntables, size_t max_tables,
+                  Report *rep, const char *name)
+{
+    unsigned run = 0;           /* instructions decoded in a row */
+    bool anchored = false;      /* the run started at a branch target (a call's, a jump's) */
+    Prev prev[4];
+    unsigned nprev = 0;
+    uint32_t va = lo;
+    while (va < hi) {
+        uint32_t skip;
+        if (in_regions(tables, *ntables, va, &skip)) {
+            va = skip;
+            run = 0;
+            anchored = false;
+            continue;
+        }
+        const uint8_t *p = nc_vm_host(vm, va);
+        NcX86Insn in;
+        const unsigned n = nc_x86_decode(p, hi - va, va, &in);
+        if (!n) {
+            rep->undecodable += pass;
+            va++;
+            run = 0;
+            anchored = false;
+            nprev = 0;
+            continue;
+        }
+        if (pass == 1 && (run == 0 || !anchored) && !is_padding(&in) && target_is(va)) {
+            anchored = true;    /* code: something decoded branches here */
+        }
+        if (pass == 0) {
+            if (in.flow == NC_FLOW_JCC || in.flow == NC_FLOW_JMP || in.flow == NC_FLOW_CALL) {
+                target_add(in.target);
+            }
+            if (in.table && in.table >= lo && in.table < hi && *ntables < max_tables) {
+                uint32_t t = in.table;
+                while (t + 4 <= hi && nc_vm_rd32(vm, t) >= lo && nc_vm_rd32(vm, t) < hi) {
+                    t += 4;
+                }
+                for (uint32_t e = in.table; e < t; e += 4) {
+                    target_add(nc_vm_rd32(vm, e));
+                }
+                if (t > in.table) {
+                    tables[(*ntables)++] = (Region){in.table, t};
+                    rep->tables++;
+                }
+            }
+            va += n;
+            continue;
+        }
+        int kind = NC_PATCH_NONE;
+        if (in.prefixes == 0) {
+            if (in.op == 0x0F31) {
+                kind = NC_PATCH_RDTSC;
+            } else if (in.op == 0x0FA2) {
+                kind = NC_PATCH_CPUID;
+            } else if (in.op == 0x0F01 && (in.modrm >> 6) != 3 && ((in.modrm >> 3) & 7) <= 1) {
+                kind = ((in.modrm >> 3) & 7) == 1 ? NC_PATCH_SIDT : NC_PATCH_SGDT;
+            } else if (in.op == 0x9C) {
+                kind = NC_PATCH_PUSHFD;
+            } else if (in.op == 0x9D) {
+                kind = NC_PATCH_POPFD;
+            }
+        }
+        if (kind != NC_PATCH_NONE && !kind_enabled(kind)) {
+            kind = NC_PATCH_NONE;
+        }
+        if (kind == NC_PATCH_RDTSC && !rdtsc_section_ok(name)) {
+            kind = NC_PATCH_NONE;
+        }
+        if (kind == NC_PATCH_CPUID && cpuid_mode() == CPUID_LEAF_SET && !leaf_set_before(vm, va, prev, nprev)) {
+            static unsigned said_leaf;
+            if (said_leaf++ < 32) {
+                nc_log("hakuX-native-cpu", "sweep %s: cpuid at %08x left (no leaf loaded right before it)", name,
+                       va);
+            }
+            rep->skipped++;
+            kind = NC_PATCH_NONE;
+        }
+        /* OGBox 0.1.20: Cxbx-Reloaded's byte test vetoes an rdtsc only where the sweep is not
+         * certain it decodes code. It is a list of the bytes that followed rdtsc in the titles
+         * Cxbx-Reloaded looked at, for a scan of raw bytes; this sweep decodes instructions, and
+         * an rdtsc in the middle of a long run of them, or at a branch target, with code after
+         * it, is one. OGBox's nxdk test (tests/xbox/ogbox-tests, t_cpu.c) has `rdtsc ; add eax,
+         * [mem]` (0F 31 03 05): left, it read the host's TSC while the trapped rdtsc after it
+         * read the guest's 733 MHz one, and a 15-ms wait between the two never ended. Def Jam:
+         * Fight for NY has two left that way (0008be40, 00182a9a in OGBox 0.1.19's log). */
+        if (kind == NC_PATCH_RDTSC && !rdtsc_bytes_ok(vm, va)) {
+            /* OGBox 0.1.25: eight instructions decoded in a row before it,
+             * not a branch target alone: Def Jam's 00182a9a (2 before it, a
+             * branch target, then 0x99) was trapped by 0.1.20's rule and the
+             * game froze after its EA logo in a loop on its timer */
+            /* OGBox 0.1.56: or a function's first instruction: a branch target whose byte before it
+             * ends the code before (int3 or nop padding, a ret), with code after it. Forza
+             * Motorsport's timer start at 00019f80 (`rdtsc ; fld qword [mem]`, after int3 padding,
+             * called from its loader's time slices) was left reading the host's TSC, while its
+             * elapsed time at 00019fa0 was trapped: the difference was never under the slice's
+             * budget and the loading screen ran forever without loading. Def Jam's 00182a9a (two
+             * instructions into its run) is not one. Four instructions after it, not six: a timer
+             * function is short (Forza's: rdtsc, fld, fstp, two movs, ret). */
+            const uint8_t *before = va > lo ? code_byte(vm, va - 1) : NULL;
+            const bool entry = run == 0 && target_is(va) && before &&
+                               (*before == 0xCC || *before == 0x90 || *before == 0xC3 || *before == 0xC2) &&
+                               va + n < hi && forward_code(vm, va + n, hi, 4);
+            const bool certain = (run >= 8 && va + n < hi && forward_code(vm, va + n, hi, 6)) || entry;
+            static unsigned said_fp;
+            if (certain) {
+                if (said_fp++ < 32) {
+                    const uint8_t *nb = code_byte(vm, va + 2);
+                    nc_log("hakuX-native-cpu", "sweep %s: rdtsc at %08x trapped although Cxbx-Reloaded's byte "
+                           "test says no (next byte %02x; %u instructions decoded before it%s, code after it)",
+                           name, va, nb ? *nb : 0, run,
+                           entry ? ", a function's first instruction" : anchored ? ", a branch target" : "");
+                }
+            } else {
+                if (said_fp++ < 32)
+                    nc_log("hakuX-native-cpu",
+                           "sweep %s: 0f 31 at %08x left (Cxbx-Reloaded's test: not an rdtsc; the sweep isn't "
+                           "certain it is code)",
+                           name, va);
+                rep->skipped++;
+                kind = NC_PATCH_NONE;
+            }
+        }
+        if (kind != NC_PATCH_NONE) {
+            NcX86Insn next;
+            /* Sure it is code: four instructions decoded in a row before it,
+             * or a run that starts at a branch target (0.1.5: a short
+             * function after its alignment padding, `rdtsc ; ret` or
+             * `push ebp ; mov ebp, esp ; rdtsc`, was left, so the game's
+             * timer read the host's TSC unscaled beside the scaled stubs:
+             * Burnout 3's three at 001fc934-001fc984, D3D's 00356ac0, and
+             * DirectSound's, WMA's and XNET's pushfd/popfd); and the
+             * instruction after it decodes. */
+            /* 0.1.7: or, for the two-byte ones (rdtsc, cpuid, sidt/sgdt),
+             * six instructions after it decode as code (no padding, no
+             * undecodable byte, the last one's end inside the section):
+             * Burnout 3's 001fc961 and 001fc984, each a short timer function
+             * reached through a pointer (no call names it, too few
+             * instructions after the alignment before it), kept reading the
+             * host's TSC beside 001fc934's scaled stub. */
+            const bool two = kind == NC_PATCH_RDTSC || kind == NC_PATCH_CPUID || kind == NC_PATCH_SIDT ||
+                             kind == NC_PATCH_SGDT;
+            const bool sure = (run >= 4 || anchored || (two && forward_code(vm, va + n, hi, 6))) && va + n < hi &&
+                              nc_x86_decode(p + n, hi - va - n, va + n, &next) != 0;
+            static unsigned said;
+            /* 0.1.13: an rdtsc becomes ud2 in its own two bytes, as Cxbx's
+             * OUT DX,EAX; NOP does, and nothing around it is touched. The
+             * stub (a 5-byte jump that moves neighbouring instructions) only
+             * with env NC_SWEEP_RDTSC_STUBS=1: the traps cost ~11 us each,
+             * and Burnout 3 takes ~120 a second. */
+            if (sure && kind == NC_PATCH_RDTSC && env_on("NC_SWEEP_RDTSC_STUBS", false)) {
+                const uint32_t next_va = promote(vm, va, hi, prev, nprev);
+                if (next_va) {
+                    rep->rdtsc_stub++;
+                    nc_log("hakuX-native-cpu", "sweep %s: rdtsc at %08x scaled in a stub", name, va);
+                    va = next_va;
+                    nprev = 0;
+                    run = 0;
+                    continue;
+                }
+            }
+            /* 0.1.14: an rdtsc that passed Cxbx-Reloaded's test is trapped
+             * even where the sweep is not sure it is code, as Cxbx-Reloaded
+             * does (its byte test is all it asks; the trap changes only the
+             * instruction's own two bytes). Def Jam: Fight for NY's 11 timer
+             * functions reached through pointers (rdtsc first, at 0002f900,
+             * 00086f10, 000cc210 ...) were left reading the host's TSC at
+             * 1.6 GHz beside its 23 trapped ones at 733 MHz, and the game
+             * froze after its EA logo; hakuX's changelog has that intro
+             * freezing on the game's clock too. */
+            const bool trap_anyway = !sure && kind == NC_PATCH_RDTSC;
+            if (trap_anyway) {
+                static unsigned said_any;
+                if (said_any++ < 64)
+                    nc_log("hakuX-native-cpu", "sweep %s: rdtsc at %08x trapped by Cxbx-Reloaded's test alone",
+                           name, va);
+            }
+            if (!sure && !trap_anyway) {
+                rep->skipped++;
+                if (said++ < 64)
+                    nc_log("hakuX-native-cpu", "sweep %s: %s at %08x left (not sure it is code)", name,
+                       kind_name(kind), va);
+            } else if (patch(vm, va, kind)) {
+                switch (kind) {
+                case NC_PATCH_RDTSC: rep->rdtsc++; break;
+                case NC_PATCH_CPUID: rep->cpuid++; break;
+                case NC_PATCH_SIDT: case NC_PATCH_SGDT: rep->sidt++; break;
+                case NC_PATCH_PUSHFD: rep->pushfd++; break;
+                default: rep->popfd++; break;
+                }
+                if (kind != NC_PATCH_PUSHFD && kind != NC_PATCH_POPFD) {
+                    nc_log("hakuX-native-cpu", "sweep %s: %s at %08x trapped", name, kind_name(kind), va);
+                }
+            }
+        }
+        if (is_padding(&in)) {
+            run = 0;
+            anchored = false;
+        } else {
+            run++;
+        }
+        if (kind != NC_PATCH_NONE) {
+            nprev = 0;
+        } else {
+            memmove(&prev[1], &prev[0], 3 * sizeof(prev[0]));
+            prev[0] = (Prev){va, n, movable_insn(&in)};
+            nprev = nprev < 4 ? nprev + 1 : 4;
+            if (in.flow != NC_FLOW_NONE && in.flow != NC_FLOW_CALL) {
+                nprev = 0;      /* a new block starts after it */
+            }
+        }
+        va += n;
+    }
+}
+
+void nc_cpu_native_code_loaded(NcVm *vm, uint32_t va, uint32_t len, const char *name)
+{
+    if (!len) {
+        return;
+    }
+    const char *e = getenv("NC_NATIVE_SWEEP");
+    if (e && e[0] == '0') {
+        nc_log("hakuX-native-cpu", "sweep %s: off (NC_NATIVE_SWEEP=0)", name);
+        return;
+    }
+    /* 0.1.12: NC_SWEEP_SKIP=XMV,DSOUND leaves those sections unpatched (A/B) */
+    const char *skip = getenv("NC_SWEEP_SKIP");
+    if (skip && name) {
+        const size_t nl = strlen(name);
+        for (const char *q = skip; *q;) {
+            const char *c = strchr(q, ',');
+            const size_t l = c ? (size_t)(c - q) : strlen(q);
+            if (l == nl && !strncmp(q, name, l)) {
+                nc_log("hakuX-native-cpu", "sweep %s: skipped (NC_SWEEP_SKIP)", name);
+                return;
+            }
+            q += l + (c ? 1 : 0);
+        }
+    }
+    for (uint32_t p = va & ~(NC_PAGE - 1); p < va + len; p += NC_PAGE) {
+        if (nc_vm_phys(vm, p) == UINT32_MAX) {
+            return;
+        }
+    }
+    /* (cpuid's leaf-set rule alone doesn't sweep the XDK libraries' sections: as before 0.0.2) */
+    if (!rdtsc_section_ok(name) && cpuid_mode() != CPUID_ALL && !kind_enabled(NC_PATCH_PUSHFD) &&
+        !kind_enabled(NC_PATCH_SIDT)) {
+        nc_log("hakuX-native-cpu", "sweep %s: left as it is (an XDK library that never reads the TSC)", name);
+        return;
+    }
+    const size_t max_tables = 4096;
+    size_t ntables = 0;
+    Region *tables = malloc(max_tables * sizeof(*tables));
+    if (!tables) {
+        return;
+    }
+    Report rep = {0};
+    g_ntargets = 0;
+    sweep(vm, va, va + len, 0, tables, &ntables, max_tables, &rep, name);
+    sweep(vm, va, va + len, 1, tables, &ntables, max_tables, &rep, name);
+    free(tables);
+    nc_log("hakuX-native-cpu", "sweep %s %08x+%x: rdtsc %u in stubs, %u trapped; cpuid %u, sidt/sgdt %u, pushfd %u, popfd %u trapped; "
+           "%u left, %u jump tables, %u undecodable bytes", name, va, len, rep.rdtsc_stub, rep.rdtsc, rep.cpuid, rep.sidt,
+           rep.pushfd, rep.popfd, rep.skipped, rep.tables, rep.undecodable);
+}
+
+void ncn_patch_add(NcVm *vm, uint32_t va, int kind)
+{
+    if (ncn_patch_kind(va, NULL) == NC_PATCH_NONE && patch(vm, va, kind)) {
+        nc_log("hakuX-native-cpu", "%s at %08x trapped (found after a cli)", kind_name(kind), va);
+    }
+}
