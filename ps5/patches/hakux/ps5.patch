+bool nc_rsqrt_decode(const uint8_t *code, unsigned size, const uint32_t regs[8], uint32_t fs_base,
+                     uint32_t gs_base, NcRsqrtInsn *out)
+{
+    unsigned n = 0;
+    bool scalar = false, addr16 = false;
+    uint8_t seg = 0;
+    if (size > 15) {
+        size = 15;
+    }
+    while (n < size) {
+        const uint8_t b = code[n];
+        if (b == 0xF3) {
+            scalar = true;
+        } else if (b == 0x67) {
+            addr16 = true;
+        } else if (b == 0x64 || b == 0x65 || b == 0x2E || b == 0x36 || b == 0x3E || b == 0x26) {
+            seg = b; /* the last segment override wins; ES, CS, SS, DS are flat */
+        } else {
+            break;
+        }
+        n++;
+    }
+    if (size - n < 3 || code[n] != 0x0F || code[n + 1] != 0x52) {
+        return false;
+    }
+    n += 2;
+    const uint8_t m = code[n++];
+    const unsigned mod = m >> 6, rm = m & 7;
+    *out = (NcRsqrtInsn){.dst = (m >> 3) & 7, .src = rm, .scalar = scalar, .mem = mod != 3};
+    uint32_t address = 0;
+    unsigned disp = 0;
+    if (mod != 3 && addr16) {
+        /* BX+SI, BX+DI, BP+SI, BP+DI, SI, DI, BP, BX */
+        static const uint8_t base[] = {3, 3, 5, 5, 6, 7, 5, 3};
+        address = regs[base[rm]];
+        if (rm < 4) {
+            address += regs[6 + (rm & 1)];
+        }
+        if (mod == 0 && rm == 6) {
+            address = 0;
+            disp = 2;
+        } else {
+            disp = mod == 1 ? 1 : mod == 2 ? 2 : 0;
+        }
+    } else if (mod != 3) {
+        unsigned base = rm;
+        if (rm == 4) {
+            if (n == size) {
+                return false;
+            }
+            const uint8_t sib = code[n++];
+            const unsigned index = (sib >> 3) & 7;
+            if (index != 4) {
+                address = regs[index] << (sib >> 6);
+            }
+            base = sib & 7;
+        }
+        if (mod == 0 && base == 5) {
+            disp = 4;
+        } else {
+            address += regs[base];
+            disp = mod == 1 ? 1 : mod == 2 ? 4 : 0;
+        }
+    }
+    if (disp > size - n) {
+        return false;
+    }
+    if (disp == 1) {
+        address += (uint32_t)(int32_t)(int8_t)code[n];
+    } else if (disp) {
+        uint32_t d = code[n] | (uint32_t)code[n + 1] << 8;
+        if (disp == 4) {
+            d |= (uint32_t)code[n + 2] << 16 | (uint32_t)code[n + 3] << 24;
+        }
+        address += d;
+    }
+    if (addr16) {
+        address &= 0xFFFFu;
+    }
+    out->address = address + (seg == 0x64 ? fs_base : seg == 0x65 ? gs_base : 0);
+    out->len = n + disp;
+    return true;
+}
