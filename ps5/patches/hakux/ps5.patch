diff --git a/native/tests/cpu_native_test.c b/native/tests/cpu_native_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..a3f354658792abc2e476d0ca9afc2986631048be
--- /dev/null
+++ b/native/tests/cpu_native_test.c
@@ -0,0 +1,454 @@
+/*
+ * hakuX native core tests — the native CPU backend (cpu_native.c) on its
+ * own: hand-written 32-bit guest code against a small kernel of the test's.
+ *
+ * Copyright (C) 2026 Press5elect
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * Additional terms (GPL-3.0 section 7(b)): keep the attribution "OGBox by
+ * Press5elect" (github.com/Press5elect/OGBox, NOTICE).
+ *
+ * Checks: a context switch inside system ops keeps each guest thread's x87
+ * (ST0, FCW) and SSE (XMM0, MXCSR) state, through the int 0x3F path and the
+ * far-call gate; interrupts requested from another thread reach guest code
+ * spinning on its own; rdtsc (in a sweep stub and as a trap) counts at
+ * 733.333 MHz; cpuid answers the kernel's; RSQRT sites (NC_RSQRT_SITES)
+ * give Intel's estimates through their int3s, on any host (the AMD gate is
+ * the setup's argument here). Prints the cost of a kernel call by signal and
+ * by the gate, and the system ops a second.
+ *
+ *   cpu_native_test   (exit 0: all passed)
+ */
+#include "native/cpu/cpu_native.h"
+#include "native/cpu/rsqrt.h"
+#include "native/cpu/vmhost.h"
+
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#define RAM_SIZE (16u << 20)
+#define VA_BASE 0x00100000u     /* RAM mapped here: code, data, stacks */
+#define CODE_A (VA_BASE + 0x1000)
+#define CODE_B (VA_BASE + 0x2000)
+#define DATA (VA_BASE + 0x8000)
+#define STACK_A (VA_BASE + 0x40000)
+#define STACK_B (VA_BASE + 0x50000)
+#define GATE_PAD (VA_BASE + 0x9000)
+#define TSC_DATA (VA_BASE + 0xA000)
+#define TSC_STUBS (VA_BASE + 0xB000)
+#define RSQ_CODE (VA_BASE + 0x10000)
+#define RSQ_DATA (VA_BASE + 0x12000)
+#define KPCR (DATA + 0x400)
+
+/* What the core links beside the backend (vm.c, mmiosite.c), stood in for. */
+const uint8_t *nc_vm_soft_map;
+unsigned nc_vm_soft_shift;
+void (*nc_vm_read_hook)(uint32_t va, uint32_t len);
+void nc_mmio_site_rdtsc(uint32_t eip, void *ucontext)
+{
+    (void)eip, (void)ucontext;
+}
+
+static NcVm g_vm;
+static NcCpu *g_cpu;
+static NcCpuContext g_ctx[2];
+static int g_cur;
+static int g_fail;
+static int g_mode;              /* what the sysop does (below) */
+static uint64_t g_count, g_ints;
+static uint64_t g_t0;
+
+enum { M_COUNT, M_SWITCH, M_INTR, M_TSC };
+
+static uint64_t now_ns(void)
+{
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return (uint64_t)t.tv_sec * 1000000000ull + (uint64_t)t.tv_nsec;
+}
+
+static void check(bool ok, const char *what)
+{
+    if (!ok) {
+        g_fail++;
+        fprintf(stderr, "FAIL: %s\n", what);
+    }
+}
+
+static uint8_t *at(uint32_t va)
+{
+    return (uint8_t *)(uintptr_t)va;
+}
+
+/* The thread's own state, checked at each switch: XMM0's low dword, ST0's
+ * exponent (fld1 0x3FFF, fldz 0), FCW and MXCSR. */
+static void check_state(const NcFrame *f, int t)
+{
+    uint32_t x0, mxcsr;
+    uint16_t fcw, st0_exp;
+    memcpy(&x0, f->fx + 160, 4);
+    memcpy(&mxcsr, f->fx + 24, 4);
+    memcpy(&fcw, f->fx, 2);
+    memcpy(&st0_exp, f->fx + 32 + 8, 2);
+    const uint32_t want_x0 = t ? 0x22222222u : 0x11111111u;
+    const uint16_t want_fcw = t ? 0x027F : 0x007F, want_exp = t ? 0 : 0x3FFF;
+    const uint32_t want_mx = t ? 0x1F80 : 0x9F80;   /* A: FTZ */
+    static unsigned said;
+    if ((x0 != want_x0 || fcw != want_fcw || st0_exp != want_exp || mxcsr != want_mx) && said++ < 4) {
+        fprintf(stderr, "FAIL: thread %c state: xmm0 %08x fcw %04x st0 exp %04x mxcsr %08x\n", 'A' + t, x0, fcw,
+                st0_exp, mxcsr);
+        g_fail++;
+    }
+}
+
+static bool sysop(void *opaque, NcFrame *f, enum NcSysOp op, unsigned size)
+{
+    (void)opaque;
+    const uint32_t eip = nc_frame_eip(f);
+    if (op == NC_SYSOP_INTERRUPT) {
+        nc_frame_clear_interrupt(f);
+        if (g_mode == M_INTR && ++g_ints >= 200) {
+            nc_frame_set_eip(f, DATA + 0x100);      /* a hlt: the run ends */
+        }
+        return true;
+    }
+    if (op == NC_SYSOP_CPUID) {
+        nc_frame_set_gpr(f, NC_EBX, 0x756E6547);    /* Genu */
+        nc_frame_set_eip(f, eip + size);
+        return true;
+    }
+    if (op != NC_SYSOP_INT || at(eip)[1] != 0x3F) {
+        fprintf(stderr, "FAIL: system op %d at %08x\n", (int)op, eip);
+        g_fail++;
+        nc_frame_set_eip(f, DATA + 0x100);
+        return true;
+    }
+    nc_frame_set_eip(f, eip + 2);
+    g_count++;
+    if (g_mode == M_SWITCH) {
+        check_state(f, g_cur);
+        nc_frame_save(f, &g_ctx[g_cur]);
+        g_cur ^= 1;
+        nc_frame_load(f, &g_ctx[g_cur]);
+    } else if (g_mode == M_TSC) {
+        /* EDX:EAX now, EDI:ESI before a 50 ms sleep, ECX: 1 sleep, 2 check */
+        if (nc_frame_gpr(f, NC_ECX) == 1) {
+            const struct timespec d = {0, 50000000};
+            nanosleep(&d, NULL);
+        } else {
+            const uint64_t a = (uint64_t)nc_frame_gpr(f, NC_EDI) << 32 | nc_frame_gpr(f, NC_ESI);
+            const uint64_t b = (uint64_t)nc_frame_gpr(f, NC_EDX) << 32 | nc_frame_gpr(f, NC_EAX);
+            const double mhz = (double)(b - a) / 50e3;
+            printf("  rdtsc over 50 ms: %.1f MHz (want ~733.3, a little more for the sleep's overshoot)\n", mhz);
+            check(mhz > 725.0 && mhz < 760.0, "rdtsc at 733.333 MHz");
+            check(nc_frame_gpr(f, NC_EBX) == 0x756E6547, "cpuid answered by the kernel");
+            nc_frame_set_eip(f, DATA + 0x100);
+        }
+    }
+    return true;
+}
+
+/* Thread code: its XMM0, ST0, FCW, MXCSR, then n kernel calls (int 0x3F,
+ * or the gate's far call followed by the int 0x3F form), then hlt. */
+static void emit_thread(uint32_t va, uint32_t xmm, bool fld1, uint32_t fcw_va, uint32_t mx_va, uint32_t n, bool gate)
+{
+    uint8_t *p = at(va);
+    unsigned o = 0;
+    p[o++] = 0xB8;
+    memcpy(p + o, &xmm, 4), o += 4;                                 /* mov eax, xmm */
+    p[o++] = 0x66, p[o++] = 0x0F, p[o++] = 0x6E, p[o++] = 0xC0;    /* movd xmm0, eax */
+    p[o++] = 0xD9, p[o++] = fld1 ? 0xE8 : 0xEE;                    /* fld1 / fldz */
+    p[o++] = 0xD9, p[o++] = 0x2D;
+    memcpy(p + o, &fcw_va, 4), o += 4;                              /* fldcw [fcw] */
+    p[o++] = 0x0F, p[o++] = 0xAE, p[o++] = 0x15;
+    memcpy(p + o, &mx_va, 4), o += 4;                               /* ldmxcsr [mx] */
+    p[o++] = 0xB9;
+    memcpy(p + o, &n, 4), o += 4;                                   /* mov ecx, n */
+    const unsigned loop = o;
+    if (gate) {
+        const uint32_t pad = GATE_PAD;
+        const uint16_t cs = nc_cpu_native_host_cs();
+        p[o++] = 0x9A;
+        memcpy(p + o, &pad, 4), o += 4;
+        memcpy(p + o, &cs, 2), o += 2;                              /* call far gate */
+    }
+    p[o++] = 0xCD, p[o++] = 0x3F;                                   /* int 3Fh */
+    p[o++] = 0x49;                                                  /* dec ecx */
+    p[o++] = 0x75, p[o] = (uint8_t)(loop - (o + 1)), o++;           /* jnz loop */
+    p[o++] = 0xF4;                                                  /* hlt */
+}
+
+static void run_switch(bool gate, uint32_t n)
+{
+    nc_wr16(at(DATA), 0x007F);                  /* A: single precision */
+    nc_wr16(at(DATA + 4), 0x027F);              /* B: double */
+    nc_wr32(at(DATA + 8), 0x9F80);              /* A: FTZ */
+    nc_wr32(at(DATA + 12), 0x1F80);
+    emit_thread(CODE_A, 0x11111111u, true, DATA, DATA + 8, n, gate);
+    emit_thread(CODE_B, 0x22222222u, false, DATA + 4, DATA + 12, 0xFFFFFFFFu, gate);
+    nc_context_init(g_cpu, &g_ctx[0], CODE_A, STACK_A);
+    nc_context_init(g_cpu, &g_ctx[1], CODE_B, STACK_B);
+    g_mode = M_SWITCH;
+    g_cur = 0;
+    g_count = 0;
+    const uint64_t t0 = now_ns();
+    nc_cpu_run(g_cpu, &g_ctx[0]);
+    const uint64_t ns = now_ns() - t0;
+    printf("  %s: %llu switches in %.1f ms: %.0f ns per kernel call with a thread switch\n",
+           gate ? "gate" : "int 0x3F", (unsigned long long)g_count, ns / 1e6, (double)ns / (double)g_count);
+    check(g_count >= 2 * (uint64_t)n - 1, "every kernel call taken");
+}
+
+static void run_count(bool gate, uint32_t n)
+{
+    nc_wr16(at(DATA), 0x027F);
+    nc_wr32(at(DATA + 8), 0x1F80);
+    emit_thread(CODE_A, 0x11111111u, true, DATA, DATA + 8, n, gate);
+    NcCpuContext c;
+    nc_context_init(g_cpu, &c, CODE_A, STACK_A);
+    g_mode = M_COUNT;
+    g_count = 0;
+    const uint64_t t0 = now_ns();
+    nc_cpu_run(g_cpu, &c);
+    const uint64_t ns = now_ns() - t0;
+    printf("  %s: %.0f ns per kernel call, %.0f system ops/s\n", gate ? "gate" : "int 0x3F",
+           (double)ns / (double)g_count, (double)g_count * 1e9 / (double)ns);
+    check(g_count == n, "kernel call count");
+}
+
+static volatile int g_kicker_run;
+
+static void *kicker(void *arg)
+{
+    (void)arg;
+    while (g_kicker_run) {
+        nc_cpu_request_interrupt(g_cpu);
+        usleep(200);
+    }
+    return NULL;
+}
+
+static void run_interrupts(void)
+{
+    at(CODE_A)[0] = 0xEB;                       /* jmp $: guest code that never leaves */
+    at(CODE_A)[1] = 0xFE;
+    NcCpuContext c;
+    nc_context_init(g_cpu, &c, CODE_A, STACK_A);
+    g_mode = M_INTR;
+    g_ints = 0;
+    g_kicker_run = 1;
+    pthread_t t;
+    pthread_create(&t, NULL, kicker, NULL);
+    const uint64_t t0 = now_ns();
+    nc_cpu_run(g_cpu, &c);
+    g_kicker_run = 0;
+    pthread_join(t, NULL);
+    printf("  interrupts: %llu taken in a guest spin in %.1f ms\n", (unsigned long long)g_ints, (now_ns() - t0) / 1e6);
+    check(g_ints >= 200, "interrupts reach spinning guest code");
+}
+
+static void run_tsc(bool stub)
+{
+    /* mov eax, eax (x3) ; rdtsc ; mov esi, eax ; mov edi, edx ; mov ecx, 1 ; int 3Fh (sleep) ;
+     * xor ebx, ebx ; cpuid (eax 0) ; rdtsc ; mov ecx, 2 ; int 3Fh (check) */
+    static const uint8_t code[] = {0x89, 0xC0, 0x89, 0xC0, 0x89, 0xC0, 0x0F, 0x31, 0x89, 0xC6, 0x89, 0xD7,
+                                   0xB9, 0x01, 0x00, 0x00, 0x00, 0xCD, 0x3F, 0x31, 0xDB, 0x31, 0xC0, 0x0F,
+                                   0xA2, 0x0F, 0x31, 0x89, 0xC0, 0x89, 0xC0, 0xB9, 0x02, 0x00, 0x00, 0x00,
+                                   0xCD, 0x3F, 0xF4, 0x90, 0x90, 0x90, 0x90, 0x90};
+    /* each run at its own place: the trap run's sites stay registered */
+    const uint32_t entry = CODE_A + (stub ? 0x90 : 0x10);
+    memset(at(CODE_A), 0x90, 0x100);
+    memcpy(at(entry), code, sizeof(code));
+    at(entry - 2)[0] = 0x89;                    /* a fourth mov before: the sweep is sure it is code */
+    at(entry - 2)[1] = 0xC0;
+    /* both rdtsc sites have movs around them: stubs when there is a stub
+     * area and they are asked for (0.1.13: NC_SWEEP_RDTSC_STUBS=1), traps
+     * (ud2) otherwise */
+    if (stub) {
+        setenv("NC_SWEEP_RDTSC_STUBS", "1", 1);
+    }
+    ncn_tsc_stubs_setup(stub ? TSC_STUBS : 0, stub ? 0x4000 : 0, TSC_DATA);
+    nc_cpu_native_code_loaded(&g_vm, CODE_A, 0x100, stub ? "test-stub" : "test-trap");
+    nc_cpu_native_attach(g_cpu, &g_vm, 0, 0);  /* publishes the stubs' base and ratio */
+    NcCpuContext c;
+    nc_context_init(g_cpu, &c, entry, STACK_A);
+    g_mode = M_TSC;
+    nc_cpu_run(g_cpu, &c);
+}
+
+/* RSQRT sites: register, SIB, absolute and fs: sources, scalar and packed,
+ * through the run's int3s; a scalar's upper lanes, MXCSR and EFLAGS kept; the
+ * int3s out while a savestate is written; changed code given back its byte. */
+static void put(uint32_t va, const uint8_t *b, unsigned n, unsigned *o)
+{
+    memcpy(at(va + *o), b, n);
+    *o += n;
+}
+
+static void put32(uint32_t v, unsigned *o)
+{
+    memcpy(at(RSQ_CODE + *o), &v, 4);
+    *o += 4;
+}
+
+static void run_rsqrt(void)
+{
+    const uint32_t D = RSQ_DATA;
+    uint32_t site[5];
+    unsigned o = 7;                             /* nops: the second run's store there */
+    memset(at(RSQ_CODE), 0x90, 0x400);
+    memset(at(D), 0, 0x100);
+    put(RSQ_CODE, (const uint8_t[]){0x0F, 0xAE, 0x15}, 3, &o), put32(D + 0x98, &o);     /* ldmxcsr [D+98] */
+    put(RSQ_CODE, (const uint8_t[]){0x31, 0xD2, 0xF9}, 3, &o);                          /* xor edx, edx ; stc */
+    put(RSQ_CODE, (const uint8_t[]){0x0F, 0x10, 0x0D}, 3, &o), put32(D, &o);            /* movups xmm1, [D] */
+    put(RSQ_CODE, (const uint8_t[]){0x0F, 0x10, 0x05}, 3, &o), put32(D + 0x10, &o);     /* movups xmm0, [D+10] */
+    site[0] = RSQ_CODE + o;
+    put(RSQ_CODE, (const uint8_t[]){0xF3, 0x0F, 0x52, 0xC1}, 4, &o);                    /* rsqrtss xmm0, xmm1 */
+    put(RSQ_CODE, (const uint8_t[]){0x0F, 0x11, 0x05}, 3, &o), put32(D + 0x40, &o);     /* movups [D+40], xmm0 */
+    site[1] = RSQ_CODE + o;
+    put(RSQ_CODE, (const uint8_t[]){0x0F, 0x52, 0xD1}, 3, &o);                          /* rsqrtps xmm2, xmm1 */
+    put(RSQ_CODE, (const uint8_t[]){0x0F, 0x11, 0x15}, 3, &o), put32(D + 0x50, &o);     /* movups [D+50], xmm2 */
+    put(RSQ_CODE, (const uint8_t[]){0xB8}, 1, &o), put32(D + 0x20, &o);                 /* mov eax, D+20 */
+    put(RSQ_CODE, (const uint8_t[]){0xB9, 1, 0, 0, 0}, 5, &o);                          /* mov ecx, 1 */
+    site[2] = RSQ_CODE + o;
+    put(RSQ_CODE, (const uint8_t[]){0x0F, 0x52, 0x5C, 0xC8, 0x08}, 5, &o);              /* rsqrtps xmm3, [eax+ecx*8+8] */
+    put(RSQ_CODE, (const uint8_t[]){0x0F, 0x11, 0x1D}, 3, &o), put32(D + 0x60, &o);     /* movups [D+60], xmm3 */
+    put(RSQ_CODE, (const uint8_t[]){0x0F, 0x10, 0x25}, 3, &o), put32(D + 0x10, &o);     /* movups xmm4, [D+10] */
+    site[3] = RSQ_CODE + o;
+    put(RSQ_CODE, (const uint8_t[]){0xF3, 0x0F, 0x52, 0x25}, 4, &o), put32(D + 0x24, &o); /* rsqrtss xmm4, [D+24] */
+    put(RSQ_CODE, (const uint8_t[]){0x0F, 0x11, 0x25}, 3, &o), put32(D + 0x70, &o);     /* movups [D+70], xmm4 */
+    put(RSQ_CODE, (const uint8_t[]){0x0F, 0x10, 0x2D}, 3, &o), put32(D + 0x10, &o);     /* movups xmm5, [D+10] */
+    site[4] = RSQ_CODE + o;
+    put(RSQ_CODE, (const uint8_t[]){0x64, 0xF3, 0x0F, 0x52, 0x2D}, 5, &o), put32(0x10, &o); /* rsqrtss xmm5, fs:[10] */
+    put(RSQ_CODE, (const uint8_t[]){0x0F, 0x11, 0x2D}, 3, &o), put32(D + 0x80, &o);     /* movups [D+80], xmm5 */
+    put(RSQ_CODE, (const uint8_t[]){0x0F, 0xAE, 0x1D}, 3, &o), put32(D + 0x90, &o);     /* stmxcsr [D+90] */
+    put(RSQ_CODE, (const uint8_t[]){0x9C, 0x58, 0xA3}, 3, &o), put32(D + 0x94, &o);     /* pushfd ; pop eax ; mov [D+94], eax */
+    put(RSQ_CODE, (const uint8_t[]){0xF4}, 1, &o);                                      /* hlt */
+    const uint8_t unlisted[] = {0xF3, 0x0F, 0x52, 0xC1};
+    memcpy(at(RSQ_CODE + 0x200), unlisted, sizeof(unlisted));
+
+    const uint32_t a[4] = {0x3F800000, 0x40800000, 0x3E800000, 0x41800000};   /* 1, 4, 0.25, 16 */
+    const uint32_t b[4] = {0x40490FDB, 0x40000000, 0x3A83126F, 0x449A5000};   /* pi, 2, 0.001, 1234.5 */
+    const uint32_t canary[4] = {0xAAAAAAAA, 0x11111111, 0x22222222, 0x33333333};
+    memcpy(at(D), a, 16);
+    memcpy(at(D + 0x10), canary, 16);
+    nc_wr32(at(D + 0x24), 0x42280000);          /* 42 */
+    memcpy(at(D + 0x30), b, 16);
+    nc_wr32(at(D + 0x98), 0x7FA0);              /* round toward zero, the precision flag set */
+    nc_wr32(at(KPCR + 0x10), 0x3FC00000);       /* 1.5 */
+
+    char list[128];
+    snprintf(list, sizeof(list), "%x, %x,%x,%x ,0x%x", site[0], site[1], site[2], site[3], site[4]);
+    check(!ncn_rsqrt_setup(g_cpu, "10000,zz", true), "a malformed site list refused");
+    check(!ncn_rsqrt_setup(g_cpu, "fff0", true), "a site below 0x10000 refused");
+    check(ncn_rsqrt_setup(g_cpu, list, false), "no sites on a host that isn't AMD");
+    check(ncn_rsqrt_setup(g_cpu, list, true), "the site list taken");
+    check(at(site[0])[0] == 0xF3, "nothing patched before the run");
+    NcNativeStats st0, st1;
+    nc_cpu_native_stats(g_cpu, &st0);
+    NcCpuContext c;
+    nc_context_init(g_cpu, &c, RSQ_CODE, STACK_A);
+    nc_cpu_run(g_cpu, &c);
+    nc_cpu_native_stats(g_cpu, &st1);
+    printf("  RSQRT sites: %llu instructions corrected\n", (unsigned long long)(st1.rsqrt - st0.rsqrt));
+    check(st1.rsqrt - st0.rsqrt == 5, "every site trapped once");
+    bool patched = true;
+    for (unsigned i = 0; i < 5; i++) {
+        patched &= at(site[i])[0] == 0xCC;
+    }
+    check(patched && at(RSQ_CODE + 0x200)[0] == 0xF3, "the listed sites patched, nothing else");
+    uint32_t want[4];
+    memcpy(want, canary, 16);
+    want[0] = nc_rsqrt_intel(a[0]);
+    check(!memcmp(at(D + 0x40), want, 16), "rsqrtss xmm, xmm: Intel's estimate, the upper lanes kept");
+    for (unsigned i = 0; i < 4; i++) {
+        want[i] = nc_rsqrt_intel(a[i]);
+    }
+    check(!memcmp(at(D + 0x50), want, 16), "rsqrtps xmm, xmm: Intel's four estimates");
+    for (unsigned i = 0; i < 4; i++) {
+        want[i] = nc_rsqrt_intel(b[i]);
+    }
+    check(!memcmp(at(D + 0x60), want, 16), "rsqrtps xmm, [eax+ecx*8+8]");
+    memcpy(want, canary, 16);
+    want[0] = nc_rsqrt_intel(0x42280000);
+    check(!memcmp(at(D + 0x70), want, 16), "rsqrtss xmm, [abs]");
+    want[0] = nc_rsqrt_intel(0x3FC00000);
+    check(!memcmp(at(D + 0x80), want, 16), "rsqrtss xmm, fs:[10] (the KPCR)");
+    check(nc_rd32(at(D + 0x90)) == 0x7FA0, "the guest's MXCSR kept");
+    check((nc_rd32(at(D + 0x94)) & 0xC5) == 0x45, "the guest's flags kept (CF, PF, ZF)");
+
+    nc_cpu_native_rsqrt_hold(g_cpu, true);
+    check(at(site[0])[0] == 0xF3 && at(site[1])[0] == 0x0F && at(site[4])[0] == 0x64,
+          "a savestate's RAM has the original bytes");
+    nc_cpu_native_rsqrt_hold(g_cpu, false);
+    check(at(site[0])[0] == 0xCC && at(site[4])[0] == 0xCC, "patched again after it");
+
+    at(site[1])[1] = 0x51;                      /* rsqrtps becomes sqrtps */
+    nc_cpu_invalidate(g_cpu, site[1] + 1, 1);
+    check(at(site[1])[0] == 0x0F && at(site[1])[1] == 0x51, "code rewritten: the site's byte back, the new code kept");
+    at(site[1])[1] = 0x52;
+    nc_cpu_invalidate(g_cpu, site[1], 3);
+    check(at(site[1])[0] == 0xCC, "an RSQRT again: patched again");
+
+    /* the guest rewrites a site itself, after the run's refresh and with no
+     * invalidation: mov byte [site + 3], 0xC2 (rsqrtss xmm0, xmm2: zero) */
+    at(RSQ_CODE)[0] = 0xC6;
+    at(RSQ_CODE)[1] = 0x05;
+    nc_wr32(at(RSQ_CODE + 2), site[0] + 3);
+    at(RSQ_CODE)[6] = 0xC2;
+    nc_cpu_native_stats(g_cpu, &st0);
+    nc_context_init(g_cpu, &c, RSQ_CODE, STACK_A);
+    nc_cpu_run(g_cpu, &c);
+    nc_cpu_native_stats(g_cpu, &st1);
+    check(st1.rsqrt - st0.rsqrt == 4 && at(site[0])[0] == 0xF3, "code changed unannounced runs as it is");
+    check(nc_rd32(at(D + 0x40)) == 0x7F800000, "and gives its own result");
+    ncn_rsqrt_setup(g_cpu, NULL, true);
+    check(at(site[1])[0] == 0x0F && at(site[4])[0] == 0x64, "no sites: every byte back");
+}
+
+int main(void)
+{
+    if (!nc_vmhost_reserve_guest()) {
+        return 2;
+    }
+    memset(&g_vm, 0, sizeof(g_vm));
+    g_vm.ram_size = RAM_SIZE;
+    g_vm.ram_fd = nc_vmhost_ram_create(RAM_SIZE);
+    g_vm.phys = nc_vmhost_ram_view(g_vm.ram_fd, RAM_SIZE);
+    g_vm.pte = calloc((1ull << 32) / NC_PAGE, sizeof(uint32_t));
+    if (g_vm.ram_fd < 0 || !g_vm.phys || !g_vm.pte || !nc_vmhost_map(VA_BASE, g_vm.ram_fd, 0, RAM_SIZE)) {
+        fprintf(stderr, "no guest memory\n");
+        return 2;
+    }
+    for (uint32_t o = 0; o < RAM_SIZE; o += NC_PAGE) {
+        g_vm.pte[(VA_BASE + o) / NC_PAGE] = o | NC_PTE_VALID;
+    }
+    at(DATA + 0x100)[0] = 0xF4;                 /* hlt */
+    NcCpuConfig cfg = {.membase = NULL, .sysop = sysop, .idt_base = DATA + 0x800, .idt_limit = 0x7FF};
+    g_cpu = nc_cpu_create(&cfg, DATA + 0x400);
+    if (!g_cpu) {
+        return 2;
+    }
+    nc_cpu_native_attach(g_cpu, &g_vm, 0, 0);
+    nc_cpu_native_gate_install(g_cpu, at(GATE_PAD), GATE_PAD);
+    g_t0 = now_ns();
+
+    printf("context switches (x87 / SSE kept per thread):\n");
+    run_switch(false, 20000);
+    run_switch(true, 200000);
+    printf("kernel call cost:\n");
+    run_count(false, 100000);
+    run_count(true, 2000000);
+    printf("interrupts:\n");
+    run_interrupts();
+    printf("rdtsc and cpuid:\n");
+    run_tsc(false);
+    run_tsc(true);
+    printf("RSQRT sites:\n");
+    run_rsqrt();
+    printf("%s\n", g_fail ? "FAILED" : "all passed");
+    return g_fail ? 1 : 0;
+}
diff --git a/native/tests/mkxiso.c b/native/tests/mkxiso.c
new file mode 100644
index 0000000000000000000000000000000000000000..fc5380fa421b6d280e52c6c464c802f970a09a94
--- /dev/null
+++ b/native/tests/mkxiso.c
@@ -0,0 +1,60 @@
+/*
+ * hakuX native core tests — mkxiso: an XBE as an Xbox disc image's
+ * default.xbe (xboxrun takes disc images), for nxdk test programs.
+ *
+ * Copyright (C) 2026 Press5elect
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * Additional terms (GPL-3.0 section 7(b)): keep the attribution "OGBox by
+ * Press5elect" (github.com/Press5elect/OGBox, NOTICE).
+ *
+ *   mkxiso <file.xbe> <out.iso>
+ */
+#include "xdvdfs_writer.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+int main(int argc, char **argv)
+{
+    if (argc != 3) {
+        fprintf(stderr, "usage: mkxiso <file.xbe> <out.iso>\n");
+        return 2;
+    }
+    FILE *f = fopen(argv[1], "rb");
+    if (!f) {
+        perror(argv[1]);
+        return 1;
+    }
+    fseek(f, 0, SEEK_END);
+    const long n = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    uint8_t *xbe = malloc((size_t)n);
+    if (!xbe || fread(xbe, 1, (size_t)n, f) != (size_t)n) {
+        return 1;
+    }
+    fclose(f);
+    struct xw_node file;
+    memset(&file, 0, sizeof(file));
+    snprintf(file.name, sizeof(file.name), "default.xbe");
+    file.data = xbe;
+    file.size = (uint32_t)n;
+    struct xw_node root;
+    memset(&root, 0, sizeof(root));
+    root.is_dir = 1;
+    root.children = &file;
+    root.nchildren = 1;
+    uint8_t *img;
+    size_t len;
+    if (xw_write(&root, 0, &img, &len) != 0) {
+        fprintf(stderr, "mkxiso: write failed\n");
+        return 1;
+    }
+    f = fopen(argv[2], "wb");
+    if (!f || fwrite(img, 1, len, f) != len) {
+        perror(argv[2]);
+        return 1;
+    }
+    fclose(f);
+    return 0;
+}
diff --git a/native/tests/xdvdfs_writer.c b/native/tests/xdvdfs_writer.c
new file mode 100644
index 0000000000000000000000000000000000000000..0c131a99e6135737fcf3fa866551595b3d25c302
--- /dev/null
+++ b/native/tests/xdvdfs_writer.c
@@ -0,0 +1,196 @@
+/*
+ * hakuX native core tests — from Kelvin (PS5_Kelvin tests/, same author and licence).
+ *
+ * Copyright (C) 2026 Press5elect
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * Additional terms (GPL-3.0 section 7(b)): keep the attribution "OGBox by
+ * Press5elect" (github.com/Press5elect/OGBox, NOTICE).
+ *
+ * A minimal XDVDFS image writer, for the host tests only. Each directory's
+ * entries are sorted by upper-cased name and stored as a balanced binary
+ * search tree in pre-order; entries are 4-byte aligned, never cross a
+ * sector, and the gaps are 0xFF (the layout documented on
+ * xboxdevwiki.net/XDVDFS). Sectors 0-31 are zero, 32 is the volume
+ * descriptor, then the directory tables, then the files' data.
+ */
+#include "xdvdfs_writer.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#define SECTOR 2048u
+
+static int upper(int c)
+{
+   return (c >= 'a' && c <= 'z') ? c - 32 : c;
+}
+
+static int cmp_nodes(const void *a, const void *b)
+{
+   const unsigned char *x = (const unsigned char *)((const struct xw_node *)a)->name;
+   const unsigned char *y = (const unsigned char *)((const struct xw_node *)b)->name;
+   while (*x && upper(*x) == upper(*y)) {
+      x++;
+      y++;
+   }
+   return upper(*x) - upper(*y);
+}
+
+static uint32_t entry_len(const struct xw_node *n)
+{
+   return (uint32_t)((14 + strlen(n->name) + 3) & ~3u);
+}
+
+/* Pre-order placement: offsets[i] for child i of the sorted range lo..hi. */
+static void place(const struct xw_node *kids, int lo, int hi, uint32_t *offsets, uint32_t *cursor)
+{
+   int mid;
+   uint32_t len;
+   if (lo > hi)
+      return;
+   mid = (lo + hi) / 2;
+   len = entry_len(&kids[mid]);
+   if (*cursor / SECTOR != (*cursor + len - 1) / SECTOR)
+      *cursor = (*cursor / SECTOR + 1) * SECTOR;
+   offsets[mid] = *cursor;
+   *cursor += len;
+   place(kids, lo, mid - 1, offsets, cursor);
+   place(kids, mid + 1, hi, offsets, cursor);
+}
+
+static uint32_t child_ref(const uint32_t *offsets, int lo, int hi)
+{
+   if (lo > hi)
+      return 0;
+   return offsets[(lo + hi) / 2] / 4;
+}
+
+static void put16(uint8_t *p, uint32_t v)
+{
+   p[0] = (uint8_t)v;
+   p[1] = (uint8_t)(v >> 8);
+}
+
+static void put32(uint8_t *p, uint32_t v)
+{
+   put16(p, v & 0xFFFF);
+   put16(p + 2, v >> 16);
+}
+
+static void write_tree(uint8_t *table, const struct xw_node *kids, int lo, int hi, const uint32_t *offsets)
+{
+   int mid;
+   uint8_t *p;
+   size_t n;
+   if (lo > hi)
+      return;
+   mid = (lo + hi) / 2;
+   p = table + offsets[mid];
+   n = strlen(kids[mid].name);
+   put16(p, child_ref(offsets, lo, mid - 1));
+   put16(p + 2, child_ref(offsets, mid + 1, hi));
+   put32(p + 4, kids[mid].sector);
+   put32(p + 8, kids[mid].is_dir ? kids[mid].table_size : kids[mid].size);
+   p[12] = kids[mid].is_dir ? 0x10 : 0x20;
+   p[13] = (uint8_t)n;
+   memcpy(p + 14, kids[mid].name, n);
+   /* The alignment padding inside an entry is 0xFF like the gaps. */
+   write_tree(table, kids, lo, mid - 1, offsets);
+   write_tree(table, kids, mid + 1, hi, offsets);
+}
+
+/* Sorts children and works out each directory's table size. */
+static void prepare(struct xw_node *d, int empty_zero)
+{
+   unsigned i;
+   uint32_t *offsets, cursor = 0;
+   if (!d->is_dir)
+      return;
+   if (d->nchildren)
+      qsort(d->children, d->nchildren, sizeof(*d->children), cmp_nodes);
+   for (i = 0; i < d->nchildren; i++)
+      prepare(&d->children[i], empty_zero);
+   if (d->nchildren == 0) {
+      d->table_size = empty_zero ? 0 : SECTOR;
+      return;
+   }
+   offsets = (uint32_t *)calloc(d->nchildren, sizeof(*offsets));
+   place(d->children, 0, (int)d->nchildren - 1, offsets, &cursor);
+   free(offsets);
+   d->table_size = (cursor + SECTOR - 1) / SECTOR * SECTOR;
+}
+
+static void alloc_dirs(struct xw_node *d, uint32_t *next)
+{
+   unsigned i;
+   if (!d->is_dir)
+      return;
+   d->sector = d->table_size ? *next : 0;
+   *next += d->table_size / SECTOR;
+   for (i = 0; i < d->nchildren; i++)
+      alloc_dirs(&d->children[i], next);
+}
+
+static void alloc_files(struct xw_node *d, uint32_t *next)
+{
+   unsigned i;
+   for (i = 0; i < d->nchildren; i++) {
+      struct xw_node *c = &d->children[i];
+      if (c->is_dir) {
+         alloc_files(c, next);
+      } else {
+         c->sector = *next;
+         *next += (c->size + SECTOR - 1) / SECTOR;
+      }
+   }
+}
+
+static void emit(struct xw_node *d, uint8_t *img)
+{
+   unsigned i;
+   if (d->table_size) {
+      uint8_t *table = img + (size_t)d->sector * SECTOR;
+      memset(table, 0xFF, d->table_size);
+      if (d->nchildren) {
+         uint32_t *offsets = (uint32_t *)calloc(d->nchildren, sizeof(*offsets));
+         uint32_t cursor = 0;
+         place(d->children, 0, (int)d->nchildren - 1, offsets, &cursor);
+         write_tree(table, d->children, 0, (int)d->nchildren - 1, offsets);
+         free(offsets);
+      }
+   }
+   for (i = 0; i < d->nchildren; i++) {
+      struct xw_node *c = &d->children[i];
+      if (c->is_dir)
+         emit(c, img);
+      else if (c->size)
+         memcpy(img + (size_t)c->sector * SECTOR, c->data, c->size);
+   }
+}
+
+int xw_write(struct xw_node *root, int empty_dir_zero_size, uint8_t **out, size_t *out_size)
+{
+   uint32_t next = 34;
+   size_t size;
+   uint8_t *img, *vd;
+
+   root->is_dir = 1;
+   prepare(root, empty_dir_zero_size);
+   alloc_dirs(root, &next);
+   alloc_files(root, &next);
+   size = (size_t)next * SECTOR;
+   img = (uint8_t *)calloc(1, size);
+   if (!img)
+      return -1;
+   vd = img + 32 * SECTOR;
+   memcpy(vd, "MICROSOFT*XBOX*MEDIA", 20);
+   put32(vd + 0x14, root->sector);
+   put32(vd + 0x18, root->table_size);
+   put32(vd + 0x1C, 0x89ABCDEFu); /* a FILETIME; any value */
+   put32(vd + 0x20, 0x01C00000u);
+   memcpy(vd + 0x7EC, "MICROSOFT*XBOX*MEDIA", 20);
+   emit(root, img);
+   *out = img;
+   *out_size = size;
+   return 0;
+}
diff --git a/native/tests/xdvdfs_writer.h b/native/tests/xdvdfs_writer.h
new file mode 100644
index 0000000000000000000000000000000000000000..813c5f30688d49bb12548256ebd8a4333da3b80d
--- /dev/null
+++ b/native/tests/xdvdfs_writer.h
@@ -0,0 +1,35 @@
+/*
+ * hakuX native core tests — from Kelvin (PS5_Kelvin tests/, same author and licence).
+ *
+ * Copyright (C) 2026 Press5elect
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * Additional terms (GPL-3.0 section 7(b)): keep the attribution "OGBox by
+ * Press5elect" (github.com/Press5elect/OGBox, NOTICE).
+ *
+ * A minimal XDVDFS image writer, for the host tests only: builds an XISO in
+ * memory from a tree of nodes so the reader can be checked against known
