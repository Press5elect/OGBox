new file mode 100644
index 0000000000000000000000000000000000000000..08c0820074f7c7207ef4e0e3081cb4ef8d95aa4d
--- /dev/null
+++ b/native/kernel/rtl_fmt.h
@@ -0,0 +1,430 @@
+/* Copyright (C) 2026-present PortareOS */
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * hakuX native core — the runtime library's formatted output: the C runtime's
+ * _vsnprintf as the Xbox kernel's printf family (RtlSprintf, RtlSnprintf,
+ * RtlVsprintf, RtlVsnprintf) has it, on host buffers. From hakuX-lr's
+ * rtl_text.c (39db3c4403, its #86), its formatter alone; header-only, as
+ * rtl_case.h, for the host test (tests/hle/test_rtl_fmt.c) and so the
+ * kernel's file list needs no new file.
+ *
+ * Flags, width and precision (or *), h/l/ll/I/I32/I64/w sizes, %d %i %u %o
+ * %x %X %p %c %C %s %S %Z %wZ %n and the floating conversions (the host's
+ * digits, a three-digit exponent, 1.#INF and the like for infinities and
+ * NaNs). Wide text is shown in Latin-1 ('?' above 0xFF). Text that doesn't
+ * fit gives -1 and no terminator. Arguments come through a callback, so the
+ * kernel can feed it guest stack words and the test fake ones.
+ */
+#ifndef NC_RTL_FMT_H
+#define NC_RTL_FMT_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+/* Where the formatter gets its arguments: the next 32-bit argument word, and
+ * the host address of a 32-bit pointer (NULL for 0, or one it can't read). */
+typedef struct NcRtlFmtIo {
+    void *ctx;
+    uint32_t (*arg)(void *ctx);
+    void *(*mem)(void *ctx, uint32_t va);
+} NcRtlFmtIo;
+
+static inline uint16_t nc_rtl_fmt_rd16(const void *p)
+{
+    uint16_t v;
+    memcpy(&v, p, 2);
+    return v;
+}
+
+static inline uint32_t nc_rtl_fmt_rd32(const void *p)
+{
+    uint32_t v;
+    memcpy(&v, p, 4);
+    return v;
+}
+
+/* A UTF-16 character in Latin-1. */
+static inline uint8_t nc_rtl_fmt_latin1(uint16_t c)
+{
+    return c < 0x100 ? (uint8_t)c : '?';
+}
+
+enum {
+    NC_FMT_LEFT = 1 << 0,    /* - */
+    NC_FMT_PLUS = 1 << 1,    /* + */
+    NC_FMT_SPACE = 1 << 2,   /* ' ' */
+    NC_FMT_ALT = 1 << 3,     /* # */
+    NC_FMT_ZERO = 1 << 4,    /* 0 */
+    NC_FMT_SHORT = 1 << 5,   /* h */
+    NC_FMT_LONG = 1 << 6,    /* l */
+    NC_FMT_I64 = 1 << 7,     /* I64, ll */
+    NC_FMT_WIDE = 1 << 8,    /* w */
+    NC_FMT_SIGNED = 1 << 9,
+    NC_FMT_NEG = 1 << 10,
+};
+
+#define NC_FMT_MAX_PRECISION 512
+
+typedef struct NcRtlFmtOut {
+    char *buf;
+    size_t cap, pos;
+    bool over;          /* the text didn't fit: the rest is dropped */
+} NcRtlFmtOut;
+
+static inline void nc_rtl_fmt_put(NcRtlFmtOut *o, char c)
+{
+    if (o->over) {
+        return;
+    }
+    if (o->pos < o->cap) {
+        o->buf[o->pos++] = c;
+    } else {
+        o->over = true;
+    }
+}
+
+static inline void nc_rtl_fmt_put_n(NcRtlFmtOut *o, char c, int64_t n)
+{
+    for (; n > 0 && !o->over; n--) {
+        nc_rtl_fmt_put(o, c);
+    }
+}
+
+/* A converted field: padding, prefix (a sign or 0x), zeros for the 0 flag,
+ * then the text (wide: UTF-16, in Latin-1). */
+static inline void nc_rtl_fmt_field(NcRtlFmtOut *o, unsigned flags, int64_t width, const char *prefix, size_t plen,
+                                    const void *text, size_t tlen, bool wide)
+{
+    const int64_t pad = width - (int64_t)tlen - (int64_t)plen;
+    if (!(flags & (NC_FMT_LEFT | NC_FMT_ZERO))) {
+        nc_rtl_fmt_put_n(o, ' ', pad);
+    }
+    for (size_t i = 0; i < plen; i++) {
+        nc_rtl_fmt_put(o, prefix[i]);
+    }
+    if ((flags & NC_FMT_ZERO) && !(flags & NC_FMT_LEFT)) {
+        nc_rtl_fmt_put_n(o, '0', pad);
+    }
+    for (size_t i = 0; i < tlen && !o->over; i++) {
+        const uint8_t *t = text;
+        nc_rtl_fmt_put(o, wide ? (char)nc_rtl_fmt_latin1(nc_rtl_fmt_rd16(t + 2 * i)) : (char)t[i]);
+    }
+    if (flags & NC_FMT_LEFT) {
+        nc_rtl_fmt_put_n(o, ' ', pad);
+    }
+}
+
+static inline uint64_t nc_rtl_fmt_arg64(const NcRtlFmtIo *io)
+{
+    const uint64_t lo = io->arg(io->ctx);
+    return lo | (uint64_t)io->arg(io->ctx) << 32;
+}
+
+static inline void nc_rtl_fmt_int(NcRtlFmtOut *o, char t, unsigned flags, int64_t width, int64_t prec,
+                                  const NcRtlFmtIo *io)
+{
+    unsigned radix = 10;
+    bool upper = false;
+    if (t == 'd' || t == 'i') {
+        flags |= NC_FMT_SIGNED;
+    } else if (t == 'o') {
+        radix = 8;
+    } else if (t == 'x' || t == 'X' || t == 'p') {
+        radix = 16;
+        upper = t != 'x';
+        if (t == 'p') {
+            prec = 8;                       /* a pointer: eight uppercase digits */
+        }
+    }
+    uint64_t v;
+    if (flags & NC_FMT_I64) {
+        v = nc_rtl_fmt_arg64(io);
+    } else {
+        const uint32_t w = io->arg(io->ctx);
+        if (flags & NC_FMT_SHORT) {
+            v = flags & NC_FMT_SIGNED ? (uint64_t)(int64_t)(int16_t)w : (uint16_t)w;
+        } else {
+            v = flags & NC_FMT_SIGNED ? (uint64_t)(int64_t)(int32_t)w : w;
+        }
+    }
+    if ((flags & NC_FMT_SIGNED) && (int64_t)v < 0) {
+        v = 0 - v;
+        flags |= NC_FMT_NEG;
+    }
+    if (prec < 0) {
+        prec = 1;
+    } else {
+        flags &= ~(unsigned)NC_FMT_ZERO;         /* a precision turns the 0 flag off */
+        prec = prec > NC_FMT_MAX_PRECISION ? NC_FMT_MAX_PRECISION : prec;
+    }
+    char prefix[2];
+    size_t plen = 0;
+    if (flags & NC_FMT_NEG) {
+        prefix[plen++] = '-';
+    } else if ((flags & NC_FMT_SIGNED) && (flags & NC_FMT_PLUS)) {
+        prefix[plen++] = '+';
+    } else if ((flags & NC_FMT_SIGNED) && (flags & NC_FMT_SPACE)) {
+        prefix[plen++] = ' ';
+    } else if (radix == 16 && (flags & NC_FMT_ALT) && v) {
+        prefix[plen++] = '0';
+        prefix[plen++] = upper ? 'X' : 'x';
+    }
+    const char *digits = upper ? "0123456789ABCDEF" : "0123456789abcdef";
+    char buf[NC_FMT_MAX_PRECISION + 32];
+    char *end = buf + sizeof(buf), *q = end;
+    while (prec-- > 0 || v) {               /* precision 0 and value 0: no digits */
+        *--q = digits[v % radix];
+        v /= radix;
+    }
+    if (radix == 8 && (flags & NC_FMT_ALT) && (q == end || *q != '0')) {
+        *--q = '0';
+    }
+    nc_rtl_fmt_field(o, flags, width, prefix, plen, q, (size_t)(end - q), false);
+}
+
+/* The C runtime's digits for an infinity or NaN (after a leading 1), shown
+ * as 1.#INF and the like and rounded as digits are. */
+static inline size_t nc_rtl_fmt_special(char *text, char t, unsigned flags, int64_t prec, const char *tail)
+{
+    const size_t tl = strlen(tail);
+    const bool g = t == 'g' || t == 'G';
+    const int64_t fp = g ? (prec ? prec : 1) - 1 : prec;   /* digits after the point */
+    size_t n = 0;
+    text[n++] = '1';
+    if (fp > 0 || (flags & NC_FMT_ALT)) {
+        text[n++] = '.';
+    }
+    for (int64_t i = 0; i < fp; i++) {
+        text[n++] = (size_t)i < tl ? tail[i] : '0';
+    }
+    if (fp > 0 && (size_t)fp < tl && tail[fp] >= '5') {
+        text[n - 1]++;
+    }
+    if (g && !(flags & NC_FMT_ALT)) {
+        while (text[n - 1] == '0') {
+            n--;
+        }
+        if (text[n - 1] == '.') {
+            n--;
+        }
+    }
+    if (t == 'e' || t == 'E') {
+        memcpy(text + n, t == 'e' ? "e+000" : "E+000", 5);
+        n += 5;
+    }
+    return n;
+}
+
+/* %e %E %f %g %G: the host formats the digits (its rounding); the exponent
+ * has three digits, as the C runtime's. */
+static inline void nc_rtl_fmt_float(NcRtlFmtOut *o, char t, unsigned flags, int64_t width, int64_t prec,
+                                    uint64_t bits)
+{
+    prec = prec < 0 ? 6 : prec > NC_FMT_MAX_PRECISION ? NC_FMT_MAX_PRECISION : prec;
+    const bool neg = bits >> 63;
+    bits &= ~(1ull << 63);
+    char text[NC_FMT_MAX_PRECISION + 400];
+    size_t n;
+    if ((bits >> 52) == 0x7FF) {
+        const uint64_t mant = bits & ((1ull << 52) - 1);
+        const char *tail = !mant ? "#INF" : neg && mant == 1ull << 51 ? "#IND" : mant & 1ull << 51 ? "#QNAN" : "#SNAN";
+        n = nc_rtl_fmt_special(text, t, flags, prec, tail);
+    } else {
+        double d;
+        memcpy(&d, &bits, sizeof(d));
+        char spec[8];
+        size_t s = 0;
+        spec[s++] = '%';
+        if (flags & NC_FMT_ALT) {
+            spec[s++] = '#';
+        }
+        spec[s++] = '.';
+        spec[s++] = '*';
+        spec[s++] = t;
+        spec[s] = 0;
+        const int r = snprintf(text, sizeof(text) - 2, spec, (int)prec, d);
+        n = r < 0 ? 0 : (size_t)r < sizeof(text) - 2 ? (size_t)r : sizeof(text) - 3;
+        char *e = memchr(text, t == 'E' || t == 'G' ? 'E' : 'e', n);
+        if (e && e + 2 <= text + n) {
+            const size_t nd = (size_t)(text + n - (e + 2));
+            if (nd < 3) {
+                memmove(e + 2 + (3 - nd), e + 2, nd);
+                memset(e + 2, '0', 3 - nd);
+                n += 3 - nd;
+            }
+        }
+    }
+    char prefix = neg ? '-' : (flags & NC_FMT_PLUS) ? '+' : (flags & NC_FMT_SPACE) ? ' ' : 0;
+    nc_rtl_fmt_field(o, flags, width, &prefix, prefix ? 1 : 0, text, n, false);
+}
+
+/* fmt formatted into out (RtlVsnprintf; RtlVsprintf with cap SIZE_MAX). Returns the length,
+ * with a terminator if there's room; when the text is longer than cap, cap bytes of it and -1. */
+static inline int nc_rtl_vsnprintf(char *out, size_t cap, const char *fmt, const NcRtlFmtIo *io)
+{
+    static const uint16_t wnull[] = {'(', 'n', 'u', 'l', 'l', ')', 0};
+    NcRtlFmtOut o = {out, cap, 0, false};
+    const char *p = fmt;
+    while (*p && !o.over) {
+        if (*p != '%') {
+            nc_rtl_fmt_put(&o, *p++);
+            continue;
+        }
+        p++;
+        unsigned flags = 0;
+        for (;; p++) {
+            const char c = *p;
+            if (c == '-') {
+                flags |= NC_FMT_LEFT;
+            } else if (c == '+') {
+                flags |= NC_FMT_PLUS;
+            } else if (c == ' ') {
+                flags |= NC_FMT_SPACE;
+            } else if (c == '#') {
+                flags |= NC_FMT_ALT;
+            } else if (c == '0') {
+                flags |= NC_FMT_ZERO;
+            } else {
+                break;
+            }
+        }
+        int64_t width = 0, prec = -1;
+        if (*p == '*') {                    /* from an argument; negative: left-justified */
+            const int32_t w = (int32_t)io->arg(io->ctx);
+            if (w < 0) {
+                flags |= NC_FMT_LEFT;
+            }
+            width = w < 0 ? -(int64_t)w : w;
+            p++;
+        }
+        for (; *p >= '0' && *p <= '9'; p++) {
+            width = width * 10 + (*p - '0');
+            width = width > 0x7FFFFFFF ? 0x7FFFFFFF : width;
+        }
+        if (*p == '.') {
+            p++;
+            prec = 0;
+            if (*p == '*') {                /* from an argument; negative: as if none */
+                const int32_t v = (int32_t)io->arg(io->ctx);
+                prec = v < 0 ? -1 : v;
+                p++;
+            }
+            for (; *p >= '0' && *p <= '9'; p++) {
+                prec = prec * 10 + (*p - '0');
+                prec = prec > 0x7FFFFFFF ? 0x7FFFFFFF : prec;
+            }
+        }
+        for (;; p++) {
+            const char c = *p;
+            if (c == 'h') {
+                flags |= NC_FMT_SHORT;
+            } else if (c == 'l') {
+                if (p[1] == 'l') {
+                    flags |= NC_FMT_I64;
+                    p++;
+                } else {
+                    flags |= NC_FMT_LONG;
+                }
+            } else if (c == 'w') {
+                flags |= NC_FMT_WIDE;
+            } else if (c == 'L' || c == 'N' || c == 'F') {
+                /* long double (a double), near and far pointers: no change */
+            } else if (c == 'I') {
+                if (p[1] == '6' && p[2] == '4') {
+                    flags |= NC_FMT_I64;
+                    p += 2;
+                } else if (p[1] == '3' && p[2] == '2') {
+                    flags &= ~(unsigned)NC_FMT_I64;
+                    p += 2;
+                } else if (!p[1] || !strchr("diouxX", p[1])) {
+                    break;                  /* not a size: the I itself is printed */
+                }
+            } else {
+                break;
+            }
+        }
+        const char t = *p;
+        if (!t) {
+            break;                          /* the format ends inside a conversion */
+        }
+        p++;
+        switch (t) {
+        case 'd': case 'i': case 'u': case 'o': case 'x': case 'X': case 'p':
+            nc_rtl_fmt_int(&o, t, flags, width, prec, io);
+            break;
+        case 'e': case 'E': case 'f': case 'g': case 'G':
+            nc_rtl_fmt_float(&o, t, flags, width, prec, nc_rtl_fmt_arg64(io));
+            break;
+        case 'C':
+            if (!(flags & (NC_FMT_SHORT | NC_FMT_LONG | NC_FMT_WIDE))) {
+                flags |= NC_FMT_WIDE;
+            }
+            /* fall through */
+        case 'c': {
+            const uint32_t w = io->arg(io->ctx);
+            const char c = (flags & (NC_FMT_LONG | NC_FMT_WIDE)) ? (char)nc_rtl_fmt_latin1((uint16_t)w) : (char)w;
+            nc_rtl_fmt_field(&o, flags, width, NULL, 0, &c, 1, false);
+            break;
+        }
+        case 'S':
+            if (!(flags & (NC_FMT_SHORT | NC_FMT_LONG | NC_FMT_WIDE))) {
+                flags |= NC_FMT_WIDE;
+            }
+            /* fall through */
+        case 's': {
+            const bool wide = flags & (NC_FMT_LONG | NC_FMT_WIDE);
+            const void *s = io->mem(io->ctx, io->arg(io->ctx));
+            if (!s) {
+                s = wide ? (const void *)wnull : (const void *)"(null)";
+            }
+            const size_t max = prec < 0 ? SIZE_MAX : (size_t)prec;
+            size_t n = 0;
+            while (n < max && (wide ? nc_rtl_fmt_rd16((const uint8_t *)s + 2 * n) : ((const char *)s)[n])) {
+                n++;
+            }
+            nc_rtl_fmt_field(&o, flags, width, NULL, 0, s, n, wide);
+            break;
+        }
+        case 'Z': {                         /* a STRING, or with w a UNICODE_STRING */
+            const uint8_t *str = io->mem(io->ctx, io->arg(io->ctx));
+            const void *buf = str ? io->mem(io->ctx, nc_rtl_fmt_rd32(str + 4)) : NULL;
+            if (!buf) {
+                nc_rtl_fmt_field(&o, flags, width, NULL, 0, "(null)", 6, false);
+            } else if (flags & NC_FMT_WIDE) {
+                nc_rtl_fmt_field(&o, flags, width, NULL, 0, buf, nc_rtl_fmt_rd16(str) / 2u, true);
+            } else {
+                nc_rtl_fmt_field(&o, flags, width, NULL, 0, buf, nc_rtl_fmt_rd16(str), false);
+            }
+            break;
+        }
+        case 'n': {                         /* the count so far, stored */
+            uint8_t *dst = io->mem(io->ctx, io->arg(io->ctx));
+            const int32_t v = o.over ? -1 : (int32_t)o.pos;
+            if (dst) {
+                if (flags & NC_FMT_SHORT) {
+                    const int16_t h = (int16_t)v;
+                    memcpy(dst, &h, 2);
+                } else {
+                    memcpy(dst, &v, 4);
+                }
+            }
+            break;
+        }
+        default:                            /* not a conversion: the character itself */
+            nc_rtl_fmt_put(&o, t);
+            break;
+        }
+    }
+    if (o.over) {
+        return -1;
+    }
+    if (o.pos < o.cap) {
+        o.buf[o.pos] = 0;
+    }
+    return (int)o.pos;
+}
+
+#endif
