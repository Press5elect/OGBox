+        HT_CHECK((strstr(buf, "bool zOne = vZx.z <= 0.0 && dFdx(vW) == 0.0 && dFdy(vW) == 0.0;") != NULL) == zx);
+        HT_CHECK((strstr(buf, "float zSrc = zOne ? vW : gl_FragCoord.z / zsc;") != NULL) == zx);
+        HT_CHECK((strstr(buf, "max(abs(dFdx(zSrc)), abs(dFdy(zSrc)))") != NULL) == zx);
+        HT_CHECK((strstr(buf, "max(abs(dFdx(vW)), abs(dFdy(vW)))") != NULL) == !zx);
+        HT_CHECK(strstr(buf, "gl_FragDepth = wDepth;") != NULL);
