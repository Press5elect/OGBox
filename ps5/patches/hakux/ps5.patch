+                   "host can't make): emulated", va, pa, g_hp >> 10);
+        }
+        return false;
+    }
+    const uint64_t end = (uint64_t)va + len;
+    for (uint64_t vblk = va & ~m; vblk < end; vblk += g_hp) {
+        const uint32_t pblk = (uint32_t)(pa - (va - vblk));
+        const uint32_t bound = block_pa(vm, (uint32_t)vblk);
+        if (bound == pblk) {
