+++ b/native/dev/apu/vp/mcpx_curves.h
@@ -0,0 +1,72 @@
+/*
+ * hakuX native core — the MCPX voice processor's measured curves, from
+ * raddad772's tests on a retail console (xemu PR #3105,
+ * https://github.com/xemu-project/xemu/pull/3105, by way of CallistoNTG's
+ * hakuX port): the volume curve, the HRIR taps' format and the filters'
+ * frequency coefficients. In a header of their own so tests/hle/test_apu_mcpx.c
+ * checks them against the measurements.
+ *
+ * This library is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or (at your
+ * option) any later version.
+ */
+#ifndef NATIVE_DEV_APU_VP_MCPX_CURVES_H
+#define NATIVE_DEV_APU_VP_MCPX_CURVES_H
+
+#include <math.h>
+#include <stdint.h>
+
+/* A route's gain in 1/16384 for an attenuation in 1/64 dB (0..4095), PR
+ * fb7e45a: straight lines between whole decibels through
+ * round(4095 * 10^(-k / 20)), rounded down; from 48 dB a straight line to
+ * nothing at 63 dB. Attenuation 0 is unity (16384). */
+static inline uint32_t mcpx_attenuation_gain(int att)
+{
+    if (att <= 0) {
+        return 16384;
+    }
+    if (att >= 63 * 64) {
+        return 0;
+    }
+    const int k = att >> 6;
+    const uint32_t n48 = (uint32_t)floor(4095.0 * pow(10.0, -48 / 20.0) + 0.5);
+    const uint32_t n0 = k <= 48 ? (uint32_t)floor(4095.0 * pow(10.0, -k / 20.0) + 0.5) : n48 * (uint32_t)(63 - k) / 15;
+    const uint32_t n1 = k + 1 <= 48 ? (uint32_t)floor(4095.0 * pow(10.0, -(k + 1) / 20.0) + 0.5)
+                                    : n48 * (uint32_t)(63 - (k + 1)) / 15;
+    return (256 * n0 - 4 * (n0 - n1) * (uint32_t)(att & 63)) >> 6;
+}
+
+/* An HRIR tap, PR ccc18b4: sign-magnitude, a 3-bit exponent and a 4-bit
+ * mantissa (S EEE MMMM), from 1/2048 to 31/32: e = 0, m / 2048; else
+ * (16 + m) * 2^(e - 1) / 2048. 0x40 is 1/16. */
+static inline float hrtf_coeff_to_float(uint8_t encoded)
+{
+    const unsigned exponent = (encoded >> 4) & 7u;
+    const unsigned mantissa = encoded & 15u;
+    const unsigned magnitude = exponent ? ((16u + mantissa) << (exponent - 1)) : mantissa;
+    const float coefficient = (float)magnitude / 2048.0f;
+    return (encoded & 0x80u) ? -coefficient : coefficient;
+}
+
+/* A filter's frequency coefficient for fc in 1/4096 octave, PR b323e32: 2^(fc
+ * / 4096) taken to a 1024th of an octave (rounded down), then to the nearest
+ * 1/65536, at most FFFFh. Measured: D97Eh gave 3043h. */
+static inline float mcpx_filter_frequency(double fc)
+{
+    const int k = (int)floor(fc / 4.0);
+    const int octave = (int)floor(k / 1024.0);
+    const double c = ldexp(exp2((k - octave * 1024) / 1024.0) * 65536.0, octave);
+    return (float)(fmin(fmax(floor(c + 0.5), 0.0), 65535.0) / 65536.0);
+}
+
+/* OGBox 0.0.8: the DLS2 filter's damping for FC1 (TAR_FCA's high half; FCB's for a stereo voice's
+ * second channel): FC1 / 32768 as PR b323e32 measured (FC1 0 self-oscillated on the console), at
+ * most 1.0 as xemu had it before the PR. Past 1.0 the state-variable recurrence is unstable from f
+ * 0.83 up (at f 1.0 a pole at -1.618 with FC1 FFFFh, NFS Carbon's DirectSound filter). */
+static inline float mcpx_dls2_damping(uint16_t fc1)
+{
+    return fminf((float)fc1 / 32768.0f, 1.0f);
+}
+
+#endif
diff --git a/native/dev/apu/vp/mcpx_round.h b/native/dev/apu/vp/mcpx_round.h
