+
+/* ---- the folder's disc written out: an ISO, then CSOs of it */
+
+static uint8_t *g_iso;
+static size_t g_iso_len;
+
+static bool end_entry(void *ctx, const uint8_t *e, uint32_t off)
+{
+    (void)off;
+    uint64_t *end = ctx;
+    const uint64_t at = (uint64_t)nc_rd32(e + 4) * 2048 + nc_rd32(e + 8);
+    *end = at > *end ? at : *end;
+    return true;
+}
+
+static void dump_tree(const NcDisc *d, uint32_t sector, uint32_t size, uint64_t *end)
+{
+    uint8_t *t = malloc(size);
+    NcDiscFile f = {sector, size, 0x10};
+    if (nc_disc_read(d, &f, 0, t, size)) {
+        nc_xdvdfs_walk(t, size, end_entry, end);
+    }
+    /* and the folders below */
+    for (uint32_t off = 0; off + 14 <= size;) {
+        const uint8_t *e = t + off;
+        if (nc_rd16(e) == 0xFFFF && nc_rd16(e + 2) == 0xFFFF) {
+            off = (off / 2048 + 1) * 2048;
+            continue;
+        }
+        if (e[12] & 0x10) {
+            dump_tree(d, nc_rd32(e + 4), nc_rd32(e + 8), end);
+        }
+        off += (14u + e[13] + 3u) & ~3u;
+    }
+    free(t);
+}
+
+static void test_folder_as_iso(void)
+{
+    const int fd = open_xbe("default.xbe");
+    char game[512];
+    snprintf(game, sizeof(game), "%s/game", g_dir);
+    nc_pack_register_folder(fd, game, "default.xbe");
+    NcDisc d;
+    HT_CHECK(nc_disc_open(&d, fd));
+    uint64_t end = (uint64_t)(d.root_sector + 1) * 2048;
+    dump_tree(&d, d.root_sector, d.root_size, &end);
+    g_iso_len = (size_t)((end + 2047) / 2048 * 2048);
+    g_iso = malloc(g_iso_len);
+    HT_CHECK(nc_pack_read(d.pack, g_iso, g_iso_len, 0));
+    nc_disc_close(&d);
+    nc_pack_unregister(fd);
+    char p[512];
+    snprintf(p, sizeof(p), "%s/game.iso", g_dir);
+    FILE *f = fopen(p, "wb");
+    HT_CHECK(f && fwrite(g_iso, 1, g_iso_len, f) == g_iso_len);
+    fclose(f);
+    const int iso = open(p, O_RDONLY);
+    HT_CHECK(nc_disc_open(&d, iso));
+    check_game(&d, g_xbe, 10000);
+    nc_disc_close(&d);
+}
+
+/* A CSO of the ISO in ciso.py's layout. variant 0: as ciso.py (a compressed block an LZ4 frame's
+ * block: its size, then the LZ4 block; others plain); 1: some frame blocks stored (bit 31 of their
+ * size); 2: bare LZ4 blocks, no size before them. A run of one byte is the block compressed (an
+ * LZ4 block: a literal, a match of 2042 at distance 1, five literals). split_at: past this place
+ * the blocks go in .2.cso, their places from 0 again (ciso.py's 0xFFBF6000). */
+static size_t lz4_run(uint8_t byte, uint8_t *out)
+{
+    size_t n = 0;
+    out[n++] = (1 << 4) | 15;
+    out[n++] = byte;
+    out[n++] = 1, out[n++] = 0;
+    unsigned more = 2042 - 4 - 15;
+    while (more >= 255) {
+        out[n++] = 255;
+        more -= 255;
+    }
+    out[n++] = (uint8_t)more;
+    out[n++] = 5 << 4;
+    for (int i = 0; i < 5; i++) {
+        out[n++] = byte;
+    }
+    return n;
+}
+
+static bool one_byte(const uint8_t *b)
+{
+    for (int i = 1; i < 2048; i++) {
+        if (b[i] != b[0]) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static void w32(FILE *f, uint32_t v)
+{
+    const uint8_t b[4] = {(uint8_t)v, (uint8_t)(v >> 8), (uint8_t)(v >> 16), (uint8_t)(v >> 24)};
+    fwrite(b, 1, 4, f);
+}
+
+static void write_cso(const char *base, int variant, uint64_t split_at)
+{
+    const uint32_t blocks = (uint32_t)(g_iso_len / 2048);
+    char p1[512], p2[512];
+    snprintf(p1, sizeof(p1), "%s.1.cso", base);
+    snprintf(p2, sizeof(p2), "%s.2.cso", base);
+    FILE *f1 = fopen(p1, "wb"), *f2 = NULL, *out = f1;
+    uint32_t *index = calloc(blocks + 1, 4);
+    const uint8_t hdr[24] = {'C', 'I', 'S', 'O', 0x18, 0, 0, 0};
+    fwrite(hdr, 1, 24, f1);
+    for (uint32_t i = 0; i <= blocks; i++) {
+        w32(f1, 0);
+    }
+    uint64_t pos = 24 + 4ull * (blocks + 1);
+    for (uint32_t b = 0; b < blocks; b++) {
+        if (pos > split_at && !f2) {
+            f2 = fopen(p2, "wb");
+            out = f2;
+            pos = 0;
+        }
+        while (pos & 3) {
+            fputc(0, out);
+            pos++;
+        }
+        index[b] = (uint32_t)(pos >> 2);
+        const uint8_t *src = g_iso + (size_t)b * 2048;
+        uint8_t blk[64];
+        if (one_byte(src)) {
+            const size_t n = lz4_run(src[0], blk);
+            if (variant != 2) {
+                w32(out, (uint32_t)n);
+                pos += 4;
+            }
+            fwrite(blk, 1, n, out);
+            pos += n;
+            index[b] |= 0x80000000u;
+        } else if (variant == 1 && b % 7 == 3) {
+            w32(out, 0x80000000u | 2048);
+            fwrite(src, 1, 2048, out);
+            pos += 2052;
+            index[b] |= 0x80000000u;
+        } else {
+            fwrite(src, 1, 2048, out);
+            pos += 2048;
+        }
+    }
+    index[blocks] = (uint32_t)(pos >> 2);
+    for (FILE *f = f1; f; f = f == f1 ? f2 : NULL) {
+        fseek(f, 0, SEEK_END);
+        const long size = ftell(f);
+        for (long k = 0; k < 0x400 - (size & 0x3FF); k++) {
+            fputc(0, f);
+        }
+    }
+    /* the header's image size, block, version and alignment; the index */
+    fseek(f1, 8, SEEK_SET);
+    w32(f1, (uint32_t)g_iso_len);
+    w32(f1, (uint32_t)((uint64_t)g_iso_len >> 32));
+    w32(f1, 2048);
+    fputc(2, f1);
+    fputc(2, f1);
+    fseek(f1, 24, SEEK_SET);
+    for (uint32_t i = 0; i <= blocks; i++) {
+        w32(f1, index[i]);
+    }
+    free(index);
+    fclose(f1);
+    if (f2) {
+        fclose(f2);
+    }
+}
+
+static void read_cso(const char *base, bool split, bool second_there)
+{
+    char p[512];
+    snprintf(p, sizeof(p), "%s.1.cso", base);
+    const int fd = open(p, O_RDONLY);
+    if (split && second_there) {
+        snprintf(p, sizeof(p), "%s.2.cso", base);
+        const int more = open(p, O_RDONLY);
+        nc_pack_register_slices(fd, &more, 1);
+    }
+    NcDisc d;
+    const bool opened = nc_disc_open(&d, fd);
+    HT_CHECK(opened == (!split || second_there));
+    if (opened) {
+        check_game(&d, g_xbe, 10000);
+        HT_CHECK(d.pack != NULL);
+        /* the whole image, as the ISO */
+        uint8_t *all = malloc(g_iso_len);
+        HT_CHECK(nc_pack_read(d.pack, all, g_iso_len, 0) && !memcmp(all, g_iso, g_iso_len));
+        free(all);
+        nc_disc_close(&d);
+    } else {
+        close(fd);
+    }
+    nc_pack_unregister(fd);
+}
+
+static void test_cso(void)
+{
+    char base[512];
+    for (int variant = 0; variant < 3; variant++) {
+        snprintf(base, sizeof(base), "%s/one%d", g_dir, variant);
+        write_cso(base, variant, UINT64_MAX);
+        read_cso(base, false, false);
+    }
+}
+
+static void test_cso_split(void)
+{
+    char base[512];
+    snprintf(base, sizeof(base), "%s/split", g_dir);
+    write_cso(base, 0, g_iso_len / 2);              /* about half in each file */
+    read_cso(base, true, true);
+    read_cso(base, true, false);                    /* game.2.cso missing: not read */
+}
+
+int main(void)
+{
+    make_game();
+    HT_RUN(test_folder);
+    HT_RUN(test_folder_other_xbe);
+    HT_RUN(test_folder_as_iso);
+    HT_RUN(test_cso);
+    HT_RUN(test_cso_split);
+    printf("(the folder and its images in %s)\n", g_dir);
+    HT_DONE();
+}
