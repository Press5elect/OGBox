+/* Copyright (C) 2026-present PortareOS */
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * hakuX native core — the I/O manager's IRP walks, device queues and StartIo
+ * bookkeeping, on guest memory through accessors: io.c runs them on the
+ * guest's RAM (its routines as callouts, kernel.h's continuations), the host
+ * test (tests/hle/test_iorp.c) on a buffer of its own. From hakuX-lr's
+ * iomgr.c (ac3ab2361b, its #86); header-only, as rtl_fmt.h, so the kernel's
+ * file list needs no new file.
+ *
+ * Xbox layouts (nxdk xboxkrnl.h; the stack location's parameters as title
+ * drivers read them):
+ *   IRP (0x68, its stack locations after it): Type 6, Size 0x02, Flags 0x04,
+ *     ThreadListEntry 0x08, IoStatus 0x10, StackCount 0x18, CurrentLocation
+ *     0x19, PendingReturned 0x1A, Cancel 0x1B, UserIosb 0x1C, UserEvent 0x20,
+ *     UserApcRoutine 0x28, UserApcContext 0x2C, UserBuffer 0x30, Tail at 0x3C:
+ *     DeviceQueueEntry / CompletionKey 0x3C, Thread 0x50, ListEntry 0x54,
+ *     CurrentStackLocation / PacketType 0x5C, OriginalFileObject 0x60.
+ *   IO_STACK_LOCATION (0x24): MajorFunction, MinorFunction, Flags, Control,
+ *     Parameters 0x04 (Read/Write { Length, BufferOffset, ByteOffset 0x0C };
+ *     DeviceIoControl { OutputBufferLength, InputBuffer, InputBufferLength,
+ *     IoControlCode 0x10 }), DeviceObject 0x14, FileObject 0x18,
+ *     CompletionRoutine 0x1C, Context 0x20.
+ *   DEVICE_OBJECT: DriverObject 0x08, CurrentIrp 0x10, StartIoFlags 0x1D,
+ *     StackSize 0x1E, DeviceQueue 0x28, StartIoKey 0x44 (io.c's device_new).
+ *   DRIVER_OBJECT: DriverStartIo 0x00, MajorFunction[14] 0x0C.
+ *   KDEVICE_QUEUE (0x0C): Type, Size, Busy 0x03, DeviceListHead 0x04;
+ *     KDEVICE_QUEUE_ENTRY: DeviceListEntry, SortKey 0x08, Inserted 0x0C.
+ *
+ * An IRP's CurrentLocation is StackCount + 1 while no driver has it; each
+ * IofCallDriver takes it one down (the location below, CurrentStackLocation
+ * with it), each completed location one up.
+ */
+#ifndef NC_IORP_H
+#define NC_IORP_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define NC_IRP_BASE        0x68u
+#define NC_SL_SIZE         0x24u
+
+#define NC_IRP_TYPE        0x00
+#define NC_IRP_SIZE        0x02
+#define NC_IRP_FLAGS       0x04
+#define NC_IRP_THREAD_LIST 0x08
+#define NC_IRP_STATUS      0x10
+#define NC_IRP_INFORMATION 0x14
+#define NC_IRP_STACK_COUNT 0x18
+#define NC_IRP_LOCATION    0x19
+#define NC_IRP_PENDING     0x1A
+#define NC_IRP_CANCEL      0x1B
+#define NC_IRP_USER_IOSB   0x1C
+#define NC_IRP_USER_EVENT  0x20
+#define NC_IRP_APC_ROUTINE 0x28
+#define NC_IRP_APC_CONTEXT 0x2C
+#define NC_IRP_USER_BUFFER 0x30
+#define NC_IRP_QUEUE_ENTRY 0x3C
+#define NC_IRP_THREAD      0x50
+#define NC_IRP_LIST_ENTRY  0x54
+#define NC_IRP_STACK       0x5C
+#define NC_IRP_FILE        0x60
+
+#define NC_IRP_PAGING_IO   0x02u
+#define NC_IRP_CLOSE       0x40u
+#define NC_IRP_DEFER       0x80u
+
+#define NC_SL_MAJOR        0x00
+#define NC_SL_MINOR        0x01
+#define NC_SL_FLAGS        0x02
+#define NC_SL_CONTROL      0x03
+#define NC_SL_LENGTH       0x04
+#define NC_SL_OFFSET       0x0C
+#define NC_SL_OUT_LENGTH   0x04
+#define NC_SL_IN_BUFFER    0x08
+#define NC_SL_IN_LENGTH    0x0C
+#define NC_SL_CODE         0x10
+#define NC_SL_DEVICE       0x14
+#define NC_SL_ROUTINE      0x1C
+#define NC_SL_CONTEXT      0x20
+#define NC_SL_PENDING      0x01u
+#define NC_SL_ON_CANCEL    0x20u
+#define NC_SL_ON_SUCCESS   0x40u
+#define NC_SL_ON_ERROR     0x80u
+
+#define NC_DEV_DRIVER      0x08
+#define NC_DEV_CURRENT_IRP 0x10
+#define NC_DEV_STARTIO     0x1D
+#define NC_DEV_STACK_SIZE  0x1E
+#define NC_DEV_QUEUE       0x28
+#define NC_DEV_STARTIO_KEY 0x44
+#define NC_STARTIO_INSIDE   0x01u
+#define NC_STARTIO_DEFERRED 0x02u
+#define NC_STARTIO_BY_KEY   0x04u
+
+#define NC_DRV_STARTIO     0x00
+#define NC_DRV_MAJOR       0x0C
+#define NC_IRP_MJ_COUNT    14u
+
+#define NC_DQ_BUSY         0x03
+#define NC_DQ_HEAD         0x04
+#define NC_DQE_KEY         0x08
+#define NC_DQE_INSERTED    0x0C
+
+#define NC_STATUS_MORE_PROCESSING_REQUIRED 0xC0000016u
+
+/* Guest memory as the walks see it. */
+typedef struct NcIoMem {
+    void *ctx;
+    uint8_t (*rd8)(void *ctx, uint32_t va);
+    void (*wr8)(void *ctx, uint32_t va, uint8_t v);
+    uint32_t (*rd32)(void *ctx, uint32_t va);
+    void (*wr32)(void *ctx, uint32_t va, uint32_t v);
+} NcIoMem;
+
+static inline uint8_t nc_io_rd8(const NcIoMem *m, uint32_t va)
+{
+    return m->rd8(m->ctx, va);
+}
+
+static inline void nc_io_wr8(const NcIoMem *m, uint32_t va, uint8_t v)
+{
+    m->wr8(m->ctx, va, v);
+}
+
+static inline uint32_t nc_io_rd32(const NcIoMem *m, uint32_t va)
+{
+    return m->rd32(m->ctx, va);
+}
+
+static inline void nc_io_wr32(const NcIoMem *m, uint32_t va, uint32_t v)
+{
+    m->wr32(m->ctx, va, v);
+}
+
+static inline void nc_io_wr16(const NcIoMem *m, uint32_t va, uint16_t v)
+{
+    nc_io_wr8(m, va, (uint8_t)v);
+    nc_io_wr8(m, va + 1, (uint8_t)(v >> 8));
+}
+
+/* ----------------------------------------------------------- lists */
+
+static inline void nc_io_list_init(const NcIoMem *m, uint32_t head)
+{
+    nc_io_wr32(m, head, head);
+    nc_io_wr32(m, head + 4, head);
+}
+
+static inline bool nc_io_list_empty(const NcIoMem *m, uint32_t head)
+{
+    return nc_io_rd32(m, head) == head;
+}
+
+/* entry goes in before next */
+static inline void nc_io_list_insert_before(const NcIoMem *m, uint32_t next, uint32_t entry)
+{
+    const uint32_t prev = nc_io_rd32(m, next + 4);
+    nc_io_wr32(m, entry, next);
+    nc_io_wr32(m, entry + 4, prev);
+    nc_io_wr32(m, prev, entry);
+    nc_io_wr32(m, next + 4, entry);
+}
+
+static inline void nc_io_list_remove(const NcIoMem *m, uint32_t entry)
+{
+    const uint32_t next = nc_io_rd32(m, entry), prev = nc_io_rd32(m, entry + 4);
+    nc_io_wr32(m, prev, next);
+    nc_io_wr32(m, next + 4, prev);
+}
+
+/* --------------------------------------------------- device queues */
+
+/* KeInitializeDeviceQueue */
+static inline void nc_devq_init(const NcIoMem *m, uint32_t q)
+{
+    nc_io_wr16(m, q, 0x14);     /* DeviceQueueObject */
+    nc_io_wr8(m, q + 2, 0x0C);
+    nc_io_wr8(m, q + NC_DQ_BUSY, 0);
+    nc_io_list_init(m, q + NC_DQ_HEAD);
+}
+
+/* An entry for a busy queue goes in (by key: after those of its key or
+ * lower); an idle queue becomes busy instead. Returns whether it went in. */
+static inline bool nc_devq_insert(const NcIoMem *m, uint32_t q, uint32_t e, bool by_key, uint32_t key)
+{
+    if (!nc_io_rd8(m, q + NC_DQ_BUSY)) {
+        nc_io_wr8(m, q + NC_DQ_BUSY, 1);
+        nc_io_wr8(m, e + NC_DQE_INSERTED, 0);
+        return false;
+    }
+    uint32_t next = q + NC_DQ_HEAD;
+    if (by_key) {
+        nc_io_wr32(m, e + NC_DQE_KEY, key);
+        for (next = nc_io_rd32(m, q + NC_DQ_HEAD); next != q + NC_DQ_HEAD && nc_io_rd32(m, next + NC_DQE_KEY) <= key;) {
+            next = nc_io_rd32(m, next);
+        }
+    }
+    nc_io_list_insert_before(m, next, e);
+    nc_io_wr8(m, e + NC_DQE_INSERTED, 1);
+    return true;
+}
+
+/* The first entry (by key: the first of the key or above, else the first),
+ * out of the queue; an empty queue goes idle and gives 0. */
+static inline uint32_t nc_devq_remove(const NcIoMem *m, uint32_t q, bool by_key, uint32_t key)
+{
+    const uint32_t head = q + NC_DQ_HEAD;
+    if (nc_io_list_empty(m, head)) {
+        nc_io_wr8(m, q + NC_DQ_BUSY, 0);
+        return 0;
+    }
+    uint32_t e = nc_io_rd32(m, head);
+    if (by_key) {
+        while (e != head && nc_io_rd32(m, e + NC_DQE_KEY) < key) {
+            e = nc_io_rd32(m, e);
+        }
+        if (e == head) {
+            e = nc_io_rd32(m, head);
+        }
+    }
+    nc_io_list_remove(m, e);
+    nc_io_wr8(m, e + NC_DQE_INSERTED, 0);
+    return e;
+}
+
+/* KeRemoveEntryDeviceQueue: whether e was queued (and now isn't) */
+static inline bool nc_devq_remove_entry(const NcIoMem *m, uint32_t e)
+{
+    if (!nc_io_rd8(m, e + NC_DQE_INSERTED)) {
+        return false;
+    }
+    nc_io_list_remove(m, e);
+    nc_io_wr8(m, e + NC_DQE_INSERTED, 0);
+    return true;
+}
+
+/* ------------------------------------------------------------- IRPs */
+
+/* IoInitializeIrp: size bytes zeroed, stack locations, none in use. */
+static inline void nc_irp_init(const NcIoMem *m, uint32_t irp, uint16_t size, uint8_t stack)
+{
+    for (uint32_t i = 0; i < size; i++) {
+        nc_io_wr8(m, irp + i, 0);
+    }
+    nc_io_wr16(m, irp + NC_IRP_TYPE, 6); /* IO_TYPE_IRP */
+    nc_io_wr16(m, irp + NC_IRP_SIZE, size);
+    nc_io_wr8(m, irp + NC_IRP_STACK_COUNT, stack);
+    nc_io_wr8(m, irp + NC_IRP_LOCATION, (uint8_t)(stack + 1));
+    nc_io_list_init(m, irp + NC_IRP_THREAD_LIST);
+    nc_io_wr32(m, irp + NC_IRP_STACK, irp + NC_IRP_BASE + stack * NC_SL_SIZE);
+}
+
+/* IofCallDriver's step: down a stack location to dev; *routine its dispatch
+ * routine for the location's major function (0: dev has no driver, one of
+ * the kernel's own, or no routine for it), *sp the new location. False: no
+ * location left (NO_MORE_IRP_STACK_LOCATIONS). */
+static inline bool nc_irp_down(const NcIoMem *m, uint32_t irp, uint32_t dev, uint32_t *routine, uint32_t *sp)
+{
+    const int loc = (int8_t)nc_io_rd8(m, irp + NC_IRP_LOCATION) - 1;
+    nc_io_wr8(m, irp + NC_IRP_LOCATION, (uint8_t)loc);
+    if (loc <= 0) {
+        return false;
+    }
+    *sp = nc_io_rd32(m, irp + NC_IRP_STACK) - NC_SL_SIZE;
+    nc_io_wr32(m, irp + NC_IRP_STACK, *sp);
+    nc_io_wr32(m, *sp + NC_SL_DEVICE, dev);
+    const uint32_t drv = nc_io_rd32(m, dev + NC_DEV_DRIVER);
+    const uint8_t major = nc_io_rd8(m, *sp + NC_SL_MAJOR);
+    *routine = drv && major < NC_IRP_MJ_COUNT ? nc_io_rd32(m, drv + NC_DRV_MAJOR + 4u * major) : 0;
+    return true;
+}
+
+/* The location under the current one is done: the current goes up one. */
+static inline void nc_irp_up(const NcIoMem *m, uint32_t irp)
+{
+    nc_io_wr8(m, irp + NC_IRP_LOCATION, (uint8_t)(nc_io_rd8(m, irp + NC_IRP_LOCATION) + 1));
+    nc_io_wr32(m, irp + NC_IRP_STACK, nc_io_rd32(m, irp + NC_IRP_STACK) + NC_SL_SIZE);
+}
+
+/* IofCompleteRequest's start: false if the IRP has no location left to
+ * complete (MULTIPLE_IRP_COMPLETE_REQUESTS); else the current location is
+ * done (up one) and the walk can begin. */
+static inline bool nc_irp_complete_begin(const NcIoMem *m, uint32_t irp)
+{
+    const int loc = (int8_t)nc_io_rd8(m, irp + NC_IRP_LOCATION);
+    const int count = (int8_t)nc_io_rd8(m, irp + NC_IRP_STACK_COUNT);
+    if (loc > count + 1) {
+        return false;
+    }
+    nc_irp_up(m, irp);
+    return true;
+}
+
+/* A completion routine to run: routine(DeviceObject, Irp, Context). */
+typedef struct NcIrpCall {
+    uint32_t routine;
+    uint32_t args[3];
+} NcIrpCall;
+
+/* The walk up the stack locations as IopCompleteRequest does it (the current
+ * one already moved past the one to do): each location's completion routine
+ * runs as its Control asks (on success, on error, on cancel), with the
+ * device of the location above (none for the top's); a location without one
+ * passes PendingReturned up. True: *call is to run, then
+ * nc_irp_routine_returned; false: every location is done, the IRP is to
+ * finish (IoStatusBlock, event, APC, free). */
+static inline bool nc_irp_walk(const NcIoMem *m, uint32_t irp, NcIrpCall *call)
+{
+    for (;;) {
+        const int loc = (int8_t)nc_io_rd8(m, irp + NC_IRP_LOCATION);
+        const int count = (int8_t)nc_io_rd8(m, irp + NC_IRP_STACK_COUNT);
+        if (loc > count + 1) {
+            return false;
+        }
+        const uint32_t up = nc_io_rd32(m, irp + NC_IRP_STACK), sp = up - NC_SL_SIZE;
+        const uint8_t control = nc_io_rd8(m, sp + NC_SL_CONTROL);
+        const uint32_t status = nc_io_rd32(m, irp + NC_IRP_STATUS);
+        const uint32_t routine = nc_io_rd32(m, sp + NC_SL_ROUTINE), context = nc_io_rd32(m, sp + NC_SL_CONTEXT);
+        const bool ok = (int32_t)status >= 0;
+        nc_io_wr8(m, irp + NC_IRP_PENDING, control & NC_SL_PENDING);
+        const bool run = routine && ((ok && (control & NC_SL_ON_SUCCESS)) || (!ok && (control & NC_SL_ON_ERROR)) ||
+                                     (nc_io_rd8(m, irp + NC_IRP_CANCEL) && (control & NC_SL_ON_CANCEL)));
+        nc_io_wr8(m, sp + NC_SL_MINOR, 0);
+        nc_io_wr8(m, sp + NC_SL_FLAGS, 0);
+        nc_io_wr8(m, sp + NC_SL_CONTROL, 0);
+        nc_io_wr32(m, sp + NC_SL_ROUTINE, 0);
+        nc_io_wr32(m, sp + NC_SL_CONTEXT, 0);
+        if (run) {
+            call->routine = routine;
+            call->args[0] = loc == count + 1 ? 0 : nc_io_rd32(m, up + NC_SL_DEVICE);
+            call->args[1] = irp;
+            call->args[2] = context;
+            return true;
+        }
+        if ((control & NC_SL_PENDING) && loc <= count) {
+            nc_io_wr8(m, up + NC_SL_CONTROL, nc_io_rd8(m, up + NC_SL_CONTROL) | NC_SL_PENDING);
+        }
+        nc_irp_up(m, irp);
+    }
+}
+
+/* A completion routine returned eax: false if it was
+ * STATUS_MORE_PROCESSING_REQUIRED (the walk stops there, the IRP its
+ * driver's again); else its location is done and the walk goes on. */
+static inline bool nc_irp_routine_returned(const NcIoMem *m, uint32_t irp, uint32_t eax)
+{
+    if (eax == NC_STATUS_MORE_PROCESSING_REQUIRED) {
+        return false;
+    }
+    nc_irp_up(m, irp);
+    return true;
+}
+
+/* ---------------------------------------------------------- StartIo */
+
+/* dev's current IRP is irp, for its driver's StartIo: the routine (0: none,
+ * the IRP stays current), dev marked inside it. */
+static inline uint32_t nc_startio_begin(const NcIoMem *m, uint32_t dev, uint32_t irp)
+{
+    nc_io_wr32(m, dev + NC_DEV_CURRENT_IRP, irp);
+    const uint32_t drv = nc_io_rd32(m, dev + NC_DEV_DRIVER);
+    const uint32_t routine = drv ? nc_io_rd32(m, drv + NC_DRV_STARTIO) : 0;
+    if (routine) {
+        nc_io_wr8(m, dev + NC_DEV_STARTIO, (uint8_t)(nc_io_rd8(m, dev + NC_DEV_STARTIO) | NC_STARTIO_INSIDE));
+    }
+    return routine;
+}
+
+enum NcStartIoNext { NC_STARTIO_IDLE, NC_STARTIO_LATER, NC_STARTIO_START };
+
+/* IoStartNextPacket(ByKey): from inside StartIo, LATER (it starts once
+ * StartIo returns, nc_startio_returned); else the device's next packet (by
+ * key: the first of the key or above) to START in *irp, or IDLE (the queue
+ * empty, no current IRP). */
+static inline enum NcStartIoNext nc_startio_next(const NcIoMem *m, uint32_t dev, bool by_key, uint32_t key,
+                                                 uint32_t *irp)
+{
+    const uint8_t flags = nc_io_rd8(m, dev + NC_DEV_STARTIO);
+    if (flags & NC_STARTIO_INSIDE) {
+        nc_io_wr8(m, dev + NC_DEV_STARTIO, (uint8_t)(flags | NC_STARTIO_DEFERRED | (by_key ? NC_STARTIO_BY_KEY : 0)));
+        nc_io_wr32(m, dev + NC_DEV_STARTIO_KEY, key);
+        return NC_STARTIO_LATER;
+    }
+    nc_io_wr32(m, dev + NC_DEV_CURRENT_IRP, 0);
+    const uint32_t e = nc_devq_remove(m, dev + NC_DEV_QUEUE, by_key, key);
+    if (!e) {
+        return NC_STARTIO_IDLE;
+    }
+    *irp = e - NC_IRP_QUEUE_ENTRY;
+    return NC_STARTIO_START;
+}
+
+/* StartIo returned: true if it asked for the next packet meanwhile (by
+ * *by_key, *key), which goes now. */
+static inline bool nc_startio_returned(const NcIoMem *m, uint32_t dev, bool *by_key, uint32_t *key)
+{
+    const uint8_t flags = nc_io_rd8(m, dev + NC_DEV_STARTIO);
+    nc_io_wr8(m, dev + NC_DEV_STARTIO,
+              (uint8_t)(flags & ~(NC_STARTIO_INSIDE | NC_STARTIO_DEFERRED | NC_STARTIO_BY_KEY)));
+    *by_key = (flags & NC_STARTIO_BY_KEY) != 0;
+    *key = nc_io_rd32(m, dev + NC_DEV_STARTIO_KEY);
+    return (flags & NC_STARTIO_DEFERRED) != 0;
+}
+
