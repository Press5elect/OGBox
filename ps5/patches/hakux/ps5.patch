+/* An IRP the kernel frees as it completes: one in the Ex pool (IoAllocateIrp's, or
+ * ExAllocatePool's that a title initialized), its block at least the IRP's size. One
+ * elsewhere (a driver's own, completed without STATUS_MORE_PROCESSING_REQUIRED) is
+ * left where it is, logged once: the pool's header isn't there to free it by. */
+static void irp_free(NcKernel *k, uint32_t irp)
+{
+    const uint32_t size = *(const uint16_t *)nc_vm_host(k->vm, irp + NC_IRP_SIZE);
+    const uint32_t block = nc_vm_phys(k->vm, irp - 16) != UINT32_MAX ? nc_vm_rd32(k->vm, irp - 16) : 0;
+    if (block >= size && block < 0x10000) {
+        nc_ex_free(k, irp);
+        return;
+    }
+    static bool told;
+    if (!told) {
+        told = true;
+        nc_log("hakuX-native-io", "irp %08x completed, not from the pool: not freed", irp);
+    }
+}
