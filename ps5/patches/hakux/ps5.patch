+    const unsigned ss = GET_MASK(fmt, NV_PAVS_VOICE_CFG_FMT_SAMPLE_SIZE);
+    char ssl[160] = "";
+    if (stream) {
+        const MCPXAPUVPSSLData *sd = &d->vp.ssl[v];
+        snprintf(ssl, sizeof(ssl), " | SSL A %06x x%u B %06x x%u, at %c[%d]", sd->base[0], sd->count[0], sd->base[1],
+                 sd->count[1], sd->ssl_index ? 'B' : 'A', sd->ssl_seg);
+    }
+    nc_log("hakuX-apu", "  voice %02x %s: %s%s%s, %s, %s%s%s, %s%s, %u per block%s%s%s | cbo %06x ebo %06x lbo %06x ba %06x | "
+           "pitch %d | env a %s f %s | vol %08x %08x %08x%s | in %.1f s: samples %u, segments %u, SSLs %u, "
+           "buffer ends %u, notified %u; held %u frames",
+           v, list, (state & NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE) ? "active" : "idle",
+           (state & NV_PAVS_VOICE_PAR_STATE_PAUSED) ? " paused" : "",
+           (state & NV_PAVS_VOICE_PAR_STATE_NEW_VOICE) ? " new" : "", stream ? "stream" : "buffer", k_cs[cs],
+           cs == NV_PAVS_VOICE_CFG_FMT_CONTAINER_SIZE_ADPCM ? "" : " ", cs == NV_PAVS_VOICE_CFG_FMT_CONTAINER_SIZE_ADPCM ? "" : k_ss[ss],
+           (fmt & NV_PAVS_VOICE_CFG_FMT_STEREO) ? "stereo" : "mono",
+           (fmt & NV_PAVS_VOICE_CFG_FMT_MULTIPASS) ? " multipass" : "",
+           1 + GET_MASK(fmt, NV_PAVS_VOICE_CFG_FMT_SAMPLES_PER_BLOCK),
+           (fmt & NV_PAVS_VOICE_CFG_FMT_LOOP) ? ", loop" : "", (fmt & NV_PAVS_VOICE_CFG_FMT_PERSIST) ? ", persist" : "",
+           (fmt & NV_PAVS_VOICE_CFG_FMT_LINKED) ? ", linked" : "",
+           voice_get_mask(d, v, NV_PAVS_VOICE_PAR_OFFSET, NV_PAVS_VOICE_PAR_OFFSET_CBO),
+           voice_get_mask(d, v, NV_PAVS_VOICE_PAR_NEXT, NV_PAVS_VOICE_PAR_NEXT_EBO),
+           voice_get_mask(d, v, NV_PAVS_VOICE_CUR_PSH_SAMPLE, NV_PAVS_VOICE_CUR_PSH_SAMPLE_LBO),
+           voice_get_mask(d, v, NV_PAVS_VOICE_CUR_PSL_START, NV_PAVS_VOICE_CUR_PSL_START_BA),
+           (int16_t)voice_get_mask(d, v, NV_PAVS_VOICE_TAR_PITCH_LINK, NV_PAVS_VOICE_TAR_PITCH_LINK_PITCH),
+           k_env_state[GET_MASK(state, NV_PAVS_VOICE_PAR_STATE_EACUR)],
+           k_env_state[GET_MASK(state, NV_PAVS_VOICE_PAR_STATE_EFCUR)],
+           voice_get_mask(d, v, NV_PAVS_VOICE_TAR_VOLA, 0xFFFFFFFF),
+           voice_get_mask(d, v, NV_PAVS_VOICE_TAR_VOLB, 0xFFFFFFFF),
+           voice_get_mask(d, v, NV_PAVS_VOICE_TAR_VOLC, 0xFFFFFFFF), ssl, s,
+           apu_xchg(&g_v_samples[v], 0), apu_xchg(&g_v_segments[v], 0), apu_xchg(&g_v_ssls[v], 0),
+           apu_xchg(&g_v_ends[v], 0), apu_xchg(&g_v_notified[v], 0), d->vp.held_frames[v]);
+}
+
+void mcpx_apu_vp_diag(MCPXAPUState *d, double s)
+{
+    /* the methods, busiest first (at most 12 named) */
+    uint32_t n[PIO_SLOTS];
+    for (unsigned i = 0; i < PIO_SLOTS; i++) {
+        n[i] = apu_xchg(&g_pio_n[i], 0);
+    }
+    char line[900];
+    int len = snprintf(line, sizeof(line), "methods in %.1f s:", s);
+    const int empty = len;
+    for (unsigned k = 0; k < 12; k++) {
+        unsigned best = PIO_SLOTS;
+        for (unsigned i = 0; i < PIO_SLOTS; i++) {
+            if (n[i] && (best == PIO_SLOTS || n[i] > n[best])) {
+                best = i;
+            }
+        }
+        if (best == PIO_SLOTS || len > (int)sizeof(line) - 80) {
+            break;
+        }
+        char b[24];
+        len += snprintf(line + len, sizeof(line) - (size_t)len, " %s %u", method_name(best * 4, b, sizeof(b)),
+                        n[best]);
+        n[best] = 0;
+    }
+    if (len == empty) {
+        len += snprintf(line + len, sizeof(line) - (size_t)len, " none");
+    }
+    nc_log("hakuX-apu", "%s | past the methods %u | reads: FREE %u, other %u", line, apu_xchg(&g_pio_other, 0),
+           apu_xchg(&g_pio_free_reads, 0), apu_xchg(&g_pio_other_reads, 0));
+
+    const uint32_t lv = apu_ld(&g_notify_last_v);
+    nc_log("hakuX-apu", "notifications in %.1f s: %u (%u in all; notifier base FENADDR %08x), idle traps %u "
+           "(FETFORCE1 %08x: %s), the current voice %04x, SSL base page %x, VPVADDR %08x VPSSLADDR %08x VPSGEADDR %08x",
+           s, apu_xchg(&g_notify_n, 0), apu_ld(&g_notify_total), d->regs[NV_PAPU_FENADDR], apu_xchg(&g_idle_traps, 0), d->regs[NV_PAPU_FETFORCE1],
+           (d->regs[NV_PAPU_FETFORCE1] & NV_PAPU_FETFORCE1_SE2FE_IDLE_VOICE) ? "the guest takes idle reports"
+                                                                              : "no idle reports",
+           d->regs[NV_PAPU_FECV] & 0xFFFF, d->vp.ssl_base_page, d->regs[NV_PAPU_VPVADDR], d->regs[NV_PAPU_VPSSLADDR],
+           d->regs[NV_PAPU_VPSGEADDR]);
+    if (apu_ld(&g_notify_total)) {
+        nc_log("hakuX-apu", "  the last notification: voice %02x, %s, at pa %08x (status byte %08x)%s", lv,
+               apu_ld(&g_notify_last_kind) == MCPX_HW_NOTIFIER_SSLB_DONE ? "SSL B done" : "SSL A done / voice done",
+               apu_ld(&g_notify_last_pa), apu_ld(&g_notify_last_pa) + 15,
+               apu_ld(&g_notify_dropped) ? " (some went nowhere: no notifier base, or outside RAM)" : "");
+    }
+
+    /* the voices on the lists, at most 16 */
+    static const uint32_t k_top[3] = {NV_PAPU_TVL2D, NV_PAPU_TVL3D, NV_PAPU_TVLMP};
+    static const char *const k_list[3] = {"2d", "3d", "mp"};
+    unsigned shown = 0;
+    for (unsigned l = 0; l < 3 && d->regs[NV_PAPU_VPVADDR]; l++) {
+        uint32_t h = d->regs[k_top[l]] & 0xFFFF;
+        for (unsigned i = 0; h != 0xFFFF && i < MCPX_HW_MAX_VOICES; i++) {
+            if (h >= MCPX_HW_MAX_VOICES) {
+                nc_log("hakuX-apu", "  list %s: voice %04x is past the voices", k_list[l], h);
+                break;
+            }
+            if (shown++ < 16) {
+                voice_diag_line(d, (uint16_t)h, k_list[l], s);
+            }
+            h = voice_get_mask(d, (uint16_t)h, NV_PAVS_VOICE_TAR_PITCH_LINK,
+                               NV_PAVS_VOICE_TAR_PITCH_LINK_NEXT_VOICE_HANDLE);
+        }
+    }
+    if (shown > 16) {
+        nc_log("hakuX-apu", "  (%u voices more on the lists)", shown - 16);
+    }
+}
