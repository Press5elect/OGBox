+#include "hw/xbox/hle/base.h"
+#include "hw/xbox/hle/hle.h"
+#include "hw/xbox/hle/tex/xdk.h"
+#define XXH_INLINE_ALL                  /* (as pb/pbdraw.c: no xxhash library is linked) */
+#include "xxhash.h"
+
+#include <dirent.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+
+#define TP_PNG_SIDE     2048u               /* a PNG's largest side (its chain: 22 MiB as A8R8G8B8) */
+#define TP_DDS_SIDE     8192u
+#define TP_MAX_BYTES    (24u << 20)         /* a replacement's levels, at most: room in the 32 MiB upload arena */
+#define TP_MAX_SCALE    8u
+#define TP_SLOTS        (1u << 16)          /* the key table: dumped and replacement keys */
+#define TP_DUMP_QUEUE   (96u << 20)         /* dumps' bytes waiting to be written, at most */
+#define TP_DUMP_MAX     60000u              /* dumps a run, at most */
+#define TP_GPU_BYTES    (1024ull << 20)     /* replacements on the GPU, at most */
+
+static struct {
+    HleTexpackLoadFn load;
+    HleTexpackFreeFn free_fn;
+    HleTexpackSaveFn save;
+} g_codec;
+
+typedef struct TpEntry {
+    uint64_t key;               /* 0: free */
+    bool dumped;                /* dumped (this run, or a file of it in the dump folder) */
+    bool bad;                   /* its file didn't read or doesn't fit: not tried again */
+    bool gpu;                   /* its image is on the GPU (vk/draw.c's replacement images) */
+    bool dds;
+    char *path;                 /* a replacement's file, or NULL */
+    uint8_t *data;              /* its levels, read and not yet uploaded */
+    uint32_t xfmt, w, h, levels, bytes;
+    uint64_t used;              /* the last use (the GPU budget's order) */
+    int64_t mtime;              /* a replacement file's time (the newest of a key's files wins) */
+} TpEntry;
+
+typedef struct TpDump {
+    struct TpDump *next;
+    uint64_t key;
+    uint32_t fmt, w, h, levels, size;
+    bool dds;
+    uint8_t data[];             /* PNG: RGBA; DDS: the blocks */
+} TpDump;
+
+static struct {
+    pthread_once_t once;
+    pthread_mutex_t mu;
+    pthread_cond_t work;
+    bool dump_on, pack_on;
+    char dump_dir[512], pack_dir[512];
+    TpEntry *tab;
+    unsigned nrepl, npng, ndds, nskipped;
+    TpDump *head, *tail;
+    size_t queued;
+    unsigned ndumped, ndropped, nfailed, nreplaced;
+    uint64_t gpu_bytes, clock;
+} g_tp = { .once = PTHREAD_ONCE_INIT, .mu = PTHREAD_MUTEX_INITIALIZER, .work = PTHREAD_COND_INITIALIZER };
+
+void hle_texpack_set_codec(HleTexpackLoadFn load, HleTexpackFreeFn free_fn, HleTexpackSaveFn save)
+{
+    g_codec.load = load;
+    g_codec.free_fn = free_fn;
+    g_codec.save = save;
+}
+
+/* key's entry (created when make), or NULL. g_tp.mu held. */
+static TpEntry *entry(uint64_t key, bool make)
+{
+    key |= !key;                                        /* (0 marks a free slot) */
+    for (uint32_t i = (uint32_t)(key ^ key >> 32) & (TP_SLOTS - 1), n = 0; n < TP_SLOTS;
+         i = (i + 1) & (TP_SLOTS - 1), n++) {
+        TpEntry *e = &g_tp.tab[i];
+        if (e->key == key) {
+            return e;
+        }
+        if (!e->key) {
+            if (!make) {
+                return NULL;
+            }
+            e->key = key;
+            return e;
+        }
+    }
+    return NULL;
+}
+
+/* The key in a file name: the 16 hex digits after "tex_" */
+static bool name_key(const char *name, uint64_t *key)
+{
+    for (const char *p = strstr(name, "tex_"); p; p = strstr(p + 1, "tex_")) {
+        char hex[17];
+        unsigned i = 0;
+        for (; i < 16 && ((p[4 + i] >= '0' && p[4 + i] <= '9') || ((p[4 + i] | 32) >= 'a' && (p[4 + i] | 32) <= 'f'));
+             i++) {
+            hex[i] = p[4 + i];
+        }
+        if (i == 16) {
+            hex[16] = 0;
+            *key = strtoull(hex, NULL, 16);
+            return true;
+        }
+    }
+    return false;
+}
+
+/* 1 a .png, 2 a .dds, 0 neither */
+static int file_kind(const char *name)
+{
+    const size_t n = strlen(name);
+    return n <= 4 ? 0 : !strcasecmp(name + n - 4, ".png") ? 1 : !strcasecmp(name + n - 4, ".dds") ? 2 : 0;
+}
+
+/* dump: the dump folder's files marked dumped; else the replacements under dir. 1.0.2: the
+ * pack folder's own "dump" folder is never read for replacements, whether dumps are on or not
+ * (its files are the game's own textures: read as replacements, every one of them replaced its
+ * texture with itself, and a dumped DDS won over the player's PNG of the same key). Of a key's
+ * files the newest wins (a DDS over a PNG of the same time). */
+static void scan(const char *dir, bool dump, int depth)
+{
+    DIR *d = opendir(dir);
+    struct dirent *de;
+    while (d && (de = readdir(d))) {
+        if (de->d_name[0] == '.') {
+            continue;
+        }
+        char p[1024];
+        snprintf(p, sizeof(p), "%s/%s", dir, de->d_name);
+        struct stat st;
+        if (stat(p, &st) != 0) {
+            continue;
+        }
+        if (S_ISDIR(st.st_mode)) {
+            const bool dump_dir = !dump && ((depth == 0 && !strcasecmp(de->d_name, "dump")) ||
+                                            (g_tp.dump_dir[0] && !strcmp(p, g_tp.dump_dir)));
+            if (dump_dir) {
+                g_tp.nskipped++;
+            } else if (depth < 8) {
+                scan(p, dump, depth + 1);
+            }
+            continue;
+        }
+        uint64_t key;
+        const int kind = file_kind(de->d_name);
+        if (!kind || !name_key(de->d_name, &key)) {
+            continue;
+        }
+        if (!dump && kind == 1 && !g_codec.load) {
+            continue;
+        }
+        TpEntry *e = entry(key, true);
+        if (!e) {
+            continue;
+        }
+        const int64_t t = (int64_t)st.st_mtime;
+        if (dump) {
+            e->dumped = true;
+        } else if (!e->path || t > e->mtime || (t == e->mtime && kind == 2 && !e->dds)) {
+            if (!e->path) {
+                g_tp.nrepl++;
+            } else {
+                e->dds ? g_tp.ndds-- : g_tp.npng--;
+            }
+            kind == 2 ? g_tp.ndds++ : g_tp.npng++;
+            free(e->path);
+            e->path = strdup(p);
+            e->dds = kind == 2;
+            e->mtime = t;
+        }
+    }
+    if (d) {
+        closedir(d);
+    }
+}
+
+static bool mkdirs(const char *path)
+{
+    char tmp[512];
+    snprintf(tmp, sizeof(tmp), "%s", path);
+    for (char *p = tmp + 1; *p; p++) {
+        if (*p == '/') {
+            *p = 0;
+            mkdir(tmp, 0777);
+            *p = '/';
+        }
+    }
+    return mkdir(tmp, 0777) == 0 || errno == EEXIST;
+}
+
+/* ---- DDS ---------------------------------------------------------------------------------- */
+
+static void put32le(uint8_t *p, uint32_t v)
+{
+    p[0] = (uint8_t)v;
+    p[1] = (uint8_t)(v >> 8);
+    p[2] = (uint8_t)(v >> 16);
+    p[3] = (uint8_t)(v >> 24);
+}
+
+static uint32_t get32le(const uint8_t *p)
+{
+    return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static uint32_t dxt_block_bytes(uint32_t xfmt)
+{
+    return xfmt == HLE_XFMT_DXT1 ? 8 : 16;
+}
+
+static uint32_t dxt_level_bytes(uint32_t xfmt, uint32_t w, uint32_t h)
+{
+    return MAX((w + 3) / 4, 1u) * MAX((h + 3) / 4, 1u) * dxt_block_bytes(xfmt);
+}
+
+static bool write_dds(const char *path, const TpDump *j)
+{
+    uint8_t hd[128] = { 'D', 'D', 'S', ' ' };
+    put32le(hd + 4, 124);
+    put32le(hd + 8, 0x1 | 0x2 | 0x4 | 0x1000 | 0x80000 | (j->levels > 1 ? 0x20000 : 0));
+    put32le(hd + 12, j->h);
+    put32le(hd + 16, j->w);
+    put32le(hd + 20, dxt_level_bytes(j->fmt, j->w, j->h));
+    put32le(hd + 28, j->levels);
+    put32le(hd + 76, 32);                               /* DDS_PIXELFORMAT */
+    put32le(hd + 80, 0x4);                              /* DDPF_FOURCC */
+    memcpy(hd + 84, j->fmt == HLE_XFMT_DXT1 ? "DXT1" : j->fmt == HLE_XFMT_DXT3 ? "DXT3" : "DXT5", 4);
+    put32le(hd + 108, 0x1000 | (j->levels > 1 ? 0x8 | 0x400000 : 0));
+    FILE *f = fopen(path, "wb");
+    if (!f) {
+        return false;
+    }
+    const bool ok = fwrite(hd, 1, sizeof(hd), f) == sizeof(hd) && fwrite(j->data, 1, j->size, f) == j->size;
+    return fclose(f) == 0 && ok;
+}
+
+/* A DDS file's DXT levels (the chain cut where the file ends) */
+static bool read_dds(const char *path, uint8_t **data, uint32_t *xfmt, uint32_t *ow, uint32_t *oh,
+                     uint32_t *olevels, uint32_t *obytes, char *why, size_t why_len)
+{
+    FILE *f = fopen(path, "rb");
+    if (!f) {
+        snprintf(why, why_len, "not opened");
+        return false;
+    }
+    uint8_t hd[148];
+    size_t got = fread(hd, 1, 128, f);
+    if (got != 128 || memcmp(hd, "DDS ", 4) || get32le(hd + 4) != 124) {
+        fclose(f);
+        snprintf(why, why_len, "not a DDS file");
+        return false;
+    }
+    const uint32_t h = get32le(hd + 12), w = get32le(hd + 16), pf = get32le(hd + 80);
+    uint32_t mips = (get32le(hd + 8) & 0x20000) ? MAX(get32le(hd + 28), 1u) : 1;
+    uint32_t x = 0;
+    if ((pf & 0x4) && !memcmp(hd + 84, "DXT1", 4)) {
+        x = HLE_XFMT_DXT1;
+    } else if ((pf & 0x4) && (!memcmp(hd + 84, "DXT3", 4) || !memcmp(hd + 84, "DXT2", 4))) {
+        x = HLE_XFMT_DXT3;
+    } else if ((pf & 0x4) && (!memcmp(hd + 84, "DXT5", 4) || !memcmp(hd + 84, "DXT4", 4))) {
+        x = HLE_XFMT_DXT5;
+    } else if ((pf & 0x4) && !memcmp(hd + 84, "DX10", 4) && fread(hd + 128, 1, 20, f) == 20) {
+        const uint32_t dxgi = get32le(hd + 128);        /* BC1, BC2, BC3: typeless, unorm, srgb */
+        x = dxgi >= 70 && dxgi <= 72 ? HLE_XFMT_DXT1 : dxgi >= 73 && dxgi <= 75 ? HLE_XFMT_DXT3 :
+            dxgi >= 76 && dxgi <= 78 ? HLE_XFMT_DXT5 : 0;
+    }
+    if (!x || !w || !h || w > TP_DDS_SIDE || h > TP_DDS_SIDE) {
+        fclose(f);
+        snprintf(why, why_len, x ? "too large (%u x %u)" : "not DXT1, DXT3 or DXT5", w, h);
+        return false;
+    }
+    mips = MIN(mips, 16u);
+    uint32_t total = 0, levels = 0;
+    for (; levels < mips; levels++) {
+        const uint32_t n = dxt_level_bytes(x, MAX(w >> levels, 1u), MAX(h >> levels, 1u));
+        if (total + n > TP_MAX_BYTES) {
+            break;
+        }
+        total += n;
+    }
+    uint8_t *d = levels ? malloc(total) : NULL;
+    got = d ? fread(d, 1, total, f) : 0;
+    fclose(f);
+    /* a short file: the levels it holds */
+    uint32_t have = 0, keep = 0;
+    for (uint32_t l = 0; l < levels; l++) {
+        const uint32_t n = dxt_level_bytes(x, MAX(w >> l, 1u), MAX(h >> l, 1u));
+        if (have + n > got) {
+            break;
+        }
+        have += n;
+        keep++;
+    }
+    if (!keep) {
+        free(d);
+        snprintf(why, why_len, levels ? "its first level is cut short" : "its first level is over %u MiB",
+                 TP_MAX_BYTES >> 20);
+        return false;
+    }
+    *data = d;
+    *xfmt = x;
+    *ow = w;
+    *oh = h;
+    *olevels = keep;
+    *obytes = have;
+    return true;
+}
+
+/* ---- PNG ---------------------------------------------------------------------------------- */
+
+/* A box filter's next level from one w x h (4 bytes a texel; the four texels' plain mean) */
+static void half_level(const uint8_t *s, uint32_t w, uint32_t h, uint8_t *o)
+{
+    const uint32_t ow = w > 1 ? w / 2 : 1, oh = h > 1 ? h / 2 : 1;
+    for (uint32_t y = 0; y < oh; y++) {
+        const uint32_t y0 = MIN(2 * y, h - 1), y1 = MIN(2 * y + 1, h - 1);
+        for (uint32_t x = 0; x < ow; x++) {
+            const uint32_t x0 = MIN(2 * x, w - 1), x1 = MIN(2 * x + 1, w - 1);
+            for (unsigned c = 0; c < 4; c++) {
+                const unsigned v = s[4 * (y0 * w + x0) + c] + s[4 * (y0 * w + x1) + c] + s[4 * (y1 * w + x0) + c] +
+                                   s[4 * (y1 * w + x1) + c];
+                o[4 * (y * ow + x) + c] = (uint8_t)((v + 2) / 4);
+            }
+        }
+    }
+}
+
+/* A PNG file as A8R8G8B8 (bytes B, G, R, A), a full chain of levels */
+static bool read_png(const char *path, uint8_t **data, uint32_t *ow, uint32_t *oh, uint32_t *olevels,
+                     uint32_t *obytes, char *why, size_t why_len)
+{
+    int w = 0, h = 0;
+    unsigned char *px = g_codec.load(path, &w, &h);
+    if (!px || w <= 0 || h <= 0 || (uint32_t)w > TP_PNG_SIDE || (uint32_t)h > TP_PNG_SIDE) {
+        snprintf(why, why_len, px ? "over %u x %u (%d x %d; a DDS can be larger)" : "not a PNG file",
+                 TP_PNG_SIDE, TP_PNG_SIDE, w, h);
+        if (px) {
+            g_codec.free_fn(px);
+        }
+        return false;
+    }
+    uint32_t levels = 1;
+    for (uint32_t m = MAX((uint32_t)w, (uint32_t)h); m > 1 && levels < 16; m >>= 1) {
+        levels++;
+    }
+    size_t total = 0;
+    for (uint32_t l = 0; l < levels; l++) {
+        total += (size_t)MAX((uint32_t)w >> l, 1u) * MAX((uint32_t)h >> l, 1u) * 4;
+    }
+    uint8_t *d = malloc(total);
+    if (!d) {
+        g_codec.free_fn(px);
+        snprintf(why, why_len, "no memory");
+        return false;
+    }
+    for (size_t i = 0; i < (size_t)w * h; i++) {        /* R, G, B, A -> B, G, R, A */
+        d[4 * i] = px[4 * i + 2];
+        d[4 * i + 1] = px[4 * i + 1];
+        d[4 * i + 2] = px[4 * i];
+        d[4 * i + 3] = px[4 * i + 3];
+    }
+    g_codec.free_fn(px);
+    uint8_t *lv = d;
+    for (uint32_t l = 1; l < levels; l++) {
+        const uint32_t lw = MAX((uint32_t)w >> (l - 1), 1u), lh = MAX((uint32_t)h >> (l - 1), 1u);
+        uint8_t *next = lv + (size_t)lw * lh * 4;
+        half_level(lv, lw, lh, next);
+        lv = next;
+    }
+    *data = d;
+    *ow = (uint32_t)w;
+    *oh = (uint32_t)h;
+    *olevels = levels;
+    *obytes = (uint32_t)total;
+    return true;
+}
+
+/* ---- dumps -------------------------------------------------------------------------------- */
+
+static void *dump_thread(void *arg)
+{
+    (void)arg;
+    pthread_mutex_lock(&g_tp.mu);
+    for (;;) {
+        while (!g_tp.head) {
+            pthread_cond_wait(&g_tp.work, &g_tp.mu);
+        }
+        TpDump *j = g_tp.head;
+        g_tp.head = j->next;
+        if (!g_tp.head) {
+            g_tp.tail = NULL;
+        }
+        pthread_mutex_unlock(&g_tp.mu);
+        char path[700], tmp[720];
+        snprintf(path, sizeof(path), "%s/tex_%016llx_%ux%u_%02x.%s", g_tp.dump_dir, (unsigned long long)j->key,
+                 j->w, j->h, j->fmt, j->dds ? "dds" : "png");
+        snprintf(tmp, sizeof(tmp), "%s.part", path);
+        const bool ok = (j->dds ? write_dds(tmp, j) : g_codec.save(tmp, (int)j->w, (int)j->h, j->data)) &&
+                        rename(tmp, path) == 0;
+        if (!ok) {
+            remove(tmp);
+        }
+        pthread_mutex_lock(&g_tp.mu);
+        g_tp.queued -= j->size;
+        ok ? g_tp.ndumped++ : g_tp.nfailed++;
+        const unsigned n = g_tp.ndumped, nf = g_tp.nfailed;
+        pthread_mutex_unlock(&g_tp.mu);
+        if (!ok && nf <= 4) {
+            hle_log("hakuX-hle-tex", "dump %s: not written (first 4 told)", path);
+        } else if (ok && (n == 1 || n % 500 == 0)) {
+            hle_log("hakuX-hle-tex", "dumps: %u textures written to %s", n, g_tp.dump_dir);
+        }
+        free(j);
+        pthread_mutex_lock(&g_tp.mu);
+    }
+    return NULL;
+}
+
+static void init_once(void)
+{
+    const char *dd = getenv("NC_HLE_TEXDUMP_DIR"), *pd = getenv("NC_HLE_TEXPACK_DIR");
+    if ((!dd || !*dd) && (!pd || !*pd)) {
+        return;
+    }
+    g_tp.tab = calloc(TP_SLOTS, sizeof(TpEntry));
+    if (!g_tp.tab) {
+        return;
+    }
+    if (dd && *dd) {
+        snprintf(g_tp.dump_dir, sizeof(g_tp.dump_dir), "%s", dd);
+        pthread_t t;
+        g_tp.dump_on = mkdirs(g_tp.dump_dir) && pthread_create(&t, NULL, dump_thread, NULL) == 0;
+        if (g_tp.dump_on) {
+            pthread_detach(t);
+            scan(g_tp.dump_dir, true, 0);
+        }
+        hle_log("hakuX-hle-tex", "texture dumps: %s%s%s", g_tp.dump_dir,
+                !g_tp.dump_on ? ": the folder couldn't be made, no dumps"
+                              : " (each texture once: DXT as DDS, the rest as PNG; those there already are kept)",
+                g_tp.dump_on && !g_codec.save ? "; no PNG writer here: DDS only" : "");
+    }
+    if (pd && *pd) {
+        snprintf(g_tp.pack_dir, sizeof(g_tp.pack_dir), "%s", pd);
+        scan(g_tp.pack_dir, false, 0);
+        g_tp.pack_on = g_tp.nrepl > 0;
+        hle_log("hakuX-hle-tex", "texture replacements: %u in %s (%u PNG, %u DDS)%s", g_tp.nrepl, g_tp.pack_dir,
+                g_tp.npng, g_tp.ndds, g_tp.nskipped ? "; its dump folder is not read: copy the files you made to the "
+                "folder itself" : "");
+    }
+}
+
+bool hle_texpack_on(void)
+{
+    pthread_once(&g_tp.once, init_once);
+    return g_tp.dump_on || g_tp.pack_on;
+}
+
+bool hle_texpack_dumping(void)
+{
+    return hle_texpack_on() && g_tp.dump_on;
+}
+
+uint64_t hle_texpack_key(const void *texels, size_t n, const void *pal, size_t npal_bytes, uint32_t fmt,
+                         uint32_t w, uint32_t h, uint32_t levels)
+{
+    const uint64_t seed = (uint64_t)fmt << 56 ^ (uint64_t)levels << 48 ^ (uint64_t)w << 24 ^ h;
+    uint64_t k = XXH3_64bits_withSeed(texels, n, seed);
+    if (pal && npal_bytes) {
+        k ^= XXH3_64bits_withSeed(pal, npal_bytes, ~seed) * 0x9E3779B97F4A7C15ull;
+    }
+    return k | !k;
+}
+
+/* A dump of size bytes queued (its data filled by fill), unless key was dumped or is replaced */
+static TpDump *dump_begin(uint64_t key, uint32_t size)
+{
+    if (!hle_texpack_dumping()) {
+        return NULL;
+    }
+    pthread_mutex_lock(&g_tp.mu);
+    TpEntry *e = entry(key, true);
+    if (!e || e->dumped || e->path) {
+        pthread_mutex_unlock(&g_tp.mu);
+        return NULL;
+    }
+    if (g_tp.queued + size > TP_DUMP_QUEUE || g_tp.ndumped >= TP_DUMP_MAX) {
+        /* not marked: a later definition of it tries again */
+        const bool tell = g_tp.ndropped++ % 1000 == 0;
+        const unsigned n = g_tp.ndropped;
+        pthread_mutex_unlock(&g_tp.mu);
+        if (tell) {
+            hle_log("hakuX-hle-tex", "dumps: the writer is behind (%u left for later so far)", n);
+        }
+        return NULL;
+    }
+    TpDump *j = malloc(sizeof(*j) + size);
+    if (j) {
+        e->dumped = true;
+        g_tp.queued += size;
+    }
+    pthread_mutex_unlock(&g_tp.mu);
+    return j;
+}
+
+static void dump_queue(TpDump *j)
+{
+    pthread_mutex_lock(&g_tp.mu);
+    if (g_tp.tail) {
+        g_tp.tail->next = j;
+    } else {
+        g_tp.head = j;
+    }
+    g_tp.tail = j;
+    pthread_cond_signal(&g_tp.work);
+    pthread_mutex_unlock(&g_tp.mu);
+}
+
+void hle_texpack_dump_png(uint64_t key, uint32_t fmt, uint32_t w, uint32_t h, const uint32_t *argb)
+{
+    if (!g_codec.save || !w || !h || w > TP_DDS_SIDE || h > TP_DDS_SIDE) {
+        return;
+    }
+    TpDump *j = dump_begin(key, w * h * 4);
+    if (!j) {
+        return;
+    }
+    *j = (TpDump){ .key = key, .fmt = fmt, .w = w, .h = h, .levels = 1, .size = w * h * 4 };
+    for (size_t i = 0; i < (size_t)w * h; i++) {        /* bytes B, G, R, A -> R, G, B, A */
+        const uint32_t v = argb[i];
+        j->data[4 * i] = (uint8_t)(v >> 16);
+        j->data[4 * i + 1] = (uint8_t)(v >> 8);
+        j->data[4 * i + 2] = (uint8_t)v;
+        j->data[4 * i + 3] = (uint8_t)(v >> 24);
+    }
+    dump_queue(j);
+}
+
+void hle_texpack_dump_dds(uint64_t key, uint32_t fmt, uint32_t w, uint32_t h, uint32_t levels,
+                          const void *blocks, uint32_t bytes)
+{
+    if (!w || !h || !bytes || (fmt != HLE_XFMT_DXT1 && fmt != HLE_XFMT_DXT3 && fmt != HLE_XFMT_DXT5)) {
+        return;
+    }
+    TpDump *j = dump_begin(key, bytes);
+    if (!j) {
+        return;
+    }
+    *j = (TpDump){ .key = key, .fmt = fmt, .w = w, .h = h, .levels = MAX(levels, 1u), .size = bytes, .dds = true };
+    memcpy(j->data, blocks, bytes);
+    dump_queue(j);
+}
+
+/* ---- replacements ------------------------------------------------------------------------- */
+
+bool hle_texpack_on_gpu(uint64_t key, HleTexpackImg *out)
+{
+    if (!hle_texpack_on() || !g_tp.pack_on) {
+        return false;
+    }
+    pthread_mutex_lock(&g_tp.mu);
+    TpEntry *e = entry(key, false);
+    const bool on = e && e->gpu;
+    if (on) {
+        e->used = ++g_tp.clock;
+        *out = (HleTexpackImg){ .xfmt = e->xfmt, .w = e->w, .h = e->h, .levels = e->levels, .bytes = e->bytes };
+    }
+    pthread_mutex_unlock(&g_tp.mu);
+    return on;
+}
+
+bool hle_texpack_find(uint64_t key, uint32_t gw, uint32_t gh, HleTexpackImg *out)
+{
+    if (!hle_texpack_on() || !g_tp.pack_on) {
+        return false;
+    }
+    pthread_mutex_lock(&g_tp.mu);
+    TpEntry *e = entry(key, false);
+    if (!e || !e->path || e->bad) {
+        pthread_mutex_unlock(&g_tp.mu);
+        return false;
+    }
+    if (!e->data) {
+        char path[1024], why[160] = "";
+        snprintf(path, sizeof(path), "%s", e->path);
+        const bool dds = e->dds;
+        pthread_mutex_unlock(&g_tp.mu);
+        uint8_t *d = NULL;
+        uint32_t x = HLE_XFMT_A8R8G8B8, w = 0, h = 0, levels = 0, bytes = 0;
+        bool ok = dds ? read_dds(path, &d, &x, &w, &h, &levels, &bytes, why, sizeof(why))
+                      : read_png(path, &d, &w, &h, &levels, &bytes, why, sizeof(why));
+        /* the game's size times 1 to 8, the same shape (2x, 4x, 8x...): sampled as the game's */
+        const uint32_t k = ok && w % gw == 0 ? w / gw : 0;
+        if (ok && (!k || k > TP_MAX_SCALE || h != gh * k)) {
+            snprintf(why, sizeof(why), "%u x %u isn't the game's %u x %u times 1 to %u", w, h, gw, gh, TP_MAX_SCALE);
+            free(d);
+            ok = false;
+        }
+        if (ok && bytes > TP_MAX_BYTES) {
+            snprintf(why, sizeof(why), "its levels are over %u MiB", TP_MAX_BYTES >> 20);
+            free(d);
+            ok = false;
+        }
+        pthread_mutex_lock(&g_tp.mu);
+        e = entry(key, false);
+        if (!ok) {
+            e->bad = true;
+            pthread_mutex_unlock(&g_tp.mu);
+            hle_log("hakuX-hle-tex", "replacement %s: not used: %s", path, why);
+            return false;
+        }
+        e->data = d;
+        e->xfmt = x;
+        e->w = w;
+        e->h = h;
+        e->levels = levels;
+        e->bytes = bytes;
+        const unsigned n = ++g_tp.nreplaced;
+        pthread_mutex_unlock(&g_tp.mu);
+        if (n <= 8 || n % 100 == 0) {
+            hle_log("hakuX-hle-tex", "replacement %016llx: %s, %ux%u (%ux), %u levels, %s (%u read so far)",
+                    (unsigned long long)key, path, w, h, w / gw, levels, dds ? "DXT" : "A8R8G8B8", n);
+        }
+        pthread_mutex_lock(&g_tp.mu);
+        e = entry(key, false);
+    }
+    e->used = ++g_tp.clock;
+    *out = (HleTexpackImg){ .xfmt = e->xfmt, .w = e->w, .h = e->h, .levels = e->levels, .bytes = e->bytes,
+                            .data = e->data };
+    pthread_mutex_unlock(&g_tp.mu);
+    return true;
+}
+
+unsigned hle_texpack_uploaded(uint64_t key, uint64_t *drop, unsigned max)
+{
+    unsigned n = 0;
+    pthread_mutex_lock(&g_tp.mu);
+    TpEntry *e = entry(key, false);
+    if (e && e->data) {
+        free(e->data);
+        e->data = NULL;
+        if (!e->gpu) {
+            e->gpu = true;
+            g_tp.gpu_bytes += e->bytes;
+        }
+    }
+    /* the least recently used images go until the rest fit the budget */
+    while (g_tp.gpu_bytes > TP_GPU_BYTES && n < max) {
+        TpEntry *old = NULL;
+        for (uint32_t i = 0; i < TP_SLOTS; i++) {
+            TpEntry *o = &g_tp.tab[i];
+            if (o->gpu && o != e && (!old || o->used < old->used)) {
+                old = o;
+            }
+        }
+        if (!old) {
+            break;
+        }
+        old->gpu = false;
+        g_tp.gpu_bytes -= old->bytes;
+        drop[n++] = old->key;
+    }
+    pthread_mutex_unlock(&g_tp.mu);
+    return n;
+}
diff --git a/hw/xbox/hle/tex/texpack.h b/hw/xbox/hle/tex/texpack.h
new file mode 100644
index 0000000000000000000000000000000000000000..5ccb91ec2ee27c51ecb8435834d2cce3d16da7cd
--- /dev/null
+++ b/hw/xbox/hle/tex/texpack.h
@@ -0,0 +1,80 @@
+/*
+ * hakuX HLE GPU — texture dumps and replacements (OGBox 1.0.2).
+ *
+ * Which textures: the NV2A's 2D textures as tex_define uploads them (pb/pbres.c): swizzled, DXT
+ * or P8, in a colour format whose texels mean what A8R8G8B8's do, 4 x 4 at least.
+ *
+ * A texture's key is a 64-bit hash (XXH3) of the guest's texels as they are in memory, every mip
+ * level, seeded with its format, width, height and level count, and a P8 texture's palette: the
+ * same texture in every run and on every console, another one when any of them differs.
+ *
+ * Dumps: env NC_HLE_TEXDUMP_DIR=<folder>. Each texture once a key (and not again in a later run:
+ * the folder's files are read at the start), on a thread of its own:
+ *  - DXT1/3/5: tex_<key>_<w>x<h>_<format>.dds, the game's own blocks, every level;
+ *  - the rest: tex_<key>_<w>x<h>_<format>.png, its first level as RGBA, as it is sampled.
+ *
+ * Replacements: env NC_HLE_TEXPACK_DIR=<folder>. Every .png and .dds in it and its subfolders (not
+ * its "dump" folder) whose name holds tex_<key> (16 hex digits) replaces that texture:
+ *  - the game's size times 1 to 8 (2x, 4x, 8x...), the same shape; another size is refused (log);
+ *  - PNG: RGBA, its mip levels made from it (a box filter), up to 2048 x 2048;
+ *  - DDS: DXT1, DXT3 or DXT5 (or DX10's BC1-3), its own levels, uploaded as they are, up to the
+ *    upload arena's room (a 4096 x 4096 DXT5 chain fits);
+ *  - a dumped file edited, upscaled, renamed in any way that keeps tex_<key>, is a replacement.
+ * A replacement goes to the GPU once: every texture object with its key samples the same image
+ * (vk/draw.c), until the budget (1 GiB) makes room for others, the least recently used first.
+ *
+ * Without the host's PNG codec (hle_texpack_set_codec) PNG files are neither dumped nor read.
+ */
+#ifndef HW_XBOX_HLE_TEX_TEXPACK_H
+#define HW_XBOX_HLE_TEX_TEXPACK_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* RGBA8 (bytes R, G, B, A) from a PNG file (NULL: not read), freed with free_fn; a PNG file from
+ * RGBA8: true if written */
+typedef unsigned char *(*HleTexpackLoadFn)(const char *path, int *w, int *h);
+typedef void (*HleTexpackFreeFn)(void *p);
+typedef bool (*HleTexpackSaveFn)(const char *path, int w, int h, const unsigned char *rgba);
+void hle_texpack_set_codec(HleTexpackLoadFn load, HleTexpackFreeFn free_fn, HleTexpackSaveFn save);
+
+/* Dumps or replacements on (the environment read the first time) */
+bool hle_texpack_on(void);
+bool hle_texpack_dumping(void);
+
+uint64_t hle_texpack_key(const void *texels, size_t n, const void *pal, size_t npal_bytes, uint32_t fmt,
+                         uint32_t w, uint32_t h, uint32_t levels);
+
+/* A first level's texels as A8R8G8B8 (bytes B, G, R, A; w x h), as PNG */
+void hle_texpack_dump_png(uint64_t key, uint32_t fmt, uint32_t w, uint32_t h, const uint32_t *argb);
+/* A DXT texture's blocks, every level one after another (bytes), as DDS */
+void hle_texpack_dump_dds(uint64_t key, uint32_t fmt, uint32_t w, uint32_t h, uint32_t levels,
+                          const void *blocks, uint32_t bytes);
+
+/* key's replacement: its X_D3DFORMAT (A8R8G8B8 or DXT1/3/5), size and levels; data: the levels
+ * one after another (NULL when only on_gpu is asked) */
+typedef struct HleTexpackImg {
+    uint32_t xfmt, w, h, levels, bytes;
+    const uint8_t *data;
+} HleTexpackImg;
+
+/* Whether key's replacement is on the GPU now (its image's description in *out): the texture
+ * object is pointed at it, nothing uploaded */
+bool hle_texpack_on_gpu(uint64_t key, HleTexpackImg *out);
+/* key's replacement for a gw x gh texture, read (from its file, on the caller's thread): false
+ * without one, or when it doesn't fit gw x gh */
+bool hle_texpack_find(uint64_t key, uint32_t gw, uint32_t gh, HleTexpackImg *out);
+/* key's texels sent to the GPU: its memory copy goes; drop gets the keys whose GPU images must go
+ * to keep within the budget (at most max): their number */
+unsigned hle_texpack_uploaded(uint64_t key, uint64_t *drop, unsigned max);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/hw/xbox/hle/tex/xdk_res.c b/hw/xbox/hle/tex/xdk_res.c
index b2c28a5f1ff07e3b30fb3d2d2db39636b99f5dac..4eb3b7ef435e55f7aaf9d6c4678167c1fa26e27e 100644
--- a/hw/xbox/hle/tex/xdk_res.c
+++ b/hw/xbox/hle/tex/xdk_res.c
@@ -36,6 +36,175 @@ const HleFmtInfo *hle_fmt_info(uint32_t code)
     return NULL;
 }
 
+/* Per format and sign bit (A, R, G, B): the texel bits flipped, and the
+ * view channels (rgba bits) that byte reaches. G8B8 views as (B, G, B, G),
+ * R8B8 as (R, B, B, R) (vk/draw.c tex_format). L8, AL8, A8 and A8L8 are
+ * read as stored (no bits flipped): the channels their bytes reach. */
+static const struct {
+    uint8_t code[2];        /* swizzled, linear */
+    uint32_t xor[4];
+    uint8_t rgba[4];
+} k_sign[] = {
+    { { HLE_XFMT_A8R8G8B8, HLE_XFMT_LIN_A8R8G8B8 },     /* bytes B G R A */
+      { 0x80000000u, 0x00800000u, 0x00008000u, 0x00000080u }, { 8, 1, 2, 4 } },
+    { { HLE_XFMT_X8R8G8B8, HLE_XFMT_LIN_X8R8G8B8 },
+      { 0, 0x00800000u, 0x00008000u, 0x00000080u }, { 0, 1, 2, 4 } },
+    { { HLE_XFMT_A8B8G8R8, HLE_XFMT_LIN_A8B8G8R8 },     /* bytes R G B A */
+      { 0x80000000u, 0x00000080u, 0x00008000u, 0x00800000u }, { 8, 1, 2, 4 } },
+    { { HLE_XFMT_B8G8R8A8, HLE_XFMT_LIN_B8G8R8A8 },     /* bytes A R G B */
+      { 0x00000080u, 0x00008000u, 0x00800000u, 0x80000000u }, { 8, 1, 2, 4 } },
+    { { HLE_XFMT_R8G8B8A8, HLE_XFMT_LIN_R8G8B8A8 },     /* bytes A B G R */
+      { 0x00000080u, 0x80000000u, 0x00800000u, 0x00008000u }, { 8, 1, 2, 4 } },
+    { { HLE_XFMT_G8B8, HLE_XFMT_LIN_G8B8 },             /* bytes B G */
+      { 0, 0, 0x8000u, 0x0080u }, { 0, 0, 2 | 8, 1 | 4 } },
+    { { HLE_XFMT_R8B8, HLE_XFMT_LIN_R8B8 },             /* bytes B R */
+      { 0, 0x8000u, 0, 0x0080u }, { 0, 1 | 8, 0, 2 | 4 } },
+    { { HLE_XFMT_L8, HLE_XFMT_LIN_L8 }, { 0 }, { 0, 1, 2, 4 } },        /* (L, L, L, 1) */
+    { { HLE_XFMT_AL8, HLE_XFMT_LIN_AL8 }, { 0 }, { 8, 1, 2, 4 } },      /* (L, L, L, L) */
+    { { HLE_XFMT_A8, HLE_XFMT_LIN_A8 }, { 0 }, { 8, 0, 0, 0 } },        /* (1, 1, 1, A) */
+    { { HLE_XFMT_A8L8, HLE_XFMT_LIN_A8L8 }, { 0 }, { 8, 1, 2, 4 } },    /* (L, L, L, A) */
+};
+
+static int sign_row(uint32_t code)
+{
+    for (size_t i = 0; i < sizeof(k_sign) / sizeof(k_sign[0]); i++) {
+        if (k_sign[i].code[0] == code || k_sign[i].code[1] == code) {
+            return (int)i;
+        }
+    }
+    return -1;
+}
+
+uint32_t hle_fmt_sign_xor(uint32_t code, uint32_t sign)
+{
+    const int r = sign_row(code);
+    uint32_t x = 0;
+    for (unsigned i = 0; r >= 0 && i < 4; i++) {
+        x |= (sign >> i & 1) ? k_sign[r].xor[i] : 0;
+    }
+    return x;
+}
+
+uint32_t hle_fmt_sign_rgba(uint32_t code, uint32_t sign)
+{
+    const int r = sign_row(code);
+    uint32_t m = 0;
+    for (unsigned i = 0; r >= 0 && i < 4; i++) {
+        m |= (sign >> i & 1) ? k_sign[r].rgba[i] : 0;
+    }
+    return m;
+}
+
+static uint32_t ld16(const uint8_t *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1] << 8;
+}
+
+static uint32_t ld32(const uint8_t *p)
+{
+    return ld16(p) | ld16(p + 2) << 16;
+}
+
+/* an n-bit channel (4 <= n <= 8) as eight bits: n * 17 for four */
+static uint32_t bits8(uint32_t v, unsigned n)
+{
+    return (v << (8 - n) | v >> (2 * n - 8)) & 0xFF;
+}
+
+static void put32(uint8_t *o, uint32_t i, uint32_t v)
+{
+    memcpy(o + 4 * i, &v, 4);
+}
+
+static void put_depth(uint8_t *o, uint32_t i, float z)
+{
+    z = z < 1.0f ? z : 1.0f;            /* and NaN */
+    memcpy(o + 4 * i, &z, 4);
+}
+
+static float nv2a_float(uint32_t i)
+{
+    float f;
+    memcpy(&f, &i, 4);
+    return f;
+}
+
+bool hle_tex_convert(uint32_t code, const void *src, uint32_t n, void *dst)
+{
+    const uint8_t *s = src;
+    uint8_t *o = dst;
+    switch (code) {
+    case HLE_XFMT_A4R4G4B4: case HLE_XFMT_LIN_A4R4G4B4:
+        for (uint32_t i = 0; i < n; i++) {
+            uint32_t v = ld16(s + 2 * i);
+            put32(o, i, bits8(v >> 12, 4) << 24 | bits8(v >> 8 & 15, 4) << 16 |
+                        bits8(v >> 4 & 15, 4) << 8 | bits8(v & 15, 4));
+        }
+        return true;
+    case HLE_XFMT_R4G4B4A4: case HLE_XFMT_LIN_R4G4B4A4:
+        for (uint32_t i = 0; i < n; i++) {
+            uint32_t v = ld16(s + 2 * i);
+            put32(o, i, bits8(v & 15, 4) << 24 | bits8(v >> 12, 4) << 16 |
+                        bits8(v >> 8 & 15, 4) << 8 | bits8(v >> 4 & 15, 4));
+        }
+        return true;
+    case HLE_XFMT_R5G5B5A1: case HLE_XFMT_LIN_R5G5B5A1:
+        for (uint32_t i = 0; i < n; i++) {
+            uint32_t v = ld16(s + 2 * i);
+            put32(o, i, (v & 1 ? 0xFFu : 0) << 24 | bits8(v >> 11, 5) << 16 |
+                        bits8(v >> 6 & 31, 5) << 8 | bits8(v >> 1 & 31, 5));
+        }
+        return true;
+    case HLE_XFMT_R6G5B5: case HLE_XFMT_LIN_R6G5B5:
+        for (uint32_t i = 0; i < n; i++) {
+            uint32_t v = ld16(s + 2 * i);
+            put32(o, i, 0xFFu << 24 | bits8(v >> 10, 6) << 16 | bits8(v >> 5 & 31, 5) << 8 |
+                        bits8(v & 31, 5));
+        }
+        return true;
+    case HLE_XFMT_V16U16: case HLE_XFMT_LIN_V16U16:
+        for (uint32_t i = 0; i < n; i++) {
+            uint32_t u = s[4 * i + 1], v = s[4 * i + 3];
+            put32(o, i, v << 24 | v << 16 | u << 8 | u);
+        }
+        return true;
+    case HLE_XFMT_D16: case HLE_XFMT_LIN_D16:
+        for (uint32_t i = 0; i < n; i++) {
+            put_depth(o, i, ld16(s + 2 * i) / 65535.0f);
+        }
+        return true;
+    case HLE_XFMT_D24S8: case HLE_XFMT_LIN_D24S8:
+        for (uint32_t i = 0; i < n; i++) {
+            put_depth(o, i, (ld32(s + 4 * i) >> 8) / 16777215.0f);
+        }
+        return true;
+    case HLE_XFMT_F16: case HLE_XFMT_LIN_F16:
+        for (uint32_t i = 0; i < n; i++) {
+            uint32_t v = ld16(s + 2 * i);
+            put_depth(o, i, v ? nv2a_float((v << 11) + 0x3C000000u) / 511.9375f : 0.0f);
+        }
+        return true;
+    case HLE_XFMT_F24S8: case HLE_XFMT_LIN_F24S8:
+        for (uint32_t i = 0; i < n; i++) {
+            const uint32_t f = ld32(s + 4 * i) >> 8 << 7;
+            memcpy(o + 4 * i, &f, 4);
+        }
+        return true;
+    default:
+        return false;
+    }
+}
+
+uint32_t hle_tex_conv_xfmt(uint32_t code)
+{
+    const HleFmtInfo *fi = hle_fmt_info(code);
+    const bool lin = fi && (fi->flags & HLE_FI_LIN);
+    if (fi && (fi->flags & HLE_FI_DEPTH)) {
+        return lin ? HLE_XFMT_LIN_F24S8 : HLE_XFMT_F24S8;
+    }
+    return lin ? HLE_XFMT_LIN_A8R8G8B8 : HLE_XFMT_A8R8G8B8;
+}
+
 static int log2_exact(uint32_t v)
