+static uint64_t ObCreateObject(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    const enum NcObType type = type_of_va(k, a[0]);
+    if (type == NC_OB_FILE || type == NC_OB_SYMLINK || type == NC_OB_DIRECTORY) {
+        static bool told;
+        if (!told) {
+            told = true;
+            nc_log("hakuX-native", "ob: ObCreateObject of an I/O manager's type (%u): refused", type);
+        }
+        return NC_STATUS_OBJECT_TYPE_MISMATCH;
+    }
+    name_ignored(k, a[1], "ObCreateObject");
+    /* (made as an event: a type nc_ob_create never frees, nor keeps a size for) */
+    const uint32_t obj = nc_ob_create(k, NC_OB_EVENT, a[2]);
+    if (!obj) {
+        return NC_STATUS_INSUFFICIENT_RESOURCES;
+    }
+    nc_vm_fill(k->vm, obj, 0, a[2]);
+    nc_vm_wr32(k->vm, obj - OB_HEADER + 0x8, a[0]);
+    nc_vm_wr32(k->vm, a[3], obj);
+    return NC_STATUS_SUCCESS;
