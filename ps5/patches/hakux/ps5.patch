+    0x01, 0x00, 0x01, 0xE9, 0x91, 0x00, 0x00, 0x00, 0x58, 0x50, 0x66, 0x83, 0xE0, 0x44, 0x66, 0x83,
+    0xF8, 0x44, 0x75, 0x09, 0x80, 0x35, 0x57, 0x01, 0x01, 0x00, 0x01, 0xEB, 0x7C, 0x58, 0x50, 0x66,
+    0x83, 0xE0, 0x48, 0x66, 0x83, 0xF8, 0x48, 0x75, 0x09, 0x80, 0x35, 0x58, 0x01, 0x01, 0x00, 0x01,
+    0xEB, 0x67, 0x58, 0x50, 0x66, 0x25, 0xC0, 0x00, 0x66, 0x3D, 0xC0, 0x00, 0x75, 0x09, 0x80, 0x35,
+    0x59, 0x01, 0x01, 0x00, 0x01, 0xEB, 0x52, 0x58, 0x50, 0x66, 0x83, 0xE0, 0x60, 0x66, 0x83, 0xF8,
+    0x60, 0x75, 0x09, 0x80, 0x35, 0x5A, 0x01, 0x01, 0x00, 0x01, 0xEB, 0x3D, 0x58, 0x50, 0x66, 0x83,
+    0xE0, 0x50, 0x66, 0x83, 0xF8, 0x50, 0x75, 0x09, 0x80, 0x35, 0x5B, 0x01, 0x01, 0x00, 0x01, 0xEB,
+    0x28, 0x58, 0x50, 0x66, 0x25, 0xA0, 0x00, 0x66, 0x3D, 0xA0, 0x00, 0x75, 0x09, 0x80, 0x35, 0x5C,
+    0x01, 0x01, 0x00, 0x01, 0xEB, 0x13, 0x58, 0x50, 0x66, 0x25, 0x90, 0x00, 0x66, 0x3D, 0x90, 0x00,
+    0x75, 0x07, 0x80, 0x35, 0x5D, 0x01, 0x01, 0x00, 0x01, 0x58, 0x8D, 0x15, 0x14, 0x00, 0x00, 0x80,
+    0x8B, 0x42, 0x04, 0x89, 0x02, 0x61, 0x59, 0x5B, 0xB9, 0x10, 0x00, 0x00, 0x80, 0xFF, 0x11, 0x53,
+    0x33, 0xDB, 0xC3,
+};
+/* HookIGK(address of a call to the pad function): the call goes to igk_main
+ * (its address at 5), the function it called kept (at 0x80000010, moved) */
+static const uint8_t k_hook_igk[76] = {
+    0x55, 0x8B, 0xEC, 0x60, 0xBA, 0x34, 0x12, 0x00, 0x00, 0x8B, 0x45, 0x08, 0xB9, 0x20, 0x00, 0x00,
+    0x00, 0x8A, 0x18, 0x80, 0xFB, 0x50, 0x7C, 0x07, 0x80, 0xFB, 0x53, 0x7F, 0x02, 0xEB, 0x05, 0x48,
+    0xE2, 0xEF, 0xEB, 0x23, 0x80, 0xEB, 0x08, 0x88, 0x5A, 0x3E, 0x83, 0x45, 0x08, 0x01, 0x8B, 0x45,
+    0x08, 0x50, 0x03, 0x00, 0x83, 0xC0, 0x04, 0x2B, 0x55, 0x08, 0x83, 0xEA, 0x04, 0xBB, 0x10, 0x00,
+    0x00, 0x80, 0x89, 0x03, 0x58, 0x89, 0x10, 0x61, 0xC9, 0xC2, 0x04, 0x00,
+};
+/* LcdClear(): the text cleared, through the port (XBMC4Xbox's wrote to the
+ * LCD's ports and waited with HLT) */
+static const uint8_t k_lcd_clear[] = {
+    0x60,                               /* pushad */
+    0x66, 0xBA, 0xC8, 0xB0,             /* mov dx, PORT_LCD_CLR */
+    0xEF,                               /* out dx, eax */
+    0x61,                               /* popad */
+    0xC3,                               /* ret */
+};
+/* LcdWriteString(string, position) */
+static const uint8_t k_lcd_write[] = {
+    0x55, 0x8B, 0xEC, 0x60,             /* push ebp; mov ebp, esp; pushad */
+    0x8B, 0x45, 0x0C,                   /* mov eax, [ebp+0Ch] */
+    0x66, 0xBA, 0xCC, 0xB0,             /* mov dx, PORT_LCD_POS */
+    0xEF,                               /* out dx, eax */
+    0x8B, 0x45, 0x08,                   /* mov eax, [ebp+8] */
+    0x66, 0xBA, 0xC4, 0xB0,             /* mov dx, PORT_LCD_TEXT */
+    0xEF,                               /* out dx, eax */
+    0x61, 0xC9, 0xC2, 0x08, 0x00,       /* popad; leave; ret 8 */
+};
+
+/* Each 0x80000010 / 0x80000014 in code replaced: how many. */
+static unsigned relocate(uint8_t *code, size_t n, uint32_t from, uint32_t to)
+{
+    unsigned count = 0;
+    for (size_t i = 0; i + 4 <= n; i++) {
+        if (rd32(code + i) == from) {
+            wr32(code + i, to);
+            count++;
+            i += 3;
+        }
+    }
+    return count;
+}
+
+/* The toys after the trainer (at h + at, guest va block + at), each in the
+ * section's word if the trainer left it 0. Returns the end. */
+static uint32_t put_toys(uint8_t *h, uint32_t block, uint32_t at, uint32_t base, uint32_t section)
+{
+    uint8_t *sec = h + section;
+    struct {
+        const uint8_t *code;
+        size_t n;
+        int slot;                       /* the section's word (-1: none) */
+    } toys[7] = {
+        { k_sm_bus, sizeof(k_sm_bus), 0 },  { k_patch_it, sizeof(k_patch_it), 1 },
+        { k_hook_it, sizeof(k_hook_it), 2 }, { k_igk_main, sizeof(k_igk_main), -1 },
+        { k_hook_igk, sizeof(k_hook_igk), 3 }, { k_lcd_clear, sizeof(k_lcd_clear), 4 },
+        { k_lcd_write, sizeof(k_lcd_write), 5 },
+    };
+    uint32_t igk_main = 0;
+    for (int i = 0; i < 7; i++) {
+        uint8_t *c = h + at;
+        memcpy(c, toys[i].code, toys[i].n);
+        if (toys[i].code == k_hook_it) {
+            wr32(c + 11, base);
+        } else if (toys[i].code == k_igk_main) {
+            igk_main = block + at;
+            relocate(c, toys[i].n, 0x80000014u, block + BLK_IGK_LAST);
+            relocate(c, toys[i].n, 0x80000010u, block + BLK_IGK_ORIG);
+        } else if (toys[i].code == k_hook_igk) {
+            wr32(c + 5, igk_main);
+            relocate(c, toys[i].n, 0x80000010u, block + BLK_IGK_ORIG);
+        }
+        if (toys[i].slot >= 0 && !rd32(sec + 4 * toys[i].slot)) {
+            wr32(sec + 4 * toys[i].slot, block + at);
+        }
+        at += (uint32_t)((toys[i].n + 15) & ~15u);
+    }
+    return at;
+}
+
+/* ---- the install ---- */
+
+uint32_t nc_trainer_install(struct NcKernel *k, NcVm *vm, const HleXbeInfo *xbe, uint32_t entry)
+{
+    g_installed = false;
+    if (!g_path[0]) {
+        return entry;
+    }
+    const char *file = strrchr(g_path, '/');
+    file = file ? file + 1 : g_path;
+    char why[160] = "";
+    size_t size = 0;
+    uint8_t *buf = read_file(g_path, &size, why, sizeof(why));
+    if (!buf) {
+        nc_log("hakuX-native-trainer", "trainer %s: %s; the game starts without it", g_path, why);
+        return entry;
+    }
+    NcTrainerInfo info;
+    size_t off = 0, n = 0;
+    if (!nc_trainer_parse(buf, size, is_xbtf(g_path), &info, &off, &n, why, sizeof(why))) {
+        nc_log("hakuX-native-trainer", "trainer %s: %s; the game starts without it", file, why);
+        free(buf);
+        return entry;
+    }
+    snprintf(g_name, sizeof(g_name), "%.84s", info.name[0] ? info.name : file);
+    nc_log("hakuX-native-trainer", "trainer %s: \"%s\" by \"%s\", %s, %u bytes, %u options, for %08x %08x %08x",
+           file, info.name, info.author, info.xbtf ? (info.toys ? "XBTF with its own entry" : "XBTF") : "ETM",
+           (unsigned)n, info.noptions, info.title_ids[0], info.title_ids[1], info.title_ids[2]);
+    if (!nc_trainer_for_title(&info, xbe->title_id)) {
+        /* as the loader: a trainer for another title doesn't run */
+        nc_log("hakuX-native-trainer", "trainer: it isn't for this title (%08x): the game starts without it",
+               xbe->title_id);
+        free(buf);
+        return entry;
+    }
+    if (info.xbe_time && info.xbe_time != xbe->timedate) {
+        nc_log("hakuX-native-trainer",
+               "trainer: it checks for the XBE dated %08x and this one is dated %08x (another release): it "
+               "will run and find nothing to change",
+               info.xbe_time, xbe->timedate);
+    }
+    /* the block: XBMC4Xbox's heap (32 KiB, 40 for an .xbtf), filled with 0xFF;
+     * the stub where its loader was, the trainer after it, the toys after that */
+    uint32_t want = info.xbtf ? XBTF_HEAP : ETM_HEAP;
+    const uint32_t need = LOADER_SIZE + (uint32_t)n + 2048;
+    if (need > want) {
+        want = need;
+    }
+    want = (want + NC_PAGE - 1) & ~(NC_PAGE - 1);
+    const uint32_t block = nc_mm_contig_alloc(k, want);
+    if (!block) {
+        nc_log("hakuX-native-trainer", "trainer: no %u KiB of memory for it: the game starts without it", want >> 10);
+        free(buf);
+        return entry;
+    }
+    const uint32_t pa = block & ~NC_CONTIG_WINDOW;
+    uint8_t *h = (vm->phys ? vm->phys : vm->ram) + pa;
+    memset(h, 0xFF, want);
+    const uint32_t base = block + LOADER_SIZE;
+    memcpy(h + LOADER_SIZE, buf + off, n);
+    free(buf);
+    /* the options chosen: one byte each, 1 on */
+    unsigned on = 0;
+    char list[512] = "";
+    for (unsigned i = 0; i < info.noptions; i++) {
+        const bool o = i < strlen(g_bits) && g_bits[i] == '1';
+        h[LOADER_SIZE + info.options_off + i] = o ? 1 : 0;
+        if (o) {
+            on++;
+            if (strlen(list) + strlen(info.options[i]) + 3 < sizeof(list)) {
+                strcat(list, list[0] ? ", " : "");
+                strcat(list, info.options[i]);
+            }
+        }
+    }
+    uint32_t used = LOADER_SIZE + (uint32_t)n;
+    if (info.toys) {
+        used = put_toys(h, block, (used + 15) & ~15u, base, LOADER_SIZE + info.section_off);
+    }
+    /* the stub: XBMC4Xbox's loader begins "pushad; mov edx, base" too, so the
+     * block's +2 is the trainer's base as there */
+    uint8_t *s = h;
+    *s++ = 0x60;                                        /* pushad */
+    *s++ = 0xBA; wr32(s, base); s += 4;                 /* mov edx, base */
+    *s++ = 0x8B; *s++ = 0xEA;                           /* mov ebp, edx */
+    *s++ = 0xB9; wr32(s, base + info.entry); s += 4;    /* mov ecx, entry */
+    *s++ = 0xFF; *s++ = 0xD1;                           /* call ecx */
+    *s++ = 0x66; *s++ = 0xBA; *s++ = (uint8_t)PORT_EVENT; *s++ = (uint8_t)(PORT_EVENT >> 8); /* mov dx, port */
+    *s++ = 0xB8; wr32(s, 1); s += 4;                    /* mov eax, 1 */
+    *s++ = 0xEF;                                        /* out dx, eax */
+    *s++ = 0x61;                                        /* popad */
+    *s++ = 0x68; wr32(s, entry); s += 4;                /* push entry */
+    *s++ = 0xC3;                                        /* ret */
+    if (nc_vm_dma.wrote) {
+        nc_vm_dma.wrote(pa, want);
+    }
+    /* XBMC4Xbox's loader put the LED in its own sequence (the PIC's command 7)
+     * before the trainer ran, and trainers then show their options going on
+     * and off with command 8 alone: so here, without changing its colour */
+    g_led_mode = 1;
+    g_led_seq = g_led_shown;
+    g_vm = vm;
+    g_block = block;
+    g_block_size = want;
+    g_installed = true;
+    nc_log("hakuX-native-trainer",
+           "trainer: in %08x-%08x (its base %08x, entry %08x, %u bytes used); %u of %u options on%s%s; then the "
+           "title's entry %08x",
+           block, block + want, base, base + info.entry, used, on, info.noptions, on ? ": " : "", list, entry);
+    char msg[160];
+    snprintf(msg, sizeof(msg), "%s", g_name);
+    post(NC_TRAINER_MSG_LOADED, 0, msg);
+    return block;
+}
diff --git a/native/core/trainer.h b/native/core/trainer.h
new file mode 100644
index 0000000000000000000000000000000000000000..1ff7b183342e0bca10983b3168172934a5f7a459
--- /dev/null
+++ b/native/core/trainer.h
@@ -0,0 +1,114 @@
+/*
+ * hakuX native core — Xbox trainers: the .etm and .xbtf files the Xbox's
+ * dashboards ran in front of a game (Evolution-X, XBMC4Xbox), loaded as
+ * XBMC4Xbox's loader does on the console.
+ *
+ * Copyright (C) 2026 Press5elect
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * Additional terms (GPL-3.0 section 7(b)): keep the attribution "OGBox by
+ * Press5elect" (github.com/Press5elect/OGBox, NOTICE).
+ *
+ * The formats and the loader's conventions are XBMC4Xbox's
+ * (xbmc/platform/xbox/utils/Trainer.cpp, Team XBMC, GPL-2.0-or-later; its
+ * trainer loading "generously donated by team xored"):
+ *
+ *  - a trainer is x86 code with a header: +0x0A the option bytes' offset,
+ *    +0x0E the texts' table (name, author, then one an option), +0x12 the
+ *    title IDs it is for (3), +0x16 its entry (an .xbtf with its own entry at
+ *    +0x1A: +0x16 is then its toys section, the loader's functions it calls);
+ *  - an .xbtf is mangled: unmangled, a creation key and a scroller text come
+ *    before the trainer;
+ *  - the loader runs the trainer once, where the kernel calls the title's
+ *    entry point, if the title's ID is one of its three: EDX and EBP its
+ *    base, write protection off. The trainer patches the game's code, most
+ *    often with jumps into itself, and its option bytes say what to patch;
+ *    options marked "IGK" are turned on and off in the game with the pad.
+ *
+ * Here the trainer goes into a contiguous block below its stub, which the
+ * title's boot thread starts at: the stub runs the trainer and goes on to the
+ * title's entry. Nothing is written at 0x8000000C (where XBMC4Xbox kept the
+ * block's address, in the page the PS5's host owns): the toys that read it
+ * are given the base directly.
+ */
+#ifndef NATIVE_CORE_TRAINER_H
+#define NATIVE_CORE_TRAINER_H
+
+#include "native/core/vm.h"
+#include "hw/xbox/hle/core/xbe.h"
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct NcKernel;
+
+#define NC_TRAINER_MAX_OPTIONS 100
+#define NC_TRAINER_TEXT        85     /* XBMC4Xbox's (84 characters and the end) */
+#define NC_TRAINER_MAX_FILE    (40u << 10)
+
+typedef struct NcTrainerInfo {
+    bool xbtf;                          /* an .xbtf (unmangled), else an .etm */
+    bool toys;                          /* an .xbtf with its own entry: the loader's toys asked for */
+    char name[NC_TRAINER_TEXT];         /* the first text */
+    char author[NC_TRAINER_TEXT];       /* the second */
+    char scroller[256];                 /* an .xbtf's scroller text (often its in-game keys) */
+    unsigned noptions;
+    char options[NC_TRAINER_MAX_OPTIONS][NC_TRAINER_TEXT];
+    uint32_t title_ids[3];              /* 0: none */
+    uint32_t xbe_time;                  /* the XBE date its entry compares (0x10114), 0 if not seen */
+    uint32_t entry;                     /* offsets in the trainer's data */
+    uint32_t options_off;
+    uint32_t section_off;               /* the toys section (toys) */
+} NcTrainerInfo;
+
+/* A trainer file's bytes (an .xbtf's unmangled in place): what it says, and
+ * where its trainer starts in the buffer and how long it is. False with the
+ * reason. */
+bool nc_trainer_parse(uint8_t *file, size_t size, bool xbtf, NcTrainerInfo *info, size_t *data_off,
+                      size_t *data_size, char *why, size_t why_size);
+/* The same from a file (.xbtf by its name, any case). */
+bool nc_trainer_read(const char *path, NcTrainerInfo *info, char *why, size_t why_size);
+/* Whether the title is one the trainer is for. */
+bool nc_trainer_for_title(const NcTrainerInfo *info, uint32_t title_id);
+
+/* The run's trainer ("trainer=<file>") and its options ("trainer_options=":
+ * '1' an option on, by its order; the rest off). */
+void nc_trainer_set(const char *path);
+void nc_trainer_set_options(const char *bits);
+
+/* Once the title's XBE is in memory, before its boot thread: the trainer in
+ * guest memory and the address the boot thread starts at (the trainer's
+ * stub; entry itself when there is no trainer, or it isn't for this title). */
+uint32_t nc_trainer_install(struct NcKernel *k, NcVm *vm, const HleXbeInfo *xbe, uint32_t entry);
+
+/* The ports of the stub and the toys (0xB0C0-0xB0CF) and the SMBus's
+ * (0xC000-0xC00F, the trainers' own LED writes): true if port is one. */
+bool nc_trainer_port_out(uint16_t port, unsigned bytes, uint32_t value);
+bool nc_trainer_port_in(uint16_t port, unsigned bytes, uint32_t *value);
+/* The PIC's LED written (an SMBus write to 0x20, command 7 or 8; the kernel's
+ * HalWriteSMBusValue too). */
+void nc_trainer_smc_write(uint8_t command, uint8_t value);
+
+/* For the front end, oldest first: what the trainer shows (its LCD lines,
+ * the console's LED when it changes). */
+enum { NC_TRAINER_MSG_NONE, NC_TRAINER_MSG_LOADED, NC_TRAINER_MSG_LCD, NC_TRAINER_MSG_LED };
+typedef struct NcTrainerMessage {
+    int kind;
+    uint8_t led;                        /* the LED's sequence: bits 7-4 red, 3-0 green, a quarter each */
+    char text[160];
+} NcTrainerMessage;
+bool nc_trainer_take_message(NcTrainerMessage *out);
+/* A trainer runs (installed this boot). */
+bool nc_trainer_active(void);
+/* "solid green", "flashing red and off": the LED sequence in words. */
+void nc_trainer_led_text(uint8_t sequence, char *out, size_t n);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
