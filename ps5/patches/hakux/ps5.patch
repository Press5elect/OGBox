index 0000000000000000000000000000000000000000..663755f33099932f7699f50786acb042ccc3c208
--- /dev/null
+++ b/native/dev/apu/vp/mcpx_round.h
@@ -0,0 +1,19 @@
+/* MCPX rounding: the filters round each value halfway UP, not ties-to-even,
+ * to 2^-19 of full scale, xemu PR #3105 06ef59e's svf_round (its "1/16 of a
+ * 24-bit sample" is 10h in 24-bit units: an impulse through an I3DL2 path
+ * with a = 8000h settled at 10h on a retail console, which this step gives
+ * and a finer one does not). Double intermediates; values are not saturated
+ * by the filter.
+ */
+#ifndef HAKUX_MCPX_ROUND_H
+#define HAKUX_MCPX_ROUND_H
+#include <math.h>
+static inline double mcpx_round_units(double value, double units)
+{
+    return floor(value * units + 0.5) / units;
+}
+static inline double mcpx_round_filter(double value)
+{
+    return mcpx_round_units(value, 524288.0); /* 2^19, the PR's svf_round */
+}
+#endif
