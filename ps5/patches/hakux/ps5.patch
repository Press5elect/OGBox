new file mode 100644
index 0000000000000000000000000000000000000000..47abf4854f7dea1f974d96a7e3b279af2f76047b
--- /dev/null
+++ b/native/cpu/x86emu.h
@@ -0,0 +1,69 @@
+/*
+ * hakuX native core — native CPU backend: emulation of one guest
+ * instruction's memory access (device registers, RAM through the host's
+ * view).
+ *
+ * Copyright (C) 2026 Press5elect
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * Additional terms (GPL-3.0 section 7(b)): keep the attribution "OGBox by
+ * Press5elect" (github.com/Press5elect/OGBox, NOTICE).
+ *
+ * A guest access that the host can't let run (a device window, the
+ * contiguous window's unmappable start, a page an image is newer than) faults
+ * at the instruction; this decodes it from the interrupted registers, does the
+ * access through the caller's memory callbacks and moves EIP past it. The
+ * forms are those compilers emit for memory operands (Kelvin's fault.c set,
+ * with the SSE and MMX moves D3D and DirectSound use): MOV and its immediate,
+ * moffs, MOVZX/MOVSX, XCHG, the ALU group with flags (ADC and SBB included),
+ * TEST, INC/DEC, NOT/NEG, PUSH/POP r/m, MOVS/STOS/LODS (REP), and the
+ * MOVD/MOVQ/MOVSS/MOVSD/MOVAPS/MOVUPS/MOVDQA/MOVDQU/MOVLPS/MOVHPS/MOVNT*
+ * moves.
+ */
+#ifndef NATIVE_CPU_X86EMU_H
+#define NATIVE_CPU_X86EMU_H
+
+#include "native/cpu/cpu_native.h"
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Guest memory as the emulator reaches it: n (1-16) bytes at addr, false
+ * when the address can't be reached (the instruction is then not done). */
+typedef struct NcX86Mem {
+    bool (*rw)(void *opaque, uint32_t addr, unsigned n, uint8_t *buf, bool store);
+    void *opaque;
+} NcX86Mem;
+
+/* The instruction's memory operand: its address, size and direction (a
+ * read-modify-write is both). */
+typedef struct NcX86Access {
+    uint32_t ea;
+    unsigned bytes;
+    bool load, store;
+    unsigned len;     /* the instruction's length */
+} NcX86Access;
+
+/* The access the instruction at ip (f's EIP) makes; seg_base is the base
+ * of fs:/gs: (the KPCR). False for a form this doesn't know. */
+bool nc_x86_access(const NcFrame *f, const uint8_t *ip, uint32_t seg_base, NcX86Access *a);
+
+/* OGBox 0.0.3: an area of host memory the host executes (64 bytes or more) where x87 and SSE
+ * arithmetic with a memory operand run on the host's FPU (x86emu.c host_op); none: not emulated. */
+void nc_x86_set_exec_area(void *code, size_t len);
+
+/* Emulates it: true when done (registers, flags and EIP updated). */
+bool nc_x86_emulate(NcFrame *f, const uint8_t *ip, uint32_t seg_base, const NcX86Mem *m);
+
+/* The ModRM memory operand at p (after the opcode) with f's registers: its
+ * effective address and the bytes it takes; false for a register operand or
+ * 16-bit addressing. */
+bool nc_x86_modrm_ea(const NcFrame *f, const uint8_t *p, uint32_t *ea, unsigned *len);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
