+/* OGBox 0.0.8: the voices' filters every 5 s (the session log): the frames DLS2 and ParaEQ ran,
+ * the times one ran away (filter_check) and the loudest output, and each voice that ran away or
+ * went past twice full scale, with its filter's registers. */
+static void filter_watch(MCPXAPUState *d)
+{
+    static int64_t at_ms;
+    const int64_t now = apu_host_ms();
+    if (now - at_ms < 5000) {
+        return;
+    }
+    at_ms = now;
+    uint32_t runaways = 0;
+    float loudest = 0;
+    uint16_t loudest_v = 0;
+    uint16_t odd[4];
+    unsigned nodd = 0;
+    for (uint16_t v = 0; v < MCPX_HW_MAX_VOICES; v++) {
+        runaways += g_f_runaway[v];
+        if (g_f_peak[v] > loudest) {
+            loudest = g_f_peak[v];
+            loudest_v = v;
+        }
+        if ((g_f_runaway[v] || g_f_peak[v] > 2.0f) && nodd < ARRAY_SIZE(odd)) {
+            odd[nodd++] = v;
+        }
+    }
+    const uint32_t dls2 = apu_xchg(&g_f_dls2_frames, 0), peq = apu_xchg(&g_f_peq_frames, 0);
+    if (dls2 || peq || runaways) {
+        nc_log("hakuX-apu", "filters in 5 s: DLS2 %u voice frames, ParaEQ %u | ran away %u times "
+                            "(restarted from rest), the loudest output %.2f full scale (voice %02x)",
+               dls2, peq, runaways, loudest, loudest_v);
+    }
+    for (unsigned i = 0; i < nodd; i++) {
+        const uint16_t v = odd[i];
+        const uint32_t fmt = voice_get_mask(d, v, NV_PAVS_VOICE_CFG_FMT, 0xFFFFFFFF);
+        const uint32_t misc = voice_get_mask(d, v, NV_PAVS_VOICE_CFG_MISC, 0xFFFFFFFF);
+        nc_log("hakuX-apu", "  filter voice %02x (%s, %s): ran away %u times, peak %.2f full scale | "
+                            "fmode %u, FCA %08x FCB %08x MISC %08x",
+               v, v < MCPX_HW_MAX_3D_VOICES ? "3d" : "2d",
+               (fmt & NV_PAVS_VOICE_CFG_FMT_STEREO) ? "stereo" : "mono", g_f_runaway[v], g_f_peak[v],
+               GET_MASK(misc, NV_PAVS_VOICE_CFG_MISC_FMODE),
+               voice_get_mask(d, v, NV_PAVS_VOICE_TAR_FCA, 0xFFFFFFFF),
+               voice_get_mask(d, v, NV_PAVS_VOICE_TAR_FCB, 0xFFFFFFFF), misc);
+    }
+    memset(g_f_runaway, 0, sizeof(g_f_runaway));
+    memset(g_f_peak, 0, sizeof(g_f_peak));
+}
