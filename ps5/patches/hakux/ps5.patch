+     * the guest's CPU sees it */
+    static const char *const k_src[12] = {"", "DW", "RTW", "DP", "FET", "FEN", "FEV", "FEO", "GPM", "GPN", "EPM", "EPN"};
+    char src[160];
+    int len = 0;
+    src[0] = 0;
+    for (unsigned b = 1; b < 12; b++) {
+        const uint32_t c = apu_xchg(&g_diag.src[b], 0);
+        if (c) {
+            len += snprintf(src + len, sizeof(src) - (size_t)len, " %s %.0f", k_src[b], c / s);
+        }
+    }
+    nc_log("hakuX-apu", "interrupt rises per s by source:%s | line recomputed (set_irq) %.0f/s | the line %s (asserted "
+           "lines %08x)", len ? src : " none", g_diag.requests / s, g_diag.irq_level ? "up" : "down",
+           nc_irq_lines());
+    g_diag.frames = g_diag.stopped = g_diag.irq_up = g_diag.pushed = g_diag.requests = 0;
+    mcpx_apu_vp_diag(d, s);
