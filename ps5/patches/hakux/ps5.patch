+/* RtlExtendedIntegerMultiply(Multiplicand (LARGE_INTEGER), Multiplier (LONG)) -> LARGE_INTEGER */
+static uint64_t RtlExtendedIntegerMultiply(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    const int64_t m = (int64_t)((uint64_t)a[1] << 32 | a[0]);
+    return (uint64_t)(m * (int32_t)a[2]);
+}
+
+/* RtlExtendedLargeIntegerDivide(Dividend (LARGE_INTEGER), Divisor (ULONG), Remainder or NULL)
+ * -> LARGE_INTEGER, unsigned as the kernel's */
+static uint64_t RtlExtendedLargeIntegerDivide(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    const uint64_t n = (uint64_t)a[1] << 32 | a[0];
+    if (!a[2]) {
+        return 0;
+    }
+    if (a[3]) {
+        nc_vm_wr32(k->vm, a[3], (uint32_t)(n % a[2]));
+    }
+    return n / a[2];
+}
+
+/* RtlUlongByteSwap(Source in ecx) / RtlUshortByteSwap(Source in cx): fastcall */
+static uint64_t RtlUlongByteSwap(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    return __builtin_bswap32(a[0]);
+}
+
+static uint64_t RtlUshortByteSwap(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    return __builtin_bswap16((uint16_t)a[0]);
+}
+
+/* ---- the rest of hakuX-lr's #86 (97fe52e53f, portare-ch, GPL-2.0-or-later): the strings'
+ * create and downcase, the multibyte conversions (Latin-1, as above), the numbers' text and the
+ * printf family, as NT's. */
+
+/* RtlCreateUnicodeString(DestinationString, SourceString: a NUL-terminated wide string)
+ * -> BOOLEAN: a pool copy of it with its terminator, freed by RtlFreeUnicodeString */
+static uint64_t RtlCreateUnicodeString(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    uint32_t n = 0;
+    while (n < 0x10000 && rd16(k, a[1] + n)) {
+        n += 2;
+    }
+    if (n + 2 > 0xFFFF) {
+        return 0;
+    }
+    const uint32_t buf = str_alloc(k, n + 2);
+    if (!buf) {
+        return 0;
+    }
+    str_bytes(k, buf, a[1], n + 2);
+    str_set(k, a[0], (uint16_t)n, (uint16_t)(n + 2), buf);
+    return 1;
+}
+
+/* RtlDowncaseUnicodeString(DestinationString, SourceString, AllocateDestinationString)
+ * -> NTSTATUS: a destination of the caller's too short for it is STATUS_BUFFER_OVERFLOW */
+static uint64_t RtlDowncaseUnicodeString(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    const uint16_t n = str_len(k, a[1]) & ~1u;
+    uint32_t buf = str_buf(k, a[0]);
+    uint16_t max = str_max(k, a[0]);
+    if (a[2] & 0xff) {
+        max = n;
+        buf = str_alloc(k, max);
+        if (!buf) {
+            return NC_STATUS_NO_MEMORY;
+        }
+    } else if (max < n) {
+        return ST_BUFFER_OVERFLOW;
+    }
+    const uint32_t src = str_buf(k, a[1]);
+    for (uint16_t i = 0; i < n; i += 2) {
+        wr16(k, buf + i, nc_rtl_downcase(rd16(k, src + i)));
+    }
+    str_set(k, a[0], n, max, buf);
+    return NC_STATUS_SUCCESS;
+}
+
+/* RtlMultiByteToUnicodeN(UnicodeString, MaxBytesInUnicodeString, BytesInUnicodeString,
+ * MultiByteString, BytesInMultiByteString) -> NTSTATUS: Latin-1 */
+static uint64_t RtlMultiByteToUnicodeN(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    const uint32_t n = a[4] < a[1] / 2 ? a[4] : a[1] / 2;
+    for (uint32_t i = 0; i < n; i++) {
+        wr16(k, a[0] + 2 * i, rd8(k, a[3] + i));
+    }
+    if (a[2]) {
+        nc_vm_wr32(k->vm, a[2], n * 2);
+    }
+    return NC_STATUS_SUCCESS;
+}
+
+/* RtlMultiByteToUnicodeSize(BytesInUnicodeString, MultiByteString, BytesInMultiByteString) */
+static uint64_t RtlMultiByteToUnicodeSize(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    nc_vm_wr32(k->vm, a[0], a[2] * 2);
+    return NC_STATUS_SUCCESS;
+}
+
+/* RtlUnicodeToMultiByteN(MultiByteString, MaxBytesInMultiByteString, BytesInMultiByteString,
+ * UnicodeString, BytesInUnicodeString) -> NTSTATUS: Latin-1, '?' for what isn't in it */
+static uint64_t RtlUnicodeToMultiByteN(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    const uint32_t n = a[4] / 2 < a[1] ? a[4] / 2 : a[1];
+    for (uint32_t i = 0; i < n; i++) {
+        const uint16_t c = rd16(k, a[3] + 2 * i);
+        *(uint8_t *)nc_vm_host(k->vm, a[0] + i) = c < 0x100 ? (uint8_t)c : '?';
+    }
+    if (a[2]) {
+        nc_vm_wr32(k->vm, a[2], n);
+    }
+    return NC_STATUS_SUCCESS;
+}
+
+/* RtlUnicodeToMultiByteSize(BytesInMultiByteString, UnicodeString, BytesInUnicodeString) */
+static uint64_t RtlUnicodeToMultiByteSize(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    nc_vm_wr32(k->vm, a[0], a[2] / 2);
+    return NC_STATUS_SUCCESS;
+}
+
+/* RtlUnicodeStringToInteger(String, Base, Value) -> NTSTATUS: RtlCharToInteger's rules on
+ * the string's Length / 2 characters */
+static uint64_t RtlUnicodeStringToInteger(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    uint32_t base = a[1];
+    if (base != 0 && base != 2 && base != 8 && base != 10 && base != 16) {
+        return NC_STATUS_INVALID_PARAMETER;
+    }
+    if (!a[2]) {
+        return ST_ACCESS_VIOLATION;
+    }
+    const uint32_t p = str_buf(k, a[0]), n = str_len(k, a[0]) / 2u;
+    uint32_t i = 0;
+    while (i < n && rd16(k, p + 2 * i) <= ' ') {
+        i++;
+    }
+    bool minus = false;
+    if (i < n && (rd16(k, p + 2 * i) == '+' || rd16(k, p + 2 * i) == '-')) {
+        minus = rd16(k, p + 2 * i) == '-';
+        i++;
+    }
+    if (!base) {
+        base = 10;
+        if (i + 1 < n && rd16(k, p + 2 * i) == '0') {
+            const uint16_t x = rd16(k, p + 2 * i + 2);
+            const uint32_t b = x == 'x' || x == 'X' ? 16 : x == 'o' || x == 'O' ? 8 : x == 'b' || x == 'B' ? 2 : 0;
+            if (b) {
+                base = b;
+                i += 2;
+            }
+        }
+    }
+    uint32_t v = 0;
+    for (; i < n; i++) {
+        const uint16_t c = rd16(k, p + 2 * i);
+        const unsigned d = c >= '0' && c <= '9' ? (unsigned)(c - '0') : c >= 'a' && c <= 'f' ? c - 'a' + 10u
+                         : c >= 'A' && c <= 'F' ? c - 'A' + 10u : 99u;
+        if (d >= base) {
+            break;
+        }
+        v = v * base + d;
+    }
+    nc_vm_wr32(k->vm, a[2], minus ? (uint32_t)-(int32_t)v : v);
+    return NC_STATUS_SUCCESS;
+}
+
+/* The digits of value in base (0: 10; else 2, 8, 10 or 16), uppercase, terminated in out:
+ * how many, 0 for another base. */
+static size_t ulong_digits(uint32_t value, uint32_t base, char out[33])
+{
+    base = base ? base : 10;
+    out[0] = 0;
+    if (base != 2 && base != 8 && base != 10 && base != 16) {
+        return 0;
+    }
+    char rev[32];
+    size_t n = 0;
+    do {
+        const uint32_t d = value % base;
+        value /= base;
+        rev[n++] = (char)(d < 10 ? '0' + d : 'A' + d - 10);
+    } while (value);
+    for (size_t i = 0; i < n; i++) {
+        out[i] = rev[n - 1 - i];
+    }
+    out[n] = 0;
+    return n;
+}
+
+/* RtlIntegerToChar(Value, Base, OutputLength, String) -> NTSTATUS: the digits, terminated if
+ * OutputLength leaves room; STATUS_BUFFER_OVERFLOW if they're longer */
+static uint64_t RtlIntegerToChar(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    char d[33];
+    const size_t n = ulong_digits(a[0], a[1], d);
+    if (!n) {
+        return NC_STATUS_INVALID_PARAMETER;
+    }
+    if (n > a[2]) {
+        return ST_BUFFER_OVERFLOW;
+    }
+    if (!a[3]) {
+        return ST_ACCESS_VIOLATION;
+    }
+    nc_vm_copy_out(k->vm, a[3], d, (uint32_t)(n < a[2] ? n + 1 : n));
+    return NC_STATUS_SUCCESS;
+}
+
+/* RtlIntegerToUnicodeString(Value, Base, String) -> NTSTATUS: the digits with a terminator;
+ * Length is set even when they don't fit with it (STATUS_BUFFER_OVERFLOW) */
+static uint64_t RtlIntegerToUnicodeString(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    char d[33];
+    const size_t n = ulong_digits(a[0], a[1], d);
+    if (!n) {
+        return NC_STATUS_INVALID_PARAMETER;
+    }
+    const uint16_t len = (uint16_t)(n * 2);
+    *(uint16_t *)nc_vm_host(k->vm, a[2]) = len;
+    if (len >= str_max(k, a[2])) {
+        return ST_BUFFER_OVERFLOW;
+    }
+    const uint32_t buf = str_buf(k, a[2]);
+    for (size_t i = 0; i < n; i++) {
+        wr16(k, buf + 2 * (uint32_t)i, (uint8_t)d[i]);
+    }
+    ustr_terminate(k, a[2]);
+    return NC_STATUS_SUCCESS;
+}
+
+/* RtlExtendedMagicDivide(Dividend, MagicDivisor (LARGE_INTEGERs), ShiftCount) -> LARGE_INTEGER:
+ * the high 64 bits of |Dividend| * MagicDivisor, shifted, with Dividend's sign */
+static uint64_t RtlExtendedMagicDivide(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    const int64_t dividend = (int64_t)((uint64_t)a[1] << 32 | a[0]);
+    const uint64_t magic = (uint64_t)a[3] << 32 | a[2];
+    const bool neg = dividend < 0;
+    const uint64_t x = neg ? 0 - (uint64_t)dividend : (uint64_t)dividend;
+    const uint64_t xl = (uint32_t)x, xh = x >> 32, ml = (uint32_t)magic, mh = magic >> 32;
+    const uint64_t ll = xl * ml, lh = xl * mh, hl = xh * ml, hh = xh * mh;
+    const uint64_t mid = (ll >> 32) + (uint32_t)lh + (uint32_t)hl;
+    const uint64_t q = (hh + (lh >> 32) + (hl >> 32) + (mid >> 32)) >> ((int8_t)a[4] & 63);
+    return neg ? 0 - q : q;
+}
+
+/* RtlMapGenericMask(AccessMask, GenericMapping): GENERIC_READ, _WRITE, _EXECUTE and _ALL
+ * replaced by the mapping's four masks */
+static uint64_t RtlMapGenericMask(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    uint32_t mask = nc_vm_rd32(k->vm, a[0]);
+    for (unsigned i = 0; i < 4; i++) {
+        if (mask & (0x80000000u >> i)) {
+            mask |= nc_vm_rd32(k->vm, a[1] + 4 * i);
+        }
+    }
+    nc_vm_wr32(k->vm, a[0], mask & 0x0FFFFFFFu);
+    return 0;
+}
+
+/* The printf family's arguments: words from the guest at ap; guest pointers to what's mapped. */
+typedef struct GuestArgs {
+    NcVm *vm;
+    uint32_t ap;
+} GuestArgs;
+
+static uint32_t guest_arg(void *ctx)
+{
+    GuestArgs *g = ctx;
+    const uint32_t v = nc_vm_rd32(g->vm, g->ap);
+    g->ap += 4;
+    return v;
+}
+
+static void *guest_mem(void *ctx, uint32_t va)
+{
+    const GuestArgs *g = ctx;
+    return va && nc_vm_phys(g->vm, va) != UINT32_MAX ? nc_vm_host(g->vm, va) : NULL;
+}
+
+/* fmt (a guest string, at most 64 KiB) formatted with the arguments at ap into the guest's
+ * buf: at most count bytes when bounded (RtlSnprintf: -1 and no terminator when longer), else
+ * all of it (RtlSprintf). Formatted on the host, then copied out (the PS5's emulated pages
+ * have no host page behind a guest buffer's next one). */
+static uint64_t format(NcKernel *k, uint32_t buf, uint32_t count, bool bounded, uint32_t fmt, uint32_t ap)
+{
+    if (!fmt) {
+        return (uint32_t)-1;
+    }
+    char *text = malloc(0x10000);
+    if (!text) {
+        return (uint32_t)-1;
+    }
+    uint32_t n = 0;
+    for (; n + 1 < 0x10000; n++) {
+        if ((!n || !((fmt + n) & (NC_PAGE - 1))) && nc_vm_phys(k->vm, fmt + n) == UINT32_MAX) {
+            break;
+        }
+        if (!(text[n] = (char)rd8(k, fmt + n))) {
+            break;
+        }
+    }
+    text[n] = 0;
+    /* the host's buffer: 64 KiB, larger while the text is longer and the guest's allows it
+     * (unbounded: up to 16 MiB) */
+    const size_t limit = !buf ? 0 : bounded ? count : (size_t)16 << 20;
+    size_t cap = limit < 0x10000 ? limit : 0x10000;
+    int r;
+    for (;;) {
+        char *out = malloc(cap ? cap : 1);
+        if (!out) {
+            free(text);
+            return (uint32_t)-1;
+        }
+        GuestArgs g = {k->vm, ap};
+        const NcRtlFmtIo io = {&g, guest_arg, guest_mem};
+        r = nc_rtl_vsnprintf(out, cap, text, &io);
+        if (r < 0 && cap < limit) {
+            free(out);
+            cap = limit / 4 > cap ? cap * 4 : limit;
+            continue;
+        }
+        const size_t w = r < 0 ? cap : (size_t)r + ((size_t)r < cap);
+        if (buf && w) {
+            nc_vm_copy_out(k->vm, buf, out, (uint32_t)w);
+        }
+        free(out);
+        break;
+    }
+    free(text);
+    return (uint32_t)r;
+}
+
+/* RtlSprintf(Buffer, Format, ...), cdecl: the arguments after Format on the stack */
+static uint64_t RtlSprintf(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    return format(k, a[0], 0, false, a[1], nc_frame_gpr(f, NC_ESP) + 12);
+}
+
+/* RtlSnprintf(Buffer, Count, Format, ...), cdecl */
+static uint64_t RtlSnprintf(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    return format(k, a[0], a[1], true, a[2], nc_frame_gpr(f, NC_ESP) + 16);
+}
+
+/* RtlVsprintf(Buffer, Format, ArgList), cdecl */
+static uint64_t RtlVsprintf(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    return format(k, a[0], 0, false, a[1], a[2]);
+}
+
+/* RtlVsnprintf(Buffer, Count, Format, ArgList), cdecl */
+static uint64_t RtlVsnprintf(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    return format(k, a[0], a[1], true, a[2], a[3]);
+}
+
