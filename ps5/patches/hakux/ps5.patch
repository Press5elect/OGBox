     fprintf(stderr, "hrtf: max |difference| %.3g\n", g_max_err);
     HT_CHECK(g_max_err < 2e-6);
+}
+
+int main(void)
+{
+#if defined(__x86_64__)
+    /* each vector level the host has (vp/simd.h) */
