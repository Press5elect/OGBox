+#define NC_XC_PUBKEY_SIZE 0x11Cu /* BSAFE blob of a 2048-bit key */
+#define NC_XC_SIG_SIZE    256u
+void nc_xc_public_key(uint8_t blob[NC_XC_PUBKEY_SIZE]);
