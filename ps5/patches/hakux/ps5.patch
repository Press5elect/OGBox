+    HT_CHECK(strstr(buf, "sampk") == NULL);
+    k.conv = 1 | 2 << 2;                                /* quincunx, gaussian */
+    k.conv_mm = 3 | 1 << 2;                             /* both; minification */
+    size_t n = hle_psh_glsl(&k, buf, sizeof(buf), NULL);
+    HT_CHECK(n > 0 && n == strlen(buf));
