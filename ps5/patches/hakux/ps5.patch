+/* ---- the files ---- */
+
+static uint32_t rd32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static void wr32(uint8_t *p, uint32_t v)
+{
+    p[0] = (uint8_t)v;
+    p[1] = (uint8_t)(v >> 8);
+    p[2] = (uint8_t)(v >> 16);
+    p[3] = (uint8_t)(v >> 24);
+}
+
+/* XBMC4Xbox's "unmangle trainer" (its inline assembly): the first dword
+ * xored with a key from three bytes, then each byte after it xored with that
+ * dword's low byte and less a running sum. */
+static void unmangle(uint8_t *b, size_t n)
+{
+    const uint32_t al = (uint8_t)(b[0x27] + b[0x2F] + b[0x37]);
+    const uint32_t key = al * 0x00FFFFFFu;
+    wr32(b, rd32(b) ^ key);
+    const uint8_t bl = b[0];
+    uint32_t sum = 0;
+    const uint32_t count = (uint32_t)(n - 4);
+    for (uint32_t i = 0; i < count; i++) {
+        uint8_t v = b[4 + i] ^ bl;
+        v = (uint8_t)(v - (uint8_t)sum);
+        b[4 + i] = v;
+        sum += 3 + (count - i);         /* ECX before LOOP takes one off */
+    }
+}
+
+/* a C string at off, bounded by the data and by cap (a copy) */
+static void text_at(const uint8_t *d, size_t n, uint32_t off, char *out, size_t cap)
+{
+    size_t k = 0;
+    while (off + k < n && k + 1 < cap && d[off + k]) {
+        const uint8_t c = d[off + k];
+        out[k] = c >= 0x20 && c < 0x7F ? (char)c : c == '\t' ? ' ' : '?';
+        k++;
+    }
+    out[k] = 0;
+    /* trailing spaces off */
+    while (k && out[k - 1] == ' ') {
+        out[--k] = 0;
+    }
+}
+
+static void say(char *why, size_t n, const char *text)
+{
+    if (why && n) {
+        snprintf(why, n, "%s", text);
+    }
+}
+
+/* The XBE date its entry compares: "mov edi, 0x10114; cmp dword [edi], date"
+ * (Evolution-X's trainers, nine in ten) or "cmp dword [0x10114], date". */
+static uint32_t xbe_time_check(const uint8_t *d, size_t n, uint32_t entry)
+{
+    static const uint8_t a[] = { 0xBF, 0x14, 0x01, 0x01, 0x00, 0x81, 0x3F };
+    static const uint8_t b[] = { 0x81, 0x3D, 0x14, 0x01, 0x01, 0x00 };
+    for (uint32_t i = entry; i < entry + 64 && i + sizeof(a) + 4 <= n; i++) {
+        if (!memcmp(d + i, a, sizeof(a))) {
+            return rd32(d + i + sizeof(a));
+        }
+        if (!memcmp(d + i, b, sizeof(b))) {
+            return rd32(d + i + sizeof(b));
+        }
+    }
+    return 0;
+}
+
+bool nc_trainer_parse(uint8_t *file, size_t size, bool xbtf, NcTrainerInfo *info, size_t *data_off,
+                      size_t *data_size, char *why, size_t why_size)
+{
+    memset(info, 0, sizeof(*info));
+    info->xbtf = xbtf;
+    if (size > NC_TRAINER_MAX_FILE) {
+        say(why, why_size, "too big for a trainer (more than 40 KiB)");
+        return false;
+    }
+    if (size < 0x40) {
+        say(why, why_size, "too short for a trainer");
+        return false;
+    }
+    size_t off = 0;
+    if (xbtf) {
+        unmangle(file, size);
+        /* the creation key ("031WX2-E6H53H-..."), then the scroller text */
+        char key[200];
+        text_at(file, size, 4, key, sizeof(key));
+        if (strlen(key) < 7 || key[6] != '-') {
+            say(why, why_size, "not an .xbtf trainer (its key doesn't unmangle)");
+            return false;
+        }
+        size_t k = 4;
+        while (k < size && file[k]) {
+            k++;
+        }
+        k++;
+        text_at(file, size, (uint32_t)k, info->scroller, sizeof(info->scroller));
+        while (k < size && file[k]) {
+            k++;
+        }
+        k++;
+        off = k;
+        if (off + 0x22 > size) {
+            say(why, why_size, "an .xbtf with no trainer after its texts");
+            return false;
+        }
+    }
+    const uint8_t *d = file + off;
+    const size_t n = size - off;
+    if (n < 0x22) {
+        say(why, why_size, "too short for a trainer");
+        return false;
+    }
+    const uint32_t sel = rd32(d + 0x0A), txt = rd32(d + 0x0E), ids = rd32(d + 0x12);
+    const uint32_t e16 = rd32(d + 0x16), e1a = rd32(d + 0x1A);
+    if (txt > n || sel >= n || ids + 12 > n) {
+        say(why, why_size, "a broken trainer (its header's offsets are past its end)");
+        return false;
+    }
+    /* XBMC4Xbox: an .xbtf whose +0x1A is set has its entry there and its toys
+     * section at +0x16; else (an .etm, or an .etm made an .xbtf) +0x16 is the entry */
+    if (xbtf && e1a) {
+        info->toys = true;
+        info->entry = e1a;
+        info->section_off = e16;
+        if (e16 + 6 * 4 > n) {
+            say(why, why_size, "a broken trainer (its toys section is past its end)");
+            return false;
+        }
+    } else {
+        info->entry = e16;
+    }
+    if (info->entry < 0x22 || info->entry >= n) {
+        say(why, why_size, "a broken trainer (its entry is past its end)");
+        return false;
+    }
+    info->options_off = sel;
+    for (int i = 0; i < 3; i++) {
+        info->title_ids[i] = rd32(d + ids + 4 * i);
+    }
+    /* the texts: name, author, the options (as many as there are option bytes
+     * before the table; with the bytes after it, as many as the table has:
+     * XBMC4Xbox's count wraps then and its loop ends at the table's 0) */
+    const uint32_t nsel = sel <= txt ? txt - sel : NC_TRAINER_MAX_OPTIONS;
+    unsigned ntext = 0;
+    for (uint32_t i = 0; i < nsel + 2 && i < NC_TRAINER_MAX_OPTIONS + 2; i++) {
+        if (txt + 4 * i + 4 > n) {
+            break;
+        }
+        const uint32_t to = rd32(d + txt + 4 * i);
+        if (!to) {
+            break;
+        }
+        if (to >= n) {
+            say(why, why_size, "a broken trainer (a text is past its end)");
+            return false;
+        }
+        char t[NC_TRAINER_TEXT];
+        text_at(d, n, to, t, sizeof(t));
+        if (i == 0) {
+            snprintf(info->name, sizeof(info->name), "%s", t);
+        } else if (i == 1) {
+            snprintf(info->author, sizeof(info->author), "%s", t);
+        } else {
+            snprintf(info->options[i - 2], sizeof(info->options[0]), "%s", t);
+        }
+        ntext++;
+    }
+    info->noptions = ntext > 2 ? ntext - 2 : 0;
+    if (sel + info->noptions > n) {
+        info->noptions = (unsigned)(n - sel);   /* the option bytes stay inside the trainer */
+    }
+    info->xbe_time = xbe_time_check(d, n, info->entry);
+    if (data_off) {
+        *data_off = off;
+    }
+    if (data_size) {
+        *data_size = n;
+    }
+    return true;
+}
+
+static bool is_xbtf(const char *path)
+{
+    const char *dot = strrchr(path, '.');
+    return dot && !strcasecmp(dot, ".xbtf");
+}
+
+/* A file whole, at most NC_TRAINER_MAX_FILE + 1 bytes (to tell too big). */
+static uint8_t *read_file(const char *path, size_t *size, char *why, size_t why_size)
+{
+    FILE *f = fopen(path, "rb");
+    if (!f) {
+        if (why) {
+            snprintf(why, why_size, "can't be opened (%s)", strerror(errno));
+        }
+        return NULL;
+    }
+    uint8_t *buf = malloc(NC_TRAINER_MAX_FILE + 1);
+    const size_t n = buf ? fread(buf, 1, NC_TRAINER_MAX_FILE + 1, f) : 0;
+    fclose(f);
+    if (!buf) {
+        say(why, why_size, "out of memory");
+        return NULL;
+    }
+    *size = n;
+    return buf;
+}
+
+bool nc_trainer_read(const char *path, NcTrainerInfo *info, char *why, size_t why_size)
+{
+    size_t n = 0;
+    uint8_t *buf = read_file(path, &n, why, why_size);
+    if (!buf) {
+        memset(info, 0, sizeof(*info));
+        return false;
+    }
+    const bool ok = nc_trainer_parse(buf, n, is_xbtf(path), info, NULL, NULL, why, why_size);
+    free(buf);
+    return ok;
+}
+
+bool nc_trainer_for_title(const NcTrainerInfo *info, uint32_t title_id)
+{
+    for (int i = 0; i < 3; i++) {
+        if (info->title_ids[i] && info->title_ids[i] == title_id) {
+            return true;
+        }
+    }
+    return false;
+}
+
+void nc_trainer_set(const char *path)
+{
+    snprintf(g_path, sizeof(g_path), "%s", path ? path : "");
+}
+
+void nc_trainer_set_options(const char *bits)
+{
+    snprintf(g_bits, sizeof(g_bits), "%s", bits ? bits : "");
+}
+
+bool nc_trainer_active(void)
+{
+    return g_installed;
+}
+
+/* ---- messages for the front end ---- */
+
+#define QUEUE 16
+static pthread_mutex_t g_mq = PTHREAD_MUTEX_INITIALIZER;
+static NcTrainerMessage g_queue[QUEUE];
+static unsigned g_qhead, g_qcount;
+
+static void post(int kind, uint8_t led, const char *text)
+{
+    pthread_mutex_lock(&g_mq);
+    if (g_qcount == QUEUE) {
+        g_qhead = (g_qhead + 1) % QUEUE;    /* the oldest goes */
+        g_qcount--;
+    }
+    NcTrainerMessage *m = &g_queue[(g_qhead + g_qcount) % QUEUE];
+    m->kind = kind;
+    m->led = led;
+    snprintf(m->text, sizeof(m->text), "%s", text ? text : "");
+    g_qcount++;
+    pthread_mutex_unlock(&g_mq);
+}
+
+bool nc_trainer_take_message(NcTrainerMessage *out)
+{
+    bool got = false;
+    pthread_mutex_lock(&g_mq);
+    if (g_qcount) {
+        *out = g_queue[g_qhead];
+        g_qhead = (g_qhead + 1) % QUEUE;
+        g_qcount--;
+        got = true;
+    }
+    pthread_mutex_unlock(&g_mq);
+    return got;
+}
+
+void nc_trainer_led_text(uint8_t s, char *out, size_t n)
+{
+    static const char *const names[4] = { "off", "green", "red", "orange" };
+    int phase[4];
+    bool same = true;
+    for (int i = 0; i < 4; i++) {
+        phase[i] = ((s >> i) & 1) | ((s >> (4 + i)) & 1) << 1;
+        same &= phase[i] == phase[0];
+    }
+    if (same) {
+        snprintf(out, n, "%s", names[phase[0]]);
+        return;
+    }
+    /* flashing: its colours in order of first showing */
+    char list[64] = "";
+    bool seen[4] = { false };
+    for (int i = 0; i < 4; i++) {
+        if (!seen[phase[i]]) {
+            seen[phase[i]] = true;
+            if (list[0]) {
+                strncat(list, " and ", sizeof(list) - strlen(list) - 1);
+            }
+            strncat(list, names[phase[i]], sizeof(list) - strlen(list) - 1);
+        }
+    }
+    snprintf(out, n, "flashing %s", list);
+}
+
+/* ---- the LED (the PIC's commands 7 and 8) ---- */
+
+static uint8_t g_led_mode, g_led_seq = 0x0F;
+static uint8_t g_led_shown = 0x0F;      /* the default: solid green */
+
+void nc_trainer_smc_write(uint8_t command, uint8_t value)
+{
+    if (command == 0x07) {
+        g_led_mode = value;
+    } else if (command == 0x08) {
+        g_led_seq = value;
+    } else {
+        return;
+    }
+    const uint8_t now = g_led_mode ? g_led_seq : 0x0F;
+    if (now == g_led_shown) {
+        return;
+    }
+    g_led_shown = now;
+    char words[48];
+    nc_trainer_led_text(now, words, sizeof(words));
+    static unsigned logged;
+    if (logged++ < 32) {
+        nc_log("hakuX-native-trainer", "the console's LED: %s (%02x)", words, now);
+    }
+    if (g_installed) {
+        post(NC_TRAINER_MSG_LED, now, words);
+    }
+}
+
+/* ---- the LCD (the toys' text) ---- */
+
+static char g_lcd[4][24];
+static unsigned g_lcd_pos;
+
+static void lcd_post(void)
+{
+    char all[160] = "";
+    for (int i = 0; i < 4; i++) {
+        if (!g_lcd[i][0]) {
+            continue;
+        }
+        if (all[0]) {
+            strncat(all, "  |  ", sizeof(all) - strlen(all) - 1);
+        }
+        strncat(all, g_lcd[i], sizeof(all) - strlen(all) - 1);
+    }
+    if (all[0]) {
+        nc_log("hakuX-native-trainer", "the trainer's LCD: %s", all);
+        post(NC_TRAINER_MSG_LCD, 0, all);
+    }
+}
+
+/* A guest string (at most cap - 1 characters, through mapped pages only). */
+static void guest_text(uint32_t va, char *out, size_t cap)
+{
+    size_t k = 0;
+    if (g_vm) {
+        for (; k + 1 < cap; k++) {
+            if (nc_vm_phys(g_vm, va + (uint32_t)k) == UINT32_MAX) {
+                break;
+            }
+            const uint8_t c = *(const uint8_t *)nc_vm_host(g_vm, va + (uint32_t)k);
+            if (!c) {
+                break;
+            }
+            out[k] = c >= 0x20 && c < 0x7F ? (char)c : '?';
+        }
+    }
+    out[k] = 0;
+}
+
+/* ---- the ports ---- */
+
+static uint8_t g_smb[16];
+
+bool nc_trainer_port_out(uint16_t port, unsigned bytes, uint32_t value)
+{
+    (void)bytes;
+    switch (port) {
+    case PORT_EVENT:
+        nc_log("hakuX-native-trainer", "%s ran: the game starts", g_name);
+        return true;
+    case PORT_LCD_POS:
+        g_lcd_pos = value & 0x7F;
+        return true;
+    case PORT_LCD_CLR:
+        memset(g_lcd, 0, sizeof(g_lcd));
+        return true;
+    case PORT_LCD_TEXT: {
+        /* an HD44780's 4 x 20 lines start at 0x00, 0x40, 0x14, 0x54 */
+        const unsigned p = g_lcd_pos;
+        const int line = p >= 0x54 ? 3 : p >= 0x40 ? 1 : p >= 0x14 ? 2 : 0;
+        guest_text(value, g_lcd[line], sizeof(g_lcd[line]));
+        lcd_post();
+        return true;
+    }
+    default:
+        break;
+    }
+    if (g_path[0] && port >= SMB_BASE && port < SMB_BASE + 16) {
+        /* a trainer's own SMBus writes (the LED as its options go on and off):
+         * address 0xC004, command 0xC008, data 0xC006, control 0xC002 (the
+         * transaction starts with bit 3) */
+        g_smb[port - SMB_BASE] = (uint8_t)value;
+        if (port == SMB_BASE + 2 && (value & 0x08) && g_smb[4] == SMB_PIC_WRITE) {
+            nc_trainer_smc_write(g_smb[8], g_smb[6]);
+        }
+        return true;
+    }
+    return false;
+}
+
+bool nc_trainer_port_in(uint16_t port, unsigned bytes, uint32_t *value)
+{
+    (void)bytes;
+    if (g_path[0] && port >= SMB_BASE && port < SMB_BASE + 16) {
+        /* the status: the transaction done (an unclaimed port's all ones has
+         * the busy bit, and a trainer that waits on it would wait forever) */
+        *value = port == SMB_BASE ? 0x10u : g_smb[port - SMB_BASE];
+        return true;
+    }
+    return false;
+}
