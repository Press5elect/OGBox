+/* OGBox 0.0.8: the sound's level at each stage, once a second (the session log): the voices'
+ * mix (the VP's mixbins, and which bins carry sound), the EP's output frame, and what goes to the
+ * console after the volume limit, with the blocks that were all zeros. Where a game goes silent
+ * (NFS Carbon in a race), the first stage at zero says which part stopped. */
+static struct {
+    float vp_peak;
+    uint32_t vp_bins;
+    int ep_peak, out_peak;
+    unsigned pushed, silent;
+    int64_t at_ms;
+} g_lvl;
+
+static void levels_vp(float mixbins[NUM_MIXBINS][NUM_SAMPLES_PER_FRAME])
+{
+    for (int b = 0; b < NUM_MIXBINS; b++) {
+        float m = 0;
+        for (int i = 0; i < NUM_SAMPLES_PER_FRAME; i++) {
+            const float a = fabsf(mixbins[b][i]);
