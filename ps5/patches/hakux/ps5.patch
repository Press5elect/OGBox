+ * on. Otherwise as it was. debug.hakux.d3dtimer=0 leaves it as it is. */
+static const uint8_t k_d3d_timer[] = {0x8B, 0xF8, 0x83, 0xC7, 0x28,         /* mov edi, eax ; add edi, 28h */
+                                      0x8B, 0xCA, 0x13, 0xCE,               /* mov ecx, edx ; adc ecx, esi */
+                                      0x8B, 0x74, 0x24, 0x18, 0x3B, 0xF1,   /* mov esi, [esp+18h] ; cmp esi, ecx */
