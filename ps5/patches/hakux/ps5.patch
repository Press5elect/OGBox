+/* OGBox 0.0.8: once a second, each active looping PCM buffer voice of three or more samples a
+ * block (a game's multichannel mix ring: NFS Carbon's 5.1 music, 2400 frames): the ring in 32
+ * slices, '#' a slice with sound on the voice's channels, '.' all zeros, '^' where the VP plays
+ * (CBO), and how much of what it played in the second was zeros. A silent stretch just ahead of
+ * the CBO: the game writes behind the VP; zeros played with sound at the CBO: the VP reads wrong. */
+static void ring_watch(MCPXAPUState *d)
+{
+    static int64_t at_ms;
+    const int64_t now = apu_host_ms();
+    if (now - at_ms < 1000) {
+        return;
+    }
+    at_ms = now;
+    unsigned logged = 0;
+    for (uint16_t v = 0; v < MCPX_HW_MAX_VOICES && logged < 4; v++) {
+        const uint32_t state = voice_get_mask(d, v, NV_PAVS_VOICE_PAR_STATE, 0xFFFFFFFF);
+        const uint32_t fmt = voice_get_mask(d, v, NV_PAVS_VOICE_CFG_FMT, 0xFFFFFFFF);
+        const unsigned spb = 1 + GET_MASK(fmt, NV_PAVS_VOICE_CFG_FMT_SAMPLES_PER_BLOCK);
+        const unsigned cs_i = GET_MASK(fmt, NV_PAVS_VOICE_CFG_FMT_CONTAINER_SIZE);
+        if (!(state & NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE) || (fmt & NV_PAVS_VOICE_CFG_FMT_DATA_TYPE) ||
+            !(fmt & NV_PAVS_VOICE_CFG_FMT_LOOP) || spb < 3 || cs_i == NV_PAVS_VOICE_CFG_FMT_CONTAINER_SIZE_ADPCM) {
+            continue;
+        }
+        static const unsigned k_cs[4] = {1, 2, 0, 4};
+        const unsigned cs = k_cs[cs_i], channels = (fmt & NV_PAVS_VOICE_CFG_FMT_STEREO) ? 2 : 1;
+        const uint32_t block = cs * spb;
+        const uint32_t ebo = voice_get_mask(d, v, NV_PAVS_VOICE_PAR_NEXT, NV_PAVS_VOICE_PAR_NEXT_EBO);
+        const uint32_t cbo = voice_get_mask(d, v, NV_PAVS_VOICE_PAR_OFFSET, NV_PAVS_VOICE_PAR_OFFSET_CBO);
+        const uint32_t ba = voice_get_mask(d, v, NV_PAVS_VOICE_CUR_PSL_START, NV_PAVS_VOICE_CUR_PSL_START_BA);
+        const uint32_t frames = ebo + 1;
+        char map[33];
+        for (unsigned sl = 0; sl < 32; sl++) {
+            const uint32_t f0 = frames * sl / 32, f1 = frames * (sl + 1) / 32;
+            bool sound = false;
+            for (uint32_t f = f0; f < f1 && !sound; f++) {
+                const uint32_t lin = ba + f * block;
+                const uint64_t addr = get_data_ptr(d, d->regs[NV_PAPU_VPSGEADDR], 0xFFFFFFFF,
+                                                   lin & ~(uint32_t)(APU_PAGE_SIZE - 1)) + lin % APU_PAGE_SIZE;
+                const uint8_t *src = &d->ram_ptr[vp_ram_addr(d, addr, (size_t)cs * channels)];
+                for (unsigned c = 0; c < cs * channels; c++) {
+                    sound |= src[c] != 0;
+                }
+            }
+            map[sl] = sound ? '#' : '.';
+        }
+        map[32] = 0;
+        const unsigned at = frames ? (unsigned)((uint64_t)cbo * 32 / frames) : 0;
+        if (at < 32) {
+            map[at] = map[at] == '#' ? '^' : 'v';
+        }
+        const uint32_t played = apu_xchg(&g_v_played[v], 0), zero = apu_xchg(&g_v_zero[v], 0);
+        nc_log("hakuX-apu", "ring voice %02x (%u per block, %u frames): [%s] cbo %u | in 1 s: %u played, %u zero (%.0f%%)",
+               v, spb, frames, map, cbo, played, zero, played ? 100.0 * zero / played : 0.0);
+        logged++;
+    }
+}
