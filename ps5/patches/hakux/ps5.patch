index 0000000000000000000000000000000000000000..13c0dbe032f425f19d7f0068b3612b13e014a94e
--- /dev/null
+++ b/native/core/pack.c
@@ -0,0 +1,673 @@
+/*
+ * hakuX native core — packed and split disc images (pack.h).
+ *
+ * Copyright (C) 2026 Press5elect
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * Additional terms (GPL-3.0 section 7(b)): keep the attribution "OGBox by Press5elect"; see NOTICE.
+ *
+ * The CCI layout, as Team Resurgent's XboxToolkit (CCIContainerReader.cs, CCISectorDecoder.cs)
+ * reads it: "MCCI", the header's size (32), the image's size (u64), the index's offset (u64), the
+ * block size (2048), the version (1), the index's alignment (2). The index: a u32 a sector and one
+ * more, each its place >> alignment, bit 31 when LZ4-compressed; a sector's size is the next one's
+ * place less its own. A compressed sector (or one not 2048 bytes long) starts with a byte, the
+ * padding at its end; the rest is an LZ4 block.
+ *
+ * OGBox 0.0.8: the CSO layout, as MakeMHz's ciso.py (stellar-cso) writes it: "CISO", the header's
+ * size (24), the image's size (u64), the block size (2048), the version (2), the index's alignment
+ * (2), then the index: a u32 a block and one more, each its place >> alignment, bit 31 when the
+ * block is compressed. A compressed block is a block of an LZ4 frame: its size (u32, bit 31 when
+ * stored), then that many bytes (an LZ4 block); a plain one its 2048 bytes. Past 4 GiB the rest
+ * goes in game.2.cso, its places from 0 again: the index is the first file's, and a place lower
+ * than the one before is the next file's first block.
+ */
+#include "native/core/pack.h"
+#include "native/core/folder.h"
+#include "native/core/nc.h"
+
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#define SECTOR 2048u
+#define MAX_SLICES 16
+
+typedef struct Slice {
+    int fd;
+    uint64_t start, size;   /* its place in the image, its size uncompressed */
+    uint32_t *index;        /* a CCI's or a CSO's (sectors + 1 entries), NULL a plain part */
+    uint32_t sectors;
+    unsigned align;
+    bool cso;               /* OGBox 0.0.8: the CSO's (its parts below) */
+} Slice;
+
+struct NcPack {
+    Slice s[MAX_SLICES];
+    int n;
+    pthread_mutex_t lock;
+    /* the last sectors decoded */
+    uint64_t cached[8];
+    uint8_t cache[8][SECTOR];
+    unsigned next;
+    uint8_t *raw;           /* a run's compressed bytes */
+    size_t raw_cap;
+    /* OGBox 0.0.8: a CSO's files (the index is the first's; part_first[k] the first block in the
+     * k-th, part_first[nparts] the blocks), or a folder read as a disc */
+    int cso_fd[MAX_SLICES];
+    uint64_t cso_size[MAX_SLICES];
+    uint32_t part_first[MAX_SLICES + 1];
+    int nparts;
+    NcFolder *folder;
+};
+
+static struct {
+    int first, n;
+    int fds[MAX_SLICES - 1];
+} g_reg[8];
+/* OGBox 0.0.8: the folders registered as discs, by their XBE's descriptor */
+static struct {
+    int fd;
+    char *folder, *xbe;
+} g_folders[8];
+static const NcFolderIo *g_folder_io;
+static pthread_mutex_t g_reg_lock = PTHREAD_MUTEX_INITIALIZER;
+static void (*g_close)(int);
+
+void nc_pack_set_closer(void (*close_fd)(int fd))
+{
+    g_close = close_fd;
+}
+
+static void part_close(int fd)
+{
+    if (g_close) {
+        g_close(fd);
+    } else {
+        close(fd);
+    }
+}
+
+void nc_pack_register_slices(int first_fd, const int *more, int n)
+{
+    if (n <= 0 || n > MAX_SLICES - 1) {
+        return;
+    }
+    pthread_mutex_lock(&g_reg_lock);
+    for (unsigned i = 0; i < sizeof(g_reg) / sizeof(g_reg[0]); i++) {
+        if (g_reg[i].n == 0 || g_reg[i].first == first_fd) {
+            g_reg[i].first = first_fd;
+            g_reg[i].n = n;
+            memcpy(g_reg[i].fds, more, (size_t)n * sizeof(int));
+            break;
+        }
+    }
+    pthread_mutex_unlock(&g_reg_lock);
+}
+
+static void part_close(int fd);
+
+void nc_pack_set_folder_io(const NcFolderIo *io)
+{
+    g_folder_io = io;
+}
+
+const NcFolderIo *nc_pack_folder_io(void)
+{
+    return g_folder_io ? g_folder_io : &nc_folder_posix_io;
+}
+
+void nc_pack_register_folder(int fd, const char *folder, const char *xbe)
+{
+    pthread_mutex_lock(&g_reg_lock);
+    for (unsigned i = 0; i < sizeof(g_folders) / sizeof(g_folders[0]); i++) {
+        if (!g_folders[i].folder || g_folders[i].fd == fd) {
+            free(g_folders[i].folder);
+            free(g_folders[i].xbe);
+            g_folders[i].fd = fd;
+            g_folders[i].folder = strdup(folder);
+            g_folders[i].xbe = strdup(xbe ? xbe : "default.xbe");
+            break;
+        }
+    }
+    pthread_mutex_unlock(&g_reg_lock);
+}
+
+/* The folder registered for fd (copies the caller frees), or false. */
+static bool take_folder(int fd, char **folder, char **xbe)
+{
+    bool found = false;
+    pthread_mutex_lock(&g_reg_lock);
+    for (unsigned i = 0; i < sizeof(g_folders) / sizeof(g_folders[0]); i++) {
+        if (g_folders[i].folder && g_folders[i].fd == fd) {
+            *folder = strdup(g_folders[i].folder);
+            *xbe = strdup(g_folders[i].xbe);
+            found = *folder && *xbe;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&g_reg_lock);
+    return found;
+}
+
+void nc_pack_unregister(int first_fd)
+{
+    int fds[MAX_SLICES - 1], n = 0;
+    pthread_mutex_lock(&g_reg_lock);
+    for (unsigned i = 0; i < sizeof(g_folders) / sizeof(g_folders[0]); i++) {
+        if (g_folders[i].folder && g_folders[i].fd == first_fd) {
+            free(g_folders[i].folder);
+            free(g_folders[i].xbe);
+            g_folders[i].folder = g_folders[i].xbe = NULL;
+        }
+    }
+    for (unsigned i = 0; i < sizeof(g_reg) / sizeof(g_reg[0]); i++) {
+        if (g_reg[i].n && g_reg[i].first == first_fd) {
+            n = g_reg[i].n;
+            memcpy(fds, g_reg[i].fds, (size_t)n * sizeof(int));
+            g_reg[i].n = 0;
+        }
+    }
+    pthread_mutex_unlock(&g_reg_lock);
+    for (int k = 0; k < n; k++) {
+        part_close(fds[k]);         /* the parts are the registration's: closed with it */
+    }
+}
+
+static int take_slices(int first_fd, int *fds)
+{
+    int n = 0;
+    pthread_mutex_lock(&g_reg_lock);
+    for (unsigned i = 0; i < sizeof(g_reg) / sizeof(g_reg[0]); i++) {
+        if (g_reg[i].n && g_reg[i].first == first_fd) {
+            n = g_reg[i].n;
+            memcpy(fds, g_reg[i].fds, (size_t)n * sizeof(int));
+            break;
+        }
+    }
+    pthread_mutex_unlock(&g_reg_lock);
+    return n;
+}
+
+static bool pread_all(int fd, void *buf, size_t len, uint64_t off)
+{
+    uint8_t *p = buf;
+    while (len) {
+        const ssize_t n = pread(fd, p, len, (off_t)off);
+        if (n <= 0) {
+            return false;
+        }
+        p += n;
+        len -= (size_t)n;
+        off += (uint64_t)n;
+    }
+    return true;
+}
+
+static uint32_t rd32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static uint64_t rd64(const uint8_t *p)
+{
+    return (uint64_t)rd32(p) | (uint64_t)rd32(p + 4) << 32;
+}
+
+int nc_lz4_decode(const uint8_t *src, int src_len, uint8_t *dst, int dst_cap)
+{
+    const uint8_t *ip = src, *const iend = src + src_len;
+    uint8_t *op = dst, *const oend = dst + dst_cap;
+    while (ip < iend) {
+        const unsigned token = *ip++;
+        size_t lit = token >> 4;
+        if (lit == 15) {
+            unsigned b;
+            do {
+                if (ip >= iend) {
+                    return -1;
+                }
+                b = *ip++;
+                lit += b;
+            } while (b == 255);
+        }
+        if (lit > (size_t)(iend - ip) || lit > (size_t)(oend - op)) {
+            return -1;
+        }
+        memcpy(op, ip, lit);
+        op += lit;
+        ip += lit;
+        if (ip >= iend) {
+            break;                  /* the last sequence has no match */
+        }
+        if (iend - ip < 2) {
+            return -1;
+        }
+        const size_t dist = (size_t)ip[0] | (size_t)ip[1] << 8;
+        ip += 2;
+        if (!dist || dist > (size_t)(op - dst)) {
+            return -1;
+        }
+        size_t mlen = (token & 15) + 4;
+        if ((token & 15) == 15) {
+            unsigned b;
+            do {
+                if (ip >= iend) {
+                    return -1;
+                }
+                b = *ip++;
+                mlen += b;
+            } while (b == 255);
+        }
+        if (mlen > (size_t)(oend - op)) {
+            return -1;
+        }
+        const uint8_t *m = op - dist;
+        for (size_t i = 0; i < mlen; i++) {
+            op[i] = m[i];           /* (byte by byte: the match may overlap what it writes) */
+        }
+        op += mlen;
+    }
+    return (int)(op - dst);
+}
+
+/* ---- OGBox 0.0.8: a CSO ---- */
+
+static uint64_t cso_pos(const Slice *s, uint32_t b)
+{
+    return (uint64_t)(s->index[b] & 0x7FFFFFFFu) << s->align;
+}
+
+/* a CSO: its header and index (the first file's), its files' sizes and first blocks */
+static bool cso_open(NcPack *p, int fd, const int *more, int nmore)
+{
+    uint8_t h[24];
+    if (!pread_all(fd, h, sizeof(h), 0)) {
+        return false;
+    }
+    const uint64_t size = rd64(h + 8);
+    const uint32_t block = rd32(h + 16);
+    const unsigned version = h[20], align = h[21];
+    if (block != SECTOR || version != 2 || align > 8 || size < SECTOR || size / SECTOR > (1u << 24)) {
+        nc_log("hakuX-native", "disc: a CSO whose header this doesn't take (block %u, version %u, alignment %u)%s",
+               block, version, align, version == 1 ? ": version 1 is the PSP's, deflate-compressed" : "");
+        return false;
+    }
+    Slice *s = &p->s[0];
+    memset(s, 0, sizeof(*s));
+    s->fd = fd;
+    s->sectors = (uint32_t)(size / SECTOR);
+    s->size = (uint64_t)s->sectors * SECTOR;
+    s->align = align;
+    s->cso = true;
+    p->n = 1;
+    const size_t n = (size_t)s->sectors + 1;
+    uint8_t *raw = malloc(n * 4);
+    s->index = malloc(n * sizeof(uint32_t));
+    if (!raw || !s->index || !pread_all(fd, raw, n * 4, sizeof(h))) {
+        free(raw);
+        return false;
+    }
+    for (size_t i = 0; i < n; i++) {
+        s->index[i] = rd32(raw + 4 * i);
+    }
+    free(raw);
+    const int nfiles = 1 + nmore;
+    for (int k = 0; k < nfiles; k++) {
+        struct stat st;
+        p->cso_fd[k] = k ? more[k - 1] : fd;
+        if (fstat(p->cso_fd[k], &st) != 0) {
+            return false;
+        }
+        p->cso_size[k] = (uint64_t)st.st_size;
+    }
+    int parts = 1;
+    p->part_first[0] = 0;
+    for (uint32_t b = 1; b < s->sectors; b++) {
+        if (cso_pos(s, b) < cso_pos(s, b - 1)) {
+            if (parts == MAX_SLICES) {
+                return false;
+            }
+            p->part_first[parts++] = b;
+        }
+    }
+    p->part_first[parts] = s->sectors;
+    if (parts > nfiles) {
+        nc_log("hakuX-native", "disc: the CSO is in %d files and %d %s here (game.%d.cso is missing)", parts, nfiles,
+               nfiles == 1 ? "is" : "are", nfiles + 1);
+        return false;
+    }
+    p->nparts = parts;
+    return true;
+}
+
+/* One block's 2048 bytes: a plain one's, else its LZ4 frame block's (or a bare LZ4 block's, the
+ * padding after it up to the next block's alignment left out). */
+static bool cso_block(const uint8_t *src, size_t size, bool compressed, uint8_t *out)
+{
+    if (!compressed) {
+        if (size < SECTOR) {
+            return false;
+        }
+        memcpy(out, src, SECTOR);
+        return true;
+    }
+    if (size >= 4) {
+        const uint32_t h = rd32(src), n = h & 0x7FFFFFFFu;
+        if (n && n <= size - 4) {
+            if (h & 0x80000000u) {
+                const size_t c = n < SECTOR ? n : SECTOR;
+                memcpy(out, src + 4, c);
+                memset(out + c, 0, SECTOR - c);
+                return true;
+            }
+            const int got = nc_lz4_decode(src + 4, (int)n, out, SECTOR);
+            if (got > 0) {
+                memset(out + got, 0, SECTOR - (size_t)got);
+                return true;
+            }
+        }
+    }
+    for (size_t trim = 0; trim < 4 && trim < size; trim++) {
+        if (nc_lz4_decode(src, (int)(size - trim), out, SECTOR) == (int)SECTOR) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/* a CSO's blocks [first, first + count) into dst, under the lock: each file's runs in one read */
+static bool cso_read(NcPack *p, Slice *s, uint32_t first, uint32_t count, uint8_t *dst)
+{
+    while (count) {
+        int k = 0;
+        while (k + 1 < p->nparts && first >= p->part_first[k + 1]) {
+            k++;
+        }
+        const uint32_t end = p->part_first[k + 1];
+        uint32_t run = count < 64 ? count : 64;
+        if (first + run > end) {
+            run = end - first;
+        }
+        const uint64_t lo = cso_pos(s, first);
+        const uint64_t hi = first + run < end ? cso_pos(s, first + run) : p->cso_size[k];
+        if (!run || hi < lo || hi - lo > (64u << 20)) {
+            return false;
+        }
+        const size_t len = (size_t)(hi - lo);
+        if (len > p->raw_cap) {
+            uint8_t *r = realloc(p->raw, len);
+            if (!r) {
+                return false;
+            }
+            p->raw = r;
+            p->raw_cap = len;
+        }
+        if (!pread_all(p->cso_fd[k], p->raw, len, lo)) {
+            return false;
+        }
+        for (uint32_t j = 0; j < run; j++) {
+            const uint32_t b = first + j;
+            const uint64_t a = cso_pos(s, b) - lo;
+            const uint64_t z = (b + 1 < end ? cso_pos(s, b + 1) : p->cso_size[k]) - lo;
+            if (z < a || z > len || !cso_block(p->raw + a, (size_t)(z - a), s->index[b] & 0x80000000u,
+                                               dst + (size_t)j * SECTOR)) {
+                nc_log("hakuX-native", "disc: the CSO's block %u can't be read", b);
+                return false;
+            }
+        }
+        first += run;
+        count -= run;
+        dst += (size_t)run * SECTOR;
+    }
+    return true;
+}
+
+/* a part: a CCI's header and index, or a plain part's size */
+static bool slice_open(Slice *s, int fd, bool *cci)
+{
+    memset(s, 0, sizeof(*s));
+    s->fd = fd;
+    uint8_t h[32];
+    *cci = pread_all(fd, h, sizeof(h), 0) && !memcmp(h, "MCCI", 4);
+    if (!*cci) {
+        struct stat st;
+        if (fstat(fd, &st) != 0 || st.st_size <= 0) {
+            return false;
+        }
+        s->size = (uint64_t)st.st_size;
+        return true;
+    }
+    const uint64_t size = rd64(h + 8), index_off = rd64(h + 16);
+    const uint32_t block = rd32(h + 24);
+    if (rd32(h + 4) != 32 || block != SECTOR || h[28] != 1 || h[29] > 8 || size % SECTOR || size / SECTOR > (1u << 24)) {
+        nc_log("hakuX-native", "disc: a CCI whose header this doesn't take (header %u, block %u, version %u, alignment %u)",
+               rd32(h + 4), block, h[28], h[29]);
+        return false;
+    }
+    s->sectors = (uint32_t)(size / SECTOR);
+    s->align = h[29];
+    s->size = size;
+    const size_t n = (size_t)s->sectors + 1;
+    uint8_t *raw = malloc(n * 4);
+    s->index = malloc(n * sizeof(uint32_t));
+    if (!raw || !s->index || !pread_all(fd, raw, n * 4, index_off)) {
+        free(raw);
+        free(s->index);
+        s->index = NULL;
+        return false;
+    }
+    for (size_t i = 0; i < n; i++) {
+        s->index[i] = rd32(raw + 4 * i);
+    }
+    free(raw);
+    return true;
+}
+
+NcPack *nc_pack_open(int fd, bool *is_pack)
+{
+    *is_pack = false;
+    char *folder = NULL, *xbe = NULL;
+    if (take_folder(fd, &folder, &xbe)) {
+        /* OGBox 0.0.8: an extracted game's folder */
+        *is_pack = true;
+        NcPack *p = calloc(1, sizeof(*p));
+        if (p) {
+            pthread_mutex_init(&p->lock, NULL);
+            p->folder = nc_folder_open(folder, xbe, nc_pack_folder_io());
+            if (!p->folder) {
+                nc_pack_close(p);
+                p = NULL;
+            }
+        }
+        free(folder);
+        free(xbe);
+        return p;
+    }
+    free(folder);
+    free(xbe);
+    int more[MAX_SLICES - 1];
+    const int nmore = take_slices(fd, more);
+    uint8_t magic[4];
+    const bool magic_read = pread_all(fd, magic, 4, 0);
+    const bool cci = magic_read && !memcmp(magic, "MCCI", 4);
+    const bool cso = magic_read && !memcmp(magic, "CISO", 4);
+    if (!nmore && !cci && !cso) {
+        return NULL;
+    }
+    *is_pack = true;
+    NcPack *p = calloc(1, sizeof(*p));
+    if (!p) {
+        return NULL;
+    }
+    pthread_mutex_init(&p->lock, NULL);
+    memset(p->cached, 0xFF, sizeof(p->cached));
+    if (cso) {
+        if (!cso_open(p, fd, more, nmore)) {
+            nc_log("hakuX-native", "disc: the CSO can't be read");
+            nc_pack_close(p);
+            return NULL;
+        }
+        nc_log("hakuX-native", "disc: a CSO (compressed) in %d file%s, %llu MiB", p->nparts, p->nparts == 1 ? "" : "s",
+               (unsigned long long)(p->s[0].size >> 20));
+        return p;
+    }
+    uint64_t at = 0;
+    unsigned ccis = 0;
+    for (int i = 0; i <= nmore; i++) {
+        Slice *s = &p->s[p->n];
+        bool c;
+        if (!slice_open(s, i ? more[i - 1] : fd, &c)) {
+            nc_log("hakuX-native", "disc: part %d of the image can't be read", i + 1);
+            p->n++;
+            nc_pack_close(p);
+            return NULL;
+        }
+        ccis += c;
+        s->start = at;
+        at += s->size;
+        p->n++;
+    }
+    nc_log("hakuX-native", "disc: %s in %d part%s, %llu MiB", ccis ? "a CCI (compressed)" : "an image", p->n,
+           p->n == 1 ? "" : "s", (unsigned long long)(at >> 20));
+    return p;
+}
+
+void nc_pack_close(NcPack *p)
+{
+    if (!p) {
+        return;
+    }
+    for (int i = 0; i < p->n; i++) {
+        free(p->s[i].index);
+
+    }
+    nc_folder_close(p->folder);
+    free(p->raw);
+    pthread_mutex_destroy(&p->lock);
+    free(p);
+}
+
+/* a CCI part's sectors [first, first + count) into dst (count * 2048 bytes), under the lock */
+static bool cci_read(NcPack *p, Slice *s, uint32_t first, uint32_t count, uint8_t *dst)
+{
+    while (count) {
+        /* a run of sectors not in the cache: their bytes, one read */
+        uint32_t run = 0;
+        while (run < count && run < 64) {
+            run++;
+        }
+        const uint64_t lo = (uint64_t)(s->index[first] & 0x7FFFFFFFu) << s->align;
+        const uint64_t hi = (uint64_t)(s->index[first + run] & 0x7FFFFFFFu) << s->align;
+        if (hi < lo || hi - lo > (64u << 20)) {
+            return false;
+        }
+        const size_t len = (size_t)(hi - lo);
+        if (len > p->raw_cap) {
+            uint8_t *r = realloc(p->raw, len);
+            if (!r) {
+                return false;
+            }
+            p->raw = r;
+            p->raw_cap = len;
+        }
+        if (!pread_all(s->fd, p->raw, len, lo)) {
+            return false;
+        }
+        for (uint32_t k = 0; k < run; k++) {
+            const uint32_t e = s->index[first + k], e1 = s->index[first + k + 1];
+            const uint64_t a = (uint64_t)(e & 0x7FFFFFFFu) << s->align, b = (uint64_t)(e1 & 0x7FFFFFFFu) << s->align;
+            const uint8_t *src = p->raw + (a - lo);
+            const size_t size = (size_t)(b - a);
+            uint8_t *out = dst + (size_t)k * SECTOR;
+            if (size == SECTOR && !(e & 0x80000000u)) {
+                memcpy(out, src, SECTOR);
+            } else {
+                if (size < 1 || (size_t)src[0] + 1 > size) {
+                    return false;
+                }
+                const int got = nc_lz4_decode(src + 1, (int)(size - 1 - src[0]), out, SECTOR);
+                if (got < 0) {
+                    return false;
+                }
+                if (got < (int)SECTOR) {
+                    memset(out + got, 0, SECTOR - (size_t)got);
+                }
+            }
+        }
+        first += run;
+        count -= run;
+        dst += (size_t)run * SECTOR;
+    }
+    return true;
+}
+
+/* a compressed part's sectors, under the lock */
+static bool sectors_read(NcPack *p, Slice *s, uint32_t first, uint32_t count, uint8_t *dst)
+{
+    return s->cso ? cso_read(p, s, first, count, dst) : cci_read(p, s, first, count, dst);
+}
+
+bool nc_pack_read(NcPack *p, void *buf, size_t len, uint64_t off)
+{
+    if (p->folder) {
+        return nc_folder_read(p->folder, buf, len, off);
+    }
+    uint8_t *out = buf;
+    while (len) {
+        int i = 0;
+        while (i < p->n && off >= p->s[i].start + p->s[i].size) {
+            i++;
+        }
+        if (i >= p->n) {
+            return false;
+        }
+        Slice *s = &p->s[i];
+        const uint64_t in = off - s->start;
+        size_t n = (size_t)(s->size - in < len ? s->size - in : len);
+        if (!s->index) {
+            if (!pread_all(s->fd, out, n, in)) {
+                return false;
+            }
+        } else {
+            pthread_mutex_lock(&p->lock);
+            const uint32_t first = (uint32_t)(in / SECTOR), skip = (uint32_t)(in % SECTOR);
+            bool ok = true;
+            if (skip || n < SECTOR) {
+                /* a part of one sector: through the cache */
+                const uint64_t key = (uint64_t)i << 32 | first;
+                int c = -1;
+                for (int k = 0; k < 8; k++) {
+                    if (p->cached[k] == key) {
+                        c = k;
+                    }
+                }
+                if (c < 0) {
+                    c = (int)(p->next++ & 7);
+                    ok = sectors_read(p, s, first, 1, p->cache[c]);
+                    p->cached[c] = ok ? key : UINT64_MAX;
+                }
+                if (n > SECTOR - skip) {
+                    n = SECTOR - skip;
+                }
+                if (ok) {
+                    memcpy(out, p->cache[c] + skip, n);
+                }
+            } else {
+                /* whole sectors straight into the buffer */
+                const uint32_t count = (uint32_t)(n / SECTOR);
+                n = (size_t)count * SECTOR;
+                ok = first + count <= s->sectors && sectors_read(p, s, first, count, out);
+            }
+            pthread_mutex_unlock(&p->lock);
+            if (!ok) {
+                return false;
+            }
+        }
+        out += n;
+        off += n;
+        len -= n;
+    }
+    return true;
+}
diff --git a/native/core/pack.h b/native/core/pack.h
new file mode 100644
index 0000000000000000000000000000000000000000..f8be8a3aea80827df2b5b3dc9b4a395b5f81aaf3
--- /dev/null
+++ b/native/core/pack.h
@@ -0,0 +1,61 @@
+/*
+ * hakuX native core — packed and split disc images (OGBox 0.0.3).
+ *
+ * Copyright (C) 2026 Press5elect
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * Additional terms (GPL-3.0 section 7(b)): keep the attribution "OGBox by Press5elect"; see NOTICE.
+ *
+ * An image in more than one file (a FAT drive's 4 GiB limit: game.1.iso, game.2.iso; the opener
+ * registers the parts after the first, nc_pack_register_slices) and a CCI (Cerbios's compressed
+ * image, Team Resurgent's format: "MCCI", a 32-byte header, then 2048-byte sectors each stored or
+ * LZ4-compressed, an index of their places at the end), one file or split the same way. The
+ * xdvdfs reader reads through it as through a CHD.
+ *
+ * OGBox 0.0.8: a CSO (MakeMHz's Stellar format, the original console's ODE and Repackinator write
+ * it: "CISO", version 2, 2048-byte blocks each stored or an LZ4 frame's block, game.1.cso and
+ * game.2.cso past 4 GiB with one index in the first), and an extracted game's folder read as a
+ * disc (folder.c: its default.xbe and the files beside it, an XDVDFS image made as it is read).
+ */
+#ifndef NC_PACK_H
+#define NC_PACK_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct NcPack NcPack;
+
+/* fd an image whose slices were registered, or a CCI: its reader (*is_pack true). NULL with
+ * *is_pack false: an image of one plain file; NULL with *is_pack true: one this can't read. */
+NcPack *nc_pack_open(int fd, bool *is_pack);
+bool nc_pack_read(NcPack *p, void *buf, size_t len, uint64_t off);
+/* The reader freed (the descriptors stay: the first its opener's, the others the registration's). */
+void nc_pack_close(NcPack *p);
+
+/* The parts after the first fd of a split image (their fds, in order), for every nc_pack_open of
+ * it until nc_pack_unregister, which closes them. Up to 15. */
+void nc_pack_register_slices(int first_fd, const int *more, int n);
+void nc_pack_unregister(int first_fd);
+
+/* How a part's descriptor is closed (an opener's own descriptors: a share's virtual ones); close()
+ * when not set. */
+void nc_pack_set_closer(void (*close_fd)(int fd));
+
+/* OGBox 0.0.8: an extracted game (folder.c). The host's file access for it (a share's through its
+ * own layer): open a file to read with pread (-1: it can't be), close it, and list a folder (fn
+ * for each entry; false: it can't be listed). The default: POSIX open, close, opendir and stat. */
+typedef struct NcFolderIo {
+    int (*open)(const char *path);
+    void (*close)(int fd);
+    bool (*list)(const char *path, void (*fn)(void *ctx, const char *name, bool is_dir, uint64_t size), void *ctx);
+} NcFolderIo;
+void nc_pack_set_folder_io(const NcFolderIo *io);
+const NcFolderIo *nc_pack_folder_io(void);
+/* fd is the XBE's to boot (what nc_pack_open is then given), in folder: the game's files read as a
+ * disc, the XBE there as \default.xbe, until nc_pack_unregister(fd). */
+void nc_pack_register_folder(int fd, const char *folder, const char *xbe);
+
+/* The LZ4 block format decoded: the bytes written, or -1. */
+int nc_lz4_decode(const uint8_t *src, int src_len, uint8_t *dst, int dst_cap);
+
+#endif
