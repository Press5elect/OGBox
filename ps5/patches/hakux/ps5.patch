+/* The next stack location for an IRP the kernel builds for dev. */
+static uint32_t irp_build(NcKernel *k, uint32_t major, uint32_t dev, uint32_t iosb, uint32_t *sp)
+{
+    const uint32_t irp = irp_alloc(k, *(const uint8_t *)nc_vm_host(k->vm, dev + NC_DEV_STACK_SIZE));
+    if (!irp) {
+        return 0;
+    }
+    *sp = nc_vm_rd32(k->vm, irp + NC_IRP_STACK) - NC_SL_SIZE;
+    *(uint8_t *)nc_vm_host(k->vm, *sp + NC_SL_MAJOR) = (uint8_t)major;
+    nc_vm_wr32(k->vm, irp + NC_IRP_USER_IOSB, iosb);
+    nc_vm_wr32(k->vm, irp + NC_IRP_THREAD, current_ethread(k));
+    return irp;
+}
+
+static uint32_t irp_build_fsd(NcKernel *k, uint32_t major, uint32_t dev, uint32_t buf, uint32_t len, uint32_t offset,
+                              uint32_t iosb)
+{
+    uint32_t sp;
+    const uint32_t irp = irp_build(k, major, dev, iosb, &sp);
+    if (irp && major != IRP_MJ_FLUSH_BUFFERS && major != IRP_MJ_SHUTDOWN) {
+        nc_vm_wr32(k->vm, irp + NC_IRP_USER_BUFFER, buf);
+        nc_vm_wr32(k->vm, sp + NC_SL_LENGTH, len);
+        if (offset) {
+            nc_vm_wr32(k->vm, sp + NC_SL_OFFSET, nc_vm_rd32(k->vm, offset));
+            nc_vm_wr32(k->vm, sp + NC_SL_OFFSET + 4, nc_vm_rd32(k->vm, offset + 4));
+        }
+    }
+    return irp;
+}
+
+/* IoBuildAsynchronousFsdRequest(MajorFunction, DeviceObject, Buffer, Length, StartingOffset,
+ *   IoStatusBlock) -> IRP or NULL */
+static uint64_t IoBuildAsynchronousFsdRequest(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    return irp_build_fsd(k, a[0], a[1], a[2], a[3], a[4], a[5]);
+}
+
+/* IoBuildSynchronousFsdRequest(MajorFunction, DeviceObject, Buffer, Length, StartingOffset,
+ *   Event, IoStatusBlock) -> IRP or NULL, in the thread's IRP list */
+static uint64_t IoBuildSynchronousFsdRequest(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    const uint32_t irp = irp_build_fsd(k, a[0], a[1], a[2], a[3], a[4], a[6]);
+    if (irp) {
+        nc_vm_wr32(k->vm, irp + NC_IRP_USER_EVENT, a[5]);
+        irp_thread_link(k, irp, current_ethread(k));
+    }
+    return irp;
+}
+
+/* IoBuildDeviceIoControlRequest(IoControlCode, DeviceObject, InputBuffer, InputBufferLength,
+ *   OutputBuffer, OutputBufferLength, InternalDeviceIoControl, Event, IoStatusBlock) -> IRP or NULL */
+static uint64_t IoBuildDeviceIoControlRequest(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    uint32_t sp;
+    const uint32_t irp =
+        irp_build(k, (a[6] & 0xFF) ? IRP_MJ_INTERNAL_DEVICE_CONTROL : IRP_MJ_DEVICE_CONTROL, a[1], a[8], &sp);
+    if (irp) {
+        nc_vm_wr32(k->vm, sp + NC_SL_OUT_LENGTH, a[5]);
+        nc_vm_wr32(k->vm, sp + NC_SL_IN_BUFFER, a[2]);
+        nc_vm_wr32(k->vm, sp + NC_SL_IN_LENGTH, a[3]);
+        nc_vm_wr32(k->vm, sp + NC_SL_CODE, a[0]);
+        nc_vm_wr32(k->vm, irp + NC_IRP_USER_BUFFER, a[4]);
+        nc_vm_wr32(k->vm, irp + NC_IRP_USER_EVENT, a[7]);
+        irp_thread_link(k, irp, current_ethread(k));
+    }
+    return irp;
+}
+
+/* A synchronous request's own event and IoStatusBlock, from the pool. */
+#define SYNC_EVENT 0x00
+#define SYNC_IOSB  0x10
+#define SYNC_SIZE  0x18u
+
+/* The request ended with status: its IoStatusBlock's Information to ctx[1]
+ * (if given), the block freed. ctx: the block, the place for Information. */
+static uint64_t sync_done(NcKernel *k, const uint32_t *ctx, uint32_t status)
+{
+    if (ctx[1]) {
+        nc_vm_wr32(k->vm, ctx[1], nc_vm_rd32(k->vm, ctx[0] + SYNC_IOSB + 4));
+    }
+    nc_ex_free(k, ctx[0]);
+    return status;
+}
+
+/* A synchronous request's wait for a pending IRP ended. */
+static uint64_t sync_waited(NcKernel *k, NcFrame *f, uint32_t eax, const uint32_t *ctx)
+{
+    return sync_done(k, ctx, nc_vm_rd32(k->vm, ctx[0] + SYNC_IOSB));
+}
+
+/* The driver returned status for a synchronous request's IRP: a pending one is
+ * waited for. */
+static uint64_t sync_called(NcKernel *k, NcFrame *f, uint32_t status, const uint32_t *ctx)
+{
+    if (status != NC_STATUS_PENDING) {
+        return sync_done(k, ctx, status);
+    }
+    nc_ke_wait_one(k, ctx[0] + SYNC_EVENT);
+    if (k->current && k->current->state == NC_T_WAITING) {
+        nc_kernel_wait_cont(k, f, NC_KCONT_IRP_WAITED, ctx);
+        return 0;
+    }
+    return sync_done(k, ctx, nc_vm_rd32(k->vm, ctx[0] + SYNC_IOSB));
+}
+
+/* IoSynchronousFsdRequest(MajorFunction, DeviceObject, Buffer, Length, StartingOffset) -> status:
+ * the request built, sent and waited for, with an event and IoStatusBlock of the kernel's */
+static uint64_t IoSynchronousFsdRequest(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    const uint32_t block = nc_ex_alloc(k, SYNC_SIZE);
+    if (!block) {
+        return NC_STATUS_INSUFFICIENT_RESOURCES;
+    }
+    nc_ke_init_event(k, block + SYNC_EVENT, 0, false);
+    nc_vm_wr32(k->vm, block + SYNC_IOSB, 0);
+    nc_vm_wr32(k->vm, block + SYNC_IOSB + 4, 0);
+    const uint32_t irp = irp_build_fsd(k, a[0], a[1], a[2], a[3], a[4], block + SYNC_IOSB);
+    if (!irp) {
+        nc_ex_free(k, block);
+        return NC_STATUS_INSUFFICIENT_RESOURCES;
+    }
+    const uint32_t ctx[NC_KCONT_WORDS] = {block, 0};
+    nc_vm_wr32(k->vm, irp + NC_IRP_USER_EVENT, block + SYNC_EVENT);
+    irp_thread_link(k, irp, current_ethread(k));
+    const NcIoMem m = irp_mem(k);
+    uint32_t routine, sp;
+    const uint32_t dev = a[1];
+    if (!nc_irp_down(&m, irp, dev, &routine, &sp)) {
+        nc_kernel_request_stop(k, f, "KeBugCheckEx(NO_MORE_IRP_STACK_LOCATIONS 0x35, %08x)", irp);
+        return 0;
+    }
+    if (!routine) {
+        /* the kernel's own device (a driver without the major: invalid) */
+        const uint32_t st = nc_vm_rd32(k->vm, dev + NC_DEV_DRIVER) ? STATUS_INVALID_DEVICE_REQUEST
+                                                                 : kernel_device(k, dev, irp, sp);
+        nc_vm_wr32(k->vm, irp + NC_IRP_STATUS, st);
+        irp_complete(k, f, irp, st, IO_DISK_INCREMENT);
+        return k->redirected ? 0 : sync_called(k, f, st, ctx); /* no completion routine on the kernel's own */
+    }
+    const uint32_t args[2] = {dev, irp};
+    nc_kernel_callout_cont(k, f, routine, args, 2, 0xFF, NC_KCONT_IRP_CALLED, ctx);
+    return 0;
+}
+
+/* dev's StartIo for irp, at DISPATCH_LEVEL, as its current IRP. */
+static uint64_t start_io(NcKernel *k, NcFrame *f, uint32_t dev, uint32_t irp)
+{
+    const NcIoMem m = irp_mem(k);
+    const uint32_t routine = nc_startio_begin(&m, dev, irp);
+    if (!routine) {
+        return 0;
+    }
+    const uint32_t args[2] = {dev, irp};
+    const uint32_t ctx[NC_KCONT_WORDS] = {dev};
+    nc_kernel_callout_cont(k, f, routine, args, 2, 2, NC_KCONT_START_IO, ctx);
+    return 0;
+}
+
+/* dev's next packet to StartIo (by key: the first of the key or above); from
+ * inside StartIo, after it returns. */
+static uint64_t next_packet(NcKernel *k, NcFrame *f, uint32_t dev, bool by_key, uint32_t key)
+{
+    const NcIoMem m = irp_mem(k);
+    uint32_t irp = 0;
+    return nc_startio_next(&m, dev, by_key, key, &irp) == NC_STARTIO_START ? start_io(k, f, dev, irp) : 0;
+}
+
+/* StartIo returned: a next packet it asked for starts now. */
+static uint64_t start_io_cont(NcKernel *k, NcFrame *f, uint32_t eax, const uint32_t *ctx)
+{
+    const NcIoMem m = irp_mem(k);
+    bool by_key;
+    uint32_t key;
+    return nc_startio_returned(&m, ctx[0], &by_key, &key) ? next_packet(k, f, ctx[0], by_key, key) : 0;
+}
+
+/* IoStartPacket(DeviceObject, Irp, Key): into the device's queue (by *Key if given), or to
+ * StartIo at once when the device is idle */
+static uint64_t IoStartPacket(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    const NcIoMem m = irp_mem(k);
+    const uint32_t dev = a[0], irp = a[1];
+    if (nc_devq_insert(&m, dev + NC_DEV_QUEUE, irp + NC_IRP_QUEUE_ENTRY, a[2] != 0,
+                       a[2] ? nc_vm_rd32(k->vm, a[2]) : 0)) {
+        return 0;
+    }
+    return start_io(k, f, dev, irp);
+}
+
+/* IoStartNextPacket(DeviceObject) */
+static uint64_t IoStartNextPacket(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    return next_packet(k, f, a[0], false, 0);
+}
+
+/* IoStartNextPacketByKey(DeviceObject, Key) */
+static uint64_t IoStartNextPacketByKey(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    return next_packet(k, f, a[0], true, a[1]);
+}
+
+/* ---------------------------------------------------- completion ports
+ *
+ * An I/O completion port is a KQUEUE (ke.c) in an object of its own type
+ * (IoCompletionObjectType). NtSetIoCompletion and IoSetIoCompletion queue a
+ * packet: its ListEntry, PacketType (1) 0x08, Key 0x0C, ApcContext 0x10,
+ * Status 0x14, Information 0x18. NtRemoveIoCompletion takes the first (a
+ * blocking one when the wait ends) and frees it. Files don't post their
+ * completions to a port here (FileCompletionInformation isn't kept). From
+ * portare-ch's hakuX-lr (ac3ab2361b, GPL-2.0-or-later), the IRP packets left
+ * out. */
+#define PACKET_SIZE      0x1Cu
+#define PK_TYPE          0x08
+#define PK_KEY           0x0C
+#define PK_APC_CONTEXT   0x10
+#define PK_STATUS        0x14
+#define PK_INFORMATION   0x18
+#define PORT_SIZE        0x28u   /* KQUEUE */
+
+static uint32_t port_post(NcKernel *k, uint32_t port, uint32_t key, uint32_t apc_ctx, uint32_t status,
+                          uint32_t info)
+{
+    const uint32_t p = nc_pool_alloc(k, PACKET_SIZE);
+    if (!p) {
+        return NC_STATUS_INSUFFICIENT_RESOURCES;
+    }
+    nc_vm_wr32(k->vm, p + PK_TYPE, 1);
+    nc_vm_wr32(k->vm, p + PK_KEY, key);
+    nc_vm_wr32(k->vm, p + PK_APC_CONTEXT, apc_ctx);
+    nc_vm_wr32(k->vm, p + PK_STATUS, status);
+    nc_vm_wr32(k->vm, p + PK_INFORMATION, info);
+    nc_ke_queue_insert(k, port, p, false);
+    return NC_STATUS_SUCCESS;
+}
+
+static uint32_t port_of_handle(NcKernel *k, uint32_t handle, uint32_t *status)
+{
+    enum NcObType type;
+    const uint32_t port = nc_ob_lookup(k, handle, &type);
+    *status = !port ? NC_STATUS_INVALID_HANDLE
+            : type != NC_OB_IO_COMPLETION ? NC_STATUS_OBJECT_TYPE_MISMATCH : NC_STATUS_SUCCESS;
+    return *status == NC_STATUS_SUCCESS ? port : 0;
+}
+
+uint32_t nc_io_completion_removed(NcKernel *k, uint32_t entry, const uint32_t out[3])
+{
+    if (!entry) {
+        return NC_STATUS_TIMEOUT;
+    }
+    uint32_t key = 0, apc_ctx = 0, status = 0, info = 0;
+    if (nc_vm_rd32(k->vm, entry + PK_TYPE) == 1) {
+        key = nc_vm_rd32(k->vm, entry + PK_KEY);
+        apc_ctx = nc_vm_rd32(k->vm, entry + PK_APC_CONTEXT);
+        status = nc_vm_rd32(k->vm, entry + PK_STATUS);
+        info = nc_vm_rd32(k->vm, entry + PK_INFORMATION);
+        nc_pool_free(k, entry, PACKET_SIZE);
+    }   /* (else an entry the title queued on the port's KQUEUE itself: not ours to free) */
+    if (out[0]) {
+        nc_vm_wr32(k->vm, out[0], key);
+    }
+    if (out[1]) {
+        nc_vm_wr32(k->vm, out[1], apc_ctx);
+    }
+    if (out[2]) {
+        nc_vm_wr32(k->vm, out[2], status);
+        nc_vm_wr32(k->vm, out[2] + 4, info);
+    }
+    return NC_STATUS_SUCCESS;
+}
+
+/* NtCreateIoCompletion(IoCompletionHandle, DesiredAccess, ObjectAttributes, Count) */
+static uint64_t NtCreateIoCompletion(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    uint32_t status;
+    bool fresh;
+    const uint32_t port = nc_ob_create_named(k, NC_OB_IO_COMPLETION, PORT_SIZE, a[2], &status, &fresh);
+    if (!port) {
+        return status;
+    }
+    if (fresh) {
+        nc_ke_queue_init(k, port, a[3]);
+    }
+    const uint32_t h = nc_ob_handle(k, port, NC_OB_IO_COMPLETION);
+    if (!h) {
+        return NC_STATUS_INSUFFICIENT_RESOURCES;
+    }
+    nc_vm_wr32(k->vm, a[0], h);
+    return status;
+}
+
+/* NtSetIoCompletion(IoCompletionHandle, KeyContext, ApcContext, IoStatus, IoStatusInformation) */
+static uint64_t NtSetIoCompletion(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    uint32_t st;
+    const uint32_t port = port_of_handle(k, a[0], &st);
+    return port ? port_post(k, port, a[1], a[2], a[3], a[4]) : st;
+}
+
+/* IoSetIoCompletion(IoCompletion, KeyContext, ApcContext, IoStatus, IoStatusInformation) */
+static uint64_t IoSetIoCompletion(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    return a[0] ? port_post(k, a[0], a[1], a[2], a[3], a[4]) : NC_STATUS_INVALID_PARAMETER;
+}
+
+/* NtQueryIoCompletion(IoCompletionHandle, IoCompletionInformation) -> { Depth } */
+static uint64_t NtQueryIoCompletion(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    uint32_t st;
+    const uint32_t port = port_of_handle(k, a[0], &st);
+    if (port && a[1]) {
+        nc_vm_wr32(k->vm, a[1], (uint32_t)nc_ke_queue_depth(k, port));
+    }
+    return st;
+}
+
+/* NtRemoveIoCompletion(IoCompletionHandle, KeyContext, ApcContext, IoStatusBlock, Timeout) */
+static uint64_t NtRemoveIoCompletion(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    uint32_t st;
+    const uint32_t port = port_of_handle(k, a[0], &st);
+    if (!port) {
+        return st;
+    }
+    const uint32_t out[3] = {a[1], a[2], a[3]};
+    return nc_ke_queue_remove_io(k, port, a[4], out);
+}
+
+/* ------------------------------------------------------------ directories
+ *
+ * Directory objects: the namespace's directories the kernel has (\, \??,
+ * \Device, \Device\Harddisk0, \Win32NamedObjects) and those a title creates.
+ * The body is OBJECT_DIRECTORY's hash buckets (unused here), then the
+ * directory's full name. Their entries come from the kernel's tables: the
+ * symbolic links, the devices. From portare-ch's hakuX-lr (ac3ab2361b,
+ * GPL-2.0-or-later); a directory opened by its root handle alone (no name:
+ * Cxbx-Reloaded's kernel test suite opens \?? so) is that directory. */
+#define DIR_BUCKETS 0x2Cu
+#define DIR_NAME_MAX 0x80u
+#define OB_WIN32_NAMED 0xFFFFFFFCu
+#define STATUS_NO_MORE_ENTRIES 0x8000001Au
+
+static const char *const k_dirs[] = {"\\", "\\??", "\\Device", "\\Device\\Harddisk0", "\\Win32NamedObjects"};
+
+static const char *dir_name(NcKernel *k, uint32_t dir)
+{
+    return (const char *)nc_vm_host(k->vm, dir + DIR_BUCKETS);
+}
+
+/* The directory object with a handle open and full name path, or 0. */
+static uint32_t dir_find(NcKernel *k, const char *path)
+{
+    for (unsigned i = 1; i < NC_MAX_HANDLES; i++) {
+        const NcHandle *h = &k->handle_table[i];
+        if (h->object && h->type == NC_OB_DIRECTORY && !strcasecmp(dir_name(k, h->object), path)) {
+            return h->object;
+        }
+    }
+    return 0;
+}
+
+static bool dir_builtin(const char *path)
+{
+    for (size_t i = 0; i < sizeof(k_dirs) / sizeof(k_dirs[0]); i++) {
+        if (!strcasecmp(k_dirs[i], path)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/* OBJECT_ATTRIBUTES' full name: RootDirectory a directory handle or \?? /
+ * \Win32NamedObjects, else the name itself (absolute). False: invalid. */
+static bool ob_full_name(NcKernel *k, uint32_t attrs, char *out, size_t cap)
+{
+    if (!attrs) {
+        return false;
+    }
+    char name[256];
+    ansi(k, nc_vm_rd32(k->vm, attrs + 4), name, sizeof(name));
+    const uint32_t root = nc_vm_rd32(k->vm, attrs);
+    enum NcObType type = NC_OB_TYPES;
+    const uint32_t dir = root && root != OB_DOS_DEVICES && root != OB_WIN32_NAMED ? nc_ob_lookup(k, root, &type) : 0;
+    if (!root) {
+        snprintf(out, cap, "%s", name);
+        return name[0] == '\\';
+    }
+    if (name[0] == '\\') {
+        return false;
+    }
+    const char *base = root == OB_DOS_DEVICES ? "\\??" : root == OB_WIN32_NAMED ? "\\Win32NamedObjects"
+                     : dir && type == NC_OB_DIRECTORY ? dir_name(k, dir) : NULL;
+    if (!base) {
+        return false;
+    }
+    if (!name[0]) {
+        snprintf(out, cap, "%s", base);
+    } else {
+        snprintf(out, cap, "%s%s%s", base, strcmp(base, "\\") ? "\\" : "", name);
+    }
+    return true;
+}
+
+static uint32_t dir_open(NcKernel *k, const char *path, uint32_t handle_out, bool create)
+{
+    uint32_t dir = dir_find(k, path);
+    if (!dir && !create && !dir_builtin(path)) {
+        return STATUS_OBJECT_NAME_NOT_FOUND;
+    }
+    if (dir && create) {
+        return STATUS_OBJECT_NAME_COLLISION;
+    }
+    if (!dir) {
+        if (strlen(path) >= DIR_NAME_MAX) {
+            return STATUS_OBJECT_NAME_INVALID;
+        }
+        dir = nc_ob_create(k, NC_OB_DIRECTORY, DIR_BUCKETS + DIR_NAME_MAX);
+        if (!dir) {
+            return NC_STATUS_INSUFFICIENT_RESOURCES;
+        }
+        snprintf((char *)nc_vm_host(k->vm, dir + DIR_BUCKETS), DIR_NAME_MAX, "%s", path);
+    }
+    const uint32_t h = nc_ob_handle(k, dir, NC_OB_DIRECTORY);
+    if (!h) {
+        return NC_STATUS_INSUFFICIENT_RESOURCES;
+    }
+    nc_vm_wr32(k->vm, handle_out, h);
+    return NC_STATUS_SUCCESS;
+}
+
+/* NtCreateDirectoryObject(DirectoryHandle, ObjectAttributes) */
+static uint64_t NtCreateDirectoryObject(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    char path[256];
+    if (!ob_full_name(k, a[1], path, sizeof(path))) {
+        return STATUS_OBJECT_NAME_INVALID;
+    }
+    if (dir_builtin(path)) {
+        return STATUS_OBJECT_NAME_COLLISION;
+    }
+    return dir_open(k, path, a[0], true);
+}
+
+/* NtOpenDirectoryObject(DirectoryHandle, ObjectAttributes) */
+static uint64_t NtOpenDirectoryObject(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    char path[256];
+    if (!ob_full_name(k, a[1], path, sizeof(path))) {
+        return STATUS_OBJECT_NAME_INVALID;
+    }
+    return dir_open(k, path, a[0], false);
+}
+
+/* Entry i of directory path: its name and its type's pool tag; false past the last. */
+static bool dir_entry(NcKernel *k, const char *path, unsigned i, char *name, size_t cap, uint32_t *tag)
+{
+    static const uint32_t DIRE = 0x65726944u, SYMB = 0x626D7953u, DEVI = 0x69766544u; /* "Dire" "Symb" "Devi" */
+    unsigned n = 0;
+    const size_t plen = strlen(path);
+    if (!strcmp(path, "\\")) {
+        static const char *const top[] = {"??", "Device", "Win32NamedObjects"};
+        if (i < 3) {
+            snprintf(name, cap, "%s", top[i]);
+            *tag = DIRE;
+            return true;
+        }
+        n = 3;
+    } else if (!strcasecmp(path, "\\??")) {
+        for (int l = 0; l < MAX_LINKS; l++) {
+            if (g_links[l].name[0] && prefix_ci(g_links[l].name, "\\??\\") && n++ == i) {
+                snprintf(name, cap, "%s", g_links[l].name + 4);
+                *tag = SYMB;
+                return true;
+            }
+        }
+    } else if (!strcasecmp(path, "\\Device")) {
+        static const char *const own[] = {"CdRom0", "Harddisk0"};
+        if (i < 2) {
+            snprintf(name, cap, "%s", own[i]);
+            *tag = i ? DIRE : DEVI;
+            return true;
+        }
+        n = 2;
+        for (int d = 0; d < 32; d++) {
+            const char *dn = g_devices[d].name;
+            if (g_devices[d].object && prefix_ci(dn, "\\Device\\") && !strchr(dn + 8, '\\') &&
+                strcasecmp(dn + 8, "CdRom0") && n++ == i) {
+                snprintf(name, cap, "%s", dn + 8);
+                *tag = DEVI;
+                return true;
+            }
+        }
+    } else if (!strcasecmp(path, "\\Device\\Harddisk0")) {
+        if (i < 6) {
+            snprintf(name, cap, "Partition%u", i);
+            *tag = DEVI;
+            return true;
+        }
+        n = 6;
+    }
+    /* the directories created in it */
+    for (unsigned h = 1; h < NC_MAX_HANDLES; h++) {
+        const NcHandle *e = &k->handle_table[h];
+        if (!e->object || e->type != NC_OB_DIRECTORY) {
+            continue;
+        }
+        const char *dn = dir_name(k, e->object);
+        if (strlen(dn) <= plen + 1 || strncasecmp(dn, path, plen) || (plen > 1 && dn[plen] != '\\')) {
+            continue;
+        }
+        const char *rest = dn + plen + (plen > 1);
+        bool seen = false;
+        for (unsigned g = 1; g < h && !seen; g++) {
+            seen = k->handle_table[g].object == e->object;
+        }
+        if (!seen && !strchr(rest, '\\') && !dir_builtin(dn) && n++ == i) {
+            snprintf(name, cap, "%s", rest);
+            *tag = DIRE;
+            return true;
+        }
+    }
+    return false;
+}
+
+/* NtQueryDirectoryObject(DirectoryHandle, Buffer, Length, RestartScan, Context, ReturnLength):
+ * one entry a call, OBJECT_DIRECTORY_INFORMATION { Name (OBJECT_STRING), Type
+ * (its type's pool tag) } with the name after it; Context the next entry's index */
+static uint64_t NtQueryDirectoryObject(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    enum NcObType type;
+    const uint32_t dir = nc_ob_lookup(k, a[0], &type);
+    if (!dir) {
+        return NC_STATUS_INVALID_HANDLE;
+    }
+    if (type != NC_OB_DIRECTORY) {
+        return NC_STATUS_OBJECT_TYPE_MISMATCH;
+    }
+    if (!a[4]) {
+        return NC_STATUS_INVALID_PARAMETER;
+    }
+    const unsigned i = (a[3] & 0xFF) ? 0 : nc_vm_rd32(k->vm, a[4]);
+    char name[128];
+    uint32_t tag;
+    if (!dir_entry(k, dir_name(k, dir), i, name, sizeof(name), &tag)) {
+        return STATUS_NO_MORE_ENTRIES;
+    }
+    const uint32_t len = (uint32_t)strlen(name), need = 12 + len + 1;
+    if (a[5]) {
+        nc_vm_wr32(k->vm, a[5], need);
+    }
+    if (a[2] < need || !a[1]) {
+        return STATUS_BUFFER_TOO_SMALL;
+    }
+    uint8_t *o = nc_vm_host(k->vm, a[1]);
+    *(uint16_t *)o = (uint16_t)len;
+    *(uint16_t *)(o + 2) = (uint16_t)(len + 1);
+    nc_wr32(o + 4, a[1] + 12);
+    nc_wr32(o + 8, tag);
+    memcpy(o + 12, name, len + 1);
+    nc_vm_wr32(k->vm, a[4], i + 1);
+    return NC_STATUS_SUCCESS;
+}
+
+uint32_t nc_io_open_by_name(NcKernel *k, uint32_t oa, uint32_t type_va, uint32_t handle_out)
+{
+    if (!oa || nc_vm_rd32(k->vm, oa)) {
+        return STATUS_OBJECT_NAME_NOT_FOUND;    /* absolute names only */
+    }
+    char name[256], path[256];
+    ansi(k, nc_vm_rd32(k->vm, oa + 4), name, sizeof(name));
+    if ((!type_va || type_va == k->type_va[NC_OB_DIRECTORY]) && (dir_builtin(name) || dir_find(k, name))) {
+        return dir_open(k, name, handle_out, false);
+    }
+    if ((!type_va || type_va == k->type_va[NC_OB_DEVICE]) && canon(name, path, sizeof(path))) {
+        const uint32_t d = device_named(path);
+        if (d) {
+            const uint32_t h = nc_ob_handle(k, d, NC_OB_DEVICE);
+            if (!h) {
+                return NC_STATUS_INSUFFICIENT_RESOURCES;
+            }
+            nc_vm_wr32(k->vm, handle_out, h);
