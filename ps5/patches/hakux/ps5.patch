+
+/* ObInsertObject(Object, ObjectAttributes, ObjectPointerBias, Handle): a handle to it,
+ * ObjectPointerBias more references */
+static uint64_t ObInsertObject(NcKernel *k, NcFrame *f, const uint32_t *a)
