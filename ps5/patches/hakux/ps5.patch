+/* A linear target's rows, no more than the title's block of memory holds: a
+ * write-back (front_stale, writeback) covers pitch x rows. NBA Inside Drive
+ * 2003 binds its 640 x 480 front buffer (a 600 KiB block) while the display
+ * is still its first target's, the 640 x 960 antialiased back buffer; sized
+ * as the display, the front buffer's write-back overwrote the 600 KiB above
+ * it, where a page of the title's code had been moved, and the title ran
+ * into zeros after its intro. A target carries on through the adjacent blocks
+ * its caller holds (hle_host_contig_end: Thrillville's and Wallace & Gromit's
+ * 640 x 480 frame buffers over 1 MiB blocks, the frame's bottom black without).
+ * carry false: the first block only (not used now: a depth target kept to its
+ * first block left everything below it undrawn, the frame's bottom half
+ * black; zread leaves a carried-on depth target alone instead). */
+static uint32_t rows_in_block(uint32_t pa, uint32_t pitch, uint32_t h, bool carry)
+{
+    const uint32_t limit = carry ? (uint32_t)MIN((uint64_t)pa + (uint64_t)pitch * h, UINT32_MAX) : 0;
+    const uint32_t end = pitch ? hle_host_contig_end(pa, limit) : 0;
+    if (pitch && end) {     /* (diagnostics: a target the adjacent blocks carried on) */
+        const uint32_t end1 = hle_host_contig_end(pa, 0);
+        static unsigned s_ext;
+        if (end != end1 && s_ext++ < 16) {
+            hle_log("hakuX-hle-pb", "target %08x: %u rows of %u bytes, its block ends %08x, carried on to %08x "
+                    "(first 16)", pa, h, pitch, end1, end);
+        }
+    }
+    if (!end || (uint64_t)pitch * h <= end - pa) {
+        return h;
+    }
+    const uint32_t rows = (end - pa) / pitch;
+    static unsigned s_logged;
+    if (s_logged < 8) {
+        s_logged++;
+        hle_log("hakuX-hle-pb", "target %08x: %u rows of %u bytes, %u in its block (first 8 logged)", pa,
+                h, pitch, rows);
+    }
+    return MAX(rows, 1u);
+}
