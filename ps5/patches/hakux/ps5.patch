diff --git a/hw/xbox/hle/core/probe.h b/hw/xbox/hle/core/probe.h
index ee34394dc9b69142d58d1b5ebd92f61aedb365f8..f288eaa3ad1606aa1d8df3c078457a2b5165c89c 100644
--- a/hw/xbox/hle/core/probe.h
+++ b/hw/xbox/hle/core/probe.h
@@ -1,11 +1,13 @@
 /*
  * hakuX HLE — debug probes on title code.
  *
- * HAKUX_HLE_PROBE="va[:n],va[:n]..." (hex VAs, at most 8; n default 16):
+ * HAKUX_HLE_PROBE="va[:n],va[:n]..." (hex VAs, at most 16; n default 16):
  * each time execution reaches va, the registers and the top eight stack
  * words are logged (hakuX-hle-probe) for the first n times and every
  * 1000th after, and the title's code runs on (set it through
- * debug.hakux.env).
+ * debug.hakux.env). FEX hooks the address when it translates the block;
+ * the native CPU puts a jump to a stub there (native/kernel/mmiosite.c).
+ * HAKUX_HLE_PROBE_TITLE=<title ID> (hex) places them in that title only.
  */
 #ifndef HW_XBOX_HLE_CORE_PROBE_H
 #define HW_XBOX_HLE_CORE_PROBE_H
@@ -17,6 +19,8 @@ struct HleCpu;
 
 /* The probes the environment asks for (title start): how many. */
 unsigned hle_probe_register(void);
+/* The probes' VAs (at most max): how many. */
+unsigned hle_probe_list(uint32_t *va, unsigned max);
 /* Whether a probe is at va (the host hooks it). */
 bool hle_probe_at(uint32_t va);
 /* Execution reached a probe: the registers at it (eip the probe's VA). */
