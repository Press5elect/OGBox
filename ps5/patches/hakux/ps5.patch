+                         "-1.0), m); }") != NULL);
+    HT_CHECK(strstr(buf, "* tsh(t0, bvec4(false, true, true, true)).bg;") != NULL);
+    HT_CHECK(strstr(buf, "sgn8(t0.bg)") == NULL);
