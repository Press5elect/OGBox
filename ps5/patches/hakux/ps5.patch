+/* OGBox 0.0.4: full DSP (NC_APU_DSP=1) runs the GP's and EP's programs whole each frame, in the
+ * DSP JIT, or its interpreter where there is none. On the PS5 neither keeps real time in every
+ * game: the interpreter took ~2000 us of a frame's 666, the JIT ~1150 us (test9, four games). The
+ * sound then plays slow, and so do the movies timed by it. Measured every sixth of a second (250
+ * frames), the first half second left out (the JIT compiling the programs): three slow windows in a
+ * row (more than 1.25 times real time) and the rest of the run mixes as Fast does, about a second
+ * in (it was three seconds, the length of a first movie's start). The log says which engine and
+ * how the time divides between the GP and the EP. NC_APU_DSP_TIMING=1: every window logged. */
+extern int64_t g_apu_dsp_us[2];     /* dsp/gp_ep.c */
+
+static void dsp_speed_watch(MCPXAPUState *d, int64_t work_us)
+{
+    static int64_t s_work_us, s_frames, s_seen, s_dsp0[2];
+    static int s_slow_windows;
+    static bool s_fell_back;
+    static int s_timing = -1;
+    if (s_timing < 0) {
+        s_timing = getenv("NC_APU_DSP_TIMING") != NULL;
+    }
+    if (!g_apu_config.use_dsp || s_fell_back) {
+        s_work_us = s_frames = 0;
+        s_slow_windows = 0;
+        return;
+    }
+    if (++s_seen <= 750) {                /* the first half second: compiling */
+        s_dsp0[0] = g_apu_dsp_us[0];
+        s_dsp0[1] = g_apu_dsp_us[1];
+        return;
+    }
+    s_work_us += work_us;
+    if (++s_frames < 250) {
+        return;
+    }
+    const double per_frame = (double)s_work_us / (double)s_frames;
+    const double gp = (double)(g_apu_dsp_us[0] - s_dsp0[0]) / (double)s_frames;
+    const double ep = (double)(g_apu_dsp_us[1] - s_dsp0[1]) / (double)s_frames;
+    s_dsp0[0] = g_apu_dsp_us[0];
+    s_dsp0[1] = g_apu_dsp_us[1];
+    if (s_timing) {
+        nc_log("hakuX-apu", "full DSP: %.0f us a GP frame (of %d): GP %.0f, EP %.0f", per_frame, GP_FRAME_US, gp, ep);
+    }
+    s_slow_windows = per_frame > 1.25 * GP_FRAME_US ? s_slow_windows + 1 : 0;
+    static int s_keep = -1;
+    if (s_keep < 0) {
+        s_keep = getenv("NC_APU_DSP_KEEP") != NULL;   /* full DSP however slow (the EP profile's runs) */
+    }
+    if (s_slow_windows >= 3 && !s_keep) {
+        s_fell_back = true;
+        g_apu_config.use_dsp = false;
+        mcpx_apu_update_dsp_preference(d);
+        nc_log("hakuX-apu", "full DSP: a frame takes %.0f us of its %d (%.0f%% of real time; GP %.0f us, EP %.0f, the "
+               "rest the voices) in the DSP %s: the rest of this run mixes as Fast does (Settings > Audio)",
+               per_frame, GP_FRAME_US, 100.0 * GP_FRAME_US / per_frame, gp, ep, dsp_engine_name(d->gp.dsp));
+    }
+    s_work_us = s_frames = 0;
+}
