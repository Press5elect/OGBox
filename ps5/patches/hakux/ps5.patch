+    bool ok;
+    uint32_t pgen, start;
+    Nv2aVshProgram prog;
+    bool writes, rel;                   /* writes oFog; reads constants by A0 */
+    unsigned comp;                      /* the component its last oFog write lands in x from
+                                           (shader/vsh.c out_write: the top masked one) */
+    uint8_t cmask[HLE_VSH_CONSTANTS / 8];   /* the constants it reads */
