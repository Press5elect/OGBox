diff --git a/native/kernel/mmiosite.c b/native/kernel/mmiosite.c
new file mode 100644
index 0000000000000000000000000000000000000000..37a07b50fe1c3678668168aef0277aee32da43c0
--- /dev/null
+++ b/native/kernel/mmiosite.c
@@ -0,0 +1,906 @@
+/*
+ * hakuX native core — device register accesses through the gate (the
+ * native CPU).
+ *
+ * Copyright (C) 2026 Press5elect
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * Additional terms (GPL-3.0 section 7(b)): keep the attribution "OGBox by
+ * Press5elect" (github.com/Press5elect/OGBox, NOTICE).
+ *
+ * With FEX (Android), a guest instruction that touches a device is hooked
+ * once it has faulted (x86mmio.c): its block is translated again with a
+ * call to the kernel before it, and every later access is a function call.
+ * The native CPU runs the title's code as it is, so each of those accesses
+ * was a host fault: a signal, its delivery through libkernel's wrapper (two
+ * more system calls) and a sigreturn. Games make thousands a second (the
+ * PS5 logs of OGBox 0.1.36: Burnout 3 37 000, GTA San Andreas 14 500, NFS
+ * Most Wanted 12 000, Mortal Kombat Shaolin Monks 9 000), and every freeze
+ * of a second those logs show stopped inside that signal path.
+ *
+ * Here an instruction that faulted on a device NC_MMIO_GATE_HITS times
+ * becomes a jump to a stub in the kernel area that enters the kernel through
+ * the gate (a far call, no signal):
+ *
+ *   +0   call far gate           (9A, 7 bytes)
+ *   +7   int 3Fh, ordinal         (the kernel reads NC_KORDINAL_MMIO_SITE here)
+ *   +11  the instruction's length, +12 the bytes moved after it
+ *   +16  its address, +20 its bytes (up to 15), +40 the moved bytes as
+ *        they were
+ *   +64  the instructions moved out of the jump's way (short ones; a
+ *        relative jump or branch with its target kept, a ret as it is),
+ *        then jmp back
+ *
+ * The kernel emulates the instruction against the device with the guest's
+ * registers (x86emu.c, the same emulation the fault took) and the guest goes
+ * on after it, the interrupts it raised taken at the gate's way out. An
+ * instruction of 5 bytes or more takes the jump in its own bytes. A shorter
+ * one moves the instructions after it into the stub (up to a ret or a jump,
+ * or until there are five bytes), only where none of them calls, traps or
+ * is patched, no direct branch or address within 128 KiB
+ * points between them, and no guest thread is stopped there. An access that
+ * turns out to be ordinary memory puts the bytes back (three times: left as
+ * it is). NC_MMIO_GATE=0 turns it off, NC_MMIO_GATE_SHORT=0 the moves. The
+ * stubs describe themselves, so a savestate's patched code finds them.
+ */
+#include "native/kernel/kernel.h"
+
+#if defined(NC_CPU_NATIVE)
+#include "native/core/mmio.h"
+#include "native/cpu/cpu_native.h"
+#include "native/cpu/x86dec.h"
+#include "native/cpu/x86emu.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define STUB_SIZE   160u
+#define S_LEN       11u
+#define S_MOVED     12u
+#define S_EIP       16u
+#define S_ORIG      20u     /* the instruction's bytes (15 at most) */
+#define S_MOVED_AT  40u     /* the moved instructions' bytes as they were (MOVED_MAX) */
+#define S_BODY      64u     /* the moved instructions as they run here, then the jump back */
+#define MOVED_MAX   16u
+
+#define SITES       4096u
+#define STRIKES     3u
+
+enum { SITE_COUNTING = 0, SITE_PATCHED, SITE_REFUSED };
+
+enum { KIND_MMIO = 0, KIND_RDTSC };
+
+typedef struct Site {
+    uint32_t eip;
+    uint32_t stub;
+    uint16_t hits;
+    uint8_t state;
+    uint8_t strikes;
+} Site;
+
+static NcKernel *g_k;
+static unsigned g_tsc_sites;
+
+static Site g_sites[SITES];
+static uint32_t g_lo, g_hi, g_next;
+static int g_on = -1, g_short = -1;
+static unsigned g_hits_needed = 16, g_hits_short = 64;
+static uint64_t g_runs, g_runs_logged, g_last_log_ns;
+static unsigned g_patched, g_moved, g_put_back, g_logged;
+
+static unsigned refused_count(void)
+{
+    unsigned n = 0;
+    for (unsigned i = 0; i < SITES; i++) {
+        n += g_sites[i].state == SITE_REFUSED;
+    }
+    return n;
+}
+
+static bool env_flag(const char *name, bool dflt)
+{
+    const char *e = getenv(name);
+    return e && e[0] ? e[0] != '0' : dflt;
+}
+
+void nc_mmio_site_init(NcKernel *k, uint32_t area_va, uint32_t area_len)
+{
+    g_k = k;
+    g_lo = g_next = area_va;
+    g_hi = area_va + area_len;
+    g_on = env_flag("NC_MMIO_GATE", true);
+    g_short = env_flag("NC_MMIO_GATE_SHORT", true);
+    const char *h = getenv("NC_MMIO_GATE_HITS");
+    if (h && atoi(h) > 0) {
+        g_hits_needed = (unsigned)atoi(h);
+        g_hits_short = g_hits_needed * 4;
+    }
+    memset(g_sites, 0, sizeof(g_sites));
+    nc_log("hakuX-native", "mmio: device accesses through the gate %s (after %u faults at an instruction; "
+           "short ones moving the next %s), stubs at %08x-%08x", g_on ? "on" : "off (NC_MMIO_GATE=0)",
+           g_hits_needed, g_short ? "instructions" : "instructions: off (NC_MMIO_GATE_SHORT=0)", g_lo, g_hi);
+}
+
+static Site *site_of(uint32_t eip, bool add)
+{
+    unsigned h = (eip * 2654435761u) % SITES;
+    for (unsigned n = 0; n < SITES; n++, h = (h + 1) % SITES) {
+        if (g_sites[h].eip == eip) {
+            return &g_sites[h];
+        }
+        if (!g_sites[h].eip) {
+            if (!add) {
+                return NULL;
+            }
+            g_sites[h].eip = eip;
+            return &g_sites[h];
+        }
+    }
+    return NULL;
+}
+
+/* Guest code and the kernel area, read and written through the host's view
+ * of RAM (a page may be write-protected by write tracking). */
+static uint8_t *ram_byte(NcVm *vm, uint32_t va)
+{
+    const uint32_t pa = nc_vm_phys(vm, va);
+    return pa == UINT32_MAX || pa >= vm->ram_size ? NULL : vm->phys + pa;
+}
+
+static bool ram_write(NcVm *vm, uint32_t va, const uint8_t *b, unsigned n)
+{
+    for (unsigned i = 0; i < n; i++) {
+        if (!ram_byte(vm, va + i)) {
+            return false;
+        }
+    }
+    for (unsigned i = 0; i < n; i++) {
+        *ram_byte(vm, va + i) = b[i];
+    }
+    return true;
+}
+
+static bool ram_read(NcVm *vm, uint32_t va, uint8_t *b, unsigned n)
+{
+    for (unsigned i = 0; i < n; i++) {
+        const uint8_t *p = ram_byte(vm, va + i);
+        if (!p) {
+            return false;
+        }
+        b[i] = *p;
+    }
+    return true;
+}
+
+/* may this instruction run from the stub instead of its own address */
+static bool movable(const NcX86Insn *in)
+{
+    if (in->flow != NC_FLOW_NONE || in->seg || in->addr16 || in->lock) {
+        return false;
+    }
+    switch (in->op) {
+    case 0x9C: case 0x9D:                       /* pushfd/popfd (trapped by address) */
+    case 0x0F31: case 0x0FA2: case 0x0F0B:      /* rdtsc, cpuid, ud2 */
+    case 0x0F01: case 0x0F00:                   /* descriptor tables */
+    case 0xFA: case 0xFB: case 0xF4:            /* cli, sti, hlt */
+    case 0xE4: case 0xE5: case 0xE6: case 0xE7: /* in/out */
+    case 0xEC: case 0xED: case 0xEE: case 0xEF:
+    case 0x6C: case 0x6D: case 0x6E: case 0x6F: /* ins/outs */
+    case 0x90: case 0xCC:                       /* padding */
+        return false;
+    default:
+        return true;
+    }
+}
+
+/* The relative branches of the code around [lo, hi) decoded from a start
+ * that falls in step with the instructions at lo (x86 decoding comes into
+ * step within a few instructions): whether one points into (lo, hi). -1
+ * when no start before lo lands on it (then the byte patterns decide). */
+#define NEAR 512u
+static int near_branches_into(NcVm *vm, uint32_t lo, uint32_t hi)
+{
+    const uint8_t *m = nc_vm_host(vm, 0);
+    for (uint32_t back = NEAR; back > NEAR - 32; back--) {
+        uint32_t p = lo - back;
+        bool hit = false;
+        while (p < lo) {
+            NcX86Insn in;
+            const unsigned len = nc_x86_decode(m + p, 15, p, &in);
+            if (!len) {
+                break;
+            }
+            if ((in.flow == NC_FLOW_JCC || in.flow == NC_FLOW_JMP || in.flow == NC_FLOW_CALL) && in.target > lo &&
+                in.target < hi) {
+                hit = true;
+            }
+            p += len;
+        }
+        if (p != lo) {
+            continue;               /* not in step: another start */
+        }
+        /* in step: the window's own and those after it */
+        for (p = lo; p < hi + NEAR;) {
+            NcX86Insn in;
+            const unsigned len = nc_x86_decode(m + p, 15, p, &in);
+            if (!len) {
+                break;              /* data after the code: what is after it isn't code we know */
+            }
+            if ((in.flow == NC_FLOW_JCC || in.flow == NC_FLOW_JMP || in.flow == NC_FLOW_CALL) && in.target > lo &&
+                in.target < hi) {
+                hit = true;
+            }
+            p += len;
+        }
+        return hit ? 1 : 0;
+    }
+    return -1;
+}
+
+/* OGBox 0.0.3: a stub's moved branch pointing into (lo, hi). A short site moves the instructions
+ * after it into its stub, a jump among them with its target kept: from then on that jump is in
+ * the stub, not near its target, and only the stubs show it. One game crashed so: "mov esi,[esi+8];
+ * jmp +3" moved for one site (the jump's target kept: the test after the next mov), then that next
+ * mov a site of its own, moving the test: the first stub jumped into the second site's jump, and
+ * ran the middle of it. */
+static bool stubs_branch_into(NcVm *vm, uint32_t lo, uint32_t hi)
+{
+    for (uint32_t va = g_lo; va && va + STUB_SIZE <= g_hi; va += STUB_SIZE) {
+        uint8_t st[STUB_SIZE + 15];
+        if (!ram_read(vm, va, st, STUB_SIZE)) {
+            break;
+        }
+        if (st[0] != 0x9A && st[0] != 0xEB) {
+            if (va >= g_next) {
+                break;              /* past the stubs made (a savestate's are before g_next too) */
+            }
+            continue;
+        }
+        memset(st + STUB_SIZE, 0xCC, 15);
+        for (unsigned o = S_BODY; o < STUB_SIZE && st[o] != 0xCC;) {
+            NcX86Insn in;
+            const unsigned len = nc_x86_decode(st + o, 15, va + o, &in);
+            if (!len) {
+                break;
+            }
+            if ((in.flow == NC_FLOW_JCC || in.flow == NC_FLOW_JMP || in.flow == NC_FLOW_CALL) && in.target > lo &&
+                in.target < hi) {
+                return true;
+            }
+            o += len;
+        }
+    }
+    return false;
+}
+
+/* The other way round: a branch about to move whose target is inside another site's jump
+ * (between its first byte and the end of what it moved). */
+static bool inside_a_patch(NcVm *vm, uint32_t t)
+{
+    for (uint32_t va = g_lo; va && va + STUB_SIZE <= g_hi; va += STUB_SIZE) {
+        uint8_t st[STUB_SIZE];
+        if (!ram_read(vm, va, st, STUB_SIZE)) {
+            break;
+        }
+        if (st[0] != 0x9A && st[0] != 0xEB) {
+            if (va >= g_next) {
+                break;
+            }
+            continue;
+        }
+        const uint32_t eip = nc_rd32(st + S_EIP);
+        if (t > eip && t < eip + st[S_LEN] + st[S_MOVED]) {
+            uint8_t now[5];
+            if (ram_read(vm, eip, now, 5) && now[0] == 0xE9 && eip + 5 + nc_rd32(now + 1) == va) {
+                return true;        /* still patched */
+            }
+        }
+    }
+    return false;
+}
+
+static bool moves_into_a_patch(NcVm *vm, const uint32_t *body_rel, unsigned bl)
+{
+    for (unsigned i = 0; i < bl; i++) {
+        if (body_rel[i] && inside_a_patch(vm, body_rel[i])) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/* A direct branch or an address within 128 KiB pointing into (lo, hi): the
+ * bytes there can't move. Near the site (512 bytes each way) by the decoded
+ * instructions when the decode comes into step, else by byte patterns; past
+ * that, rel32 jumps, calls and branches and absolute addresses by byte
+ * patterns: a false one only keeps the instruction faulting. */
+static bool pointed_into(NcVm *vm, uint32_t lo, uint32_t hi)
+{
+    const uint32_t span = 0x20000u;
+    uint32_t a = lo > span ? (lo - span) & ~(NC_PAGE - 1) : 0;
+    uint32_t b = hi + span < hi ? 0xFFFFF000u : (hi + span + NC_PAGE - 1) & ~(NC_PAGE - 1);
+    /* the mapped run around the site */
+    for (uint32_t p = lo & ~(NC_PAGE - 1); p < b; p += NC_PAGE) {
+        if (nc_vm_phys(vm, p) == UINT32_MAX) {
+            b = p;
+            break;
+        }
+    }
+    for (uint32_t p = lo & ~(NC_PAGE - 1); p > a; p -= NC_PAGE) {
+        if (nc_vm_phys(vm, p - NC_PAGE) == UINT32_MAX) {
+            a = p;
+            break;
+        }
+    }
+    if (b - a < 8 || lo - a < NEAR + 16 || b - hi < NEAR + 32) {
+        return true;
+    }
+    if (stubs_branch_into(vm, lo, hi)) {
+        return true;
+    }
+    const int near = near_branches_into(vm, lo, hi);
+    if (near > 0) {
+        return true;
+    }
+    const uint32_t nlo = lo - NEAR, nhi = hi + NEAR;    /* decoded when near == 0 */
+    const uint8_t *m = nc_vm_host(vm, a);   /* guest VA order, contiguous in the window */
+    const uint32_t n = b - a;
+    for (uint32_t i = 0; i + 6 <= n; i++) {
+        const uint32_t at = a + i;
+        const uint8_t op = m[i];
+        const bool decoded = near == 0 && at >= nlo && at < nhi;
+        uint32_t t = 0;
+        bool br = false;
+        if (!decoded) {
+            if (op == 0xEB || (op >= 0x70 && op <= 0x7F) || (op >= 0xE0 && op <= 0xE3)) {
+                t = at + 2 + (uint32_t)(int32_t)(int8_t)m[i + 1];
+                br = true;
+            } else if (op == 0xE8 || op == 0xE9) {
+                t = at + 5 + nc_rd32(m + i + 1);
+                br = true;
+            } else if (op == 0x0F && m[i + 1] >= 0x80 && m[i + 1] <= 0x8F) {
+                t = at + 6 + nc_rd32(m + i + 2);
+                br = true;
+            }
+        }
+        if (br && t > lo && t < hi) {
+            return true;
+        }
+        const uint32_t v = nc_rd32(m + i);
+        if (v > lo && v < hi) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/* a guest thread stopped (or a callout's return) inside (lo, hi) */
+static bool thread_inside(NcKernel *k, uint32_t lo, uint32_t hi)
+{
+    for (unsigned i = 0; i < k->threads_hi && i < NC_MAX_THREADS; i++) {
+        const NcThread *t = &k->threads[i];
+        if (t->state == NC_T_FREE || t == k->current) {
+            continue;
+        }
+        const uint32_t e = nc_context_eip(&t->ctx);
+        if (e > lo && e < hi) {
+            return true;
+        }
+        for (unsigned c = 0; c < t->ncallouts && c < sizeof(t->callout_ret) / sizeof(t->callout_ret[0]); c++) {
+            if (t->callout_ret[c] > lo && t->callout_ret[c] < hi) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+static uint32_t stub_alloc(NcVm *vm)
+{
+    while (g_next + STUB_SIZE <= g_hi) {
+        const uint8_t *p = ram_byte(vm, g_next);
+        if (!p) {
+            return 0;
+        }
+        if (*p != 0x9A && *p != 0xEB) { /* not a stub's (one a savestate's code may still jump to) */
+            const uint32_t va = g_next;
+            g_next += STUB_SIZE;
+            return va;
+        }
+        g_next += STUB_SIZE;
+    }
+    return 0;
+}
+
+/* The patched site's bytes as they were (the instruction and those moved). */
+static bool put_back(NcKernel *k, Site *s, const char *why)
+{
+    uint8_t st[STUB_SIZE];
+    if (!s->stub || !ram_read(k->vm, s->stub, st, STUB_SIZE) || nc_rd32(st + S_EIP) != s->eip) {
+        return false;
+    }
+    const unsigned n = st[S_LEN], moved = st[S_MOVED];
+    uint8_t now[5];
+    if (!ram_read(k->vm, s->eip, now, 5) || now[0] != 0xE9 || s->eip + 5 + nc_rd32(now + 1) != s->stub) {
+        return false;           /* not ours any more (the code was loaded again) */
+    }
+    uint8_t orig[15 + MOVED_MAX];
+    memcpy(orig, st + S_ORIG, n);
+    memcpy(orig + n, st + S_MOVED_AT, moved);
+    if (!ram_write(k->vm, s->eip, orig, n + moved)) {
+        return false;
+    }
+    g_put_back++;
+    if (g_logged < 96) {
+        g_logged++;
+        nc_log("hakuX-native", "mmio: site %08x back to faulting (%s)", s->eip, why);
+    }
+    return true;
+}
+
+static void refuse(Site *s, const char *why, const uint8_t *code)
+{
+    s->state = SITE_REFUSED;
+    if (g_logged < 96) {
+        g_logged++;
+        nc_log("hakuX-native", "mmio: site %08x keeps faulting: %s (%02x %02x %02x %02x %02x %02x)", s->eip, why,
+               code[0], code[1], code[2], code[3], code[4], code[5]);
+    }
+}
+
+static void try_patch(NcKernel *k, Site *s, void *ucontext, int kind)
+{
+    NcVm *vm = k->vm;
+    const uint32_t eip = s->eip;
+    uint8_t code[15 + MOVED_MAX + 16];
+    if (!ram_read(vm, eip, code, 15)) {
+        s->state = SITE_REFUSED;
+        return;
+    }
+    unsigned n = 2;             /* rdtsc: the sweep's ud2 there */
+    if (kind == KIND_RDTSC) {
+        if (code[0] != 0x0F || code[1] != 0x0B) {
+            s->state = SITE_REFUSED;
+            return;
+        }
+    } else {
+        NcX86Insn in;
+        n = nc_x86_decode(code, 15, eip, &in);
+        NcFrame f0;
+        memset(&f0, 0, sizeof(f0));
+        NcX86Access acc;
+        if (!n || in.flow != NC_FLOW_NONE || in.seg || in.lock || in.rep || in.repne || in.addr16 ||
+            !nc_x86_access(&f0, code, 0, &acc) || acc.len != n || in.op == 0xFF || in.op == 0x8F) {
+            refuse(s, "a form the stub doesn't take (push/pop r/m, strings, segments, locks)", code);
+            return;
+        }
+    }
+    unsigned moved = 0, body_len = 0;
+    bool body_ends = false;
+    uint8_t body[STUB_SIZE - S_BODY];
+    uint32_t body_rel[STUB_SIZE - S_BODY];  /* at a branch's rel32: its target */
+    memset(body_rel, 0, sizeof(body_rel));
+    if (n < 5) {
+        if (!g_short || s->hits < g_hits_short) {
+            if (!g_short) {
+                s->state = SITE_REFUSED;
+            }
+            return;
+        }
+        uint32_t p = eip + n;
+        unsigned bl = 0;
+        bool ends = false;      /* a ret or a jump: nothing after it runs from here */
+        while (p - eip < 5 && !ends) {
+            uint8_t b[15];
+            NcX86Insn m;
+            unsigned len;
+            if (!ram_read(vm, p, b, 15) || !(len = nc_x86_decode(b, 15, p, &m)) ||
+                p + len - (eip + n) > MOVED_MAX || bl + 6 > sizeof(body) - 5) {
+                refuse(s, "short, and what follows it can't move", code);
+                return;
+            }
+            if (m.flow == NC_FLOW_JMP && !m.seg && !m.opsize16) {
+                body[bl] = 0xE9;            /* jmp target (rel32 from the stub) */
+                body_rel[bl + 1] = m.target;
+                bl += 5;
+                ends = true;
+            } else if (m.flow == NC_FLOW_JCC && ((m.op >= 0x70 && m.op <= 0x7F) || (m.op >= 0x0F80 && m.op <= 0x0F8F)) &&
+                       !m.opsize16) {
+                body[bl] = 0x0F;            /* jcc target (rel32) */
+                body[bl + 1] = (uint8_t)(0x80 | (m.op & 0x0F));
+                body_rel[bl + 2] = m.target;
+                bl += 6;
+            } else if (m.flow == NC_FLOW_RET && (b[0] == 0xC3 || b[0] == 0xC2)) {
+                memcpy(body + bl, b, len);
+                bl += len;
+                ends = true;
+            } else if (movable(&m)) {
+                memcpy(body + bl, b, len);
+                bl += len;
+            } else {
+                refuse(s, "short, and what follows it can't move (a call, a trap, a patched byte)", code);
+                return;
+            }
+            p += len;
+        }
+        if (p - eip < 5) {
+            refuse(s, "short, and too little before the ret or jump after it", code);
+            return;
+        }
+        body_len = bl;
+        body_ends = ends;
+        moved = p - (eip + n);
+        if (pointed_into(vm, eip, p)) {
+            refuse(s, "short, and a branch or an address points into what would move", code);
+            return;
+        }
+        if (moves_into_a_patch(vm, body_rel, bl)) {
+            refuse(s, "short, and a jump it would move goes into another site's jump", code);
+            return;
+        }
+        if (thread_inside(k, eip, p)) {
+            s->hits = 0;        /* a thread stopped in there: later */
+            return;
+        }
+        if (!ram_read(vm, eip, code, n + moved)) {
+            s->state = SITE_REFUSED;
+            return;
+        }
+    }
+    uint8_t st[STUB_SIZE];
+    memset(st, 0xCC, sizeof(st));
+    unsigned pre = 0;           /* the body's own first bytes: rdtsc's sequence */
+    if (kind == KIND_RDTSC) {
+        st[0] = 0xEB;           /* jmp short to the body */
+        st[1] = (uint8_t)(S_BODY - 2);
+        pre = ncn_tsc_emit(st + S_BODY);
+        if (!pre || S_BODY + pre + body_len + 5 > STUB_SIZE) {
+            s->state = SITE_REFUSED;
+            return;
+        }
+    } else if (!nc_kernel_gate_call(st)) {
+        s->state = SITE_REFUSED;    /* no gate (NC_NATIVE_GATE=0): an int 3Fh is a signal too */
+        return;
+    }
+    const uint32_t stub = stub_alloc(vm);
+    if (!stub) {
+        static bool said;
+        if (!said) {
+            said = true;
+            nc_log("hakuX-native", "mmio: the stub area is full (%u sites); the rest keep faulting", g_patched);
+        }
+        s->state = SITE_REFUSED;
+        return;
+    }
+    if (kind == KIND_MMIO) {
+        st[7] = 0xCD;
+        st[8] = NC_KCALL_VECTOR;
+        st[9] = (uint8_t)NC_KORDINAL_MMIO_SITE;
+        st[10] = (uint8_t)(NC_KORDINAL_MMIO_SITE >> 8);
+    }
+    st[S_LEN] = (uint8_t)n;
+    st[S_MOVED] = (uint8_t)moved;
+    st[13] = st[14] = st[15] = 0;
+    nc_wr32(st + S_EIP, eip);
+    memcpy(st + S_ORIG, code, n);
+    memcpy(st + S_MOVED_AT, code + n, moved);
+    const uint32_t at = S_BODY + pre;   /* the moved instructions */
+    for (unsigned i = 0; i < body_len; i++) {
+        st[at + i] = body[i];
+        if (body_rel[i]) {          /* a rel32 to its target, from where it now ends */
+            nc_wr32(st + at + i, body_rel[i] - (stub + at + i + 4));
+            i += 3;
+        }
+    }
+    if (!body_ends) {
+        const uint32_t back = eip + n + moved, from = stub + at + body_len;
+        st[at + body_len] = 0xE9;
+        nc_wr32(st + at + body_len + 1, back - (from + 5));
+    }
+    if (!ram_write(vm, stub, st, STUB_SIZE)) {
+        s->state = SITE_REFUSED;
+        return;
+    }
+    uint8_t site[15 + MOVED_MAX];
+    memset(site, 0xCC, sizeof(site));
+    site[0] = 0xE9;
+    nc_wr32(site + 1, stub - (eip + 5));
+    if (!ram_write(vm, eip, site, n + moved)) {
+        s->state = SITE_REFUSED;
+        return;
+    }
+    s->stub = stub;
+    s->state = SITE_PATCHED;
+    if (kind == KIND_RDTSC) {
+        g_tsc_sites++;
+    } else {
+        g_patched++;
+        g_moved += moved != 0;
+    }
+    if (moved) {
+        /* the trap's emulation left the guest after the instruction, now
+         * inside the jump: it goes on from the moved instructions' copies */
+        NcFrame f;
+        ncn_frame_from_uc(&f, ucontext, false);
+        if ((uint32_t)f.rip == eip + n) {
+            f.rip = stub + at;
+            ncn_frame_to_uc(&f, ucontext, false);
+        }
+    }
+    if (g_logged < 96) {
+        g_logged++;
+        char hex[3 * (15 + MOVED_MAX) + 1];
+        unsigned h = 0;
+        for (unsigned i = 0; i < n + moved; i++) {
+            h += (unsigned)snprintf(hex + h, sizeof(hex) - h, "%02x ", code[i]);
+        }
+        nc_log("hakuX-native", "mmio: site %08x (%u bytes, %u moved) %s, stub %08x: %s", eip, n, moved,
+               kind == KIND_RDTSC ? "rdtsc, natively" : "through the gate", stub, hex);
+    }
+}
+
+void nc_mmio_site_fault(NcKernel *k, uint32_t eip, void *ucontext)
+{
+    if (g_on <= 0 || !k || !eip || eip >= 0x80000000u || !g_lo) {
+        return;
+    }
+    Site *s = site_of(eip, true);
+    if (!s || s->state == SITE_REFUSED) {
+        return;
+    }
+    if (s->state == SITE_PATCHED) {
+        s->state = SITE_COUNTING;   /* it faulted, so the jump is gone: the code was loaded again */
+        s->hits = 0;
+        s->stub = 0;
+    }
+    if (s->hits < 0xFFFF) {
+        s->hits++;
+    }
+    if (s->hits >= g_hits_needed) {
+        try_patch(k, s, ucontext, KIND_MMIO);
+    }
+}
+
+void nc_mmio_site_rdtsc(uint32_t eip, void *ucontext)
+{
+    if (g_on <= 0 || !g_k || !eip || eip >= 0x80000000u || !g_lo) {
+        return;
+    }
+    Site *s = site_of(eip, true);
+    if (!s || s->state == SITE_REFUSED) {
+        return;
+    }
+    if (s->state == SITE_PATCHED) {
+        s->state = SITE_COUNTING;   /* trapped again: the code was loaded again */
+        s->hits = 0;
+        s->stub = 0;
+    }
+    if (s->hits < 0xFFFF) {
+        s->hits++;
+    }
+    if (s->hits >= g_hits_needed) {
+        try_patch(g_k, s, ucontext, KIND_RDTSC);
+    }
+}
+
+/* ---- probes on the title's code (HAKUX_HLE_PROBE, hw/xbox/hle/core/probe.h) ----
+ *
+ * FEX hooks a probe's address when it translates the block; the native CPU
+ * runs the title's code as it is, so a probe is a jump in the code to a stub
+ * laid out as a device access's: the stub enters the kernel through the gate
+ * (NC_KORDINAL_PROBE), the kernel logs the registers (k->hle_hook, as FEX's
+ * hook does), and the instructions the jump covers run from the stub (a
+ * relative jump or branch with its target kept, a relative call as a push of
+ * its return address and a jump), then a jump back. Placed when the title
+ * starts, before its code runs; a probe whose instructions can't move (a
+ * branch or an address into them, a trap, a far or indirect jump) is refused
+ * and logged. */
+bool nc_probe_place(NcKernel *k, uint32_t eip)
+{
+    NcVm *vm = k->vm;
+    const char *why = NULL;
+    uint8_t first[15];
+    uint8_t body[STUB_SIZE - S_BODY];
+    uint32_t body_rel[STUB_SIZE - S_BODY];  /* at a branch's rel32: its target */
+    memset(body_rel, 0, sizeof(body_rel));
+    unsigned n = 0, bl = 0;
+    uint32_t p = eip;
+    bool ends = false;
+    if (g_on < 0 || !g_lo || !eip || eip >= 0x80000000u || !ram_read(vm, eip, first, 15)) {
+        why = "not in the title's memory";
+        goto refused;
+    }
+    while (p - eip < 5 && !ends) {
+        uint8_t b[15];
+        NcX86Insn m;
+        unsigned len;
+        if (!ram_read(vm, p, b, 15) || !(len = nc_x86_decode(b, 15, p, &m))) {
+            why = "an instruction that doesn't decode";
+            goto refused;
+        }
+        if ((p == eip ? len > 15 : p + len - (eip + n) > MOVED_MAX) || bl + 12 > sizeof(body) - 5) {
+            why = "too long to move";
+            goto refused;
+        }
+        if (m.flow == NC_FLOW_JMP && !m.seg && !m.opsize16) {
+            body[bl] = 0xE9;                /* jmp target (rel32 from the stub) */
+            body_rel[bl + 1] = m.target;
+            bl += 5;
+            ends = true;
+        } else if (m.flow == NC_FLOW_JCC && ((m.op >= 0x70 && m.op <= 0x7F) || (m.op >= 0x0F80 && m.op <= 0x0F8F)) &&
+                   !m.opsize16) {
+            body[bl] = 0x0F;                /* jcc target (rel32) */
+            body[bl + 1] = (uint8_t)(0x80 | (m.op & 0x0F));
+            body_rel[bl + 2] = m.target;
+            bl += 6;
+        } else if (m.flow == NC_FLOW_CALL && b[0] == 0xE8) {
+            body[bl] = 0x68;                /* push the return address as it was */
+            nc_wr32(body + bl + 1, p + len);
+            body[bl + 5] = 0xE9;            /* jmp target */
+            body_rel[bl + 6] = m.target;
+            bl += 10;
+            ends = true;
+        } else if (m.flow == NC_FLOW_RET && (b[0] == 0xC3 || b[0] == 0xC2)) {
+            memcpy(body + bl, b, len);
+            bl += len;
+            ends = true;
+        } else if (movable(&m)) {
+            memcpy(body + bl, b, len);
+            bl += len;
+        } else {
+            why = "an instruction that can't move (a trap, a far or indirect jump, a segment)";
+            goto refused;
+        }
+        if (p == eip) {
+            n = len;
+        }
+        p += len;
+    }
+    if (p - eip < 5) {
+        why = "too little before the ret or jump after it";
+        goto refused;
+    }
+    if (pointed_into(vm, eip, p)) {
+        why = "a branch or an address points into what would move";
+        goto refused;
+    }
+    if (moves_into_a_patch(vm, body_rel, bl)) {
+        why = "a jump it would move goes into another site's jump";
+        goto refused;
+    }
+    if (thread_inside(k, eip, p)) {
+        why = "a guest thread is stopped there";
+        goto refused;
+    }
+    uint8_t code[15 + MOVED_MAX];
+    const unsigned moved = p - (eip + n);
+    uint8_t st[STUB_SIZE];
+    memset(st, 0xCC, sizeof(st));
+    if (!ram_read(vm, eip, code, n + moved) || !nc_kernel_gate_call(st)) {
+        why = "no gate (NC_NATIVE_GATE=0)";
+        goto refused;
+    }
+    const uint32_t stub = stub_alloc(vm);
+    if (!stub) {
+        why = "the stub area is full";
+        goto refused;
+    }
+    st[7] = 0xCD;
+    st[8] = NC_KCALL_VECTOR;
+    st[9] = (uint8_t)NC_KORDINAL_PROBE;
+    st[10] = (uint8_t)(NC_KORDINAL_PROBE >> 8);
+    st[S_LEN] = (uint8_t)n;
+    st[S_MOVED] = (uint8_t)moved;
+    st[13] = st[14] = st[15] = 0;
+    nc_wr32(st + S_EIP, eip);
+    memcpy(st + S_ORIG, code, n);
+    memcpy(st + S_MOVED_AT, code + n, moved);
+    for (unsigned i = 0; i < bl; i++) {
+        st[S_BODY + i] = body[i];
+        if (body_rel[i]) {                  /* a rel32 to its target, from where it now ends */
+            nc_wr32(st + S_BODY + i, body_rel[i] - (stub + S_BODY + i + 4));
+            i += 3;
+        }
+    }
+    if (!ends) {
+        const uint32_t from = stub + S_BODY + bl;
+        st[S_BODY + bl] = 0xE9;
+        nc_wr32(st + S_BODY + bl + 1, p - (from + 5));
+    }
+    uint8_t site[15 + MOVED_MAX];
+    memset(site, 0xCC, sizeof(site));
+    site[0] = 0xE9;
+    nc_wr32(site + 1, stub - (eip + 5));
+    if (!ram_write(vm, stub, st, STUB_SIZE) || !ram_write(vm, eip, site, n + moved)) {
+        why = "its memory can't be written";
+        goto refused;
+    }
+    char hex[3 * (15 + MOVED_MAX) + 1];
+    unsigned h = 0;
+    for (unsigned i = 0; i < n + moved; i++) {
+        h += (unsigned)snprintf(hex + h, sizeof(hex) - h, "%02x ", code[i]);
+    }
+    nc_log("hakuX-native", "probe at %08x: a jump to the stub at %08x (%u bytes moved: %s)", eip, stub, n + moved, hex);
+    return true;
+refused:
+    nc_log("hakuX-native", "probe at %08x refused: %s (%02x %02x %02x %02x %02x %02x)", eip, why, first[0], first[1],
+           first[2], first[3], first[4], first[5]);
+    return false;
+}
+
+/* A probe's stub entered the kernel: the registers as at the probe, then the
+ * moved instructions run from the stub. */
+void nc_probe_run(NcKernel *k, NcFrame *f)
+{
+    const uint32_t stub = nc_frame_eip(f) - 7;
+    const uint8_t *st = nc_vm_host(k->vm, stub);
+    nc_frame_set_eip(f, nc_rd32(st + S_EIP));
+    if (k->hle_hook) {
+        k->hle_hook(k, f);
+    }
+    nc_frame_set_eip(f, stub + S_BODY);
+}
+
+/* a store through the gate to an emulated page: the HLE learns the RAM changed */
+static void soft_site_stored(uint32_t pa, uint32_t n)
+{
+    if (nc_vm_dma.wrote) {
+        nc_vm_dma.wrote(pa, n);
+    }
+}
+
+void nc_mmio_site_run(NcKernel *k, NcFrame *f)
+{
+    const uint32_t stub = nc_frame_eip(f) - 7;
+    const uint8_t *st = nc_vm_host(k->vm, stub);
+    const unsigned n = st[S_LEN], moved = st[S_MOVED];
+    const uint32_t eip = nc_rd32(st + S_EIP);
+    nc_frame_set_eip(f, eip);
+    NcX86Access acc;
+    const bool known = nc_x86_access(f, st + S_ORIG, ncn_seg_base(), &acc);
+    const bool device = known && nc_mmio_is_device(acc.ea);
+    /* OGBox 0.0.3: or a page of an emulated block (vm.c g_soft), done against RAM */
+    const bool soft = known && !device && nc_vm_soft(k->vm, acc.ea) && nc_vm_phys(k->vm, acc.ea) != UINT32_MAX;
+    if (device && k->in_isr && k->current == k->isr_thread) {
+        nc_fr_note('m', 0, 0, eip, acc.ea);     /* an ISR's device access (the flight recorder) */
+    }
+    int r = device ? nc_mmio_emulate_frame(k->vm, f, st + S_ORIG) : 0;
+    if (soft) {
+        r = nc_ram_emulate_frame(k->vm, f, st + S_ORIG, soft_site_stored) ? 1 : -1;
+    }
+    if (r <= 0) {
+        /* ordinary memory (or a form the emulation refused): the bytes go back
+         * and the instruction runs where it is, from the start */
+        Site *s = site_of(eip, true);
+        nc_frame_set_eip(f, eip);
+        if (s) {
+            if (s->stub != stub) {
+                s->stub = stub;     /* a savestate's: not in the table yet */
+            }
+            if (put_back(k, s, r < 0 ? "the emulation refused it" : "it reached ordinary memory")) {
+                s->state = ++s->strikes >= STRIKES ? SITE_REFUSED : SITE_COUNTING;
+                s->hits = 0;
+                s->stub = 0;
+            }
+        }
+        return;
+    }
+    if (moved && nc_frame_eip(f) == eip + n) {
+        nc_frame_set_eip(f, stub + S_BODY);
+    }
+    g_runs++;
+    if ((g_runs & 0xFFFF) == 0) {
+        const uint64_t now = nc_ke_now_ns();
+        if (now - g_last_log_ns > 10000000000ull) {
+            const double s = g_last_log_ns ? (now - g_last_log_ns) / 1e9 : 0;
+            if (s > 0) {
+                nc_log("hakuX-native", "mmio: %.0f device accesses/s through the gate; %u sites (%u moving "
+                       "instructions), %u refused, %u put back; %u rdtsc sites natively", (g_runs - g_runs_logged) / s,
+                       g_patched, g_moved, refused_count(), g_put_back, g_tsc_sites);
+            }
+            g_last_log_ns = now;
+            g_runs_logged = g_runs;
+        }
+    }
+}
+#endif
