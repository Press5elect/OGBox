+/*
+ * hakuX native core — Xbox trainers (trainer.h).
+ *
+ * Copyright (C) 2026 Press5elect
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * Additional terms (GPL-3.0 section 7(b)): keep the attribution "OGBox by
+ * Press5elect" (github.com/Press5elect/OGBox, NOTICE).
+ *
+ * The unmangling, the header's offsets, the texts' reading and the toys'
+ * code are XBMC4Xbox's (xbmc/platform/xbox/utils/Trainer.cpp, Team XBMC,
+ * GPL-2.0-or-later, from team xored), in C; the toys that read the block's
+ * address at 0x8000000C or keep their state at 0x80000010-0x80000018 are
+ * given addresses in the block instead, and the LCD toys (which wait with HLT,
+ * the native CPU's stop) report their text through a port.
+ */
+#include "native/core/trainer.h"
+
+#include "native/kernel/kernel.h"
+
+#include <ctype.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+#define LOADER_SIZE   167u              /* XBMC4Xbox's loader: the trainer follows it */
+#define ETM_HEAP      (32u << 10)
+#define XBTF_HEAP     (ETM_HEAP + (8u << 10))
+
+/* the stub's and the toys' ports */
+#define PORT_EVENT    0xB0C0u           /* 1: the trainer's entry returned */
+#define PORT_LCD_TEXT 0xB0C4u           /* a string's address, at the position before */
+#define PORT_LCD_CLR  0xB0C8u
+#define PORT_LCD_POS  0xB0CCu
+/* the MCPX's SMBus */
+#define SMB_BASE      0xC000u
+#define SMB_PIC_WRITE 0x20u             /* the PIC (the SMC) at 0x10, written */
+
+/* the block's own words (the loader's 167 bytes hold only the stub's 32) */
+#define BLK_IGK_ORIG  0x90u             /* was 0x80000010: the pad function igk_main calls */
+#define BLK_IGK_LAST  0x94u             /* was 0x80000014 (and +4) */
+
+static char g_path[1024];
+static char g_bits[NC_TRAINER_MAX_OPTIONS + 1];
+static NcVm *g_vm;
+static bool g_installed;
+static uint32_t g_block, g_block_size;
+static char g_name[NC_TRAINER_TEXT];
