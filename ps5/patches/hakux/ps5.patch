+/* IofCallDriver(DeviceObject, Irp), fastcall -> the dispatch routine's status */
+static uint64_t IofCallDriver(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    const NcIoMem m = irp_mem(k);
+    uint32_t routine, sp;
+    if (!nc_irp_down(&m, a[1], a[0], &routine, &sp)) {
+        nc_kernel_request_stop(k, f, "KeBugCheckEx(NO_MORE_IRP_STACK_LOCATIONS 0x35, %08x)", a[1]);
+        return 0;
+    }
+    if (!nc_vm_rd32(k->vm, a[0] + NC_DEV_DRIVER)) {
+        const uint32_t st = kernel_device(k, a[0], a[1], sp);
+        return irp_complete(k, f, a[1], st, IO_DISK_INCREMENT);
+    }
+    if (!routine) {
+        nc_vm_wr32(k->vm, a[1] + NC_IRP_STATUS, STATUS_INVALID_DEVICE_REQUEST);
+        nc_vm_wr32(k->vm, a[1] + NC_IRP_INFORMATION, 0);
+        return irp_complete(k, f, a[1], STATUS_INVALID_DEVICE_REQUEST, 0);
+    }
+    const uint32_t args[2] = {a[0], a[1]};
+    nc_kernel_callout(k, f, routine, args, 2);  /* its EAX: the call's */
+    return 0;
+}
