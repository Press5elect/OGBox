+static bool in_hole(uint32_t a)
+{
+    const uint32_t hole = NC_HOLE_END;
+    return hole && a - NC_CONTIG_WINDOW < hole - NC_CONTIG_WINDOW;
+}
+
+typedef struct MemCtx {
+    const NcVm *vm;
+    bool ram_only;                          /* nc_ram_emulate: no devices */
+    void (*stored)(uint32_t pa, uint32_t n);
+    const NcMmioDev *dev;                   /* the last device reached, for the log */
+    uint32_t addr;
+    uint64_t v;
+    unsigned bytes;
+    bool store;
