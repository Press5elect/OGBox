+            const uint8_t *ip = (const uint8_t *)(uintptr_t)f.rip;
+            nc_log("hakuX-native-mmio", "an access to %08x the decoder doesn't know at %08x: %02x %02x %02x %02x %02x %02x",
+                   (uint32_t)at, (uint32_t)f.rip, ip[0], ip[1], ip[2], ip[3], ip[4], ip[5]);
+        }
+        return false;
+    }
+    ncn_frame_to_uc(&f, ucontext, true);
+    note_last(&m, false);
+    if (m.dev) {
+        mmio_log(&m);
+    }
+    return true;
+}
+
+/* (mmiosite.c) The instruction at ip (its bytes; f's EIP its address) done
+ * with f's registers: 1 when it reached a device, 0 ordinary memory only,
+ * -1 when the emulation doesn't take it (f unchanged then). */
+int nc_mmio_emulate_frame(const NcVm *vm, NcFrame *f, const uint8_t *ip)
+{
+    MemCtx m = {.vm = vm};
+    const NcX86Mem mem = {mem_rw, &m};
+    if (!nc_x86_emulate(f, ip, ncn_seg_base(), &mem)) {
+        return -1;
+    }
+    note_last(&m, false);
+    if (m.dev) {
+        mmio_log(&m);
+        return 1;
+    }
+    return 0;
+}
+
+bool nc_ram_access_span(const NcVm *vm, const siginfo_t *info, void *ucontext, uint32_t *lo,
+                        uint32_t *hi, bool *store)
+{
+    if (!ncn_uc_in_guest(ucontext)) {
+        return false;
+    }
+    NcFrame f;
+    ncn_frame_from_uc(&f, ucontext, false);
+    NcX86Access a;
+    if (!nc_x86_access(&f, (const uint8_t *)(uintptr_t)f.rip, ncn_seg_base(), &a)) {
+        return false;
+    }
+    const uint64_t fa = (uint64_t)(uintptr_t)info->si_addr;
+    if (fa < a.ea || fa - a.ea >= a.bytes) {
