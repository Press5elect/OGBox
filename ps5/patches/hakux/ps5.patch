+    "    if (raw(texelFetch(src, t, 0).rgb, fmt) != (p.key & mask)) {\n"
+    "      discard;\n"
+    "    }\n"
+    "  }\n"
+    "  vec2 st = p.in_.xy + (f - p.rect.xy) * p.in_.zw;\n"
+    "  o = vec4(texture(ovl, st / vec2(textureSize(ovl, 0))).rgb, 1.0);\n"
+    "}\n";
