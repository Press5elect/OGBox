+/* What IopCompleteRequest does once the completion routines are done, boost the
+ * waiter's increment. (No completion port gets the IRP: no file here is a port's.) */
+static void irp_finish(NcKernel *k, uint32_t irp, int boost)
+{
+    const uint32_t flags = nc_vm_rd32(k->vm, irp + NC_IRP_FLAGS);
+    const uint32_t iosb = nc_vm_rd32(k->vm, irp + NC_IRP_USER_IOSB), event = nc_vm_rd32(k->vm, irp + NC_IRP_USER_EVENT);
+    const uint32_t status = nc_vm_rd32(k->vm, irp + NC_IRP_STATUS);
+    if (flags & (NC_IRP_CLOSE | NC_IRP_PAGING_IO)) {
+        if (iosb) {
+            nc_vm_wr32(k->vm, iosb, status);
+            nc_vm_wr32(k->vm, iosb + 4, nc_vm_rd32(k->vm, irp + NC_IRP_INFORMATION));
+        }
+        if (event) {
+            nc_ke_set_event(k, event, boost);
+        }
+        if (flags & NC_IRP_PAGING_IO) {
+            irp_free(k, irp);
+        }
+        return;
+    }
+    const bool pending = *(const uint8_t *)nc_vm_host(k->vm, irp + NC_IRP_PENDING);
+    if ((flags & NC_IRP_DEFER) && !pending) {
+        return; /* the service that sent it finishes it */
+    }
+    irp_thread_unlink(k, irp);
+    if (status >= 0xC0000000u && !pending) {
+        irp_free(k, irp); /* the caller has the error from the call itself */
+        return;
+    }
+    const uint32_t fo = nc_vm_rd32(k->vm, irp + NC_IRP_FILE);
+    if (iosb) {
+        nc_vm_wr32(k->vm, iosb, status);
+        nc_vm_wr32(k->vm, iosb + 4, nc_vm_rd32(k->vm, irp + NC_IRP_INFORMATION));
+    }
+    if (event) {
+        nc_ke_set_event(k, event, boost);
+    } else if (fo) {
+        nc_vm_wr32(k->vm, fo + FO_FINAL_STATUS, status);
+        nc_ke_set_event(k, fo + NC_FO_EVENT, boost);
+    }
+    const uint32_t apc = nc_vm_rd32(k->vm, irp + NC_IRP_APC_ROUTINE);
+    if (apc) {
+        NcThread *t = nc_ps_thread_of(k, nc_vm_rd32(k->vm, irp + NC_IRP_THREAD));
+        if (t && t->state != NC_T_TERMINATED) {
+            const NcApc ap = {.normal = apc, .ctx = nc_vm_rd32(k->vm, irp + NC_IRP_APC_CONTEXT), .a1 = iosb, .a2 = 0};
+            nc_apc_queue(k, t, &ap, boost);
+        }
+    }
+    irp_free(k, irp);
+}
+
+/* IofCompleteRequest's walk (iorp.h): each completion routine as a callout,
+ * then irp_finish. The kernel call returns result (now, or from the
+ * continuation after the routines). */
+static uint64_t irp_walk(NcKernel *k, NcFrame *f, uint32_t irp, uint32_t result, int boost)
+{
+    const NcIoMem m = irp_mem(k);
+    NcIrpCall call;
+    if (nc_irp_walk(&m, irp, &call)) {
+        const uint32_t ctx[NC_KCONT_WORDS] = {irp, result, (uint32_t)boost};
+        nc_kernel_callout_cont(k, f, call.routine, call.args, 3, 0xFF, NC_KCONT_IRP_COMPLETE, ctx);
+        return 0;
+    }
+    irp_finish(k, irp, boost);
+    return result;
+}
+
+static uint64_t irp_complete_cont(NcKernel *k, NcFrame *f, uint32_t eax, const uint32_t *ctx)
+{
+    const NcIoMem m = irp_mem(k);
+    if (!nc_irp_routine_returned(&m, ctx[0], eax)) {
+        return ctx[1];      /* STATUS_MORE_PROCESSING_REQUIRED: the IRP is its driver's again */
+    }
+    return irp_walk(k, f, ctx[0], ctx[1], (int32_t)ctx[2]);
+}
+
+/* Completes irp from its current stack location (IofCompleteRequest's
+ * PriorityBoost: boost); the call returns result. */
+static uint64_t irp_complete(NcKernel *k, NcFrame *f, uint32_t irp, uint32_t result, int boost)
+{
+    const NcIoMem m = irp_mem(k);
+    if (!nc_irp_complete_begin(&m, irp)) {
+        nc_kernel_request_stop(k, f, "KeBugCheckEx(MULTIPLE_IRP_COMPLETE_REQUESTS 0x44, %08x)", irp);
+        return 0;
+    }
+    return irp_walk(k, f, irp, result, boost);
+}
+
+/* IofCompleteRequest(Irp, PriorityBoost), fastcall */
+static uint64_t IofCompleteRequest(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    return irp_complete(k, f, a[0], 0, (int8_t)a[1]);
+}
+
+/* IoInvalidDeviceRequest(DeviceObject, Irp) -> STATUS_INVALID_DEVICE_REQUEST, written into the
+ * IRP's IoStatus, the IRP completed (no boost) as the Xbox kernel's: its sender's event or APC
+ * comes, and its completion routines run. (OGBox 0.0.9 wrote the status alone: there was no IRP
+ * completion to do.) */
+static uint64_t IoInvalidDeviceRequest(NcKernel *k, NcFrame *f, const uint32_t *a)
+{
+    if (!a[1]) {
+        return STATUS_INVALID_DEVICE_REQUEST;
+    }
+    nc_vm_wr32(k->vm, a[1] + NC_IRP_STATUS, STATUS_INVALID_DEVICE_REQUEST);
+    nc_vm_wr32(k->vm, a[1] + NC_IRP_INFORMATION, 0);
+    return irp_complete(k, f, a[1], STATUS_INVALID_DEVICE_REQUEST, 0);
+}
