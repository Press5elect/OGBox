+/* ------------------------------------------------ thread notify routines
+ *
+ * From hakuX-lr 968bed3fda (portare-ch, GPL-2.0-or-later). PsSetCreateThreadNotifyRoutine's
+ * routines, in the KPCR's page (a savestate keeps them): routine(Thread, ThreadId, Create) as
