+#error "the native CPU backend needs an x86-64 host"
+#endif
+
+/* ---- the host's view of an interrupted context ---- */
+
+#if defined(__linux__)
+#define C_GREG(u, r) ((u)->uc_mcontext.gregs[r])
+#define C_RIP(u) C_GREG(u, REG_RIP)
+#define C_RSP(u) C_GREG(u, REG_RSP)
+#define C_EFL(u) C_GREG(u, REG_EFL)
+#define C_CS(u) ((uint16_t)((uint64_t)C_GREG(u, REG_CSGSFS) & 0xFFFF))
+#define C_TRAPNO(u) ((unsigned)C_GREG(u, REG_TRAPNO))
+#define C_ERR(u) ((uint64_t)C_GREG(u, REG_ERR))
+/* the guest's x87/SSE: the signal frame's (Linux saves it and gives the
+ * handler a fresh FPU) */
+#define C_FX(u) ((uint8_t *)(u)->uc_mcontext.fpregs)
+static long long *creg(ucontext_t *u, unsigned i)
+{
+    static const int k_greg[8] = {REG_RAX, REG_RCX, REG_RDX, REG_RBX, REG_RSP, REG_RBP, REG_RSI, REG_RDI};
+    return &u->uc_mcontext.gregs[k_greg[i & 7]];
+}
+#define TRAP_GP 13u                 /* #GP: SIGSEGV */
+#define NC_GUEST_CS 0x23u           /* __USER32_CS */
+#define FX_LIVE 0
+#define ALTSTACK_SIZE (16u << 20)
+#define GATE_STACK_SIZE (16u << 20)
+#elif defined(__PROSPERO__) || defined(__FreeBSD__)
+/* FreeBSD's mcontext (the PS5's kernel), as Kelvin's ctx.h. */
+#define C_RIP(u) ((u)->uc_mcontext.mc_rip)
+#define C_RSP(u) ((u)->uc_mcontext.mc_rsp)
+#define C_EFL(u) ((u)->uc_mcontext.mc_rflags)
+#define C_CS(u) ((uint16_t)((u)->uc_mcontext.mc_cs & 0xFFFF))
+#define C_TRAPNO(u) ((unsigned)(u)->uc_mcontext.mc_trapno)
+#define C_ERR(u) ((uint64_t)(u)->uc_mcontext.mc_err)
+/* the guest's x87/SSE: still in the registers when the handler runs (the
+ * console's mc_fpstate is not the thread's: _MC_FPOWNED_FPU), so the entry
+ * wrapper (cpu_native_asm.S) fxsaves them into a buffer on the handler's
+ * stack and fxrstors it on the way out; the frame reads and writes that */
+static __thread uint8_t *t_live_fx;
+#define C_FX(u) ((void)(u), t_live_fx)
+static __register_t *creg(ucontext_t *u, unsigned i)
+{
+    switch (i & 7) {
+    case 0: return &u->uc_mcontext.mc_rax;
+    case 1: return &u->uc_mcontext.mc_rcx;
+    case 2: return &u->uc_mcontext.mc_rdx;
+    case 3: return &u->uc_mcontext.mc_rbx;
+    case 4: return &u->uc_mcontext.mc_rsp;
+    case 5: return &u->uc_mcontext.mc_rbp;
+    case 6: return &u->uc_mcontext.mc_rsi;
+    default: return &u->uc_mcontext.mc_rdi;
+    }
+}
+#define TRAP_GP 9u                  /* T_PROTFLT: SIGBUS (si_code 3) */
+#define NC_GUEST_CS 0x33u           /* the console's 32-bit user code segment */
+#define FX_LIVE 1
+/* From the platform heap (direct memory), not the title's small flexible
+ * memory. A system op taken in a signal (a kick's interrupt, a trap's
+ * thread switch, its DPCs) runs the kernel on the signal stack: 2 MiB (0.1.2)
+ * left little room, and an overflow there cannot be reported (the kernel
+ * has nowhere to put the fault's signal frame). */
+#define ALTSTACK_SIZE (8u << 20)
+#define GATE_STACK_SIZE (8u << 20)
+#else
+#error "the native CPU backend's signal context: Linux or FreeBSD (the PS5)"
+#endif
+#define C_REG(u, i) (*creg((u), (i)))
+#define RAX 0
+#define RCX 1
+#define RDX 2
+#define RBX 3
+
+#define NC_KICK_SIGNAL SIGUSR2
+#define EFLAGS_KEEP 0x00240DD5u     /* CF PF AF ZF SF DF OF AC ID: the guest's */
+#define POPF_MASK 0x00254DD5u       /* what popfd takes from the stack (IF apart) */
+#define XBOX_TSC_HZ 733333333ull
+
+/* cpu_native_asm.S */
+void ncn_enter(NcFrame *f, uint64_t cs, uint64_t ss) __attribute__((noreturn));
+void ncn_gate_entry(void);
+uint16_t ncn_read_cs(void);
+uint16_t ncn_read_ss(void);
+void ncn_load_segs(uint16_t gs, uint16_t data);
+void ncn_gate_dispatch(NcFrame *f);
+int ncn_gate_again(NcFrame *f);
+
+/* read by the assembly */
+NcFrame *ncn_gate_frame;
+uint64_t ncn_gate_stack;
+int *ncn_gate_pending;          /* the CPU's request flag, for the gate's tail (0.1.43) */
+uint32_t ncn_host_mxcsr = 0x1F80;
+uint16_t ncn_guest_cs, ncn_guest_ss;
+
+typedef struct NcCtx {
+    uint64_t regs[8];
+    uint64_t rip;
+    uint64_t eflags;
+    uint8_t fx[512];
+} NcCtx;
+_Static_assert(sizeof(NcCtx) <= sizeof(((NcCpuContext *)0)->blob), "NcCtx in NcCpuContext");
+
+struct NcCpu {
+    NcFrame frame;              /* first: 64-byte aligned */
+    NcCpuConfig cfg;
+    NcVm *vm;
+    uint32_t fs_base;
+    uint32_t noint_lo, noint_hi;
+    uint16_t host_cs, host_ss, gs_sel;
+    pthread_t thread;
+    volatile int running;
+    volatile int in_host;       /* the gate's C code runs (no kick needed) */
+    volatile uint32_t last_eip; /* the guest's EIP at the last system op or kick (the samplers) */
+    volatile int smp_req;       /* a sample asked of the next kick (nc_cpu_native_sample) */
+    volatile uint32_t smp_seq, smp_eip;
+    uint32_t smp_regs[9];       /* the sample's EAX..EDI and EFLAGS (guest code only) */
+    volatile int smp_regs_ok;
+    volatile int smp_where;     /* NC_SAMPLE_GUEST / _GATE / _HOST */
+    int pending;                /* an interrupt was requested */
+    int kicked;                 /* a kick signal is on its way */
+    bool stepping;              /* TF set to leave a no-interrupt range */
+    bool cpuid_faults;          /* Linux's CPUID faulting is on for the vCPU thread */
+    bool gate_step;             /* TF set in the gate's exit for a request it missed */
+    nc_jmp_buf exit_env;        /* nc_setjmp: the PS5's libc has no sigsetjmp */
+    uint64_t cycle_offset;      /* host TSC ticks the guest's RDTSC leaves out */
+    uint64_t tsc_ratio;         /* XBOX_TSC_HZ / host Hz, 32.32 */
+    uint8_t *altstack, *gate_stack;
+    NcCtx reset;
+    NcNativeStats st;
+    uint64_t st_t0, st_sysops0, st_sig0, st_gate0, st_seg0;
+    uint64_t st_kind0[32];
+};
+
+static NcCpu *g_cpu;
+static volatile uint32_t g_vif = 1;    /* the running thread's virtual IF */
+static uint64_t g_tsc_hz;
+static const int k_signals[] = {SIGSEGV, SIGBUS, SIGILL, SIGTRAP, SIGFPE};
+#define NSIGNALS (sizeof(k_signals) / sizeof(k_signals[0]))
+static struct sigaction g_prev[NSIGNALS];
+
+/* ---- the last word before the process goes ----
+ * A line straight to the host's log file, from a signal handler too: the
+ * host's nc_host_emergency_write (the PS5 title: its boot log, written and
+ * synced at once, and klog), else standard error. */
+__attribute__((weak)) void nc_host_emergency_write(const char *text, size_t len)
+{
+    (void)!write(2, text, len);
+}
+
+static void emergency(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+static void emergency(const char *fmt, ...)
+{
+    char b[600];
+    int n = snprintf(b, sizeof(b), "hakuX-native-cpu: ");
+    va_list ap;
+    va_start(ap, fmt);
+    const int m = vsnprintf(b + n, sizeof(b) - (size_t)n - 1, fmt, ap);
+    va_end(ap);
+    n += m > 0 ? (m < (int)(sizeof(b) - (size_t)n - 1) ? m : (int)(sizeof(b) - (size_t)n - 2)) : 0;
+    b[n++] = '\n';
+    nc_host_emergency_write(b, (size_t)n);
+}
+
+/* how deep this thread is in the backend's handlers (a fault in a handler
+ * re-enters it: NODEFER) */
+static __thread int t_depth;
+
+static inline uint64_t rdtsc(void)
+{
+    uint32_t lo, hi;
+    __asm__ volatile("rdtsc" : "=a"(lo), "=d"(hi));
+    return (uint64_t)hi << 32 | lo;
+}
+
+uint64_t ncn_tsc_hz(void)
+{
+#if defined(__PROSPERO__)
+    if (!g_tsc_hz) {
+        g_tsc_hz = sceKernelGetTscFrequency();
+    }
+#endif
+    if (!g_tsc_hz) {
+        /* measured against CLOCK_MONOTONIC over 50 ms (Kelvin's way; the
+         * PS5 has sceKernelGetTscFrequency) */
+        struct timespec a, b, d = {0, 50000000};
+        clock_gettime(CLOCK_MONOTONIC, &a);
+        const uint64_t t0 = rdtsc();
+        nanosleep(&d, NULL);
+        clock_gettime(CLOCK_MONOTONIC, &b);
+        const uint64_t t1 = rdtsc();
+        const uint64_t ns = (uint64_t)(b.tv_sec - a.tv_sec) * 1000000000ull + (uint64_t)b.tv_nsec - (uint64_t)a.tv_nsec;
+        g_tsc_hz = ns ? (uint64_t)((unsigned __int128)(t1 - t0) * 1000000000u / ns) : XBOX_TSC_HZ;
+    }
+    return g_tsc_hz;
+}
+
+/* ---- frames ---- */
+
+static bool in_guest(const ucontext_t *u)
+{
+    return C_CS(u) == ncn_guest_cs;
+}
+
+bool ncn_uc_in_guest(const void *ucontext)
+{
+    return in_guest(ucontext);
+}
+
+uintptr_t ncn_uc_pc(const void *ucontext)
+{
+    return (uintptr_t)C_RIP((const ucontext_t *)ucontext);
+}
+
+void ncn_frame_from_uc(NcFrame *f, const void *ucontext, bool fx)
+{
+    const ucontext_t *u = ucontext;
+    for (int i = 0; i < 8; i++) {
+        f->regs[i] = (uint32_t)C_REG((ucontext_t *)u, i);
+    }
+    f->rip = (uint32_t)C_RIP(u);
+    f->eflags = ((uint64_t)C_EFL(u) & EFLAGS_KEEP) | 0x2u | (g_vif ? NC_EFLAGS_IF : 0);
+    if (fx && C_FX(u)) {
+        memcpy(f->fx, C_FX(u), 512);
+    }
+}
+
+void ncn_frame_to_uc(const NcFrame *f, void *ucontext, bool fx)
+{
+    ucontext_t *u = ucontext;
+    for (int i = 0; i < 8; i++) {
+        C_REG(u, i) = (uint32_t)f->regs[i];
+    }
+    C_RIP(u) = (uint32_t)f->rip;
+    const bool step = g_cpu && g_cpu->stepping;
+    C_EFL(u) = ((((uint64_t)C_EFL(u) & ~(uint64_t)(EFLAGS_KEEP | NC_EFLAGS_TF)) | (f->eflags & EFLAGS_KEEP) |
+                           NC_EFLAGS_IF | (step ? NC_EFLAGS_TF : 0)));
+    g_vif = (f->eflags & NC_EFLAGS_IF) != 0;
+    if (fx && C_FX(u)) {
+        uint8_t *x = C_FX(u);
+        memcpy(x, f->fx, 512);
+        uint32_t mxcsr;
+        memcpy(&mxcsr, x + 24, 4);
+        mxcsr &= 0xFFFF;                /* reserved bits make the signal's return fail */
+        memcpy(x + 24, &mxcsr, 4);
+        uint32_t magic;
+        memcpy(&magic, x + 464, 4);
+        if (!FX_LIVE && magic == 0x46505853u) {     /* FP_XSTATE_MAGIC1: an XSAVE frame */
+            uint64_t bv;
+            memcpy(&bv, x + 512, 8);
+            bv |= 3;                    /* x87 and SSE are the image's, not their init state */
+            memcpy(x + 512, &bv, 8);
+        }
+    }
+}
+
