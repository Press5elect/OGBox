+/* OGBox 0.0.4: a guest thread waiting for the lock (apu_lock_guest) gets it now, before the next
+ * frame: the frame thread waits (2 ms at most) until it has it, then queues behind it */
+static void let_guest_in(MCPXAPUState *d)
+{
+    if (!__atomic_load_n(&d->lock_waiters, __ATOMIC_SEQ_CST)) {
+        return;
+    }
+    pthread_mutex_unlock(&d->lock);
+    const int64_t t0 = apu_host_us();
+    while (__atomic_load_n(&d->lock_waiters, __ATOMIC_SEQ_CST) && apu_host_us() - t0 < 2000) {
+        sched_yield();
+    }
+    pthread_mutex_lock(&d->lock);
+}
