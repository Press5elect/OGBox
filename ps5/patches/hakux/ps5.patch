+    }
+    NcFrame f;
+    ncn_frame_from_uc(&f, ucontext, true);
+    if (seg) {
+        const uint32_t eip = (uint32_t)f.rip;
+        MemCtx m = {.vm = vm};
+        const NcX86Mem mem = {mem_rw, &m};
+        if (!nc_x86_emulate(&f, (const uint8_t *)(uintptr_t)f.rip, ncn_seg_base(), &mem)) {
+            return false;
+        }
+        ncn_frame_to_uc(&f, ucontext, true);
+        nc_cpu_native_seg_fault(eip, seg == 0x64);
