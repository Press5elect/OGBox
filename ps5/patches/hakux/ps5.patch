+        }
+        if (!(b == 0x26 || b == 0x2E || b == 0x36 || b == 0x3E || b == 0x66 || b == 0x67 || b == 0xF0 ||
+              b == 0xF2 || b == 0xF3)) {
+            return 0;
+        }
+    }
+    return 0;
+}
+
+bool nc_mmio_fault(const NcVm *vm, const siginfo_t *info, void *ucontext)
+{
+    const uintptr_t at = (uintptr_t)info->si_addr;
+    if (at >= (1ull << 32) || !ncn_uc_in_guest(ucontext)) {
+        return false;
+    }
+    /* OGBox 0.0.8: the fetch of the instruction itself faulted (a jump to an address no page backs:
+     * BLACK at 0x00008671), the fault address within its 15 bytes: no instruction to read, so no device
+     * access; the guest's fault (core.c: its page fault, its exception handler or the report with its
+     * EIP and threads). Reading those bytes for the prefix below faulted in this handler and stopped
+     * the app without a word about the guest. */
+    if ((uint64_t)at - (uint64_t)ncn_uc_pc(ucontext) < 16) {
+        return false;
+    }
+    /* An fs:/gs: access (the KPCR) that faulted: on the PS5 an fs: prefix
+     * doesn't #GP in compatibility mode, the host's FS base (its TLS,
+     * truncated to 32 bits) is used, so the access lands wherever that
+     * points (0.1.4: in the device range, ~8k faults a second from the
+     * kernel's own IRQL and critical-section fast paths). Emulated against
+     * the KPCR, and the prefix made gs: (cpu_native.c), whose base is the
+     * KPCR, so it runs natively from then on; a gs: access that still
+     * faults is emulated the same way (counted: the stats say whether the
+     * GS base works). */
+    const uint8_t seg = seg_prefix((const uint8_t *)(uintptr_t)ncn_uc_pc(ucontext));
+    if (!seg && !dev_at((uint32_t)at)) {
+        return false;
+    }
+    NcFrame f;
+    ncn_frame_from_uc(&f, ucontext, true);
+    if (seg) {
+        const uint32_t eip = (uint32_t)f.rip;
+        MemCtx m = {.vm = vm};
+        const NcX86Mem mem = {mem_rw, &m};
+        if (!nc_x86_emulate(&f, (const uint8_t *)(uintptr_t)f.rip, ncn_seg_base(), &mem)) {
+            return false;
+        }
+        ncn_frame_to_uc(&f, ucontext, true);
+        nc_cpu_native_seg_fault(eip, seg == 0x64);
+        note_last(&m, true);
+        if (m.dev) {
+            mmio_log(&m);
+        }
+        return true;
+    }
+    MemCtx m = {.vm = vm};
+    const NcX86Mem mem = {mem_rw, &m};
+    const uint32_t esp_in = (uint32_t)f.regs[4];     /* OGBox 0.0.8 (a diagnostic): see below */
+    if (!nc_x86_emulate(&f, (const uint8_t *)(uintptr_t)f.rip, ncn_seg_base(), &mem)) {
+        static unsigned said;
+        if (said++ < 16) {
+            const uint8_t *ip = (const uint8_t *)(uintptr_t)f.rip;
+            nc_log("hakuX-native-mmio", "an access to %08x the decoder doesn't know at %08x: %02x %02x %02x %02x %02x %02x",
+                   (uint32_t)at, (uint32_t)f.rip, ip[0], ip[1], ip[2], ip[3], ip[4], ip[5]);
+        }
+        return false;
+    }
+    /* OGBox 0.0.8 (a diagnostic): an emulated device access that left the guest's ESP off a dword (BLACK
+     * returned to 0x00008671 from a stack 2 bytes off) */
+    if (((uint32_t)f.regs[4] & 3u) && !(esp_in & 3u)) {
+        static unsigned said_esp;
+        if (said_esp++ < 4) {
+            const uint8_t *ip = (const uint8_t *)(uintptr_t)ncn_uc_pc(ucontext);
+            nc_log("hakuX-native-mmio", "esp off a dword after emulating %02x %02x %02x %02x %02x %02x at %08x "
+                   "(device %08x): esp %08x -> %08x", ip[0], ip[1], ip[2], ip[3], ip[4], ip[5],
+                   (uint32_t)ncn_uc_pc(ucontext), (uint32_t)at, esp_in, (uint32_t)f.regs[4]);
+        }
+    }
+    ncn_frame_to_uc(&f, ucontext, true);
+    note_last(&m, false);
+    if (m.dev) {
+        mmio_log(&m);
+    }
+    return true;
+}
+
+/* (mmiosite.c) The instruction at ip (its bytes; f's EIP its address) done
+ * with f's registers: 1 when it reached a device, 0 ordinary memory only,
+ * -1 when the emulation doesn't take it (f unchanged then). */
+int nc_mmio_emulate_frame(const NcVm *vm, NcFrame *f, const uint8_t *ip)
+{
+    MemCtx m = {.vm = vm};
+    const NcX86Mem mem = {mem_rw, &m};
+    if (!nc_x86_emulate(f, ip, ncn_seg_base(), &mem)) {
+        return -1;
+    }
+    note_last(&m, false);
+    if (m.dev) {
+        mmio_log(&m);
+        return 1;
+    }
+    return 0;
+}
+
+bool nc_ram_access_span(const NcVm *vm, const siginfo_t *info, void *ucontext, uint32_t *lo,
+                        uint32_t *hi, bool *store)
+{
+    if (!ncn_uc_in_guest(ucontext)) {
+        return false;
+    }
+    NcFrame f;
+    ncn_frame_from_uc(&f, ucontext, false);
+    NcX86Access a;
+    if (!nc_x86_access(&f, (const uint8_t *)(uintptr_t)f.rip, ncn_seg_base(), &a)) {
+        return false;
+    }
+    const uint64_t fa = (uint64_t)(uintptr_t)info->si_addr;
+    if (fa < a.ea || fa - a.ea >= a.bytes) {
+        return false;
+    }
+    const uint32_t p0 = nc_vm_phys(vm, a.ea);
+    if (p0 == UINT32_MAX || (p0 & (NC_PAGE - 1)) + a.bytes > NC_PAGE || (uint64_t)p0 + a.bytes > vm->ram_size) {
+        return false;
+    }
+    *lo = p0;
+    *hi = p0 + a.bytes;
+    *store = a.store;
+    return true;
+}
+
+bool nc_ram_emulate_frame(NcVm *vm, NcFrame *f, const uint8_t *ip, void (*stored)(uint32_t pa, uint32_t n))
+{
+    MemCtx m = {.vm = vm, .ram_only = true, .stored = stored};
+    const NcX86Mem mem = {mem_rw, &m};
+    return nc_x86_emulate(f, ip, ncn_seg_base(), &mem);
+}
+
+/* A string instruction (REP MOVS, STOS, LODS) done in part: it stopped at a page the guest doesn't
+ * have (one its own page tables give it when it faults there), its registers moved on as far as
+ * it went. The guest runs the rest itself, and faults where the emulation stopped. */
+static bool string_progress(const NcFrame *before, const NcFrame *after)
+{
+    return before->regs[1] != after->regs[1] || before->regs[6] != after->regs[6] || before->regs[7] != after->regs[7];
+}
+
+bool nc_ram_emulate(NcVm *vm, const siginfo_t *info, void *ucontext,
+                    void (*stored)(uint32_t pa, uint32_t n))
+{
+    (void)info;
+    if (!ncn_uc_in_guest(ucontext)) {
+        return false;
+    }
+    NcFrame f;
+    ncn_frame_from_uc(&f, ucontext, true);
+    const NcFrame before = f;
+    t_miss = false;
+    MemCtx m = {.vm = vm, .ram_only = true, .stored = stored};
+    const NcX86Mem mem = {mem_rw, &m};
+    if (!nc_x86_emulate(&f, (const uint8_t *)(uintptr_t)f.rip, ncn_seg_base(), &mem)) {
+        if (!string_progress(&before, &f)) {
+            return false;
+        }
+    }
+    ncn_frame_to_uc(&f, ucontext, true);
+    return true;
+}
+
+#endif /* NC_CPU_NATIVE */
+
