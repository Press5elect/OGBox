+
+static Site *site_of(uint32_t eip, bool add)
+{
+    unsigned h = (eip * 2654435761u) % SITES;
+    for (unsigned n = 0; n < SITES; n++, h = (h + 1) % SITES) {
+        if (g_sites[h].eip == eip) {
+            return &g_sites[h];
+        }
+        if (!g_sites[h].eip) {
+            if (!add) {
+                return NULL;
+            }
+            g_sites[h].eip = eip;
+            return &g_sites[h];
+        }
+    }
+    return NULL;
+}
+
+/* Guest code and the kernel area, read and written through the host's view
+ * of RAM (a page may be write-protected by write tracking). */
+static uint8_t *ram_byte(NcVm *vm, uint32_t va)
+{
+    const uint32_t pa = nc_vm_phys(vm, va);
+    return pa == UINT32_MAX || pa >= vm->ram_size ? NULL : vm->phys + pa;
+}
+
+static bool ram_write(NcVm *vm, uint32_t va, const uint8_t *b, unsigned n)
+{
+    for (unsigned i = 0; i < n; i++) {
+        if (!ram_byte(vm, va + i)) {
+            return false;
+        }
+    }
+    for (unsigned i = 0; i < n; i++) {
+        *ram_byte(vm, va + i) = b[i];
+    }
+    return true;
+}
+
+static bool ram_read(NcVm *vm, uint32_t va, uint8_t *b, unsigned n)
+{
+    for (unsigned i = 0; i < n; i++) {
+        const uint8_t *p = ram_byte(vm, va + i);
+        if (!p) {
+            return false;
+        }
+        b[i] = *p;
+    }
+    return true;
+}
+
+/* may this instruction run from the stub instead of its own address */
+static bool movable(const NcX86Insn *in)
+{
+    if (in->flow != NC_FLOW_NONE || in->seg || in->addr16 || in->lock) {
+        return false;
+    }
+    switch (in->op) {
+    case 0x9C: case 0x9D:                       /* pushfd/popfd (trapped by address) */
+    case 0x0F31: case 0x0FA2: case 0x0F0B:      /* rdtsc, cpuid, ud2 */
+    case 0x0F01: case 0x0F00:                   /* descriptor tables */
+    case 0xFA: case 0xFB: case 0xF4:            /* cli, sti, hlt */
+    case 0xE4: case 0xE5: case 0xE6: case 0xE7: /* in/out */
+    case 0xEC: case 0xED: case 0xEE: case 0xEF:
+    case 0x6C: case 0x6D: case 0x6E: case 0x6F: /* ins/outs */
+    case 0x90: case 0xCC:                       /* padding */
+        return false;
+    default:
+        return true;
+    }
+}
+
+/* The relative branches of the code around [lo, hi) decoded from a start
+ * that falls in step with the instructions at lo (x86 decoding comes into
+ * step within a few instructions): whether one points into (lo, hi). -1
+ * when no start before lo lands on it (then the byte patterns decide). */
+#define NEAR 512u
+static int near_branches_into(NcVm *vm, uint32_t lo, uint32_t hi)
+{
+    const uint8_t *m = nc_vm_host(vm, 0);
+    for (uint32_t back = NEAR; back > NEAR - 32; back--) {
+        uint32_t p = lo - back;
+        bool hit = false;
+        while (p < lo) {
+            NcX86Insn in;
+            const unsigned len = nc_x86_decode(m + p, 15, p, &in);
+            if (!len) {
+                break;
+            }
+            if ((in.flow == NC_FLOW_JCC || in.flow == NC_FLOW_JMP || in.flow == NC_FLOW_CALL) && in.target > lo &&
+                in.target < hi) {
+                hit = true;
+            }
+            p += len;
+        }
+        if (p != lo) {
+            continue;               /* not in step: another start */
+        }
+        /* in step: the window's own and those after it */
+        for (p = lo; p < hi + NEAR;) {
+            NcX86Insn in;
+            const unsigned len = nc_x86_decode(m + p, 15, p, &in);
+            if (!len) {
+                break;              /* data after the code: what is after it isn't code we know */
+            }
+            if ((in.flow == NC_FLOW_JCC || in.flow == NC_FLOW_JMP || in.flow == NC_FLOW_CALL) && in.target > lo &&
+                in.target < hi) {
+                hit = true;
+            }
+            p += len;
+        }
+        return hit ? 1 : 0;
+    }
+    return -1;
+}
+
+/* A direct branch or an address within 128 KiB pointing into (lo, hi): the
+ * bytes there can't move. Near the site (512 bytes each way) by the decoded
+ * instructions when the decode comes into step, else by byte patterns; past
+ * that, rel32 jumps, calls and branches and absolute addresses by byte
+ * patterns: a false one only keeps the instruction faulting. */
+static bool pointed_into(NcVm *vm, uint32_t lo, uint32_t hi)
+{
+    const uint32_t span = 0x20000u;
+    uint32_t a = lo > span ? (lo - span) & ~(NC_PAGE - 1) : 0;
+    uint32_t b = hi + span < hi ? 0xFFFFF000u : (hi + span + NC_PAGE - 1) & ~(NC_PAGE - 1);
+    /* the mapped run around the site */
+    for (uint32_t p = lo & ~(NC_PAGE - 1); p < b; p += NC_PAGE) {
+        if (nc_vm_phys(vm, p) == UINT32_MAX) {
+            b = p;
+            break;
+        }
+    }
+    for (uint32_t p = lo & ~(NC_PAGE - 1); p > a; p -= NC_PAGE) {
+        if (nc_vm_phys(vm, p - NC_PAGE) == UINT32_MAX) {
+            a = p;
+            break;
+        }
+    }
+    if (b - a < 8 || lo - a < NEAR + 16 || b - hi < NEAR + 32) {
+        return true;
+    }
+    const int near = near_branches_into(vm, lo, hi);
+    if (near > 0) {
+        return true;
+    }
+    const uint32_t nlo = lo - NEAR, nhi = hi + NEAR;    /* decoded when near == 0 */
+    const uint8_t *m = nc_vm_host(vm, a);   /* guest VA order, contiguous in the window */
+    const uint32_t n = b - a;
+    for (uint32_t i = 0; i + 6 <= n; i++) {
+        const uint32_t at = a + i;
+        const uint8_t op = m[i];
+        const bool decoded = near == 0 && at >= nlo && at < nhi;
+        uint32_t t = 0;
+        bool br = false;
+        if (!decoded) {
+            if (op == 0xEB || (op >= 0x70 && op <= 0x7F) || (op >= 0xE0 && op <= 0xE3)) {
+                t = at + 2 + (uint32_t)(int32_t)(int8_t)m[i + 1];
+                br = true;
+            } else if (op == 0xE8 || op == 0xE9) {
+                t = at + 5 + nc_rd32(m + i + 1);
+                br = true;
+            } else if (op == 0x0F && m[i + 1] >= 0x80 && m[i + 1] <= 0x8F) {
+                t = at + 6 + nc_rd32(m + i + 2);
+                br = true;
+            }
+        }
+        if (br && t > lo && t < hi) {
+            return true;
+        }
+        const uint32_t v = nc_rd32(m + i);
+        if (v > lo && v < hi) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/* a guest thread stopped (or a callout's return) inside (lo, hi) */
+static bool thread_inside(NcKernel *k, uint32_t lo, uint32_t hi)
+{
+    for (unsigned i = 0; i < k->threads_hi && i < NC_MAX_THREADS; i++) {
+        const NcThread *t = &k->threads[i];
+        if (t->state == NC_T_FREE || t == k->current) {
+            continue;
+        }
+        const uint32_t e = nc_context_eip(&t->ctx);
+        if (e > lo && e < hi) {
+            return true;
+        }
+        for (unsigned c = 0; c < t->ncallouts && c < sizeof(t->callout_ret) / sizeof(t->callout_ret[0]); c++) {
+            if (t->callout_ret[c] > lo && t->callout_ret[c] < hi) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+static uint32_t stub_alloc(NcVm *vm)
+{
