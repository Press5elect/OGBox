     free(res);
     return true;
 }
+
+static uint32_t get32(const uint8_t *p)
+{
+    return p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+/* r = a - b over n words; returns the borrow out. */
+static uint32_t sub_words(uint32_t *r, const uint32_t *a, const uint32_t *b, unsigned n)
+{
+    uint64_t borrow = 0;
+    for (unsigned i = 0; i < n; i++) {
+        const uint64_t t = (uint64_t)a[i] - b[i] - borrow;
+        r[i] = (uint32_t)t;
+        borrow = t >> 63;
+    }
+    return (uint32_t)borrow;
+}
+
+/* r += b over n words (b of bn <= n); the carry out is dropped. */
+static void add_words(uint32_t *r, const uint32_t *b, unsigned bn, unsigned n)
+{
+    uint64_t carry = 0;
+    for (unsigned i = 0; i < n; i++) {
+        const uint64_t t = (uint64_t)r[i] + (i < bn ? b[i] : 0) + carry;
+        r[i] = (uint32_t)t;
+        carry = t >> 32;
+    }
+}
+
+bool nc_xc_pk_private(const uint8_t *key, const uint8_t *in, uint8_t *out)
+{
+    const uint32_t keylen = get32(key + 4), bitlen = get32(key + 8);
+    if (get32(key) != NC_XC_RSA2 || !bitlen || keylen < bitlen / 8 || keylen > 1024 || keylen % 8) {
+        return false;
+    }
+    const unsigned n = keylen / 4, h = n / 2;
+    uint32_t *w = calloc(2 * n + 8 * h, 4);
+    uint32_t *x = w, *m = x + n, *p = m + n, *q = p + h, *dp = q + h, *dq = dp + h, *qinv = dq + h;
+    uint32_t *m1 = qinv + h, *m2 = m1 + h, *t = m2 + h;
+    memcpy(x, in, bitlen / 8);
+    memcpy(m, key + 0x14, keylen);
+    memcpy(p, key + 0x14 + keylen, 5 * (keylen / 2)); /* prime1 .. coefficient */
+    /* the input must be below the modulus */
+    int i = (int)n - 1;
+    while (i > 0 && x[i] == m[i]) {
+        i--;
+    }
+    bool ok = x[i] < m[i];
+    /* By the Chinese remainder theorem, as the Xbox kernel: m1 = x^dp mod p,
+     * m2 = x^dq mod q, then out = m2 + q * (qinv * (m1 - m2) mod p). */
+    if (ok) {
+        mod_reduce(t, x, n, p, h);
+        ok = nc_modexp(m1, t, dp, p, h);
+        mod_reduce(t, x, n, q, h);
+        ok = ok && nc_modexp(m2, t, dq, q, h);
+    }
+    if (ok) {
+        mod_reduce(t, m2, h, p, h);
+        if (sub_words(t, m1, t, h)) {
+            add_words(t, p, h, h);
+        }
+        mul_mod(t, qinv, t, p, h);
+        memset(x, 0, n * 4);
+        for (unsigned a = 0; a < h; a++) {
+            uint64_t carry = 0;
+            for (unsigned b = 0; b < h; b++) {
+                const uint64_t v = (uint64_t)t[a] * q[b] + x[a + b] + carry;
+                x[a + b] = (uint32_t)v;
+                carry = v >> 32;
+            }
+            x[a + h] = (uint32_t)carry;
+        }
+        add_words(x, m2, h, n);
+        memcpy(out, x, keylen);
+    }
+    free(w);
+    return ok;
+}
+
+static void put32(uint8_t *p, uint32_t v)
+{
+    p[0] = (uint8_t)v;
+    p[1] = (uint8_t)(v >> 8);
+    p[2] = (uint8_t)(v >> 16);
+    p[3] = (uint8_t)(v >> 24);
+}
+
+/* A synthetic XePublicKeyData for the emulated drive's security sector.
+ * With a public exponent of 1 and a modulus of all ones, the public-key
+ * operation returns a signature unchanged, so a valid signature is just the
+ * expected PKCS #1 block and needs no private key. It lets the check pass
+ * without proving anything about the disc.
+ * Layout (BSAFE): "RSA1", key length 0x108, 2048 bits, 255 data bytes, the
+ * public exponent, then the modulus. */
+void nc_xc_public_key(uint8_t blob[NC_XC_PUBKEY_SIZE])
+{
+    memset(blob, 0, NC_XC_PUBKEY_SIZE);
+    put32(blob, 0x31415352u);
+    put32(blob + 4, 0x108);
+    put32(blob + 8, NC_XC_SIG_SIZE * 8);
+    put32(blob + 0xC, NC_XC_SIG_SIZE - 1);
+    put32(blob + 0x10, 1);
+    memset(blob + 0x14, 0xFF, NC_XC_SIG_SIZE);
+}
+
+/* Signs digest for the synthetic XePublicKeyData: writes the PKCS #1 type 1
+ * block 00 01 FF..FF 00 digest, byte-reversed, because
+ * XcVerifyPKCS1Signature reads numbers little-endian. */
+void nc_xc_sign(const uint8_t digest[20], uint8_t sig[NC_XC_SIG_SIZE])
+{
+    memset(sig, 0xFF, NC_XC_SIG_SIZE);
+    for (int i = 0; i < 20; i++) {
+        sig[i] = digest[19 - i];
+    }
+    sig[20] = 0;
+    sig[NC_XC_SIG_SIZE - 2] = 1;
+    sig[NC_XC_SIG_SIZE - 1] = 0;
+}
