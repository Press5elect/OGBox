+static struct {
+    float fog[4];                       /* vcarry */
+    uint64_t gen;                       /* bumped as fog changes (the constant block's reuse) */
+    bool wanted, pending, have_consts;
+    FcProg *p;                          /* pending: the program, its inputs */
+    uint64_t cgen;
+    float cur[ATTRS][4];
+    uint32_t consts[HLE_VSH_CONSTANTS][4];
+    uint64_t runs;
