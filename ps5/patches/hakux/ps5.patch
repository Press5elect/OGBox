+#include <string.h>
+#include <time.h>
+
+#include "native/dev/apu/vp/resample.h"
+#include "native/dev/apu/vp/simd.h"
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+
+/* ---- a test signal, 32 stereo frames a callback */
+enum { TONE, IMPULSE, STEP };
+
+typedef struct {
+    int kind;
+    double fs;                  /* its rate */
+    double f[2], amp[2];        /* each channel's tone (f 0: DC) */
+    long at;                    /* the impulse's or step's frame */
+    long len;                   /* frames, then silence (-1: endless) */
+    long n;                     /* frames given */
+    float buf[64];
+} Signal;
+
+static long feed(void *p, float **data)
+{
+    Signal *s = p;
+    for (int i = 0; i < 32; i++) {
+        const long n = s->n + i;
+        for (int ch = 0; ch < 2; ch++) {
+            float v = 0.0f;
+            if (s->len < 0 || n < s->len) {
+                switch (s->kind) {
+                case TONE:
+                    v = s->f[ch] ? (float)(s->amp[ch] * sin(2 * M_PI * s->f[ch] * n / s->fs)) : (float)s->amp[ch];
+                    break;
+                case IMPULSE:
+                    v = n == s->at ? (float)s->amp[ch] : 0.0f;
+                    break;
+                default:
+                    v = n >= s->at ? (float)s->amp[ch] : 0.0f;
+                    break;
+                }
+            }
+            s->buf[2 * i + ch] = v;
+        }
+    }
+    s->n += 32;
+    *data = s->buf;
+    return 32;          /* always 32, padded with silence, as the VP's callback */
+}
+
+static Signal tone(double fs, double fl, double al, double fr, double ar)
+{
+    return (Signal){.kind = TONE, .fs = fs, .f = {fl, fr}, .amp = {al, ar}, .len = -1};
+}
+
+/* n output frames of s at ratio, read 32 at a time */
+static float *convert(int quality, Signal *s, double ratio, long n)
+{
+    float *out = calloc((size_t)n * 2, sizeof(float));
+    VpResampler *r = vp_resample_new(feed, quality, 2, s);
+    for (long done = 0; done < n;) {
+        const long want = n - done < 32 ? n - done : 32;
+        const long got = vp_resample_read(r, ratio, want, out + 2 * done);
+        HT_CHECK(got == want);
+        if (got <= 0) {
+            break;
+        }
+        done += got;
+    }
+    vp_resample_delete(r);
+    return out;
+}
+
+/* the amplitude of the sine at f in channel ch of y[start, start + n) */
+static double fit(const float *y, int ch, long start, long n, double f, double fs)
+{
+    double m[3][4] = {{0}};
+    for (long i = 0; i < n; i++) {
+        const double a = sin(2 * M_PI * f * i / fs), b = cos(2 * M_PI * f * i / fs), v = y[2 * (start + i) + ch];
+        const double row[4] = {a, b, 1.0, v};
+        for (int r = 0; r < 3; r++) {
+            for (int c = 0; c < 4; c++) {
+                m[r][c] += row[r] * row[c];
+            }
+        }
+    }
+    for (int c = 0; c < 3; c++) {
+        for (int r = c + 1; r < 3; r++) {
+            const double k = m[r][c] / m[c][c];
+            for (int j = c; j < 4; j++) {
+                m[r][j] -= k * m[c][j];
+            }
+        }
+    }
+    double x[3];
+    for (int r = 2; r >= 0; r--) {
+        double v = m[r][3];
+        for (int j = r + 1; j < 3; j++) {
+            v -= m[r][j] * x[j];
+        }
+        x[r] = v / m[r][r];
+    }
+    return sqrt(x[0] * x[0] + x[1] * x[1]);
+}
+
+static double db(double x)
+{
+    return 20.0 * log10(x);
+}
+
+static const char *const k_name[2] = {"linear", "sinc"};
+static int g_qualities;         /* 1: linear only, 2: and sinc */
+
+/* ---- the criteria */
+
+/* 22.05 kHz to 48 kHz: 1, 8, 9, 9.5 and 10 kHz within 1 dB */
+static void test_passband_22k(void)
+{
+    static const double tones[] = {1000, 8000, 9000, 9500, 10000};
+    for (int q = 0; q < g_qualities; q++) {
+        fprintf(stderr, "  %-6s 22.05 -> 48 kHz:", k_name[q]);
+        for (size_t k = 0; k < sizeof(tones) / sizeof(tones[0]); k++) {
+            Signal s = tone(22050, tones[k], 0.5, tones[k], 0.5);
+            float *y = convert(q, &s, 48000.0 / 22050, 12000);
+            const double l = db(fit(y, 0, 4000, 7200, tones[k], 48000) / 0.5);
+            const double r = db(fit(y, 1, 4000, 7200, tones[k], 48000) / 0.5);
+            fprintf(stderr, " %5.0f Hz %+6.2f dB", tones[k], l);
+            HT_CHECK(fabs(l - r) < 0.01);
+            if (q == VP_RESAMPLE_SINC) {
+                HT_CHECK(fabs(l) < 1.0);
+            }
+            free(y);
+        }
+        fprintf(stderr, "\n");
+    }
+}
+
+/* 96 kHz to 48 kHz: a 30 kHz tone's 18 kHz alias 40 dB under the input */
+static void test_alias_96k(void)
+{
+    for (int q = 0; q < g_qualities; q++) {
+        Signal s = tone(96000, 30000, 0.5, 30000, 0.5);
+        float *y = convert(q, &s, 0.5, 12000);
+        const double a = db(fit(y, 0, 4000, 7200, 18000, 48000) / 0.5);
+        fprintf(stderr, "  %-6s 96 -> 48 kHz, 30 kHz in: 18 kHz alias %+7.1f dB\n", k_name[q], a);
+        if (q == VP_RESAMPLE_SINC) {
+            HT_CHECK(a < -40.0);
+        }
+        free(y);
+    }
+}
+
+/* 48 kHz to 24 kHz (a voice pitched up an octave): 5 kHz kept */
+static void test_downsample_passband(void)
+{
+    for (int q = 0; q < g_qualities; q++) {
+        Signal s = tone(48000, 5000, 0.5, 5000, 0.5);
+        float *y = convert(q, &s, 0.5, 12000);
+        const double l = db(fit(y, 0, 4000, 7200, 5000, 24000) / 0.5);
+        fprintf(stderr, "  %-6s 48 -> 24 kHz: 5 kHz %+6.2f dB\n", k_name[q], l);
+        if (q == VP_RESAMPLE_SINC) {
+            HT_CHECK(fabs(l) < 1.0);
+        }
+        free(y);
+    }
+}
+
+/* unity: 1 kHz as it was */
+static void test_unity(void)
+{
+    for (int q = 0; q < g_qualities; q++) {
+        Signal s = tone(48000, 1000, 0.5, 3000, 0.25);
+        float *y = convert(q, &s, 1.0, 12000);
+        const double l = db(fit(y, 0, 4000, 7200, 1000, 48000) / 0.5), r = db(fit(y, 1, 4000, 7200, 3000, 48000) / 0.25);
+        fprintf(stderr, "  %-6s unity: 1 kHz %+6.3f dB, 3 kHz %+6.3f dB\n", k_name[q], l, r);
+        HT_CHECK(fabs(l) < 0.1 && fabs(r) < 0.1);
+        free(y);
+    }
+}
+
+/* a silent channel stays silent beside a loud one; silence stays silence */
+static void test_channels_and_silence(void)
+{
+    for (int q = 0; q < g_qualities; q++) {
+        Signal s = tone(22050, 1000, 0.9, 0, 0.0);
+        float *y = convert(q, &s, 48000.0 / 22050, 6000);
+        unsigned leaked = 0;
+        for (long i = 0; i < 6000; i++) {
+            leaked += y[2 * i + 1] != 0.0f;
+        }
+        free(y);
+        Signal z = tone(22050, 0, 0.0, 0, 0.0);
+        y = convert(q, &z, 48000.0 / 22050, 6000);
+        unsigned noise = 0;
+        for (long i = 0; i < 12000; i++) {
+            noise += y[i] != 0.0f;
+        }
+        free(y);
+        fprintf(stderr, "  %-6s channel leakage: %u samples; silence: %u non-zero\n", k_name[q], leaked, noise);
+        HT_EQ_INT(leaked, 0);
+        HT_EQ_INT(noise, 0);
+    }
+}
+
+/* DC gain, an impulse's delay, a step's overshoot, and how long a sound's
+ * tail rings after its input stops */
+static void test_dc_impulse_step_tail(void)
+{
+    for (int q = 0; q < g_qualities; q++) {
+        const double ratio = 48000.0 / 22050;
+        Signal dc = tone(22050, 0, 0.5, 0, 0.5);
+        float *y = convert(q, &dc, ratio, 6000);
+        double mean = 0;
+        for (long i = 3000; i < 6000; i++) {
+            mean += y[2 * i];
+        }
+        mean /= 3000;
+        free(y);
+        Signal imp = {.kind = IMPULSE, .fs = 22050, .amp = {1.0, 1.0}, .at = 1000, .len = -1};
+        y = convert(q, &imp, ratio, 4000);
+        long peak = 0;
+        for (long i = 1; i < 4000; i++) {
+            peak = fabsf(y[2 * i]) > fabsf(y[2 * peak]) ? i : peak;
+        }
+        free(y);
+        Signal step = {.kind = STEP, .fs = 22050, .amp = {0.5, 0.5}, .at = 1000, .len = -1};
+        y = convert(q, &step, ratio, 4000);
+        double top = 0;
+        for (long i = 0; i < 4000; i++) {
+            top = fmax(top, y[2 * i]);
+        }
+        free(y);
+        Signal fin = tone(22050, 1000, 0.5, 1000, 0.5);
+        fin.len = 2000;                     /* then silence, as a voice that ended */
+        y = convert(q, &fin, ratio, 8000);
+        const long end = (long)ceil(2000 * ratio);
+        long rings = 0;
+        for (long i = end; i < 8000; i++) {
+            if (fabsf(y[2 * i]) > 1e-4f) {
+                rings = i - end + 1;
+            }
+        }
+        free(y);
+        const double delay = peak - 1000 * ratio;
+        fprintf(stderr, "  %-6s DC gain %+7.4f dB, impulse delay %+.1f output frames, step overshoot %.1f %%, "
+                        "tail after the input ends %ld output frames\n",
+                k_name[q], db(mean / 0.5), delay, (top / 0.5 - 1) * 100, rings);
+        HT_CHECK(fabs(db(mean / 0.5)) < 0.1);
+        HT_CHECK(rings < 200);
+        HT_CHECK(top < 0.5 * 1.2);
+    }
+}
+
+/* How far ahead of its output a converter has taken its input: the frames
+ * the callback gave past what the output covers (the decoder, and the
+ * voice's guest-visible position, run that far ahead of what is heard),
+ * the callback's 32-frame granularity included */
+static void test_lookahead(void)
+{
+    static const double ratios[] = {48000.0 / 22050, 1.0, 0.5};
+    for (int q = 0; q < g_qualities; q++) {
+        fprintf(stderr, "  %-6s input taken ahead of the output:", k_name[q]);
+        for (size_t k = 0; k < sizeof(ratios) / sizeof(ratios[0]); k++) {
+            Signal s = tone(22050, 500, 0.5, 500, 0.5);
+            long worst = 0;
+            VpResampler *r = vp_resample_new(feed, q, 2, &s);
+            float y[64];
+            for (long out = 32; out <= 32 * 300; out += 32) {
+                vp_resample_read(r, ratios[k], 32, y);
+                const long ahead = s.n - (long)floor(out / ratios[k]);
+                worst = ahead > worst ? ahead : worst;
+            }
+            vp_resample_delete(r);
+            fprintf(stderr, "  ratio %.3f: up to %ld frames", ratios[k], worst);
+            HT_CHECK(worst <= (q == VP_RESAMPLE_SINC ? 200 : 64));
+        }
+        fprintf(stderr, "\n");
+    }
+}
+
+/* the same output whatever the reads' sizes (1, 31, 32, 33, 256 frames)
+ * as one continuous conversion at the same rate */
+static void test_chunking(void)
+{
+    static const long sizes[] = {1, 31, 32, 33, 256};
+    const long n = 9000;
+    const double ratio = 48000.0 / 22050;
+    for (int q = 0; q < g_qualities; q++) {
+        Signal s0 = tone(22050, 1234, 0.5, 4321, 0.3);
+        float *ref = convert(q, &s0, ratio, n);
+        double worst = 0;
+        for (size_t k = 0; k < sizeof(sizes) / sizeof(sizes[0]); k++) {
+            Signal s = tone(22050, 1234, 0.5, 4321, 0.3);
+            float *y = calloc((size_t)n * 2, sizeof(float));
+            VpResampler *r = vp_resample_new(feed, q, 2, &s);
+            for (long done = 0; done < n;) {
+                const long want = n - done < sizes[k] ? n - done : sizes[k];
+                const long got = vp_resample_read(r, ratio, want, y + 2 * done);
+                HT_CHECK(got == want);
+                done += got > 0 ? got : n;
+            }
+            vp_resample_delete(r);
+            for (long i = 0; i < 2 * n; i++) {
+                worst = fmax(worst, fabs((double)y[i] - ref[i]));
+            }
+            free(y);
+        }
+        free(ref);
+        fprintf(stderr, "  %-6s chunks of 1, 31, 32, 33, 256 vs continuous: largest difference %.3g\n", k_name[q],
+                worst);
+        HT_CHECK(worst <= 1e-6);
+    }
+}
+
+/* the pitch changing every read (1.6 and 2.6 in turn): no NaN, no jump
+ * larger than the tone's own steepest step (with room for the ratio's) */
+static void test_rapid_pitch(void)
+{
+    for (int q = 0; q < g_qualities; q++) {
+        Signal s = tone(22050, 300, 0.5, 300, 0.5);
+        VpResampler *r = vp_resample_new(feed, q, 2, &s);
+        float y[64];
+        float last = 0.0f;
+        double worst = 0;
+        bool finite = true;
+        for (int i = 0; i < 4000; i++) {
+            const double ratio = i % 2 ? 2.6 : 1.6;
+            HT_CHECK(vp_resample_read(r, ratio, 32, y) == 32);
+            for (int k = 0; k < 32; k++) {
+                finite &= isfinite(y[2 * k]) != 0;
+                if (i > 50) {
+                    worst = fmax(worst, fabs((double)y[2 * k] - last));
+                }
+                last = y[2 * k];
+            }
+        }
+        vp_resample_delete(r);
+        const double bound = 0.5 * 2 * M_PI * 300 / 22050 / 1.6;   /* the steepest step at the slower ratio */
+        fprintf(stderr, "  %-6s pitch 1.6 / 2.6 each read: largest step %.4f (the tone's steepest %.4f)\n", k_name[q],
+                worst, bound);
+        HT_CHECK(finite);
+        HT_CHECK(worst < 1.5 * bound);
+    }
+}
+
+/* the pitch's whole range with its envelope, changing every read (1/512,
+ * the stretched filter's widest 1/8 and past it, just under and at 1, 512):
+ * every read whole, every sample finite and within the input's peak */
+static void test_extremes(void)
+{
+    static const double ratios[] = {1.0 / 512, 0.125, 0.13, 0.99, 1.0, 512.0, 0.1, 3.0};
+    for (int q = 0; q < g_qualities; q++) {
+        Signal s = tone(22050, 440, 0.5, 660, 0.5);
+        VpResampler *r = vp_resample_new(feed, q, 2, &s);
+        float y[64];
+        bool whole = true, bounded = true;
+        for (int i = 0; i < 4000; i++) {
+            whole &= vp_resample_read(r, ratios[i % 8], 32, y) == 32;
+            for (int k = 0; k < 64; k++) {
+                bounded &= isfinite(y[k]) && fabsf(y[k]) < 0.5f * 1.2f;
+            }
+        }
+        vp_resample_delete(r);
+        fprintf(stderr, "  %-6s ratios 1/512 to 512 in turn: %s, %s\n", k_name[q], whole ? "every read whole" : "short",
+                bounded ? "finite and bounded" : "out of bounds");
+        HT_CHECK(whole);
+        HT_CHECK(bounded);
+    }
+}
+
+/* each ratio's rate as asked, to the VP's 1/512 and 512 (base pitch and
+ * envelope): after n output frames the input taken is n / ratio plus what
+ * the converter holds ahead (vp_resample_ahead; negative when the position
+ * has stepped past it, up to a step), within its look-ahead and a
+ * callback's 32 frames. Linear keeps its position in float: within 0.1 %. */
+static void test_rate(void)
+{
+    static const double ratios[] = {1.0 / 512, 1.0 / 300, 1.0 / 9, 0.5, 2.0, 300.0, 512.0};
+    for (int q = 0; q < g_qualities; q++) {
+        fprintf(stderr, "  %-6s input taken against n / ratio:", k_name[q]);
+        for (size_t k = 0; k < sizeof(ratios) / sizeof(ratios[0]); k++) {
+            Signal s = tone(22050, 440, 0.5, 660, 0.5);
+            VpResampler *r = vp_resample_new(feed, q, 2, &s);
+            const long n = ratios[k] < 1 ? 64 : (long)(64 * ratios[k]);
+            float y[64];
+            for (long done = 0; done < n; done += 32) {
+                vp_resample_read(r, ratios[k], 32, y);
+            }
+            const double taken = s.n - vp_resample_ahead(r), want = n / ratios[k];
+            const double ahead = vp_resample_ahead(r);
+            vp_resample_delete(r);
+            fprintf(stderr, "  %g: %+.2g (ahead %.0f)", ratios[k], taken - want, ahead);
+            HT_CHECK(fabs(taken - want) < (q == VP_RESAMPLE_SINC ? 1e-6 : 1e-3) * want + 1e-6);
+            HT_CHECK(ahead >= -1 / ratios[k] && ahead <= 140 + 32);
+        }
+        fprintf(stderr, "\n");
+    }
+}
+
+/* a voice reused (reset) converts its new sound as a new converter does */
+static void test_reuse(void)
+{
+    for (int q = 0; q < g_qualities; q++) {
+        /* one converter and one callback object, as the VP's voice filter:
+         * a sound, then the voice's next sound in the same object */
+        Signal s = tone(22050, 700, 0.8, 900, 0.8);
+        VpResampler *r = vp_resample_new(feed, q, 2, &s);
+        float junk[64];
+        for (int i = 0; i < 100; i++) {
+            vp_resample_read(r, 1.3, 32, junk);
+        }
+        const Signal next = tone(32000, 2000, 0.4, 2500, 0.2);
+        s = next;
+        vp_resample_reset(r);
+        float y[64 * 50], fresh[64 * 50];
+        for (int i = 0; i < 50; i++) {
+            vp_resample_read(r, 48000.0 / 32000, 32, y + 64 * i);
+        }
+        vp_resample_delete(r);
+        Signal c = next;
+        VpResampler *f = vp_resample_new(feed, q, 2, &c);
+        for (int i = 0; i < 50; i++) {
+            vp_resample_read(f, 48000.0 / 32000, 32, fresh + 64 * i);
+        }
+        vp_resample_delete(f);
+        fprintf(stderr, "  %-6s reset: %s\n", k_name[q], memcmp(y, fresh, sizeof(y)) ? "differs" : "as new");
+        HT_CHECK(memcmp(y, fresh, sizeof(y)) == 0);
+    }
+}
+
+/* `bench`: a voice-frame's time, 32 stereo output frames, by quality and
+ * input rate, from a callback that only hands over a buffer */
+static long feed_buffer(void *p, float **data)
+{
+    *data = p;
+    return 32;
+}
+
+static void bench(void)
+{
+    static const double rates[] = {22050, 32000, 44100, 48000, 96000};
+    float in[64];
+    for (int i = 0; i < 64; i++) {
+        in[i] = (float)(0.5 * sin(i * 0.3));
+    }
+    for (int q = 0; q < g_qualities; q++) {
+        fprintf(stderr, "  bench %-6s", k_name[q]);
+        for (size_t k = 0; k < sizeof(rates) / sizeof(rates[0]); k++) {
+            VpResampler *r = vp_resample_new(feed_buffer, q, 2, in);
+            float y[64];
+            for (int i = 0; i < 200; i++) {
+                vp_resample_read(r, 48000.0 / rates[k], 32, y);
+            }
+            struct timespec t0, t1;
+            clock_gettime(CLOCK_MONOTONIC, &t0);
+            for (int i = 0; i < 20000; i++) {
+                vp_resample_read(r, 48000.0 / rates[k], 32, y);
+            }
+            clock_gettime(CLOCK_MONOTONIC, &t1);
+            vp_resample_delete(r);
+            const double us = ((t1.tv_sec - t0.tv_sec) * 1e6 + (t1.tv_nsec - t0.tv_nsec) / 1e3) / 20000;
+            fprintf(stderr, "  %5.0f Hz %6.3f us", rates[k], us);
+        }
+        fprintf(stderr, "  (a voice-frame)\n");
+    }
+}
+
+#if defined(__x86_64__)
+/* The levels' sinc against each other (vp/simd.h): AVX2 + FMA, SSE2 and
+ * scalar code round differently, within a 16-bit sample's 1/4 */
+static void test_levels_agree(void)
+{
+    static const double ratios[] = {48000.0 / 22050, 48000.0 / 32000, 1.0, 48000.0 / 64000, 48000.0 / 96000,
+                                    48000.0 / 192000, 48000.0 / 1e6};
+    const int top = vp_simd_set(VP_SIMD_AVX2);
+    for (size_t k = 0; k < sizeof(ratios) / sizeof(ratios[0]); k++) {
+        float *y[3] = {NULL};
+        for (int level = VP_SIMD_SCALAR; level <= top; level++) {
+            vp_simd_set(level);
+            Signal s = tone(48000 / ratios[k], 997, 0.5, 3001, 0.7);
+            y[level] = convert(VP_RESAMPLE_SINC, &s, ratios[k], 4096);
+        }
+        fprintf(stderr, "  sinc at %.4f:", ratios[k]);
+        for (int level = VP_SIMD_SCALAR; level < top; level++) {
+            double e = 0;
+            for (long i = 0; i < 2 * 4096; i++) {
+                e = fmax(e, fabs((double)y[level][i] - y[top][i]));
+            }
+            fprintf(stderr, " %s %.3g", vp_simd_name(level), e);
+            HT_CHECK(e < 0.25 / 32768);
+        }
+        fprintf(stderr, " off %s\n", vp_simd_name(top));
+        for (int level = VP_SIMD_SCALAR; level <= top; level++) {
+            free(y[level]);
+        }
+    }
+    vp_simd_set(top);
+}
+#endif
+
+static void run_suite(void)
+{
+    HT_RUN(test_passband_22k);
+    HT_RUN(test_alias_96k);
+    HT_RUN(test_downsample_passband);
+    HT_RUN(test_unity);
+    HT_RUN(test_channels_and_silence);
+    HT_RUN(test_dc_impulse_step_tail);
+    HT_RUN(test_lookahead);
+    HT_RUN(test_chunking);
+    HT_RUN(test_rapid_pitch);
+    HT_RUN(test_extremes);
+    HT_RUN(test_rate);
+    HT_RUN(test_reuse);
+}
+
+int main(int argc, char **argv)
+{
+    g_qualities = vp_resample_sinc_available() ? 2 : 1;
+#if defined(__x86_64__)
+    /* each vector level the host has (vp/simd.h), highest first */
+    for (int level = vp_simd_set(VP_SIMD_AVX2); level >= VP_SIMD_SCALAR; level--) {
+        vp_simd_set(level);
+        fprintf(stderr, "  vector paths: %s\n", vp_simd_name(level));
+        if (argc > 1 && !strcmp(argv[1], "bench")) {
+            bench();
+        } else {
+            run_suite();
+        }
+    }
+    vp_simd_set(VP_SIMD_AVX2);
+    if (argc > 1 && !strcmp(argv[1], "bench")) {
+        return 0;
+    }
+    HT_RUN(test_levels_agree);
+#else
+    if (argc > 1 && !strcmp(argv[1], "bench")) {
+        bench();
+        return 0;
+    }
+    if (g_qualities == 1) {
+        fprintf(stderr, "  sinc not in this build: linear only\n");
+    }
+    run_suite();
+#endif
+    HT_DONE();
+}
diff --git a/tests/hle/test_apu_simd.c b/tests/hle/test_apu_simd.c
new file mode 100644
index 0000000000000000000000000000000000000000..7a1c8666f793b6ecb38c6a587759a7ec7d397d84
--- /dev/null
+++ b/tests/hle/test_apu_simd.c
@@ -0,0 +1,399 @@
+/* Copyright (C) 2026-present PortareOS */
+/* The VP's vector paths against scalar models of their arithmetic, bit for
+ * bit: the mix (vp/mix_inline.h) and the HRTF filter's dot product
+ * (vp/hrtf.h), NEON's and AVX2's fused multiply-adds against fmaf in NEON's
+ * lanes and order, SSE2's multiplies and adds against the scalar forms; the
+ * monitor's float to 16-bit conversion and the linear resampler's stereo
+ * path (vp/resample.c) against the scalar code. On x86-64 at each level the
+ * host has (vp/simd.h). `test_apu_simd bench`: each path's time by level
+ * (configured with -DCMAKE_BUILD_TYPE=Release). */
+#include "hle_test.h"
+
+#include <math.h>
+#include <stdbool.h>
+#include <stdlib.h>
+#include <time.h>
+
+#include "native/dev/apu/vp/hrtf.h"
+#include "native/dev/apu/vp/mix_inline.h"
+#include "native/dev/apu/vp/resample.h"
+
+static uint32_t g_rng = 2026;
+
+static float rnd(void)   /* [-1, 1) */
+{
+    g_rng = g_rng * 1664525u + 1013904223u;
+    return (float)(int32_t)g_rng / 2147483648.0f;
+}
+
+/* the levels to run: x86-64's the host has, highest first; elsewhere one */
+static int levels(int *out)
+{
+    int n = 0;
+#if defined(__x86_64__)
+    for (int l = vp_simd_set(VP_SIMD_AVX2); l >= VP_SIMD_SCALAR; l--) {
+        out[n++] = l;
+    }
+#else
+    out[n++] = 0;
+#endif
+    return n;
+}
+
+static void set_level(int level)
+{
+#if defined(__x86_64__)
+    vp_simd_set(level);
+#else
+    (void)level;
+#endif
+}
+
+/* back to the host's highest */
+static void reset_level(void)
+{
+#if defined(__x86_64__)
+    vp_simd_set(VP_SIMD_AVX2);
+#endif
+}
+
+static const char *level_name(int level)
+{
+#if defined(__x86_64__)
+    return vp_simd_name(level);
+#else
+    (void)level;
+    return "NEON";
+#endif
+}
+
+/* fused: the path rounds a multiply-add once (NEON, AVX2 + FMA) */
+static bool fused(int level)
+{
+#if defined(__x86_64__)
+#if defined(__FMA__)
+    return level != VP_SIMD_SSE2;   /* the compiler may fuse the scalar form */
+#else
+    return level == VP_SIMD_AVX2;
+#endif
+#else
+    (void)level;
+    return true;
+#endif
+}
+
+/* the path sums as NEON does (NEON itself; AVX2 + FMA) */
+static bool neon_sums(int level)
+{
+#if defined(__x86_64__)
+    return level == VP_SIMD_AVX2;
+#elif defined(__aarch64__)
+    (void)level;
+    return true;
+#else
+    (void)level;
+    return false;
+#endif
+}
+
+/* ---- the mix */
+static void test_mix(void)
+{
+    int ls[3];
+    const int nl = levels(ls);
+    for (int li = 0; li < nl; li++) {
+        set_level(ls[li]);
+        unsigned off = 0;
+        for (int trial = 0; trial < 2000; trial++) {
+            float src[NUM_SAMPLES_PER_FRAME], dst[NUM_SAMPLES_PER_FRAME], want[NUM_SAMPLES_PER_FRAME];
+            const float g = rnd() * 2.0f;
+            for (int i = 0; i < NUM_SAMPLES_PER_FRAME; i++) {
+                src[i] = rnd() * (i & 1 ? 1.0f : 1e-3f);
+                dst[i] = rnd() * 4.0f;
+                if (fused(ls[li])) {
+                    want[i] = fmaf(g, src[i], dst[i]);
+                } else {
+                    const float p = g * src[i];
+                    want[i] = dst[i] + p;
+                }
+            }
+            mix_one_bin(dst, src, g);
+            off += memcmp(dst, want, sizeof(dst)) != 0;
+        }
+        fprintf(stderr, "  mix %-8s %s: %u of 2000 frames off\n", level_name(ls[li]),
+                fused(ls[li]) ? "fused" : "multiply, add", off);
+        HT_EQ_INT(off, 0);
+    }
+    reset_level();
+}
+
+/* ---- the HRTF filter's dot product */
+
+/* NEON's hrtf_dot in scalar code: two 4-lane accumulators, each fused
+ * multiply-add one rounding, summed (a0 + a1), then (0 + 1) + (2 + 3) */
+static float neon_dot(float *c, const float *tar, const float *w, float dfrac)
+{
+    const bool interp = dfrac > 0.0f;
+    const float w0 = 1 - dfrac;
+    float a[8] = {0};
+    for (int m = 0; m < HRTF_TAPS_PADDED; m += 8) {
+        for (int j = 0; j < 8; j++) {
+            float cj = c[m + j];
+            if (tar) {
+                cj = fmaf(tar[m + j] - cj, HRTF_PARAM_SMOOTH_ALPHA, cj);
+                c[m + j] = cj;
+            }
+            float s = w[m + j];
+            if (interp) {
+                const float p = w[m + j - 1] * dfrac;
+                s = fmaf(s, w0, p);
+            }
+            a[j] = fmaf(cj, s, a[j]);
+        }
+    }
+    float t[4];
+    for (int j = 0; j < 4; j++) {
+        t[j] = a[j] + a[j + 4];
+    }
+    const float lo = t[0] + t[1], hi = t[2] + t[3];
+    return lo + hi;
+}
+
+#if defined(__x86_64__)
+static VP_AVX2 float dot_avx2(float *c, const float *tar, const float *w, float dfrac)
+{
+    return hrtf_dot_avx2(c, tar, w, dfrac);
+}
+#endif
+
+/* the build's NEON path or x86-64's AVX2 one against the model: the same
+ * sums, the same coefficients stepped; SSE2's within rounding */
+static void test_hrtf_neon_sums(void)
+{
+    int ls[3];
+    const int nl = levels(ls);
+    for (int li = 0; li < nl; li++) {
+        const int level = ls[li];
+        unsigned off = 0, steps_off = 0;
+        double max_err = 0;
+        for (int trial = 0; trial < 4000; trial++) {
+            float c[HRTF_TAPS_PADDED], c2[HRTF_TAPS_PADDED], tar[HRTF_TAPS_PADDED], w[HRTF_TAPS_PADDED + 1];
+            for (int m = 0; m < HRTF_TAPS_PADDED; m++) {
+                c[m] = rnd() * (m < 8 ? 1.0f : 0.25f);
+                tar[m] = rnd();
+            }
+            c[HRTF_TAPS_PADDED - 1] = tar[HRTF_TAPS_PADDED - 1] = 0.0f;
+            for (int m = 0; m <= HRTF_TAPS_PADDED; m++) {
+                w[m] = rnd();
+            }
+            memcpy(c2, c, sizeof(c));
+            const bool moving = trial & 1;
+            const float dfrac = trial & 2 ? 0.0f : (trial % 97) / 97.0f;
+            const float want = neon_dot(c, moving ? tar : NULL, w + 1, dfrac);
+            float got;
+#if defined(__x86_64__)
+            if (level == VP_SIMD_AVX2) {
+                got = dot_avx2(c2, moving ? tar : NULL, w + 1, dfrac);
+            } else if (level == VP_SIMD_SSE2) {
+                got = hrtf_dot_sse2(c2, moving ? tar : NULL, w + 1, dfrac);
+            } else {
+                got = hrtf_dot(c2, moving ? tar : NULL, w + 1, dfrac);
+            }
+#else
+            got = hrtf_dot(c2, moving ? tar : NULL, w + 1, dfrac);
+#endif
+            off += memcmp(&got, &want, sizeof(got)) != 0;
+            steps_off += memcmp(c, c2, sizeof(c)) != 0;
+            max_err = fmax(max_err, fabs((double)got - want));
+        }
+        fprintf(stderr, "  hrtf %-8s %u of 4000 sums, %u coefficient steps off NEON's, max |difference| %.3g\n",
+                level_name(level), off, steps_off, max_err);
+        if (neon_sums(level)) {
+            HT_EQ_INT(off, 0);
+            HT_EQ_INT(steps_off, 0);
+        }
+        HT_CHECK(max_err < 2e-6);
+    }
+    reset_level();
+}
+
+/* ---- the monitor's conversion */
+static short to_short(float v)
+{
+    if (v != v) {
+        return 0;
+    }
+    v = v > 1.0f ? 1.0f : v < -1.0f ? -1.0f : v;
+    return (short)(v * 32767.0f);
+}
+
+static void test_float_to_short(void)
+{
+    enum { N = 70 };    /* the vector loops and their tails */
+    float in[N];
+    short want[N], got[N];
+    int ls[3];
+    const int nl = levels(ls);
+    for (int li = 0; li < nl; li++) {
+        set_level(ls[li]);
+        unsigned off = 0;
+        for (int trial = 0; trial < 500; trial++) {
+            for (int i = 0; i < N; i++) {
+                in[i] = rnd() * 1.5f;
+            }
+            /* the edges, in the vector part (NaN's conversion is undefined C) */
+            static const float edge[] = {1.0f, -1.0f, 0.0f, -0.0f, 0.99999994f, -0.99999994f,
+                                         1.0000001f, INFINITY, -INFINITY, 1e-30f, 3.0517578e-05f};
+            in[trial % 60] = edge[trial % (sizeof(edge) / sizeof(edge[0]))];
+            in[(trial * 7) % 60] = NAN;
+            for (int i = 0; i < N; i++) {
+                want[i] = to_short(in[i]);
+            }
+            vp_float_to_short_array(in, got, N);
+            off += memcmp(got, want, sizeof(got)) != 0;
+        }
+        fprintf(stderr, "  float to 16-bit %-8s %u of 500 blocks off\n", level_name(ls[li]), off);
+        HT_EQ_INT(off, 0);
+    }
+    reset_level();
+}
+
+/* ---- the linear resampler: its stereo path against each channel alone
+ * (the scalar loop), and on x86-64 against the scalar level */
+typedef struct {
+    int channels, ch;
+    long n;
+    float buf[64];
+} Feed;
+
+static long feed(void *p, float **data)
+{
+    Feed *f = p;
+    g_rng = 77 + (uint32_t)f->n;    /* the same stream for every reader */
+    for (int i = 0; i < 32; i++) {
+        const float l = rnd(), r = rnd();
+        if (f->channels == 2) {
+            f->buf[2 * i] = l;
+            f->buf[2 * i + 1] = r;
+        } else {
+            f->buf[i] = f->ch ? r : l;
+        }
+    }
+    f->n += 32;
+    *data = f->buf;
+    return 32;
+}
+
+static void linear(int channels, int ch, double ratio, float *out, long frames)
+{
+    Feed f = {.channels = channels, .ch = ch};
+    VpResampler *r = vp_resample_new(feed, VP_RESAMPLE_LINEAR, channels, &f);
+    for (long done = 0; done < frames; done += 32) {
+        HT_CHECK(vp_resample_read(r, ratio, 32, out + done * channels) == 32);
+    }
+    vp_resample_delete(r);
+}
+
+static void test_linear_stereo(void)
+{
+    enum { FRAMES = 4096 };
+    static float st[2 * FRAMES], mono[2][FRAMES], ref[2 * FRAMES];
+    static const double ratios[] = {48000.0 / 22050, 48000.0 / 32000, 1.0, 48000.0 / 44100, 0.37, 3.7};
+    int ls[3];
+    const int nl = levels(ls);
+    unsigned off = 0, levels_off = 0;
+    for (size_t k = 0; k < sizeof(ratios) / sizeof(ratios[0]); k++) {
+        set_level(ls[nl - 1]);
+        linear(2, 0, ratios[k], ref, FRAMES);
+        for (int li = 0; li < nl; li++) {
+            set_level(ls[li]);
+            linear(2, 0, ratios[k], st, FRAMES);
+            linear(1, 0, ratios[k], mono[0], FRAMES);
+            linear(1, 1, ratios[k], mono[1], FRAMES);
+            for (long i = 0; i < FRAMES; i++) {
+                off += memcmp(&st[2 * i], &mono[0][i], 4) || memcmp(&st[2 * i + 1], &mono[1][i], 4);
+            }
+            levels_off += memcmp(st, ref, sizeof(st)) != 0;
+        }
+    }
+    fprintf(stderr, "  linear stereo: %u frames off its channels alone, %u runs off the lowest level's\n", off,
+            levels_off);
+    HT_EQ_INT(off, 0);
+    HT_EQ_INT(levels_off, 0);
+    reset_level();
+}
+
+/* ---- `bench`: each path's time by level */
+static double now_us(void)
+{
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return t.tv_sec * 1e6 + t.tv_nsec / 1e3;
+}
+
+static void bench(void)
+{
+    static float bins[8][NUM_SAMPLES_PER_FRAME], src[NUM_SAMPLES_PER_FRAME], conv[64];
+    static short pcm[64];
+    static HrtfFilter f;
+    float h[2][HRTF_NUM_TAPS], io[HRTF_SAMPLES_PER_FRAME][2];
+    for (int i = 0; i < NUM_SAMPLES_PER_FRAME; i++) {
+        src[i] = rnd();
+        io[i][0] = rnd();
+        io[i][1] = rnd();
+    }
+    for (int i = 0; i < 64; i++) {
+        conv[i] = rnd() * 1.2f;
+    }
+    for (int ch = 0; ch < 2; ch++) {
+        for (int k = 0; k < HRTF_NUM_TAPS; k++) {
+            h[ch][k] = rnd();
+        }
+    }
+    int ls[3];
+    const int nl = levels(ls);
+    for (int li = 0; li < nl; li++) {
+        set_level(ls[li]);
+        const int n = 200000;
+        double t = now_us();
+        for (int i = 0; i < n; i++) {
+            for (int b = 0; b < 8; b++) {
+                mix_one_bin(bins[b], src, 0.001f);
+            }
+            __asm__ __volatile__("" ::: "memory");
+        }
+        const double mix = (now_us() - t) / n * 1e3;
+        hrtf_filter_init(&f);
+        hrtf_filter_set_target_params(&f, h, 7.3f);
+        t = now_us();
+        for (int i = 0; i < n / 10; i++) {
+            if (i % 50 == 0) {
+                hrtf_filter_set_target_params(&f, h, i % 100 ? 7.3f : -11.6f);
+            }
+            hrtf_filter_process(&f, io, io);
+            __asm__ __volatile__("" ::: "memory");
+        }
+        const double hrtf = (now_us() - t) / (n / 10) * 1e3;
+        t = now_us();
+        for (int i = 0; i < n; i++) {
+            vp_float_to_short_array(conv, pcm, 64);
+            __asm__ __volatile__("" ::: "memory");
+        }
+        const double cvt = (now_us() - t) / n * 1e3;
+        fprintf(stderr, "  bench %-8s mix %6.1f ns (8 bins), hrtf %7.1f ns (a stereo frame, moving 1 in 50), "
+                "to 16-bit %5.1f ns (64 samples)\n", level_name(ls[li]), mix, hrtf, cvt);
+    }
+}
+
+int main(int argc, char **argv)
+{
+    if (argc > 1 && !strcmp(argv[1], "bench")) {
+        bench();
+        return 0;
+    }
+    HT_RUN(test_mix);
+    HT_RUN(test_hrtf_neon_sums);
+    HT_RUN(test_float_to_short);
+    HT_RUN(test_linear_stereo);
+    HT_DONE();
+}
diff --git a/tests/hle/test_apu_stereo.c b/tests/hle/test_apu_stereo.c
new file mode 100644
index 0000000000000000000000000000000000000000..b644baf17d8b396f006bb669e03ee1164b5993a9
--- /dev/null
+++ b/tests/hle/test_apu_stereo.c
@@ -0,0 +1,416 @@
+/* Copyright (C) 2026-present PortareOS */
+/* The VP's own stereo mix for 2D voices (native/dev/apu/vp/stereo_route.h,
+ * which vp.c's voice_process calls): the route a voice's sends ask for, and
+ * each send's gain into the speakers, the centre and back bins by the
+ * stereo downmix (-3 dB), the LFE and effect bins left out. The route
+ * chosen once a sound, the 3D, multipass and full-DSP cases, and the
+ * dispatch through voice processing, are the native core's apu-stereo-smoke
+ * (tests/native/linux/apu_stereo.c). */
+#include "hle_test.h"
+
+#include <math.h>
+
+#include "native/dev/apu/vp/stereo_route.h"
+
+#define N NUM_SAMPLES_PER_FRAME
+
+/* the VP's attenuation (vp.c attenuation_init): 0xFFF is mute */
+static float att_of(uint16_t vol)
+{
+    return vol == 0xFFF ? 0.0f : powf(10.0f, vol / (64.0f * -20.0f));
+}
+
+typedef struct {
+    int bin[VP_SENDS];
+    uint16_t vol[VP_SENDS];
+    uint8_t headroom[NUM_MIXBINS];
+    unsigned channels;
+    float ea;
+} Voice;
+
+/* every send muted, to bins 0..7 in turn */
+static Voice voice(unsigned channels)
+{
+    Voice v;
+    memset(&v, 0, sizeof(v));
+    for (int b = 0; b < VP_SENDS; b++) {
+        v.bin[b] = b;
+        v.vol[b] = 0xFFF;
+    }
+    v.channels = channels;
+    v.ea = 1.0f;
+    return v;
+}
+
+static int classify(const Voice *v)
+{
+    float att[VP_SENDS];
+    for (int b = 0; b < VP_SENDS; b++) {
+        att[b] = att_of(v->vol[b]);
+    }
+    return vp_stereo_classify(v->bin, att);
+}
+
+/* the sends' headroom their bins' (a 2D voice's, as vp.c gives it) */
+static void gains(const Voice *v, float g[2][2])
+{
+    float att[VP_SENDS];
+    uint8_t shift[VP_SENDS];
+    for (int b = 0; b < VP_SENDS; b++) {
+        att[b] = att_of(v->vol[b]);
+        shift[b] = v->headroom[v->bin[b]];
+    }
+    vp_stereo_gains(v->bin, att, shift, v->channels, v->ea, g);
+}
+
+/* a frame of the voice's samples: channel 0 a ramp, channel 1 another (a
+ * mono voice's channel 1 is channel 0's copy, as voice_get_samples makes it) */
+static void source(float in[N][2], unsigned channels)
+{
+    for (int i = 0; i < N; i++) {
+        in[i][0] = 0.25f + i / 64.0f;
+        in[i][1] = channels == 2 ? -0.5f + i / 128.0f : in[i][0];
+    }
+}
+
+static void mix(const Voice *v, float out[N][2])
+{
+    float g[2][2], in[N][2];
+    HT_CHECK(classify(v) == VP_ROUTE_SPEAKERS);
+    gains(v, g);
+    source(in, v->channels);
+    memset(out, 0, sizeof(float[N][2]));
+    vp_stereo_mix(out, in, g, v->channels);
+}
+
+static void test_mono_left_only(void)
+{
+    Voice v = voice(1);
+    v.vol[0] = 0;               /* slot 0 to bin 0 (front left), 0 dB */
+    float out[N][2], in[N][2];
+    mix(&v, out);
+    source(in, 1);
+    for (int i = 0; i < N; i++) {
+        HT_CHECK(out[i][0] == in[i][0]);
+        HT_CHECK(out[i][1] == 0.0f);
+    }
+}
+
+static void test_mono_right_only(void)
+{
+    Voice v = voice(1);
+    v.vol[1] = 0;               /* slot 1 to bin 1 (front right) */
+    float out[N][2], in[N][2];
+    mix(&v, out);
+    source(in, 1);
+    for (int i = 0; i < N; i++) {
+        HT_CHECK(out[i][0] == 0.0f);
+        HT_CHECK(out[i][1] == in[i][0]);
+    }
+}
+
+static void test_mono_equal(void)
+{
+    Voice v = voice(1);
+    v.vol[0] = v.vol[1] = 0;
+    float out[N][2], in[N][2];
+    mix(&v, out);
+    source(in, 1);
+    for (int i = 0; i < N; i++) {
+        HT_CHECK(out[i][0] == out[i][1]);
+        HT_CHECK(out[i][0] == in[i][0]);      /* each speaker's own send: not doubled */
+    }
+}
+
+static void test_mono_unequal(void)
+{
+    Voice v = voice(1);
+    v.vol[0] = 0x040;           /* -1 dB */
+    v.vol[1] = 0x300;           /* -12 dB */
+    float out[N][2];
+    mix(&v, out);
+    const float want = att_of(0x300) / att_of(0x040);
+    for (int i = 0; i < N; i++) {
+        HT_CHECK(fabsf(out[i][1] / out[i][0] - want) < 1e-6f * want);
+    }
+}
+
+static void test_stereo_standard(void)
+{
+    Voice v = voice(2);
+    v.vol[0] = 0x080;           /* slot 0 (source left) to front left, -2 dB */
+    v.vol[1] = 0x100;           /* slot 1 (source right) to front right, -4 dB */
+    float out[N][2], in[N][2];
+    mix(&v, out);
+    source(in, 2);
+    for (int i = 0; i < N; i++) {
+        HT_CHECK(fabsf(out[i][0] - att_of(0x080) * in[i][0]) < 1e-6f);
+        HT_CHECK(fabsf(out[i][1] - att_of(0x100) * in[i][1]) < 1e-6f);
+    }
+}
+
+/* destination by the bin a send names, source by its slot */
+static void test_stereo_reordered(void)
+{
+    Voice v = voice(2);
+    v.bin[0] = VP_BIN_FRONT_RIGHT;
+    v.bin[1] = VP_BIN_FRONT_LEFT;
+    v.vol[0] = 0x080;
+    v.vol[1] = 0x100;
+    float out[N][2], in[N][2];
+    mix(&v, out);
+    source(in, 2);
+    for (int i = 0; i < N; i++) {
+        HT_CHECK(fabsf(out[i][1] - att_of(0x080) * in[i][0]) < 1e-6f);
+        HT_CHECK(fabsf(out[i][0] - att_of(0x100) * in[i][1]) < 1e-6f);
+    }
+}
+
+static void test_headroom_per_bin(void)
+{
+    Voice v = voice(1);
+    v.vol[0] = v.vol[1] = 0;
+    v.headroom[0] = 1;          /* front left: / 2 */
+    v.headroom[1] = 2;          /* front right: / 4 */
+    float out[N][2], in[N][2];
+    mix(&v, out);
+    source(in, 1);
+    for (int i = 0; i < N; i++) {
+        HT_CHECK(out[i][0] == in[i][0] / 2);
+        HT_CHECK(out[i][1] == in[i][0] / 4);
+    }
+}
+
+/* muted sends to any bin, the effect bins and the multipass bin among them,
+ * change nothing */
+static void test_muted_sends_ignored(void)
+{
+    Voice a = voice(2), b = voice(2);
+    a.vol[0] = b.vol[0] = 0x080;
+    a.vol[1] = b.vol[1] = 0x100;
+    b.bin[2] = 2;               /* centre */
+    b.bin[3] = 3;               /* LFE */
+    b.bin[5] = 12;              /* an effect send */
+    b.bin[7] = MULTIPASS_BIN;
+    float oa[N][2], ob[N][2];
+    mix(&a, oa);
+    mix(&b, ob);
+    HT_CHECK(memcmp(oa, ob, sizeof(oa)) == 0);
+}
+
+/* every send muted: undecided (the voice silent whichever mix it gets); the
+ * amplitude envelope at 0: silence */
+static void test_silent(void)
+{
+    Voice v = voice(2);
+    HT_CHECK(classify(&v) == VP_ROUTE_UNDECIDED);
+    float out[N][2];
+    v.vol[0] = v.vol[1] = 0;
+    v.ea = 0.0f;                /* the amplitude envelope at 0 */
+    mix(&v, out);
+    for (int i = 0; i < N; i++) {
+        HT_CHECK(out[i][0] == 0.0f && out[i][1] == 0.0f);
+    }
+}
+
+/* two voices add, with no clipping of their own */
+static void test_two_voices_add(void)
+{
+    Voice a = voice(1), b = voice(2);
+    a.vol[0] = a.vol[1] = 0;
+    b.vol[0] = b.vol[1] = 0;
+    a.ea = b.ea = 1.0f;
+    float ga[2][2], gb[2][2], ia[N][2], ib[N][2], both[N][2] = {{0}}, oa[N][2] = {{0}}, ob[N][2] = {{0}};
+    HT_CHECK(classify(&a) == VP_ROUTE_SPEAKERS && classify(&b) == VP_ROUTE_SPEAKERS);
+    gains(&a, ga);
+    gains(&b, gb);
+    source(ia, 1);
+    source(ib, 2);
+    for (int i = 0; i < N; i++) {     /* past full scale together */
+        ia[i][0] = ia[i][1] = 0.9f;
+        ib[i][0] = 0.8f;
+    }
+    vp_stereo_mix(both, ia, ga, 1);
+    vp_stereo_mix(both, ib, gb, 2);
+    vp_stereo_mix(oa, ia, ga, 1);
+    vp_stereo_mix(ob, ib, gb, 2);
+    for (int i = 0; i < N; i++) {
+        HT_CHECK(both[i][0] == oa[i][0] + ob[i][0]);
+        HT_CHECK(both[i][1] == oa[i][1] + ob[i][1]);
+    }
+    HT_CHECK(both[0][0] > 1.0f);
+}
+
+/* the centre to both speakers at -3 dB: a centred sound's power kept
+ * (L^2 + R^2 = in^2) */
+static void test_centre(void)
+{
+    Voice v = voice(1);
+    v.vol[2] = 0;               /* slot 2 to bin 2 (front centre), 0 dB */
+    float out[N][2], in[N][2];
+    mix(&v, out);
+    source(in, 1);
+    for (int i = 0; i < N; i++) {
+        HT_CHECK(out[i][0] == out[i][1]);
+        HT_CHECK(fabsf(out[i][0] - VP_DOWNMIX_SIDE * in[i][0]) < 1e-6f);
+        HT_CHECK(fabsf(out[i][0] * out[i][0] + out[i][1] * out[i][1] - in[i][0] * in[i][0]) < 1e-5f);
+    }
+}
+
+/* each back bin to its own side at -3 dB, the other speaker exactly 0; a
+ * stereo voice's slots 4 and 5 are its left and right source channels */
+static void test_backs(void)
+{
+    Voice v = voice(2);
+    v.vol[4] = 0;               /* slot 4 (source left) to bin 4 (back left) */
+    float out[N][2], in[N][2];
+    mix(&v, out);
+    source(in, 2);
+    for (int i = 0; i < N; i++) {
+        HT_CHECK(fabsf(out[i][0] - VP_DOWNMIX_SIDE * in[i][0]) < 1e-6f);
+        HT_CHECK(out[i][1] == 0.0f);
+    }
+    v = voice(2);
+    v.vol[5] = 0;               /* slot 5 (source right) to bin 5 (back right) */
+    mix(&v, out);
+    for (int i = 0; i < N; i++) {
+        HT_CHECK(out[i][0] == 0.0f);
+        HT_CHECK(fabsf(out[i][1] - VP_DOWNMIX_SIDE * in[i][1]) < 1e-6f);
+    }
+}
+
+/* a sound panned right through the front-right and back-right bins stays
+ * on the right; the speakers' sends add, each at its own weight and its
+ * bin's headroom */
+static void test_five_speakers(void)
+{
+    Voice v = voice(1);
+    v.vol[0] = 0x300;           /* front left, -12 dB */
+    v.vol[1] = 0;               /* front right, 0 dB */
+    v.vol[2] = 0x180;           /* centre, -6 dB */
+    v.vol[4] = 0xFFF;           /* back left muted */
+    v.vol[5] = 0x0C0;           /* back right, -3 dB */
+    v.headroom[5] = 1;          /* back right: / 2 */
+    float out[N][2], in[N][2];
+    mix(&v, out);
+    source(in, 1);
+    const float k = VP_DOWNMIX_SIDE;
+    const float l = att_of(0x300) + k * att_of(0x180);
+    const float r = 1.0f + k * att_of(0x180) + k * att_of(0x0C0) / 2;
+    for (int i = 0; i < N; i++) {
+        HT_CHECK(fabsf(out[i][0] - l * in[i][0]) < 1e-5f);
+        HT_CHECK(fabsf(out[i][1] - r * in[i][0]) < 1e-5f);
+        HT_CHECK(out[i][1] > out[i][0]);
+    }
+}
+
+/* audible LFE, effect and multipass sends beside the speaker sends are left
+ * out: the same gains as the speaker sends alone, whatever their level */
+static void test_other_sends_left_out(void)
+{
+    static const int others[] = {VP_BIN_LFE, 10, 12, 20, MULTIPASS_BIN};
+    for (size_t k = 0; k < sizeof(others) / sizeof(others[0]); k++) {
+        Voice a = voice(1), b = voice(1);
+        a.vol[0] = b.vol[0] = 0x300;
+        a.vol[1] = b.vol[1] = 0;
+        b.bin[3] = others[k];
+        b.vol[3] = 0;           /* louder than the left send */
+        float ga[2][2], gb[2][2];
+        HT_CHECK(classify(&a) == VP_ROUTE_SPEAKERS && classify(&b) == VP_ROUTE_SPEAKERS);
+        gains(&a, ga);
+        gains(&b, gb);
+        HT_CHECK(memcmp(ga, gb, sizeof(ga)) == 0);
+    }
+}
+
+/* a speaker-routed voice's dry send fading to mute beside a louder effect
+ * send: its gains fall with the dry send, to exactly 0 at mute (the voice
+ * keeps its route as the volume changes, vp.c, so none of this switches to
+ * the effect send's level) */
+static void test_gains_fade_to_mute(void)
+{
+    static const uint16_t steps[] = {0x000, 0x400, 0xC00, 0xFFE, 0xFFF};
+    float last = INFINITY;
+    for (size_t k = 0; k < sizeof(steps) / sizeof(steps[0]); k++) {
+        Voice v = voice(1);
+        v.vol[0] = steps[k];    /* front left */
+        v.bin[2] = 10;          /* I3DL2, 0 dB */
+        v.vol[2] = 0;
+        float g[2][2];
+        gains(&v, g);
+        HT_CHECK(g[0][0] < last && g[1][0] == 0.0f);
+        HT_CHECK(fabsf(g[0][0] - att_of(steps[k])) < 1e-6f);
+        last = g[0][0];
+    }
+    HT_CHECK(last == 0.0f);
+}
+
+/* A 3D voice's sends to the 3D bins (its HRTF submixes): its two ears the
+ * sources, the left ear the even slots; the front pair to its own speaker at
+ * 0 dB, the back pair at -3 dB (the GP's crosstalk stage, then the EP's
+ * downmix, as measured), each send at its own headroom */
+static void test_3d_bins(void)
+{
+    Voice v = voice(2);         /* the HRTF filter's ears */
+    for (int b = 0; b < 4; b++) {
+        v.bin[b] = VP_BIN_3D_FRONT_LEFT + b;
+    }
+    v.vol[0] = 0;               /* left ear, 3D front left, 0 dB */
+    v.vol[1] = 0x300;           /* right ear, 3D front right, -12 dB */
+    v.vol[2] = 0;               /* left ear, 3D back left, 0 dB */
+    float out[N][2], in[N][2];
+    mix(&v, out);
+    source(in, 2);
+    const float l = 1.0f + VP_DOWNMIX_SIDE, r = att_of(0x300);
+    for (int i = 0; i < N; i++) {
+        HT_CHECK(fabsf(out[i][0] - l * in[i][0]) < 1e-5f);
+        HT_CHECK(fabsf(out[i][1] - r * in[i][1]) < 1e-5f);
+    }
+    /* behind the listener only: 3 dB under the same sound in front */
+    Voice back = voice(2), front = voice(2);
+    for (int b = 0; b < 4; b++) {
+        back.bin[b] = front.bin[b] = VP_BIN_3D_FRONT_LEFT + b;
+    }
+    front.vol[0] = front.vol[1] = 0;
+    back.vol[2] = back.vol[3] = 0;
+    float gf[2][2], gb[2][2];
+    HT_CHECK(classify(&back) == VP_ROUTE_SPEAKERS);
+    gains(&front, gf);
+    gains(&back, gb);
+    HT_CHECK(fabsf(gb[0][0] / gf[0][0] - VP_DOWNMIX_SIDE) < 1e-6f && fabsf(gb[1][1] / gf[1][1] - VP_DOWNMIX_SIDE) < 1e-6f);
+    HT_CHECK(gb[0][1] == 0.0f && gb[1][0] == 0.0f);
+}
+
+/* only LFE or non-speaker sends audible: the monitor's mix */
+static void test_no_speaker_send(void)
+{
+    static const int others[] = {VP_BIN_LFE, 10, 12, 20, MULTIPASS_BIN};
+    for (size_t k = 0; k < sizeof(others) / sizeof(others[0]); k++) {
+        Voice v = voice(1);
+        v.bin[4] = others[k];
+        v.vol[4] = 0x200;
+        HT_CHECK(classify(&v) == VP_ROUTE_MONITOR);
+    }
+}
+
+int main(void)
+{
+    HT_RUN(test_mono_left_only);
+    HT_RUN(test_mono_right_only);
+    HT_RUN(test_mono_equal);
+    HT_RUN(test_mono_unequal);
+    HT_RUN(test_stereo_standard);
+    HT_RUN(test_stereo_reordered);
+    HT_RUN(test_headroom_per_bin);
+    HT_RUN(test_muted_sends_ignored);
+    HT_RUN(test_silent);
+    HT_RUN(test_two_voices_add);
+    HT_RUN(test_centre);
+    HT_RUN(test_backs);
+    HT_RUN(test_five_speakers);
+    HT_RUN(test_other_sends_left_out);
+    HT_RUN(test_gains_fade_to_mute);
+    HT_RUN(test_3d_bins);
+    HT_RUN(test_no_speaker_send);
+    HT_DONE();
+}
diff --git a/tests/hle/test_batch_wrap.c b/tests/hle/test_batch_wrap.c
new file mode 100644
index 0000000000000000000000000000000000000000..0d821d1a7c471d1bac0deb154aa07d5d6879b2e7
--- /dev/null
+++ b/tests/hle/test_batch_wrap.c
@@ -0,0 +1,77 @@
+/* Every command the back end records through its device table (T.vkCmd*)
+ * goes through the strip batch's wrapper (vk/batch_wrap.h), which records
+ * a held run of strips first: a command without one reaches the command
+ * buffer before the draws queued ahead of it, and those draws take its
+ * state. vkCmdSetLineWidth had none, and two line strips of different
+ * widths merged into one draw at the second width. */
+#include "hle_test.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static char *slurp(const char *path)
+{
+    FILE *f = fopen(path, "rb");
+    if (!f) {
+        return NULL;
+    }
+    fseek(f, 0, SEEK_END);
+    long n = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    char *s = malloc((size_t)n + 1);
+    if (s && fread(s, 1, (size_t)n, f) != (size_t)n) {
+        free(s);
+        s = NULL;
+    }
+    if (s) {
+        s[n] = 0;
+    }
+    fclose(f);
+    return s;
+}
+
+static void test_every_command_wrapped(void)
+{
+    char *wrap = slurp(HLE_BATCH_WRAP);
+    HT_CHECK(wrap != NULL);
+    if (!wrap) {
+        return;
+    }
+    char list[] = HLE_VK_SOURCES;
+    unsigned files = 0, cmds = 0;
+    for (char *save = NULL, *path = strtok_r(list, "|", &save); path;
+         path = strtok_r(NULL, "|", &save)) {
+        char *src = slurp(path);
+        HT_CHECK(src != NULL);
+        if (!src) {
+            continue;
+        }
+        files++;
+        for (const char *p = strstr(src, "T.vkCmd"); p; p = strstr(p + 1, "T.vkCmd")) {
+            char name[64], fn[80], inst[200];
+            size_t n = 0;
+            for (const char *q = p + 2; n + 1 < sizeof(name) &&
+                 ((*q >= 'a' && *q <= 'z') || (*q >= 'A' && *q <= 'Z') || (*q >= '0' && *q <= '9'));
+                 q++) {
+                name[n++] = *q;
+            }
+            name[n] = 0;
+            snprintf(fn, sizeof(fn), "w_%s(", name);
+            snprintf(inst, sizeof(inst), "t->%s = w_%s;", name, name);
+            cmds++;
+            if (!strstr(wrap, fn) || !strstr(wrap, inst)) {
+                fprintf(stderr, "%s: %s has no batch wrapper\n", path, name);
+                ht_failures++;
+            }
+        }
+        free(src);
+    }
+    HT_CHECK(files > 4 && cmds > 20);           /* the sources were found and read */
+    free(wrap);
+}
+
+int main(void)
+{
+    HT_RUN(test_every_command_wrapped);
+    HT_DONE();
+}
