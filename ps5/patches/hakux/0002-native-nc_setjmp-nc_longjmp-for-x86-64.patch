From 51012d042fc78c4825b9808c9ceb0a7dcd563826 Mon Sep 17 00:00:00 2001
From: Press5elect <noreply@anthropic.com>
Date: Sun, 1 Nov 2026 04:31:56 +0000
Subject: [PATCH 2/6] native: nc_setjmp/nc_longjmp for x86-64

---
 native/core/jmp.c | 48 ++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 47 insertions(+), 1 deletion(-)

diff --git a/native/core/jmp.c b/native/core/jmp.c
index e334f4e..0104756 100644
--- a/native/core/jmp.c
+++ b/native/core/jmp.c
@@ -1,9 +1,13 @@
 /*
  * hakuX native core — setjmp/longjmp for the fault scopes (jmp.h).
- * Layout: x18-x30 at 0..0x60, sp at 0x68, d8-d15 at 0x70..0xA8.
+ * Layout (aarch64): x18-x30 at 0..0x60, sp at 0x68, d8-d15 at 0x70..0xA8.
+ * Layout (x86-64): rbx, rbp, r12-r15 at 0..0x28, rsp (the caller's) at 0x30,
+ * the return address at 0x38, MXCSR at 0x40, the x87 control word at 0x44.
  */
 #include "native/core/jmp.h"
 
+#if defined(__aarch64__)
+
 __attribute__((naked, returns_twice)) int nc_setjmp(nc_jmp_buf env)
 {
     __asm__ volatile("stp x18, x19, [x0, #0x00]\n"
@@ -40,3 +44,45 @@ __attribute__((naked, noreturn)) void nc_longjmp(nc_jmp_buf env, int val)
                      "csinc w0, w1, wzr, ne\n" /* 0 comes back as 1 */
                      "ret\n");
 }
+
+#elif defined(__x86_64__)
+
+__attribute__((naked, returns_twice)) int nc_setjmp(nc_jmp_buf env)
+{
+    __asm__ volatile("movq %rbx, 0x00(%rdi)\n"
+                     "movq %rbp, 0x08(%rdi)\n"
+                     "movq %r12, 0x10(%rdi)\n"
+                     "movq %r13, 0x18(%rdi)\n"
+                     "movq %r14, 0x20(%rdi)\n"
+                     "movq %r15, 0x28(%rdi)\n"
+                     "leaq 8(%rsp), %rdx\n"   /* the stack as the caller has it after the call */
+                     "movq %rdx, 0x30(%rdi)\n"
+                     "movq (%rsp), %rdx\n"    /* the return address */
+                     "movq %rdx, 0x38(%rdi)\n"
+                     "stmxcsr 0x40(%rdi)\n"
+                     "fnstcw 0x44(%rdi)\n"
+                     "xorl %eax, %eax\n"
+                     "ret\n");
+}
+
+__attribute__((naked, noreturn)) void nc_longjmp(nc_jmp_buf env, int val)
+{
+    __asm__ volatile("movq 0x00(%rdi), %rbx\n"
+                     "movq 0x08(%rdi), %rbp\n"
+                     "movq 0x10(%rdi), %r12\n"
+                     "movq 0x18(%rdi), %r13\n"
+                     "movq 0x20(%rdi), %r14\n"
+                     "movq 0x28(%rdi), %r15\n"
+                     "ldmxcsr 0x40(%rdi)\n"
+                     "fldcw 0x44(%rdi)\n"
+                     "movq 0x30(%rdi), %rsp\n"
+                     "movl %esi, %eax\n"
+                     "testl %eax, %eax\n"
+                     "jnz 1f\n"
+                     "incl %eax\n"           /* 0 comes back as 1 */
+                     "1: jmpq *0x38(%rdi)\n");
+}
+
+#else
+#error "nc_setjmp/nc_longjmp: no implementation for this architecture"
+#endif
