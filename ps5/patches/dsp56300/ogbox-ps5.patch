+//! Read-write-execute JIT memory, for hosts that make read+execute pages execute-only.
+//!
+//! OGBox (Press5elect), for the PS5: there a page mapped read and execute can't be read, so the
+//! constants Cranelift's x86-64 backend places after a function's code (and loads RIP-relative)
+//! would fault once the default provider's `finalize` took the write bit away. This provider maps
+//! its chunks read, write and execute once and leaves them so; x86-64 keeps its instruction cache
+//! coherent with stores, so `finalize` has nothing to do.
+
+use std::io;
+use std::ptr;
+
+use cranelift_jit::{BranchProtection, JITMemoryKind, JITMemoryProvider};
+use cranelift_module::ModuleResult;
+
+const CHUNK: usize = 1 << 20;
+
+struct Chunk {
+    ptr: *mut u8,
+    len: usize,
+    used: usize,
+}
+
+/// Bump allocation from read-write-execute chunks of at least 1 MiB.
+pub struct RwxMemoryProvider {
+    chunks: Vec<Chunk>,
+}
+
+unsafe impl Send for RwxMemoryProvider {}
+
+/// Read-write-execute memory, by the first way the host allows: an anonymous map so (Linux,
+/// FreeBSD); an anonymous read-write map given execute after (a host that refuses the three at
+/// once); a shared memory object mapped read-write and given execute after, as OGBox maps the
+/// Xbox's memory on the PS5 (memfd_create, which its link binds to the platform layer's shared
+/// memory on direct memory).
+fn map_rwx(len: usize) -> io::Result<*mut u8> {
+    let rwx = libc::PROT_READ | libc::PROT_WRITE | libc::PROT_EXEC;
+    let rw = libc::PROT_READ | libc::PROT_WRITE;
+    unsafe {
+        let p = libc::mmap(ptr::null_mut(), len, rwx, libc::MAP_PRIVATE | libc::MAP_ANON, -1, 0);
+        if p != libc::MAP_FAILED {
+            return Ok(p as *mut u8);
+        }
+        let p = libc::mmap(ptr::null_mut(), len, rw, libc::MAP_PRIVATE | libc::MAP_ANON, -1, 0);
+        if p != libc::MAP_FAILED {
+            if libc::mprotect(p, len, rwx) == 0 {
+                return Ok(p as *mut u8);
+            }
+            libc::munmap(p, len);
+        }
+        #[cfg(any(target_os = "freebsd", target_os = "linux"))]
+        {
+            let fd = libc::memfd_create(c"dsp56300-jit".as_ptr(), 0);
+            if fd >= 0 {
+                let ok = libc::ftruncate(fd, len as libc::off_t) == 0;
+                let p = if ok {
+                    libc::mmap(ptr::null_mut(), len, rw, libc::MAP_SHARED, fd, 0)
+                } else {
+                    libc::MAP_FAILED
+                };
+                libc::close(fd);    // the map keeps the object
+                if p != libc::MAP_FAILED {
+                    if libc::mprotect(p, len, rwx) == 0 {
+                        return Ok(p as *mut u8);
+                    }
+                    libc::munmap(p, len);
+                }
+            }
+        }
+    }
+    Err(io::Error::other("no read-write-execute memory for the JIT"))
+}
+
+/// Whether this process may map read-write-execute memory (checked with one chunk's first 64 KiB:
+/// a whole number of the PS5's 16 KiB pages).
+pub fn rwx_available() -> bool {
+    match map_rwx(1 << 16) {
+        Ok(p) => {
+            unsafe { libc::munmap(p as *mut libc::c_void, 1 << 16) };
+            true
+        }
+        Err(_) => false,
+    }
+}
+
+impl RwxMemoryProvider {
+    pub fn new() -> Self {
+        Self { chunks: Vec::new() }
+    }
+}
+
+impl Default for RwxMemoryProvider {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl JITMemoryProvider for RwxMemoryProvider {
+    fn allocate(&mut self, size: usize, align: u64, _kind: JITMemoryKind) -> io::Result<*mut u8> {
+        let align = (align as usize).max(16);
+        if let Some(c) = self.chunks.last_mut() {
+            let start = (c.ptr as usize + c.used).next_multiple_of(align) - c.ptr as usize;
+            if start + size <= c.len {
+                c.used = start + size;
+                return Ok(unsafe { c.ptr.add(start) });
+            }
+        }
+        let len = (size + align).next_multiple_of(CHUNK).max(CHUNK);
+        let ptr = map_rwx(len)?;
+        let start = (ptr as usize).next_multiple_of(align) - ptr as usize;
+        self.chunks.push(Chunk { ptr, len, used: start + size });
+        Ok(unsafe { ptr.add(start) })
+    }
+
+    unsafe fn free_memory(&mut self) {
+        for c in self.chunks.drain(..) {
+            unsafe { libc::munmap(c.ptr as *mut libc::c_void, c.len) };
+        }
+    }
+
+    fn finalize(&mut self, _branch_protection: BranchProtection) -> ModuleResult<()> {
+        Ok(())
+    }
+}
+
+impl Drop for RwxMemoryProvider {
+    fn drop(&mut self) {
+        unsafe { self.free_memory() };
+    }
+}
